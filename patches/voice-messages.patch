+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {renderHook} from '@testing-library/react';
+
+import type {FileUpload} from 'components/file_upload/file_upload';
+
+import {TestHelper} from 'utils/test_helper';
+
+import type {PostDraft} from 'types/store/draft';
+
+import useVoiceMessageUploads from './use_voice_message_uploads';
+
+describe('useVoiceMessageUploads', () => {
+    const voiceMessage = {duration: 3100, waveform: [20, 80, 100]};
+    const file = new File(['opus'], 'voice-message-1731420000000.weba', {type: 'audio/webm'});
+
+    function setup() {
+        const checkPluginHooksAndUploadFiles = jest.fn();
+        const fileUploadRef = {current: {checkPluginHooksAndUploadFiles} as unknown as FileUpload};
+        const {result} = renderHook(() => useVoiceMessageUploads(fileUploadRef));
+        return {result, checkPluginHooksAndUploadFiles};
+    }
+
+    function draftWith(fileInfos: PostDraft['fileInfos']): PostDraft {
+        return {message: '', fileInfos, uploadsInProgress: [], channelId: 'channel1', rootId: '', createAt: 0, updateAt: 0};
+    }
+
+    test('uploads the recording through the regular upload path', () => {
+        const {result, checkPluginHooksAndUploadFiles} = setup();
+
+        result.current.uploadVoiceMessage({file, voiceMessage});
+
+        expect(checkPluginHooksAndUploadFiles).toHaveBeenCalledWith([file]);
+    });
+
+    test('stores duration and waveform under the uploaded file id once the upload finishes', () => {
+        const {result} = setup();
+        const uploaded = TestHelper.getFileInfoMock({id: 'file1', name: file.name});
+
+        result.current.uploadVoiceMessage({file, voiceMessage});
+        const draft = result.current.withVoiceMessages(draftWith([uploaded]), [uploaded]);
+
+        expect(draft.props).toEqual({voice_messages: {file1: voiceMessage}});
+    });
+
+    test('leaves drafts alone for ordinary uploads', () => {
+        const {result} = setup();
+        const uploaded = TestHelper.getFileInfoMock({id: 'file2', name: 'notes.mp3'});
+        const draft = draftWith([uploaded]);
+
+        result.current.uploadVoiceMessage({file, voiceMessage});
+
+        expect(result.current.withVoiceMessages(draft, [uploaded])).toBe(draft);
+    });
+});
diff --git a/webapp/channels/src/components/voice_message/use_voice_message_uploads.ts b/webapp/channels/src/components/voice_message/use_voice_message_uploads.ts
