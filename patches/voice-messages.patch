+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {TestHelper} from 'utils/test_helper';
+
+import type {PostDraft} from 'types/store/draft';
+
+import {addVoiceMessages, computeWaveform, formatDuration, parseVoiceMessages, pickRecorderFormat} from './voice_message';
+
+describe('parseVoiceMessages', () => {
+    test('keeps valid entries keyed by file id', () => {
+        const waveform = Array.from({length: 64}, (_, i) => i);
+
+        expect(parseVoiceMessages({voice_messages: {file1: {duration: 2400, waveform}}})).toEqual({
+            file1: {duration: 2400, waveform},
+        });
+    });
+
+    test('drops entries without a usable duration and posts without the prop', () => {
+        expect(parseVoiceMessages({voice_messages: {
+            file1: {waveform: [1, 2]},
+            file2: {duration: 'long', waveform: []},
+            file3: {duration: -5, waveform: []},
+            file4: null,
+        }})).toEqual({});
+        expect(parseVoiceMessages({})).toEqual({});
+        expect(parseVoiceMessages(undefined)).toEqual({});
+        expect(parseVoiceMessages({voice_messages: ['file1']})).toEqual({});
+    });
+
+    test('clamps bar heights and caps the waveform at 64 bars', () => {
+        const waveform = [150, -3, 'x', 42.6, ...new Array(100).fill(10)];
+
+        const parsed = parseVoiceMessages({voice_messages: {file1: {duration: 1000, waveform}}}).file1;
+
+        expect(parsed.waveform).toHaveLength(64);
+        expect(parsed.waveform.slice(0, 4)).toEqual([100, 0, 0, 43]);
+    });
+
+    test('treats a missing waveform as empty', () => {
+        expect(parseVoiceMessages({voice_messages: {file1: {duration: 1000}}})).toEqual({file1: {duration: 1000, waveform: []}});
+    });
+});
+
+describe('addVoiceMessages', () => {
+    const draft = (fileIds: string[], props?: Record<string, unknown>) => ({
+        message: '',
+        fileInfos: fileIds.map((id) => TestHelper.getFileInfoMock({id})),
+        uploadsInProgress: [],
+        channelId: 'channel1',
+        rootId: '',
+        createAt: 0,
+        updateAt: 0,
+        props,
+    } as PostDraft);
+
+    test('adds the recording under its uploaded file id and keeps other props', () => {
+        const result = addVoiceMessages(draft(['file1'], {other: 'value'}), {file1: {duration: 1000, waveform: [5]}});
+
+        expect(result.props).toEqual({other: 'value', voice_messages: {file1: {duration: 1000, waveform: [5]}}});
+    });
+
+    test('drops entries for files the user removed from the draft', () => {
+        const existing = draft(['file2'], {voice_messages: {file1: {duration: 1000, waveform: []}, file2: {duration: 2000, waveform: []}}});
+
+        const result = addVoiceMessages({...existing, fileInfos: [...existing.fileInfos, TestHelper.getFileInfoMock({id: 'file3'})]}, {file3: {duration: 3000, waveform: []}});
+
+        expect(Object.keys(result.props.voice_messages)).toEqual(['file2', 'file3']);
+    });
+
+    test('leaves the draft untouched when no recording was uploaded', () => {
+        const unchanged = draft(['file1']);
+
+        expect(addVoiceMessages(unchanged, {})).toBe(unchanged);
+    });
+});
+
+describe('computeWaveform', () => {
+    test('returns 64 bars scaled so the loudest is 100', () => {
+        const samples = new Float32Array(64 * 100);
+        samples.fill(0.25, 0, 3200);
+        samples.fill(-0.5, 3200);
+
+        const waveform = computeWaveform(samples);
+
+        expect(waveform).toHaveLength(64);
+        expect(waveform[0]).toBe(50);
+        expect(waveform[63]).toBe(100);
+    });
+
+    test('returns flat bars for silence', () => {
+        expect(computeWaveform(new Float32Array(6400))).toEqual(new Array(64).fill(0));
+    });
+});
+
+describe('formatDuration', () => {
+    test.each([
+        [0, '0:00'],
+        [2400, '0:02'],
+        [65_500, '1:06'],
+        [300_000, '5:00'],
+    ])('%i ms is %s', (ms, text) => {
+        expect(formatDuration(ms)).toBe(text);
+    });
+});
+
+describe('pickRecorderFormat', () => {
+    const originalMediaRecorder = (global as any).MediaRecorder;
+    const originalMediaDevices = navigator.mediaDevices;
+
+    function mockSupport(supported: string[]) {
+        (global as any).MediaRecorder = {isTypeSupported: (mimeType: string) => supported.includes(mimeType)};
+        Object.defineProperty(navigator, 'mediaDevices', {value: {getUserMedia: jest.fn()}, configurable: true});
+    }
+
+    afterEach(() => {
+        (global as any).MediaRecorder = originalMediaRecorder;
+        Object.defineProperty(navigator, 'mediaDevices', {value: originalMediaDevices, configurable: true});
+    });
+
+    it('prefers MP4 so recordings play on iOS', () => {
+        mockSupport(['audio/mp4;codecs=mp4a.40.2', 'audio/mp4', 'audio/webm;codecs=opus']);
+        expect(pickRecorderFormat()).toEqual({mimeType: 'audio/mp4;codecs=mp4a.40.2', extension: 'm4a'});
+    });
+
+    it('falls back to WebM when MP4 recording is not supported', () => {
+        mockSupport(['audio/webm;codecs=opus']);
+        expect(pickRecorderFormat()).toEqual({mimeType: 'audio/webm;codecs=opus', extension: 'weba'});
+    });
+});
