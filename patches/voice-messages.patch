@@ -0,0 +1,93 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {fireEvent, screen} from '@testing-library/react';
+import React from 'react';
+
+import {renderWithContext, userEvent} from 'tests/react_testing_utils';
+import {TestHelper} from 'utils/test_helper';
+
+import VoiceMessagePlayer from './voice_message_player';
+
+describe('VoiceMessagePlayer', () => {
+    const fileInfo = TestHelper.getFileInfoMock({id: 'file1', name: 'voice-message-1.weba', extension: 'weba', mime_type: 'audio/webm'});
+    const waveform = Array.from({length: 64}, (_, i) => i);
+
+    beforeEach(() => {
+        jest.spyOn(HTMLMediaElement.prototype, 'play').mockImplementation(function(this: HTMLMediaElement) {
+            Object.defineProperty(this, 'paused', {value: false, configurable: true});
+            this.dispatchEvent(new Event('play'));
+            return Promise.resolve();
+        });
+        jest.spyOn(HTMLMediaElement.prototype, 'pause').mockImplementation(function(this: HTMLMediaElement) {
+            Object.defineProperty(this, 'paused', {value: true, configurable: true});
+            this.dispatchEvent(new Event('pause'));
+        });
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    function renderPlayer(duration = 23_000) {
+        const {container} = renderWithContext(
+            <VoiceMessagePlayer
+                fileInfo={fileInfo}
+                voiceMessage={{duration, waveform}}
+            />,
+        );
+        return container.querySelector('audio')!;
+    }
+
+    test('shows the stored duration and one bar per waveform value before playback', () => {
+        const audio = renderPlayer();
+
+        expect(screen.getByText('0:23')).toBeInTheDocument();
+        expect(screen.getByRole('slider', {name: 'Voice message position'})).toHaveAttribute('aria-valuetext', '0:00 of 0:23');
+        expect(document.querySelectorAll('.VoiceMessagePlayer__bar')).toHaveLength(64);
+        expect(audio.getAttribute('src')).toContain('/api/v4/files/file1');
+    });
+
+    test('toggles between play and pause', async () => {
+        renderPlayer();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Play voice message'}));
+        expect(screen.getByRole('button', {name: 'Pause voice message'})).toBeInTheDocument();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Pause voice message'}));
+        expect(screen.getByRole('button', {name: 'Play voice message'})).toBeInTheDocument();
+    });
+
+    test('cycles playback speed through 1x, 1.5x and 2x', async () => {
+        const audio = renderPlayer();
+        const speed = () => screen.getByRole('button', {name: /Playback speed/});
+
+        expect(speed()).toHaveTextContent('1x');
+        await userEvent.click(speed());
+        expect(speed()).toHaveTextContent('1.5x');
+        expect(audio.playbackRate).toBe(1.5);
+        await userEvent.click(speed());
+        expect(speed()).toHaveTextContent('2x');
+        await userEvent.click(speed());
+        expect(speed()).toHaveTextContent('1x');
+    });
+
+    test('seeks with the keyboard and marks played bars', () => {
+        const audio = renderPlayer(20_000);
+        const slider = screen.getByRole('slider');
+
+        fireEvent.keyDown(slider, {key: 'ArrowRight'});
+        fireEvent.keyDown(slider, {key: 'ArrowRight'});
+
+        expect(audio.currentTime).toBe(10);
+        expect(slider).toHaveAttribute('aria-valuenow', '10');
+        expect(screen.getByText('0:10')).toBeInTheDocument();
+        expect(document.querySelectorAll('.VoiceMessagePlayer__bar--played')).toHaveLength(32);
+
+        fireEvent.keyDown(slider, {key: 'End'});
+        expect(slider).toHaveAttribute('aria-valuenow', '20');
+
+        fireEvent.keyDown(slider, {key: 'Home'});
+        expect(document.querySelectorAll('.VoiceMessagePlayer__bar--played')).toHaveLength(0);
+    });
+});
diff --git a/webapp/channels/src/components/voice_message/voice_message_player.tsx b/webapp/channels/src/components/voice_message/voice_message_player.tsx
new file mode 100644
index 000000000000..7a39ba77e84e
--- /dev/null
+++ b/webapp/channels/src/components/voice_message/voice_message_player.tsx
@@ -0,0 +1,176 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import classNames from 'classnames';
+import React, {useCallback, useEffect, useRef, useState} from 'react';
+import {defineMessages, useIntl} from 'react-intl';
+
+import {PauseIcon, PlayIcon} from '@mattermost/compass-icons/components';
+import type {FileInfo} from '@mattermost/types/files';
+
+import {getFileUrl} from 'mattermost-redux/utils/file_utils';
+
+import {WAVEFORM_BARS, formatDuration} from './voice_message';
+import type {VoiceMessage} from './voice_message';
+
+import './voice_message_player.scss';
+
+const messages = defineMessages({
+    play: {id: 'voice_message.play', defaultMessage: 'Play voice message', description: 'Accessible label of the play button on a voice message in a post.'},
+    pause: {id: 'voice_message.pause', defaultMessage: 'Pause voice message', description: 'Accessible label of the pause button on a voice message in a post.'},
+    seek: {id: 'voice_message.seek', defaultMessage: 'Voice message position', description: 'Accessible label of the waveform slider used to move through a voice message.'},
+    position: {id: 'voice_message.position', defaultMessage: '{position} of {duration}', description: 'Screen reader value of the voice message slider; position and duration are times like 0:07 and 0:23.'},
+    speed: {id: 'voice_message.speed', defaultMessage: '{speed, number}x', description: 'Text of the voice message playback speed button, e.g. 1.5x; speed is a number.'},
+    speedLabel: {id: 'voice_message.speed_label', defaultMessage: 'Playback speed {speed, number}x', description: 'Accessible label of the voice message playback speed button; speed is a number.'},
+});
+
+const SPEEDS = [1, 1.5, 2];
+const SEEK_STEP_SECONDS = 5;
+const MIN_BAR_HEIGHT = 10;
+const FLAT_WAVEFORM = new Array(WAVEFORM_BARS).fill(0);
+
+type Props = {
+    fileInfo: FileInfo;
+    voiceMessage: VoiceMessage;
+};
+
+export default function VoiceMessagePlayer({fileInfo, voiceMessage}: Props) {
+    const {formatMessage} = useIntl();
+    const audioRef = useRef<HTMLAudioElement>(null);
+    const [playing, setPlaying] = useState(false);
+    const [position, setPosition] = useState(0);
+    const [speed, setSpeed] = useState(SPEEDS[0]);
+
+    const durationSeconds = voiceMessage.duration / 1000;
+    const progress = Math.min(1, position / durationSeconds);
+    const bars = voiceMessage.waveform.length > 0 ? voiceMessage.waveform : FLAT_WAVEFORM;
+
+    useEffect(() => {
+        const audio = audioRef.current;
+        if (audio) {
+            audio.defaultPlaybackRate = speed;
+            audio.playbackRate = speed;
+        }
+    }, [speed]);
+
+    useEffect(() => {
+        if (!playing) {
+            return undefined;
+        }
+        let frame = 0;
+        const tick = () => {
+            setPosition(audioRef.current?.currentTime ?? 0);
+            frame = requestAnimationFrame(tick);
+        };
+        frame = requestAnimationFrame(tick);
+        return () => cancelAnimationFrame(frame);
+    }, [playing]);
+
+    const togglePlay = useCallback(() => {
+        const audio = audioRef.current;
+        if (!audio) {
+            return;
+        }
+        if (audio.paused) {
+            audio.play()?.catch(() => setPlaying(false));
+        } else {
+            audio.pause();
+        }
+    }, []);
+
+    const seek = useCallback((seconds: number) => {
+        const target = Math.min(durationSeconds, Math.max(0, seconds));
+        if (audioRef.current) {
+            audioRef.current.currentTime = target;
+        }
+        setPosition(target);
+    }, [durationSeconds]);
+
+    const handleWaveformClick = (e: React.MouseEvent<HTMLDivElement>) => {
+        const rect = e.currentTarget.getBoundingClientRect();
+        seek(((e.clientX - rect.left) / rect.width) * durationSeconds);
+    };
+
+    const handleWaveformKeyDown = (e: React.KeyboardEvent<HTMLDivElement>) => {
+        const targets: Record<string, number> = {
+            ArrowRight: position + SEEK_STEP_SECONDS,
+            ArrowUp: position + SEEK_STEP_SECONDS,
+            ArrowLeft: position - SEEK_STEP_SECONDS,
+            ArrowDown: position - SEEK_STEP_SECONDS,
+            Home: 0,
+            End: durationSeconds,
+        };
+        if (e.key in targets) {
+            e.preventDefault();
+            seek(targets[e.key]);
+        }
+    };
+
+    const handleEnded = () => {
+        setPlaying(false);
+        seek(0);
+    };
+
+    const cycleSpeed = () => setSpeed((current) => SPEEDS[(SPEEDS.indexOf(current) + 1) % SPEEDS.length]);
+
+    const started = playing || position > 0;
+    const positionText = formatDuration(position * 1000);
+    const durationText = formatDuration(voiceMessage.duration);
+
+    return (
+        <div
+            className='VoiceMessagePlayer'
+            data-testid='voiceMessagePlayer'
+        >
+            <button
+                type='button'
+                className='VoiceMessagePlayer__play'
+                aria-label={formatMessage(playing ? messages.pause : messages.play)}
+                onClick={togglePlay}
+            >
+                {playing ? <PauseIcon size={18}/> : <PlayIcon size={18}/>}
+            </button>
+            <div
+                className='VoiceMessagePlayer__waveform'
+                role='slider'
+                tabIndex={0}
+                aria-label={formatMessage(messages.seek)}
+                aria-valuemin={0}
+                aria-valuemax={Math.round(durationSeconds)}
+                aria-valuenow={Math.round(position)}
+                aria-valuetext={formatMessage(messages.position, {position: positionText, duration: durationText})}
+                onClick={handleWaveformClick}
+                onKeyDown={handleWaveformKeyDown}
+            >
+                {bars.map((bar, index) => (
+                    <span
+                        key={index}
+                        className={classNames('VoiceMessagePlayer__bar', {
+                            'VoiceMessagePlayer__bar--played': (index + 0.5) / bars.length <= progress,
+                        })}
+                        style={{height: `${Math.max(MIN_BAR_HEIGHT, bar)}%`}}
+                    />
+                ))}
+            </div>
+            <span className='VoiceMessagePlayer__time'>
+                {started ? positionText : durationText}
+            </span>
+            <button
+                type='button'
+                className='VoiceMessagePlayer__speed'
+                aria-label={formatMessage(messages.speedLabel, {speed})}
+                onClick={cycleSpeed}
+            >
+                {formatMessage(messages.speed, {speed})}
+            </button>
+            <audio
+                ref={audioRef}
+                src={getFileUrl(fileInfo.id)}
+                preload='none'
+                onPlay={() => setPlaying(true)}
+                onPause={() => setPlaying(false)}
+                onEnded={handleEnded}
+            />
+        </div>
+    );
+}
