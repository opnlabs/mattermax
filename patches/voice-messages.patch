+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {FileInfo} from '@mattermost/types/files';
+
+import type {PostDraft} from 'types/store/draft';
+
+export const VOICE_MESSAGES_PROP = 'voice_messages';
+export const MAX_RECORDING_MS = 5 * 60 * 1000;
+export const WAVEFORM_BARS = 64;
+const WAVEFORM_MAX = 100;
+
+export type VoiceMessage = {
+    duration: number;
+    waveform: number[];
+};
+
+export type VoiceRecording = {
+    file: File;
+    voiceMessage: VoiceMessage;
+};
+
+type RecorderFormat = {
+    mimeType: string;
+    extension: string;
+};
+
+const RECORDER_FORMATS: RecorderFormat[] = [
+    {mimeType: 'audio/mp4;codecs=mp4a.40.2', extension: 'm4a'},
+    {mimeType: 'audio/mp4', extension: 'm4a'},
+    {mimeType: 'audio/webm;codecs=opus', extension: 'weba'},
+];
+
+export function pickRecorderFormat(): RecorderFormat | undefined {
+    if (typeof MediaRecorder === 'undefined' || !navigator.mediaDevices?.getUserMedia) {
+        return undefined;
+    }
+    return RECORDER_FORMATS.find((format) => MediaRecorder.isTypeSupported(format.mimeType));
+}
+
+export function voiceMessageFile(blob: Blob, format: RecorderFormat): File {
+    return new File([blob], `voice-message-${Date.now()}.${format.extension}`, {type: format.mimeType.split(';')[0]});
+}
+
+function clampBar(value: unknown): number {
+    if (typeof value !== 'number' || !Number.isFinite(value)) {
+        return 0;
+    }
+    return Math.min(WAVEFORM_MAX, Math.max(0, Math.round(value)));
+}
+
+function parseVoiceMessage(entry: unknown): VoiceMessage | undefined {
+    if (!entry || typeof entry !== 'object') {
+        return undefined;
+    }
+    const {duration, waveform} = entry as Record<string, unknown>;
+    if (typeof duration !== 'number' || !Number.isFinite(duration) || duration <= 0) {
+        return undefined;
+    }
+    return {
+        duration: Math.round(duration),
+        waveform: Array.isArray(waveform) ? waveform.slice(0, WAVEFORM_BARS).map(clampBar) : [],
+    };
+}
+
+export function parseVoiceMessages(props: unknown): Record<string, VoiceMessage> {
+    const raw = (props as Record<string, unknown> | undefined)?.[VOICE_MESSAGES_PROP];
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+        return {};
+    }
+
+    const voiceMessages: Record<string, VoiceMessage> = {};
+    for (const [fileId, entry] of Object.entries(raw)) {
+        const voiceMessage = parseVoiceMessage(entry);
+        if (voiceMessage) {
+            voiceMessages[fileId] = voiceMessage;
+        }
+    }
+    return voiceMessages;
+}
+
+export function voiceMessageForFile(voiceMessages: Record<string, VoiceMessage>, fileInfo: FileInfo): VoiceMessage | undefined {
+    if (fileInfo.delete_at > 0 || fileInfo.archived || !fileInfo.mime_type.startsWith('audio/')) {
+        return undefined;
+    }
+    return voiceMessages[fileInfo.id];
+}
+
+export function addVoiceMessages(draft: PostDraft, added: Record<string, VoiceMessage>): PostDraft {
+    if (Object.keys(added).length === 0) {
+        return draft;
+    }
+
+    const attached = new Set(draft.fileInfos.map((fileInfo) => fileInfo.id));
+    const kept = Object.entries(parseVoiceMessages(draft.props)).filter(([fileId]) => attached.has(fileId));
+
+    return {
+        ...draft,
+        props: {
+            ...draft.props,
+            [VOICE_MESSAGES_PROP]: {...Object.fromEntries(kept), ...added},
+        },
+    };
+}
+
+export function computeWaveform(samples: Float32Array, bars = WAVEFORM_BARS): number[] {
+    const bucketSize = Math.floor(samples.length / bars);
+    if (bucketSize === 0) {
+        return [];
+    }
+
+    const levels: number[] = [];
+    for (let bar = 0; bar < bars; bar++) {
+        let sum = 0;
+        for (let i = bar * bucketSize; i < (bar + 1) * bucketSize; i++) {
+            sum += samples[i] * samples[i];
+        }
+        levels.push(Math.sqrt(sum / bucketSize));
+    }
+
+    const peak = Math.max(...levels);
+    return levels.map((level) => (peak > 0 ? Math.round((level / peak) * WAVEFORM_MAX) : 0));
+}
+
+export async function analyzeRecording(blob: Blob, elapsed: number): Promise<VoiceMessage> {
+    const context = new AudioContext();
+    try {
+        const buffer = await context.decodeAudioData(await blob.arrayBuffer());
+        return {
+            duration: Math.round(buffer.duration * 1000),
+            waveform: computeWaveform(buffer.getChannelData(0)),
+        };
+    } catch {
+        return {duration: elapsed, waveform: []};
+    } finally {
+        context.close();
+    }
+}
+
+export function formatDuration(ms: number): string {
+    const seconds = Math.round(ms / 1000);
+    return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
+}
