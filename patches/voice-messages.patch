+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {act, screen, waitFor} from '@testing-library/react';
+import React from 'react';
+
+import {renderWithContext, userEvent} from 'tests/react_testing_utils';
+import {TestHelper} from 'utils/test_helper';
+
+import VoiceMessageButton from './voice_message_button';
+
+class FakeMediaRecorder {
+    static isTypeSupported = jest.fn((mimeType: string) => mimeType === 'audio/webm;codecs=opus');
+    state = 'inactive';
+    ondataavailable: ((e: {data: Blob}) => void) | null = null;
+    onstop: (() => void) | null = null;
+    constructor(public stream: MediaStream, public options: MediaRecorderOptions) {}
+    start() {
+        this.state = 'recording';
+    }
+    stop() {
+        this.state = 'inactive';
+        this.ondataavailable?.({data: new Blob(['opus'], {type: 'audio/webm'})});
+        this.onstop?.();
+    }
+}
+
+class FakeAudioContext {
+    async decodeAudioData() {
+        const samples = new Float32Array(6400);
+        samples.fill(0.5, 3200);
+        return {duration: 2.4, getChannelData: () => samples};
+    }
+    close() {
+        return Promise.resolve();
+    }
+}
+
+describe('VoiceMessageButton', () => {
+    const channel = TestHelper.getChannelMock({id: 'channel1', team_id: 'team1'});
+    const user = TestHelper.getUserMock({id: 'user1', roles: 'system_user'});
+    const track = {stop: jest.fn()};
+    const getUserMedia = jest.fn();
+
+    function state({enableFileAttachments = 'true', permissions = ['upload_file']} = {}) {
+        return {
+            entities: {
+                general: {config: {EnableFileAttachments: enableFileAttachments}},
+                channels: {channels: {[channel.id]: channel}},
+                users: {currentUserId: user.id, profiles: {[user.id]: user}},
+                roles: {roles: {system_user: TestHelper.getRoleMock({name: 'system_user', permissions})}},
+            },
+        };
+    }
+
+    function renderButton(initialState = state(), props: Partial<React.ComponentProps<typeof VoiceMessageButton>> = {}) {
+        const onRecorded = jest.fn();
+        const onError = jest.fn();
+        renderWithContext(
+            <VoiceMessageButton
+                channelId={channel.id}
+                rootId=''
+                disabledByPolicy={false}
+                onRecorded={onRecorded}
+                onError={onError}
+                {...props}
+            />,
+            initialState,
+        );
+        return {onRecorded, onError};
+    }
+
+    beforeAll(() => {
+        Blob.prototype.arrayBuffer ??= () => Promise.resolve(new ArrayBuffer(0));
+    });
+
+    beforeEach(() => {
+        (global as any).MediaRecorder = FakeMediaRecorder;
+        (global as any).AudioContext = FakeAudioContext;
+        getUserMedia.mockReset().mockResolvedValue({getTracks: () => [track]});
+        Object.defineProperty(navigator, 'mediaDevices', {value: {getUserMedia}, configurable: true});
+    });
+
+    afterEach(() => {
+        delete (global as any).MediaRecorder;
+        delete (global as any).AudioContext;
+    });
+
+    test('shows the microphone button when the user can upload files in the channel', () => {
+        renderButton();
+
+        expect(screen.getByRole('button', {name: 'Record voice message'})).toBeInTheDocument();
+    });
+
+    test('hides the button when file attachments are disabled', () => {
+        renderButton(state({enableFileAttachments: 'false'}));
+
+        expect(screen.queryByRole('button', {name: 'Record voice message'})).not.toBeInTheDocument();
+    });
+
+    test('hides the button when the user lacks the upload_file permission', () => {
+        renderButton(state({permissions: []}));
+
+        expect(screen.queryByRole('button', {name: 'Record voice message'})).not.toBeInTheDocument();
+    });
+
+    test('hides the button when an access policy denies uploads in the channel', () => {
+        renderButton(state(), {disabledByPolicy: true});
+
+        expect(screen.queryByRole('button', {name: 'Record voice message'})).not.toBeInTheDocument();
+    });
+
+    test('hides the button when the browser cannot record audio', () => {
+        delete (global as any).MediaRecorder;
+        renderButton();
+
+        expect(screen.queryByRole('button', {name: 'Record voice message'})).not.toBeInTheDocument();
+    });
+
+    test('explains a denied microphone permission', async () => {
+        getUserMedia.mockRejectedValue(new DOMException('denied', 'NotAllowedError'));
+        const {onError} = renderButton();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Record voice message'}));
+
+        expect(onError).toHaveBeenLastCalledWith('Microphone access is blocked. Allow microphone access for this site in your browser settings to record voice messages.');
+        expect(screen.getByRole('button', {name: 'Record voice message'})).toBeEnabled();
+    });
+
+    test('records, then hands over a file with its duration and waveform on stop', async () => {
+        const {onRecorded} = renderButton();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Record voice message'}));
+
+        expect(screen.getByRole('group', {name: 'Recording voice message'})).toBeInTheDocument();
+        expect(screen.getByRole('timer')).toHaveTextContent('0:00 / 5:00');
+        expect(screen.getByRole('button', {name: 'Stop and attach recording'})).toHaveFocus();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Stop and attach recording'}));
+
+        await waitFor(() => expect(onRecorded).toHaveBeenCalledTimes(1));
+        const {file, voiceMessage} = onRecorded.mock.calls[0][0];
+        expect(file.name).toMatch(/^voice-message-\d+\.weba$/);
+        expect(file.type).toBe('audio/webm');
+        expect(voiceMessage.duration).toBe(2400);
+        expect(voiceMessage.waveform).toHaveLength(64);
+        expect(voiceMessage.waveform[0]).toBe(0);
+        expect(voiceMessage.waveform[63]).toBe(100);
+        expect(track.stop).toHaveBeenCalled();
+        expect(screen.getByRole('button', {name: 'Record voice message'})).toBeInTheDocument();
+    });
+
+    test('discards the recording when Escape is pressed', async () => {
+        const {onRecorded} = renderButton();
+
+        await userEvent.click(screen.getByRole('button', {name: 'Record voice message'}));
+        await userEvent.keyboard('{Escape}');
+
+        expect(screen.getByRole('button', {name: 'Record voice message'})).toHaveFocus();
+        expect(onRecorded).not.toHaveBeenCalled();
+    });
+
+    test('stops on its own at the five minute limit', async () => {
+        jest.useFakeTimers({doNotFake: ['queueMicrotask', 'nextTick']});
+        try {
+            const {onRecorded} = renderButton();
+
+            await act(async () => {
+                screen.getByRole('button', {name: 'Record voice message'}).click();
+            });
+            await act(async () => {
+                jest.advanceTimersByTime(5 * 60 * 1000);
+            });
+
+            await waitFor(() => expect(onRecorded).toHaveBeenCalledTimes(1));
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+});
