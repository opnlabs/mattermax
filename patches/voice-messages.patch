+.VoiceMessagePlayer {
+    display: flex;
+    width: 100%;
+    max-width: 420px;
+    box-sizing: border-box;
+    align-items: center;
+    padding: 8px 12px 8px 8px;
+    border: 1px solid rgba(var(--center-channel-color-rgb), 0.16);
+    border-radius: 24px;
+    margin: 4px 0;
+    background: var(--center-channel-bg);
+    gap: 12px;
+
+    &__play {
+        display: flex;
+        width: 32px;
+        height: 32px;
+        flex-shrink: 0;
+        align-items: center;
+        justify-content: center;
+        padding: 0;
+        border: none;
+        border-radius: 50%;
+        background: var(--button-bg);
+        color: var(--button-color);
+
+        &:hover {
+            background: linear-gradient(0deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.08)), var(--button-bg);
+        }
+    }
+
+    &__waveform {
+        display: flex;
+        height: 28px;
+        flex: 1;
+        align-items: center;
+        border-radius: 4px;
+        cursor: pointer;
+        gap: 2px;
+
+        &:focus-visible {
+            outline: 2px solid var(--button-bg);
+            outline-offset: 2px;
+        }
+    }
+
+    &__bar {
+        min-width: 2px;
+        flex: 1;
+        border-radius: 2px;
+        background: rgba(var(--center-channel-color-rgb), 0.32);
+
+        &--played {
+            background: var(--button-bg);
+        }
+    }
+
+    &__time {
+        min-width: 32px;
+        color: rgba(var(--center-channel-color-rgb), 0.72);
+        font-size: 12px;
+        font-variant-numeric: tabular-nums;
+        text-align: right;
+    }
+
+    &__speed {
+        min-width: 40px;
+        height: 24px;
+        flex-shrink: 0;
+        padding: 0 6px;
+        border: none;
+        border-radius: 12px;
+        background: rgba(var(--center-channel-color-rgb), 0.08);
+        color: rgba(var(--center-channel-color-rgb), 0.72);
+        font-size: 11px;
+        font-weight: 600;
+
+        &:hover {
+            background: rgba(var(--center-channel-color-rgb), 0.16);
+        }
+    }
+}
