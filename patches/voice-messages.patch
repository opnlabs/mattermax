+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React, {useCallback, useEffect, useMemo, useRef, useState} from 'react';
+import {defineMessages, useIntl} from 'react-intl';
+import {useSelector} from 'react-redux';
+
+import {CheckIcon, CloseIcon, MicrophoneOutlineIcon} from '@mattermost/compass-icons/components';
+import {WithTooltip} from '@mattermost/shared/components/tooltip';
+
+import Permissions from 'mattermost-redux/constants/permissions';
+import {getChannel} from 'mattermost-redux/selectors/entities/channels';
+import {getConfig} from 'mattermost-redux/selectors/entities/general';
+import {haveIChannelPermission} from 'mattermost-redux/selectors/entities/roles';
+
+import {canUploadFiles} from 'utils/file_utils';
+
+import type {GlobalState} from 'types/store';
+
+import {MAX_RECORDING_MS, analyzeRecording, formatDuration, pickRecorderFormat, voiceMessageFile} from './voice_message';
+import type {VoiceRecording} from './voice_message';
+
+import './voice_message_button.scss';
+
+const messages = defineMessages({
+    record: {id: 'voice_message.record', defaultMessage: 'Record voice message', description: 'Tooltip and accessible label of the microphone button in the message composer that starts recording a voice message.'},
+    recorder: {id: 'voice_message.recorder', defaultMessage: 'Recording voice message', description: 'Accessible label of the composer control group shown while a voice message is being recorded.'},
+    cancel: {id: 'voice_message.cancel', defaultMessage: 'Cancel recording', description: 'Tooltip and accessible label of the button that discards the voice message being recorded.'},
+    stop: {id: 'voice_message.stop', defaultMessage: 'Stop and attach recording', description: 'Tooltip and accessible label of the button that stops recording and attaches the voice message to the draft.'},
+    permissionDenied: {id: 'voice_message.permission_denied', defaultMessage: 'Microphone access is blocked. Allow microphone access for this site in your browser settings to record voice messages.', description: 'Error shown under the message composer when the browser denies microphone access for recording a voice message.'},
+    noMicrophone: {id: 'voice_message.no_microphone', defaultMessage: 'No microphone was found. Connect a microphone to record voice messages.', description: 'Error shown under the message composer when no microphone is available for recording a voice message.'},
+    elapsed: {id: 'voice_message.elapsed', defaultMessage: '{elapsed} / {limit}', description: 'Elapsed recording time next to the five minute limit, shown while recording a voice message; both are times like 0:12 and 5:00.'},
+    startFailed: {id: 'voice_message.start_failed', defaultMessage: 'Recording could not be started.', description: 'Error shown under the message composer when voice recording fails to start for any other reason.'},
+});
+
+type RecorderState = 'idle' | 'starting' | 'recording' | 'processing';
+
+type Session = {
+    recorder: MediaRecorder;
+    stream: MediaStream;
+    timer: number;
+    keep: boolean;
+};
+
+type Props = {
+    channelId: string;
+    rootId: string;
+    disabledByPolicy: boolean;
+    onRecorded: (recording: VoiceRecording) => void;
+    onError: (message: string | null) => void;
+};
+
+function startErrorMessage(err: unknown) {
+    const name = (err as DOMException | undefined)?.name;
+    if (name === 'NotAllowedError' || name === 'SecurityError') {
+        return messages.permissionDenied;
+    }
+    if (name === 'NotFoundError' || name === 'OverconstrainedError') {
+        return messages.noMicrophone;
+    }
+    return messages.startFailed;
+}
+
+export default function VoiceMessageButton({channelId, rootId, disabledByPolicy, onRecorded, onError}: Props) {
+    const {formatMessage} = useIntl();
+    const canUpload = useSelector((state: GlobalState) => {
+        const channel = getChannel(state, channelId);
+        if (!channel || !canUploadFiles(getConfig(state))) {
+            return false;
+        }
+        return haveIChannelPermission(state, channel.team_id, channelId, Permissions.UPLOAD_FILE);
+    });
+    const format = useMemo(() => pickRecorderFormat(), []);
+    const hidden = !format || !canUpload || disabledByPolicy;
+
+    const [recorderState, setRecorderState] = useState<RecorderState>('idle');
+    const [elapsed, setElapsed] = useState(0);
+    const session = useRef<Session | undefined>(undefined);
+    const generation = useRef(0);
+    const onRecordedRef = useRef(onRecorded);
+    onRecordedRef.current = onRecorded;
+    const micButtonRef = useRef<HTMLButtonElement>(null);
+    const refocusMicButton = useRef(false);
+    const stopButtonRef = useRef<HTMLButtonElement>(null);
+
+    const finish = useCallback((keep: boolean) => {
+        const current = session.current;
+        if (!current) {
+            return;
+        }
+        current.keep = keep;
+        window.clearInterval(current.timer);
+        current.recorder.stop();
+    }, []);
+
+    useEffect(() => () => {
+        generation.current++;
+        finish(false);
+    }, [channelId, rootId, finish]);
+
+    useEffect(() => {
+        if (hidden) {
+            finish(false);
+        }
+    }, [hidden, finish]);
+
+    useEffect(() => {
+        if (recorderState === 'recording') {
+            stopButtonRef.current?.focus();
+        } else if (recorderState === 'idle' && refocusMicButton.current) {
+            refocusMicButton.current = false;
+            micButtonRef.current?.focus();
+        }
+    }, [recorderState]);
+
+    const start = useCallback(async () => {
+        if (!format || session.current) {
+            return;
+        }
+        onError(null);
+        setRecorderState('starting');
+        const startGeneration = generation.current;
+
+        let stream: MediaStream;
+        let recorder: MediaRecorder;
+        try {
+            stream = await navigator.mediaDevices.getUserMedia({audio: true});
+        } catch (err) {
+            setRecorderState('idle');
+            onError(formatMessage(startErrorMessage(err)));
+            return;
+        }
+        if (startGeneration !== generation.current) {
+            stream.getTracks().forEach((track) => track.stop());
+            setRecorderState('idle');
+            return;
+        }
+        try {
+            recorder = new MediaRecorder(stream, {mimeType: format.mimeType, audioBitsPerSecond: 32000});
+        } catch {
+            stream.getTracks().forEach((track) => track.stop());
+            setRecorderState('idle');
+            onError(formatMessage(messages.startFailed));
+            return;
+        }
+
+        const chunks: Blob[] = [];
+        const startedAt = Date.now();
+        const current: Session = {recorder, stream, timer: 0, keep: false};
+
+        recorder.ondataavailable = (e) => chunks.push(e.data);
+        recorder.onstop = async () => {
+            const duration = Math.min(Date.now() - startedAt, MAX_RECORDING_MS);
+            stream.getTracks().forEach((track) => track.stop());
+            session.current = undefined;
+            if (!current.keep) {
+                setRecorderState('idle');
+                return;
+            }
+
+            setRecorderState('processing');
+            const blob = new Blob(chunks, {type: format.mimeType});
+            const voiceMessage = await analyzeRecording(blob, duration);
+            setRecorderState('idle');
+            if (startGeneration === generation.current) {
+                onRecordedRef.current({file: voiceMessageFile(blob, format), voiceMessage});
+            }
+        };
+
+        current.timer = window.setInterval(() => {
+            const now = Date.now() - startedAt;
+            setElapsed(now);
+            if (now >= MAX_RECORDING_MS) {
+                finish(true);
+            }
+        }, 250);
+        session.current = current;
+        setElapsed(0);
+        recorder.start();
+        setRecorderState('recording');
+    }, [format, finish, formatMessage, onError]);
+
+    if (hidden) {
+        return null;
+    }
+
+    if (recorderState === 'idle' || recorderState === 'starting') {
+        return (
+            <WithTooltip title={formatMessage(messages.record)}>
+                <button
+                    ref={micButtonRef}
+                    type='button'
+                    id='voiceMessageButton'
+                    aria-label={formatMessage(messages.record)}
+                    className='style--none AdvancedTextEditor__action-button'
+                    disabled={recorderState === 'starting'}
+                    onClick={start}
+                >
+                    <MicrophoneOutlineIcon
+                        size={18}
+                        color='currentColor'
+                    />
+                </button>
+            </WithTooltip>
+        );
+    }
+
+    const cancel = () => {
+        refocusMicButton.current = true;
+        finish(false);
+    };
+
+    const handleKeyDown = (e: React.KeyboardEvent) => {
+        if (e.key === 'Escape') {
+            e.preventDefault();
+            e.stopPropagation();
+            cancel();
+        }
+    };
+
+    return (
+        <div
+            className='VoiceMessageRecorder'
+            role='group'
+            aria-label={formatMessage(messages.recorder)}
+            onKeyDownCapture={handleKeyDown}
+        >
+            <span
+                className='VoiceMessageRecorder__indicator'
+                aria-hidden={true}
+            />
+            <span
+                className='VoiceMessageRecorder__time'
+                role='timer'
+            >
+                {formatMessage(messages.elapsed, {elapsed: formatDuration(elapsed), limit: formatDuration(MAX_RECORDING_MS)})}
+            </span>
+            <WithTooltip title={formatMessage(messages.cancel)}>
+                <button
+                    type='button'
+                    aria-label={formatMessage(messages.cancel)}
+                    className='style--none AdvancedTextEditor__action-button'
+                    onClick={cancel}
+                    disabled={recorderState === 'processing'}
+                >
+                    <CloseIcon
+                        size={18}
+                        color='currentColor'
+                    />
+                </button>
+            </WithTooltip>
+            <WithTooltip title={formatMessage(messages.stop)}>
+                <button
+                    ref={stopButtonRef}
+                    type='button'
+                    aria-label={formatMessage(messages.stop)}
+                    className='style--none AdvancedTextEditor__action-button VoiceMessageRecorder__stop'
+                    onClick={() => finish(true)}
+                    disabled={recorderState === 'processing'}
+                >
+                    <CheckIcon
+                        size={18}
+                        color='currentColor'
+                    />
+                </button>
+            </WithTooltip>
+        </div>
+    );
+}
