@@ -0,0 +1,37 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type React from 'react';
+import {useCallback, useRef} from 'react';
+
+import type {FileInfo} from '@mattermost/types/files';
+
+import type {FileUpload} from 'components/file_upload/file_upload';
+
+import type {PostDraft} from 'types/store/draft';
+
+import {addVoiceMessages} from './voice_message';
+import type {VoiceMessage, VoiceRecording} from './voice_message';
+
+export default function useVoiceMessageUploads(fileUploadRef: React.RefObject<FileUpload | null>) {
+    const pending = useRef(new Map<string, VoiceMessage>());
+
+    const uploadVoiceMessage = useCallback(({file, voiceMessage}: VoiceRecording) => {
+        pending.current.set(file.name, voiceMessage);
+        fileUploadRef.current?.checkPluginHooksAndUploadFiles([file]);
+    }, [fileUploadRef]);
+
+    const withVoiceMessages = useCallback((draft: PostDraft, uploaded: FileInfo[]) => {
+        const added: Record<string, VoiceMessage> = {};
+        for (const fileInfo of uploaded) {
+            const voiceMessage = pending.current.get(fileInfo.name);
+            if (voiceMessage) {
+                added[fileInfo.id] = voiceMessage;
+                pending.current.delete(fileInfo.name);
+            }
+        }
+        return addVoiceMessages(draft, added);
+    }, []);
+
+    return {uploadVoiceMessage, withVoiceMessages};
+}
