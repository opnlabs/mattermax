diff --git a/server/channels/api4/terms_of_service_test.go b/server/channels/api4/terms_of_service_test.go
index cd130bae0782..0d5cc7549dc4 100644
--- a/server/channels/api4/terms_of_service_test.go
+++ b/server/channels/api4/terms_of_service_test.go
@@ -44,16 +44,42 @@ func TestCreateTermsOfServiceAdminUser(t *testing.T) {
 	th := Setup(t).InitBasic(t)
 	client := th.SystemAdminClient
 
-	termsOfService, _, err := client.CreateTermsOfService(context.Background(), "terms of service new", th.SystemAdminUser.Id)
-	CheckErrorID(t, err, "api.create_terms_of_service.custom_terms_of_service_disabled.app_error")
-	assert.Nil(t, termsOfService)
-
-	th.App.Srv().SetLicense(model.NewTestLicense("EnableCustomTermsOfService"))
-
-	termsOfService, _, err = client.CreateTermsOfService(context.Background(), "terms of service new_2", th.SystemAdminUser.Id)
+	termsOfService, _, err := client.CreateTermsOfService(context.Background(), "terms of service new_2", th.SystemAdminUser.Id)
 	require.NoError(t, err)
 	assert.NotEmpty(t, termsOfService.Id)
 	assert.NotEmpty(t, termsOfService.CreateAt)
 	assert.Equal(t, "terms of service new_2", termsOfService.Text)
 	assert.Equal(t, th.SystemAdminUser.Id, termsOfService.UserId)
 }
+
+func TestCustomTermsOfServiceWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	require.Nil(t, th.App.Srv().License())
+
+	termsOfService, _, err := th.SystemAdminClient.CreateTermsOfService(context.Background(), "accept these terms", th.SystemAdminUser.Id)
+	require.NoError(t, err)
+
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.SupportSettings.CustomTermsOfServiceEnabled = true
+		*cfg.SupportSettings.CustomTermsOfServiceReAcceptancePeriod = 30
+	})
+
+	clientConfig, _, err := th.Client.GetClientConfig(context.Background(), "")
+	require.NoError(t, err)
+	assert.Equal(t, "true", clientConfig["EnableCustomTermsOfService"])
+	assert.Equal(t, "30", clientConfig["CustomTermsOfServiceReAcceptancePeriod"])
+	assert.Equal(t, termsOfService.Id, clientConfig["CustomTermsOfServiceId"])
+
+	me, _, err := th.Client.GetMe(context.Background(), "")
+	require.NoError(t, err)
+	assert.Empty(t, me.TermsOfServiceId)
+
+	_, err = th.Client.RegisterTermsOfServiceAction(context.Background(), th.BasicUser.Id, termsOfService.Id, true)
+	require.NoError(t, err)
+
+	me, _, err = th.Client.GetMe(context.Background(), "")
+	require.NoError(t, err)
+	assert.Equal(t, termsOfService.Id, me.TermsOfServiceId)
+	assert.NotZero(t, me.TermsOfServiceCreateAt)
+}
