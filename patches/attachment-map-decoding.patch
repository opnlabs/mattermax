+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package model
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+func legacyAttachmentMaps(o *Post) []*MessageAttachment {
+	if attachments, ok := o.GetProp(PostPropsAttachments).([]*MessageAttachment); ok {
+		return attachments
+	}
+	var ret []*MessageAttachment
+	if attachments, ok := o.GetProp(PostPropsAttachments).([]any); ok {
+		for _, attachment := range attachments {
+			if enc, err := json.Marshal(attachment); err == nil {
+				var decoded MessageAttachment
+				if json.Unmarshal(enc, &decoded) == nil {
+					// Ignoring nil actions
+					i := 0
+					for _, action := range decoded.Actions {
+						if action != nil {
+							decoded.Actions[i] = action
+							i++
+						}
+					}
+					decoded.Actions = decoded.Actions[:i]
+
+					// Ignoring nil fields
+					i = 0
+					for _, field := range decoded.Fields {
+						if field != nil {
+							decoded.Fields[i] = field
+							i++
+						}
+					}
+					decoded.Fields = decoded.Fields[:i]
+					ret = append(ret, &decoded)
+				}
+			}
+		}
+	}
+	return ret
+}
+
+func attachmentMapPost(value any) *Post {
+	return &Post{Props: StringInterface{PostPropsAttachments: value}}
+}
+
+func TestAttachmentMapDecode(t *testing.T) {
+	cases := []any{
+		nil, []any{}, []any{nil}, []any{map[string]any(nil)}, []any{map[string]any{}},
+		[]any{map[string]any{"fields": nil, "actions": nil}},
+		[]any{map[string]any{"fields": []any{}, "actions": []any{}}},
+		[]any{map[string]any{"fields": []any{nil, nil}, "actions": []any{nil, nil}}},
+		[]any{map[string]any{"fields": []any{map[string]any{"title": nil, "value": nil, "short": true}}}},
+		[]any{map[string]any{"fields": []any{map[string]any{"short": nil}}}},
+		[]any{map[string]any{"fields": []any{map[string]any{"short": "TRUE"}}}},
+		[]any{map[string]any{"text": "bad\xff bytes"}},
+		[]any{map[string]any{"text": "escaped \" \n \x00 <>& \u2028"}},
+		[]any{"bad", float64(5), map[string]any{"text": "ok"}, nil},
+		[]any{map[string]any{"unknown": func() {}, "text": "skipped"}},
+		[]any{map[string]any{"actions": []any{nil, map[string]any{"id": "view", "name": "View", "type": "button"}}}},
+	}
+	// Include actual invalid UTF-8 and control/Unicode bytes, not escaped spellings.
+	cases = append(cases, []any{map[string]any{"text": string([]byte{0xff, 0xc3, 0x28})}}, []any{map[string]any{"title": "\x00\n\u2028"}})
+	for _, id := range []any{float64(1 << 53), float64(-(1 << 53)), float64(1 << 63), -float64(1 << 63), math.MaxFloat64, math.SmallestNonzeroFloat64, math.Copysign(0, -1), 1.25, json.Number("9223372036854775807"), int64(math.MaxInt64), nil} {
+		cases = append(cases, []any{map[string]any{"id": id}})
+	}
+	for i, value := range cases {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			p := attachmentMapPost(value)
+			got, want := p.Attachments(), legacyAttachmentMaps(p)
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("got %#v, want %#v", got, want)
+			}
+			g, e := json.Marshal(got)
+			w, f := json.Marshal(want)
+			if (e == nil) != (f == nil) || string(g) != string(w) {
+				t.Fatalf("JSON mismatch: %s != %s", g, w)
+			}
+		})
+	}
+	typed := []*MessageAttachment{{Text: "typed"}, nil}
+	p := attachmentMapPost(typed)
+	got := p.Attachments()
+	if len(got) != 2 || got[0] != typed[0] || got[1] != nil {
+		t.Fatal("typed path must retain original pointers/nil entries")
+	}
+}
+
+func TestAttachmentMapDecodeGenerated(t *testing.T) {
+	rng := rand.New(rand.NewSource(42))
+	fast := 0
+	for n := 0; n < 200000; n++ {
+		fields := make([]any, rng.Intn(8))
+		for i := range fields {
+			fields[i] = map[string]any{"title": fmt.Sprintf("Field %d", i), "value": "value", "short": rng.Intn(2) == 0}
+		}
+		m := map[string]any{"id": float64(rng.Intn(1000)), "title": "Title \u2028", "text": "body", "fields": fields, "ts": float64(rng.Intn(100000))}
+		var item any = m
+		if n%4 == 0 {
+			switch rng.Intn(17) {
+			case 0:
+				m["unknown"] = true
+			case 1:
+				m["title"] = string([]byte{0xff})
+			case 2:
+				m["id"] = 1.25
+			case 3:
+				m["id"] = float64(1 << 63)
+			case 4:
+				m["ts"] = []any{"nested", true}
+			case 5:
+				m["fields"] = []any{nil, nil}
+			case 6:
+				m["actions"] = []any{nil, map[string]any{"id": "button", "type": "button", "name": "Button"}}
+			case 7:
+				m["fields"] = []any{map[string]any{"short": nil}}
+			case 8:
+				m["fields"] = []any{map[string]any{"short": "true"}}
+			case 9:
+				m["fields"] = []any{map[string]any{"value": map[string]any{"nested": true}}}
+			case 10:
+				m["fields"] = []any{map[string]any{"title": 5}}
+			case 11:
+				m["id"] = int64(math.MaxInt64)
+			case 12:
+				m["fields"] = []any{map[string]any{"value": math.NaN()}}
+			case 13:
+				item = nil
+			case 14:
+				m["fields"] = []any(nil)
+			case 15:
+				m["fields"] = []any{map[string]any(nil)}
+			case 16:
+				m["Title"] = "uppercase key"
+			}
+		}
+		if _, ok := decodeAttachmentMap(item); ok {
+			fast++
+		}
+		p := attachmentMapPost([]any{item, map[string]any{"text": "last"}})
+		got, want := p.Attachments(), legacyAttachmentMaps(p)
+		if !reflect.DeepEqual(got, want) {
+			g, _ := json.Marshal(got)
+			w, _ := json.Marshal(want)
+			t.Fatalf("iteration %d input %#v: %s != %s", n, item, g, w)
+		}
+	}
+	if fast < 100000 {
+		t.Fatalf("fast path insufficiently exercised: %d", fast)
+	}
+}
+
+func TestAttachmentMapDecodeOwnership(t *testing.T) {
+	field := map[string]any{"title": "original", "value": "value", "short": true}
+	p := attachmentMapPost([]any{map[string]any{"fields": []any{field}}})
+	first, second := p.Attachments(), p.Attachments()
+	first[0].Fields[0].Title = "changed"
+	first[0].Fields[0].Value = "changed"
+	if second[0].Fields[0].Title != "original" || field["title"] != "original" || field["value"] != "value" {
+		t.Fatal("decoded fields share mutable state")
+	}
+	nested := map[string]any{"value": "original"}
+	p = attachmentMapPost([]any{map[string]any{"fields": []any{map[string]any{"value": nested}}}})
+	got := p.Attachments()
+	got[0].Fields[0].Value.(map[string]any)["value"] = "changed"
+	if nested["value"] != "original" || p.Attachments()[0].Fields[0].Value.(map[string]any)["value"] != "original" {
+		t.Fatal("fallback must retain deep ownership")
+	}
+}
+
+type attachmentMapMarshalProbe struct{ Calls *int }
+
+func (p attachmentMapMarshalProbe) MarshalJSON() ([]byte, error) {
+	*p.Calls++
+	return []byte(`"from probe"`), nil
+}
+func TestAttachmentMapDecodeCustomMarshal(t *testing.T) {
+	calls := 0
+	p := attachmentMapPost([]any{map[string]any{"text": attachmentMapMarshalProbe{&calls}}})
+	want := legacyAttachmentMaps(p)
+	count := calls
+	calls = 0
+	got := p.Attachments()
+	if len(got) != 1 || got[0].Text != "from probe" || !reflect.DeepEqual(got, want) || calls != count || calls != 1 {
+		t.Fatalf("fallback changed custom marshaling: calls=%d, want=%d", calls, count)
+	}
+}
+
+func FuzzAttachmentMapDecode(f *testing.F) {
+	for _, input := range []string{`[]`, `[null]`, `[{"fields":[]}]`, `[{"fields":[null],"actions":[null]}]`, `[{"id":9223372036854775807}]`, `[{"text":"hello","fields":[{"short":"true"}]}]`} {
+		f.Add(input)
+	}
+	f.Fuzz(func(t *testing.T, input string) {
+		var value any
+		if json.Unmarshal([]byte(input), &value) != nil {
+			return
+		}
+		p := attachmentMapPost(value)
+		if !reflect.DeepEqual(p.Attachments(), legacyAttachmentMaps(p)) {
+			t.Fatalf("mismatch for %s", input)
+		}
+	})
+}
+
+func TestAttachmentMapDecodeAllFields(t *testing.T) {
+	value := map[string]any{"id": float64(42), "ts": float64(1700000000), "fields": []any{map[string]any{"title": "field title", "value": "field value", "short": true}}, "actions": []any{nil}}
+	typ := reflect.TypeOf(MessageAttachment{})
+	for i := 0; i < typ.NumField(); i++ {
+		field := typ.Field(i)
+		if field.Type.Kind() == reflect.String {
+			value[field.Tag.Get("json")] = field.Name + " \u2028"
+		}
+	}
+	if _, ok := decodeAttachmentMap(value); !ok {
+		t.Fatal("all ordinary string fields should use direct decoding")
+	}
+	p := attachmentMapPost([]any{value})
+	if !reflect.DeepEqual(p.Attachments(), legacyAttachmentMaps(p)) {
+		t.Fatal("field copy differs from JSON decoder")
+	}
+	for _, number := range []float64{math.MaxFloat64, math.SmallestNonzeroFloat64, math.Copysign(0, -1), 1.25, -1.25} {
+		p = attachmentMapPost([]any{map[string]any{"ts": number, "fields": []any{map[string]any{"value": number}}}})
+		got, want := p.Attachments(), legacyAttachmentMaps(p)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatal("numeric value mismatch")
+		}
+		g, _ := json.Marshal(got)
+		w, _ := json.Marshal(want)
+		if string(g) != string(w) {
+			t.Fatalf("numeric JSON mismatch: %s != %s", g, w)
+		}
+	}
+}
+
+var attachmentMapBenchmarkResult []*MessageAttachment
+
+func BenchmarkAttachmentMapDecode(b *testing.B) {
+	for _, kind := range []string{"plain", "typed", "fields=0", "fields=8", "fields=64", "actions", "unknown", "structured", "malformed"} {
+		b.Run(kind, func(b *testing.B) {
+			n := 8
+			if kind == "fields=0" {
+				n = 0
+			}
+			if kind == "fields=64" {
+				n = 64
+			}
+			fields := make([]any, n)
+			for i := range fields {
+				fields[i] = map[string]any{"title": fmt.Sprintf("Metric %d", i), "value": "observed value", "short": true}
+			}
+			value := map[string]any{"id": float64(0), "fallback": "monitoring report", "color": "good", "author_name": "Monitor", "title": "Report", "text": "observations", "footer": "local fixture", "fields": fields}
+			var raw any = []any{value}
+			switch kind {
+			case "plain":
+				raw = nil
+			case "typed":
+				raw = []*MessageAttachment{{Text: "typed"}}
+			case "actions":
+				value["actions"] = []any{map[string]any{"id": "view", "type": "button", "name": "View"}}
+			case "unknown":
+				value["unknown"] = true
+			case "structured":
+				fields[n-1].(map[string]any)["value"] = map[string]any{"nested": "value"}
+			case "malformed":
+				fields[n-1].(map[string]any)["short"] = nil
+			}
+			post := attachmentMapPost(raw)
+			if !reflect.DeepEqual(post.Attachments(), legacyAttachmentMaps(post)) {
+				b.Fatal("fixture differs from legacy decoder")
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				attachmentMapBenchmarkResult = post.Attachments()
+			}
+		})
+	}
+}
