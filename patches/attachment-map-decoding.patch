+// BenchmarkAttachmentMapHistory prepares real stored, ordered pages. Props are
+// read back through SQL so attachments have the same []any shape as wire data.
+func BenchmarkAttachmentMapHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(c *model.Config) { *c.ServiceSettings.EnableLinkPreviews = false })
+	if !th.App.IsPostPriorityEnabled() || !*th.App.Config().ServiceSettings.EnableCustomEmoji {
+		b.Fatal("expected normal priority/custom emoji reads")
+	}
+	for _, kind := range []string{"plain", "fields=0", "fields=8", "fields=64", "actions"} {
+		b.Run(kind, func(b *testing.B) {
+			channel := th.CreateChannel(b, th.BasicTeam)
+			fields := 0
+			switch kind {
+			case "fields=8", "actions":
+				fields = 8
+			case "fields=64":
+				fields = 64
+			}
+			fieldValues := make([]any, fields)
+			fieldTitles := make([]string, fields)
+			for i := range fields {
+				fieldTitles[i] = fmt.Sprintf("Metric %d", i)
+				fieldValues[i] = map[string]any{"title": fieldTitles[i], "value": "observed value", "short": true}
+			}
+			attachment := map[string]any{"fallback": "monitoring report", "color": "good", "author_name": "Monitor", "title": "Report", "text": "observations", "footer": "local fixture", "fields": fieldValues}
+			if kind == "actions" {
+				attachment["actions"] = []any{map[string]any{"id": "view", "type": "button", "name": "View", "integration": map[string]any{"url": "https://action.example.test/callback"}}}
+			}
+			expected := map[string]bool{}
+			for range 60 {
+				post := &model.Post{ChannelId: channel.Id, UserId: th.BasicUser.Id, Message: "attachment history"}
+				if kind != "plain" {
+					post.Props = model.StringInterface{model.PostPropsAttachments: []any{attachment}}
+				}
+				saved, err := th.App.Srv().Store().Post().Save(th.Context, post)
+				if err != nil {
+					b.Fatal(err)
+				}
+				expected[saved.Id] = true
+			}
+			list, err := th.App.Srv().Store().Post().GetPosts(th.Context, model.GetPostsOptions{ChannelId: channel.Id, PerPage: 60}, false, map[string]bool{})
+			if err != nil {
+				b.Fatal(err)
+			}
+			if len(list.Posts) != 60 || len(list.Order) != 60 {
+				b.Fatal("incorrect stored page")
+			}
+			for id, post := range list.Posts {
+				if !expected[id] {
+					b.Fatal("unexpected stored post")
+				}
+				if kind != "plain" {
+					if a, ok := post.GetProp(model.PostPropsAttachments).([]any); !ok || len(a) != 1 {
+						b.Fatal("expected wire-format attachment")
+					}
+				}
+			}
+			check := func(got *model.PostList) {
+				if len(got.Posts) != 60 || !reflect.DeepEqual(got.Order, list.Order) {
+					b.Fatal("incorrect ordered page")
+				}
+				for _, id := range list.Order {
+					post := got.Posts[id]
+					if post == nil || post.Message != "attachment history" || post.Metadata == nil {
+						b.Fatal("incorrect prepared post")
+					}
+					if len(post.Metadata.Emojis) != 0 || len(post.Metadata.Images) != 0 {
+						b.Fatal("unexpected emoji/image metadata")
+					}
+					if kind != "plain" {
+						raw, ok := post.GetProp(model.PostPropsAttachments).([]any)
+						if !ok || len(raw) != 1 {
+							b.Fatal("incorrect attachment props")
+						}
+						attachment, ok := raw[0].(map[string]any)
+						if !ok || attachment["text"] != "observations" {
+							b.Fatal("incorrect attachment text")
+						}
+						values, ok := attachment["fields"].([]any)
+						if !ok || len(values) != fields {
+							b.Fatal("incorrect attachment fields")
+						}
+						if len(post.Metadata.Embeds) != 1 || post.Metadata.Embeds[0].Type != model.PostEmbedMessageAttachment {
+							b.Fatal("incorrect attachment embed")
+						}
+						if kind == "actions" {
+							actions, ok := attachment["actions"].([]any)
+							if !ok || len(actions) != 1 {
+								b.Fatal("incorrect action count")
+							}
+							action, ok := actions[0].(map[string]any)
+							if !ok || action["id"] != "view" {
+								b.Fatal("incorrect action")
+							}
+						}
+						for i, value := range values {
+							field, ok := value.(map[string]any)
+							if !ok || field["title"] != fieldTitles[i] || field["value"] != "observed value" || field["short"] != true {
+								b.Fatal("incorrect field")
+							}
+						}
+					}
+				}
+			}
+			check(th.App.PreparePostListForClient(th.Context, list))
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				check(th.App.PreparePostListForClient(th.Context, list))
+			}
+		})
+	}
+}
