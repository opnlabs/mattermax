@@ -0,0 +1,30 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package timerlayer
+
+import (
+	"errors"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"time"
+)
+
+var _ store.PostPriorityMetadataReader = (*TimerLayerPostPriorityStore)(nil)
+
+func (s *TimerLayerPostPriorityStore) GetForPostsWithAcknowledgements(ids []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	reader, ok := s.PostPriorityStore.(store.PostPriorityMetadataReader)
+	if !ok {
+		return nil, nil, store.ErrPostPriorityMetadataUnavailable
+	}
+	start := time.Now()
+	p, a, err := reader.GetForPostsWithAcknowledgements(ids)
+	if s.Root.Metrics != nil && !errors.Is(err, store.ErrPostPriorityMetadataUnavailable) {
+		success := "false"
+		if err == nil {
+			success = "true"
+		}
+		s.Root.Metrics.ObserveStoreMethodDuration("PostPriorityStore.GetForPostsWithAcknowledgements", success, float64(time.Since(start))/float64(time.Second))
+	}
+	return p, a, err
+}
