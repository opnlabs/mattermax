+
+import (
+	"errors"
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+// PostPriorityMetadataReader is an optional combined read capability. Stores
+// without it keep the independent priority and acknowledgement reads.
+type PostPriorityMetadataReader interface {
+	GetForPostsWithAcknowledgements(postIDs []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error)
+}
+
+var ErrPostPriorityMetadataUnavailable = errors.New("combined post priority metadata read is unavailable")
