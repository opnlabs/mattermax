+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+)
+
+// readPostListPriorityMetadata keeps independent best-effort reads when a store
+// lacks the combined capability or the combined query fails.
+func readPostListPriorityMetadata(s store.Store, ids []string) (map[string]*model.PostPriority, map[string][]*model.PostAcknowledgement) {
+	priorityStore := s.PostPriority()
+	if reader, ok := priorityStore.(store.PostPriorityMetadataReader); ok {
+		if p, a, err := reader.GetForPostsWithAcknowledgements(ids); err == nil {
+			return postListPriorityMaps(p, a, nil, nil)
+		}
+	}
+	p, pErr := priorityStore.GetForPosts(ids)
+	a, aErr := s.PostAcknowledgement().GetForPosts(ids)
+	return postListPriorityMaps(p, a, pErr, aErr)
+}
+
+func postListPriorityMaps(priority []*model.PostPriority, acknowledgements []*model.PostAcknowledgement, priorityErr, acknowledgementErr error) (map[string]*model.PostPriority, map[string][]*model.PostAcknowledgement) {
+	var p map[string]*model.PostPriority
+	var a map[string][]*model.PostAcknowledgement
+	if priorityErr == nil {
+		p = make(map[string]*model.PostPriority)
+		for _, row := range priority {
+			p[row.PostId] = row
+		}
+	}
+	if acknowledgementErr == nil {
+		a = make(map[string][]*model.PostAcknowledgement)
+		for _, row := range acknowledgements {
+			a[row.PostId] = append(a[row.PostId], row)
+		}
+	}
+	return p, a
+}
