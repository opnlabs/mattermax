+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package retrylayer
+
+import (
+	"errors"
+	"github.com/lib/pq"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"testing"
+)
+
+type metadataRetryProbe struct {
+	store.PostPriorityStore
+	calls    int
+	failures []error
+}
+
+func (p *metadataRetryProbe) GetForPostsWithAcknowledgements([]string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	p.calls++
+	var err error
+	if p.calls <= len(p.failures) {
+		err = p.failures[p.calls-1]
+	}
+	return []*model.PostPriority{{PostId: "post"}}, []*model.PostAcknowledgement{{PostId: "post"}}, err
+}
+
+func TestHistoryPriorityMetadataRetry(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		failures []error
+		calls    int
+		wantErr  bool
+	}{
+		{name: "success", calls: 1},
+		{name: "ordinary", failures: []error{errors.New("ordinary")}, calls: 1, wantErr: true},
+		{name: "serialization_then_success", failures: []error{&pq.Error{Code: "40001"}}, calls: 2},
+		{name: "deadlock_then_success", failures: []error{&pq.Error{Code: "40P01"}}, calls: 2},
+		{name: "exhausted", failures: []error{&pq.Error{Code: "40001"}, &pq.Error{Code: "40001"}, &pq.Error{Code: "40001"}}, calls: 3, wantErr: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := &metadataRetryProbe{failures: tc.failures}
+			w := &RetryLayerPostPriorityStore{PostPriorityStore: p}
+			gotP, gotA, err := w.GetForPostsWithAcknowledgements([]string{"post"})
+			if p.calls != tc.calls || (err != nil) != tc.wantErr || len(gotP) != 1 || len(gotA) != 1 {
+				t.Fatalf("calls=%d error=%v rows%d/%d", p.calls, err, len(gotP), len(gotA))
+			}
+		})
+	}
+	t.Run("unsupported", func(t *testing.T) {
+		w := &RetryLayerPostPriorityStore{PostPriorityStore: &struct{ store.PostPriorityStore }{}}
+		p, a, err := w.GetForPostsWithAcknowledgements(nil)
+		if !errors.Is(err, store.ErrPostPriorityMetadataUnavailable) || p != nil || a != nil {
+			t.Fatal("unsupported capability changed")
+		}
+	})
+}
diff --git a/server/channels/store/sqlstore/post_priority_metadata.go b/server/channels/store/sqlstore/post_priority_metadata.go
new file mode 100644
index 000000000000..2afd05326e6a
--- /dev/null
+++ b/server/channels/store/sqlstore/post_priority_metadata.go
@@ -0,0 +1,66 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"github.com/lib/pq"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/pkg/errors"
+)
+
+var _ store.PostPriorityMetadataReader = (*SqlPostPriorityStore)(nil)
+
+// GetForPostsWithAcknowledgements reads both metadata tables in one round trip
+// per bounded chunk. UNION ALL avoids multiplying priority rows by the number
+// of acknowledgements. Nullable priority flags and remote IDs retain nilness.
+func (s *SqlPostPriorityStore) GetForPostsWithAcknowledgements(postIDs []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	var priority []*model.PostPriority
+	var acknowledgements []*model.PostAcknowledgement
+	for start := 0; start < len(postIDs); start += 200 {
+		p, a, err := s.readPriorityMetadataChunk(postIDs[start:min(start+200, len(postIDs))])
+		if err != nil {
+			return nil, nil, err
+		}
+		priority = append(priority, p...)
+		acknowledgements = append(acknowledgements, a...)
+	}
+	return priority, acknowledgements, nil
+}
+
+func (s *SqlPostPriorityStore) readPriorityMetadataChunk(postIDs []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	rows, err := s.GetReplica().Query(`
+ SELECT true, PostId, ChannelId, Priority, RequestedAck, PersistentNotifications,
+        ''::varchar, 0::bigint, NULL::varchar
+ FROM PostsPriority WHERE PostId = ANY($1)
+ UNION ALL
+ SELECT false, PostId, ChannelId, NULL::varchar, NULL::boolean, NULL::boolean,
+        UserId, AcknowledgedAt, RemoteId
+ FROM PostAcknowledgements WHERE PostId = ANY($1) AND AcknowledgedAt <> 0`, pq.Array(postIDs))
+	if err != nil {
+		return nil, nil, errors.Wrap(err, "query combined post priority metadata")
+	}
+	defer rows.Close()
+	var priority []*model.PostPriority
+	var acknowledgements []*model.PostAcknowledgement
+	var isPriority bool
+	var postID, channelID, userID string
+	var level, remoteID *string
+	var requested, persistent *bool
+	var acknowledgedAt int64
+	for rows.Next() {
+		if err := rows.Scan(&isPriority, &postID, &channelID, &level, &requested, &persistent, &userID, &acknowledgedAt, &remoteID); err != nil {
+			return nil, nil, errors.Wrap(err, "scan combined post priority metadata")
+		}
+		if isPriority {
+			priority = append(priority, &model.PostPriority{PostId: postID, ChannelId: channelID, Priority: level, RequestedAck: requested, PersistentNotifications: persistent})
+		} else {
+			acknowledgements = append(acknowledgements, &model.PostAcknowledgement{PostId: postID, ChannelId: channelID, UserId: userID, AcknowledgedAt: acknowledgedAt, RemoteId: remoteID})
+		}
+	}
+	if err := rows.Err(); err != nil {
+		return nil, nil, errors.Wrap(err, "iterate combined post priority metadata")
+	}
+	return priority, acknowledgements, nil
+}
diff --git a/server/channels/store/sqlstore/post_priority_metadata_test.go b/server/channels/store/sqlstore/post_priority_metadata_test.go
new file mode 100644
index 000000000000..1f61adefbf90
--- /dev/null
+++ b/server/channels/store/sqlstore/post_priority_metadata_test.go
@@ -0,0 +1,108 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestHistoryPriorityMetadataSQL(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, _ request.CTX, ss store.Store, _ storetest.SqlStore) {
+		sql := ss.(*SqlStore)
+		reader := ss.PostPriority().(store.PostPriorityMetadataReader)
+		var ids []string
+		for i := 0; i < 205; i++ {
+			id := model.NewId()
+			ids = append(ids, id)
+			if i%2 == 0 {
+				var requested, persistent any
+				if i%4 == 0 {
+					requested = true
+					persistent = false
+				}
+				_, err := sql.GetMaster().Exec(`INSERT INTO PostsPriority(PostId,ChannelId,Priority,RequestedAck,PersistentNotifications) VALUES($1,$2,$3,$4,$5)`, id, "channel", "urgent", requested, persistent)
+				require.NoError(t, err)
+			}
+			if i%3 == 0 {
+				for j := 0; j < 3; j++ {
+					var remote any
+					if j == 1 {
+						remote = ""
+					}
+					if j == 2 {
+						remote = "remote"
+					}
+					at := int64(j + 1)
+					if i == 0 && j == 2 {
+						at = -7
+					}
+					_, err := sql.GetMaster().Exec(`INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt,RemoteId) VALUES($1,$2,$3,$4,$5)`, id, model.NewId(), "channel", at, remote)
+					require.NoError(t, err)
+				}
+				_, err := sql.GetMaster().Exec(`INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt) VALUES($1,$2,$3,0),($1,$4,$3,NULL)`, id, model.NewId(), "channel", model.NewId())
+				require.NoError(t, err)
+			}
+		}
+		for _, n := range []int{0, 1, 60, 200, 201, 205} {
+			t.Run(fmt.Sprintf("requested=%d", n), func(t *testing.T) {
+				input := append([]string(nil), ids[:n]...)
+				if n > 0 {
+					input = append(input, ids[0], "missing", "")
+				}
+				wantP, err := ss.PostPriority().GetForPosts(input)
+				require.NoError(t, err)
+				wantA, err := ss.PostAcknowledgement().GetForPosts(input)
+				require.NoError(t, err)
+				gotP, gotA, err := reader.GetForPostsWithAcknowledgements(input)
+				require.NoError(t, err)
+				require.ElementsMatch(t, wantP, gotP)
+				require.ElementsMatch(t, wantA, gotA)
+				if n == 0 {
+					require.Nil(t, gotP)
+					require.Nil(t, gotA)
+				}
+				for i := 1; i < len(gotP); i++ {
+					require.NotSame(t, gotP[i-1], gotP[i])
+					if gotP[i-1].Priority != nil && gotP[i].Priority != nil {
+						require.NotSame(t, gotP[i-1].Priority, gotP[i].Priority)
+					}
+				}
+				for i := 1; i < len(gotA); i++ {
+					require.NotSame(t, gotA[i-1], gotA[i])
+					if gotA[i-1].RemoteId != nil && gotA[i].RemoteId != nil {
+						require.NotSame(t, gotA[i-1].RemoteId, gotA[i].RemoteId)
+					}
+				}
+			})
+		}
+		p1, a1, err := reader.GetForPostsWithAcknowledgements(ids)
+		require.NoError(t, err)
+		p2, a2, err := reader.GetForPostsWithAcknowledgements(ids)
+		require.NoError(t, err)
+		*p1[0].Priority = "changed"
+		a1[0].UserId = "changed"
+		require.False(t, reflect.DeepEqual(p1, p2))
+		require.False(t, reflect.DeepEqual(a1, a2))
+		// Acknowledgements with a NULL channel fail the old scanner. The composite
+		// read must return an error and no partial slices so app fallback can retain
+		// an independently successful priority read.
+		bad := model.NewId()
+		_, err = sql.GetMaster().Exec(`INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt) VALUES($1,$2,NULL,1)`, bad, model.NewId())
+		require.NoError(t, err)
+		_, err = ss.PostAcknowledgement().GetForPosts([]string{bad})
+		require.Error(t, err)
+		p, a, err := reader.GetForPostsWithAcknowledgements(append(ids, bad))
+		require.Error(t, err)
+		require.Nil(t, p)
+		require.Nil(t, a)
+	})
+}
