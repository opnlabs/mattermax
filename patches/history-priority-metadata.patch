+package app
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/stretchr/testify/require"
+)
+
+type historyPriorityFixture struct {
+	th               *TestHelper
+	list             *model.PostList
+	priority         map[string]*model.PostPriority
+	acknowledgements map[string][]*model.PostAcknowledgement
+}
+
+func newHistoryPriorityFixture(tb testing.TB, n int, kind string) *historyPriorityFixture {
+	th := Setup(tb).InitBasic(tb)
+	th.App.UpdateConfig(func(c *model.Config) {
+		*c.ServiceSettings.PostPriority = kind != "disabled"
+		*c.ServiceSettings.EnableCustomEmoji = true
+		*c.ServiceSettings.EnableLinkPreviews = false
+		*c.ImageProxySettings.Enable = false
+	})
+	posts := make([]*model.Post, n)
+	for i := range posts {
+		posts[i] = &model.Post{UserId: th.BasicUser.Id, ChannelId: th.BasicChannel.Id, Message: "priority history", CreateAt: model.GetMillis() + int64(i)}
+	}
+	saved, index, err := th.App.Srv().Store().Post().SaveMultiple(th.Context, posts)
+	require.NoError(tb, err)
+	require.Equal(tb, -1, index)
+	ids := make([]string, len(saved))
+	for i, p := range saved {
+		ids[i] = p.Id
+		withP := kind == "priority" || kind == "dense" || kind == "disabled" || kind == "mixed" && i%2 == 0
+		withA := kind == "acknowledgements" || kind == "dense" || kind == "disabled" || kind == "mixed" && i%3 == 0
+		if withP {
+			_, err := th.SQLStore.GetMaster().Exec(`INSERT INTO PostsPriority(PostId,ChannelId,Priority,RequestedAck,PersistentNotifications) VALUES($1,$2,$3,$4,$5)`, p.Id, p.ChannelId, []string{"important", "urgent"}[i%2], i%2 == 0, i%3 == 0)
+			require.NoError(tb, err)
+		}
+		if withA {
+			for j := 0; j < 3; j++ {
+				var remote any
+				if j == 1 {
+					remote = ""
+				}
+				if j == 2 {
+					remote = model.NewId()
+				}
+				_, err := th.SQLStore.GetMaster().Exec(`INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt,RemoteId) VALUES($1,$2,$3,$4,$5)`, p.Id, model.NewId(), p.ChannelId, int64(j+1), remote)
+				require.NoError(tb, err)
+			}
+		}
+	}
+	loaded, err := th.SQLStore.Post().GetPostsByIds(ids)
+	require.NoError(tb, err)
+	require.Len(tb, loaded, n)
+	list := &model.PostList{Posts: make(map[string]*model.Post), Order: make([]string, 0, n)}
+	for _, p := range loaded {
+		require.Nil(tb, p.Metadata)
+		list.Posts[p.Id] = p
+		list.Order = append(list.Order, p.Id)
+	}
+	expectedP, pErr := th.App.GetPriorityForPostList(list)
+	require.Nil(tb, pErr)
+	expectedA, aErr := th.App.GetAcknowledgementsForPostList(list)
+	require.Nil(tb, aErr)
+	if kind == "disabled" {
+		expectedP = nil
+		expectedA = nil
+	}
+	return &historyPriorityFixture{th: th, list: list, priority: expectedP, acknowledgements: expectedA}
+}
+
+func (f *historyPriorityFixture) check(tb testing.TB, got *model.PostList) {
+	if !reflect.DeepEqual(got.Order, f.list.Order) || len(got.Posts) != len(f.list.Posts) {
+		tb.Fatal("ordered page changed")
+	}
+	for _, id := range f.list.Order {
+		p := got.Posts[id]
+		if p == nil || p.Message != "priority history" || p.Metadata == nil {
+			tb.Fatal("post content/metadata missing")
+		}
+		if !reflect.DeepEqual(p.Metadata.Priority, f.priority[id]) {
+			tb.Fatalf("priority changed for %s: %#v want%#v", id, p.Metadata.Priority, f.priority[id])
+		}
+		// SQL does not promise acknowledgement row order. Compare all fields and
+		// preserve multiplicity, including nil versus empty remote IDs.
+		want, actual := f.acknowledgements[id], p.Metadata.Acknowledgements
+		if len(want) != len(actual) {
+			tb.Fatal("acknowledgement count changed")
+		}
+		for _, a := range want {
+			count := 0
+			for _, b := range actual {
+				if reflect.DeepEqual(a, b) {
+					count++
+				}
+			}
+			if count != 1 {
+				tb.Fatal("acknowledgement content/ownership changed")
+			}
+		}
+	}
+}
+
+type historyPriorityReadProbe struct {
+	store.PostPriorityStore
+	reader           store.PostPriorityMetadataReader
+	combined, legacy int
+}
+
+func (p *historyPriorityReadProbe) GetForPosts(ids []string) ([]*model.PostPriority, error) {
+	p.legacy++
+	return p.PostPriorityStore.GetForPosts(ids)
+}
+func (p *historyPriorityReadProbe) GetForPostsWithAcknowledgements(ids []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	p.combined++
+	return p.reader.GetForPostsWithAcknowledgements(ids)
+}
+
+type historyPriorityAckReadProbe struct {
+	store.PostAcknowledgementStore
+	calls int
+}
+
+func (p *historyPriorityAckReadProbe) GetForPosts(ids []string) ([]*model.PostAcknowledgement, error) {
+	p.calls++
+	return p.PostAcknowledgementStore.GetForPosts(ids)
+}
+
+type historyPriorityStoreProbe struct {
+	store.Store
+	p *historyPriorityReadProbe
+	a *historyPriorityAckReadProbe
+}
+
+func (s *historyPriorityStoreProbe) PostPriority() store.PostPriorityStore               { return s.p }
+func (s *historyPriorityStoreProbe) PostAcknowledgement() store.PostAcknowledgementStore { return s.a }
+
+func TestHistoryPriorityMetadataPreparation(t *testing.T) {
+	for _, kind := range []string{"empty", "priority", "acknowledgements", "mixed", "dense", "disabled"} {
+		t.Run(kind, func(t *testing.T) {
+			f := newHistoryPriorityFixture(t, 60, kind)
+			actual := f.th.App.Srv().Store()
+			p := actual.PostPriority()
+			reader, ok := p.(store.PostPriorityMetadataReader)
+			require.True(t, ok, "store decorators must expose the capability")
+			probe := &historyPriorityStoreProbe{Store: actual, p: &historyPriorityReadProbe{PostPriorityStore: p, reader: reader}, a: &historyPriorityAckReadProbe{PostAcknowledgementStore: actual.PostAcknowledgement()}}
+			f.th.App.Srv().SetStore(probe)
+			f.check(t, f.th.App.PreparePostListForClient(f.th.Context, f.list))
+			want := 1
+			if kind == "disabled" {
+				want = 0
+			}
+			require.Equal(t, want, probe.p.combined)
+			require.Zero(t, probe.p.legacy)
+			require.Zero(t, probe.a.calls)
+		})
+	}
+}
+
+func BenchmarkHistoryPriorityMetadata(b *testing.B) {
+	for _, n := range []int{1, 60, 201} {
+		for _, kind := range []string{"empty", "priority", "acknowledgements", "mixed", "dense", "disabled"} {
+			b.Run(fmt.Sprintf("posts=%d/%s", n, kind), func(b *testing.B) {
+				f := newHistoryPriorityFixture(b, n, kind)
+				f.check(b, f.th.App.PreparePostListForClient(f.th.Context, f.list))
+				b.ReportAllocs()
+				b.ResetTimer()
+				for range b.N {
+					f.check(b, f.th.App.PreparePostListForClient(f.th.Context, f.list))
+				}
+			})
+		}
+	}
+}
