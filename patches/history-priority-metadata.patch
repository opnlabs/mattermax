+	store.Store
+	p                           store.PostPriorityStore
+	a                           store.PostAcknowledgementStore
+	priorityGetters, ackGetters int
+}
+
+func (s *priorityMetadataStoreProbe) PostPriority() store.PostPriorityStore {
+	s.priorityGetters++
+	return s.p
+}
+func (s *priorityMetadataStoreProbe) PostAcknowledgement() store.PostAcknowledgementStore {
+	s.ackGetters++
+	return s.a
+}
+
+func TestHistoryPriorityMetadataFallback(t *testing.T) {
+	for _, combined := range []bool{false, true} {
+		for _, pFail := range []bool{false, true} {
+			for _, aFail := range []bool{false, true} {
+				name := "legacy"
+				if combined {
+					name = "combined_error"
+				}
+				if pFail {
+					name += "/priority_error"
+				}
+				if aFail {
+					name += "/ack_error"
+				}
+				t.Run(name, func(t *testing.T) {
+					row := &model.PostPriority{PostId: "post", Priority: new("urgent"), RequestedAck: new(true), PersistentNotifications: new(false)}
+					ack := &model.PostAcknowledgement{PostId: "post", UserId: "reader", AcknowledgedAt: 42, RemoteId: new("remote")}
+					legacy := &priorityMetadataLegacyProbe{rows: []*model.PostPriority{row}}
+					a := &priorityMetadataAckProbe{rows: []*model.PostAcknowledgement{ack}}
+					if pFail {
+						legacy.err = errors.New("priority error")
+					}
+					if aFail {
+						a.err = errors.New("ack error")
+					}
+					var p store.PostPriorityStore = legacy
+					var capability *priorityMetadataCombinedProbe
+					if combined {
+						capability = &priorityMetadataCombinedProbe{priorityMetadataLegacyProbe: legacy, combinedP: []*model.PostPriority{{PostId: "discarded-partial"}}, combinedErr: errors.New("combined error")}
+						p = capability
+					}
+					s := &priorityMetadataStoreProbe{p: p, a: a}
+					ids := []string{"post", "missing", "post"}
+					gotP, gotA := readPostListPriorityMetadata(s, ids)
+					if pFail {
+						if gotP != nil {
+							t.Fatal("priority error exposed partial rows")
+						}
+					} else if !reflect.DeepEqual(gotP, map[string]*model.PostPriority{"post": row}) {
+						t.Fatalf("priority got%#v", gotP)
+					}
+					if aFail {
+						if gotA != nil {
+							t.Fatal("ack error exposed partial rows")
+						}
+					} else if !reflect.DeepEqual(gotA, map[string][]*model.PostAcknowledgement{"post": {ack}}) {
+						t.Fatalf("ack got%#v", gotA)
+					}
+					if legacy.calls != 1 || a.calls != 1 || s.priorityGetters != 1 || s.ackGetters != 1 || !reflect.DeepEqual(legacy.ids, ids) || !reflect.DeepEqual(a.ids, ids) {
+						t.Fatal("fallback changed getter/read count or IDs")
+					}
+					if combined && capability.combinedCalls != 1 {
+						t.Fatal("missing capability attempt")
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestHistoryPriorityMetadataCombined(t *testing.T) {
+	for _, empty := range []bool{false, true} {
+		t.Run(map[bool]string{false: "populated", true: "empty"}[empty], func(t *testing.T) {
+			p := &model.PostPriority{PostId: "post", Priority: new("important"), RequestedAck: new(false), PersistentNotifications: new(true)}
+			a1 := &model.PostAcknowledgement{PostId: "post", UserId: "a", AcknowledgedAt: 1}
+			a2 := &model.PostAcknowledgement{PostId: "post", UserId: "b", AcknowledgedAt: 2, RemoteId: new("")}
+			base := &priorityMetadataLegacyProbe{}
+			reader := &priorityMetadataCombinedProbe{priorityMetadataLegacyProbe: base, combinedP: []*model.PostPriority{p}, combinedA: []*model.PostAcknowledgement{a1, a2}}
+			ids := []string{"post"}
+			if empty {
+				reader.combinedP = nil
+				reader.combinedA = nil
+				ids = nil
+			}
+			a := &priorityMetadataAckProbe{}
+			s := &priorityMetadataStoreProbe{p: reader, a: a}
+			gotP, gotA := readPostListPriorityMetadata(s, ids)
+			if gotP == nil || gotA == nil {
+				t.Fatal("successful empty results must retain nonnil maps")
+			}
+			if empty {
+				if len(gotP) != 0 || len(gotA) != 0 {
+					t.Fatal("unexpected empty result")
+				}
+			} else if !reflect.DeepEqual(gotP, map[string]*model.PostPriority{"post": p}) || !reflect.DeepEqual(gotA, map[string][]*model.PostAcknowledgement{"post": {a1, a2}}) {
+				t.Fatal("combined result/order changed")
+			}
+			if reader.combinedCalls != 1 || base.calls != 0 || a.calls != 0 || s.priorityGetters != 1 || s.ackGetters != 0 || !reflect.DeepEqual(reader.ids, ids) {
+				t.Fatal("successful capability performed fallback reads")
+			}
+		})
+	}
+}
