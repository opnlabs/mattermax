+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package retrylayer
+
+import (
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/pkg/errors"
+	"time"
+)
+
+var _ store.PostPriorityMetadataReader = (*RetryLayerPostPriorityStore)(nil)
+
+func (s *RetryLayerPostPriorityStore) GetForPostsWithAcknowledgements(ids []string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	reader, ok := s.PostPriorityStore.(store.PostPriorityMetadataReader)
+	if !ok {
+		return nil, nil, store.ErrPostPriorityMetadataUnavailable
+	}
+	for tries := 1; ; tries++ {
+		p, a, err := reader.GetForPostsWithAcknowledgements(ids)
+		if err == nil || !isRepeatableError(err) {
+			return p, a, err
+		}
+		if tries >= 3 {
+			return p, a, errors.Wrap(err, "giving up after 3 consecutive repeatable transaction failures")
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
