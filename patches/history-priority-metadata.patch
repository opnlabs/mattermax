@@ -0,0 +1,86 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package timerlayer
+
+import (
+	"errors"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+	"testing"
+)
+
+type metadataTimerProbe struct {
+	store.PostPriorityStore
+	err   error
+	calls int
+}
+
+func (p *metadataTimerProbe) GetForPostsWithAcknowledgements([]string) ([]*model.PostPriority, []*model.PostAcknowledgement, error) {
+	p.calls++
+	return []*model.PostPriority{{PostId: "post"}}, []*model.PostAcknowledgement{{PostId: "post"}}, p.err
+}
+
+type metadataMetricProbe struct {
+	einterfaces.MetricsInterface
+	calls         int
+	name, success string
+	duration      float64
+}
+
+func (m *metadataMetricProbe) ObserveStoreMethodDuration(name, success string, duration float64) {
+	m.calls++
+	m.name = name
+	m.success = success
+	m.duration = duration
+}
+
+func TestHistoryPriorityMetadataTimer(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		name := "success"
+		if fail {
+			name = "error"
+		}
+		t.Run(name, func(t *testing.T) {
+			probe := &metadataTimerProbe{}
+			if fail {
+				probe.err = errors.New("read failed")
+			}
+			metric := &metadataMetricProbe{}
+			w := &TimerLayerPostPriorityStore{PostPriorityStore: probe, Root: &TimerLayer{Metrics: metric}}
+			p, a, err := w.GetForPostsWithAcknowledgements([]string{"post"})
+			want := "true"
+			if fail {
+				want = "false"
+			}
+			if probe.calls != 1 || metric.calls != 1 || metric.name != "PostPriorityStore.GetForPostsWithAcknowledgements" || metric.success != want || metric.duration < 0 || (err != nil) != fail || len(p) != 1 || len(a) != 1 {
+				t.Fatal("timer changed return values or metric")
+			}
+		})
+	}
+	t.Run("unsupported", func(t *testing.T) {
+		metric := &metadataMetricProbe{}
+		w := &TimerLayerPostPriorityStore{PostPriorityStore: &struct{ store.PostPriorityStore }{}, Root: &TimerLayer{Metrics: metric}}
+		p, a, err := w.GetForPostsWithAcknowledgements(nil)
+		if !errors.Is(err, store.ErrPostPriorityMetadataUnavailable) || p != nil || a != nil || metric.calls != 0 {
+			t.Fatal("unsupported capability changed")
+		}
+	})
+	t.Run("unsupported_forwarded", func(t *testing.T) {
+		metric := &metadataMetricProbe{}
+		w := &TimerLayerPostPriorityStore{PostPriorityStore: &metadataTimerProbe{err: store.ErrPostPriorityMetadataUnavailable}, Root: &TimerLayer{Metrics: metric}}
+		_, _, err := w.GetForPostsWithAcknowledgements(nil)
+		if !errors.Is(err, store.ErrPostPriorityMetadataUnavailable) || metric.calls != 0 {
+			t.Fatal("unsupported forwarding recorded a failed store operation")
+		}
+	})
+
+	t.Run("nil_metrics", func(t *testing.T) {
+		w := &TimerLayerPostPriorityStore{PostPriorityStore: &metadataTimerProbe{}, Root: &TimerLayer{}}
+		_, _, err := w.GetForPostsWithAcknowledgements(nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+	})
+}
