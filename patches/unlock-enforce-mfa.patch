diff --git a/webapp/channels/src/components/admin_console/admin_definition_mfa.test.tsx b/webapp/channels/src/components/admin_console/admin_definition_mfa.test.tsx
new file mode 100644
index 000000000000..2d4d01290e2d
--- /dev/null
+++ b/webapp/channels/src/components/admin_console/admin_definition_mfa.test.tsx
@@ -0,0 +1,18 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import AdminDefinition from './admin_definition';
+import type {AdminDefinitionSubSectionSchema} from './types';
+
+describe('AdminDefinition - Enforce Multi-factor Authentication', () => {
+    test('is shown without a license', () => {
+        const schema = AdminDefinition.authentication.subsections.mfa.schema as AdminDefinitionSubSectionSchema;
+        const settings = 'settings' in schema && schema.settings ? schema.settings : [];
+        const setting = settings.find((s) => s.key === 'ServiceSettings.EnforceMultifactorAuthentication');
+        const isHidden = setting?.isHidden;
+        const hidden = typeof isHidden === 'function' ? isHidden({}, {}, {IsLicensed: 'false'}) : Boolean(isHidden);
+
+        expect(setting).toBeDefined();
+        expect(hidden).toBe(false);
+    });
+});
