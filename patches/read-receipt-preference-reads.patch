+func TestPreferenceUsersLookup(t *testing.T) {
+	StoreTest(t, func(t *testing.T, _ request.CTX, ss store.Store) {
+		users := []string{model.NewId(), model.NewId(), model.NewId()}
+		category, name := model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts
+		wanted := model.Preferences{
+			{UserId: users[0], Category: category, Name: name, Value: "false"},
+			{UserId: users[1], Category: category, Name: name, Value: "123"},
+		}
+		fixture := append(model.Preferences{}, wanted...)
+		fixture = append(fixture,
+			model.Preference{UserId: users[0], Category: category, Name: "unrelated", Value: "x"},
+			model.Preference{UserId: users[1], Category: "unrelated", Name: name, Value: "x"},
+			model.Preference{UserId: model.NewId(), Category: category, Name: name, Value: "x"},
+		)
+		require.NoError(t, ss.Preference().Save(fixture))
+		got, err := ss.Preference().GetCategoryAndNameForUsers(append(users, users[0]), category, name)
+		require.NoError(t, err)
+		require.ElementsMatch(t, wanted, got, "missing users are omitted; duplicate IDs do not duplicate rows")
+		empty, err := ss.Preference().GetCategoryAndNameForUsers(nil, category, name)
+		require.NoError(t, err)
+		require.Empty(t, empty)
+		missing, err := ss.Preference().GetCategoryAndNameForUsers([]string{users[2]}, category, name)
+		require.NoError(t, err)
+		require.Empty(t, missing)
+	})
+}
