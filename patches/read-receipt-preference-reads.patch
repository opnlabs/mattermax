+func TestReadReceiptBulkInputs(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		name := "preferences and defaults"
+		if fail {
+			name = "database failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			th := SetupWithStoreMock(t)
+			channel := &model.Channel{Id: model.NewId(), Type: model.ChannelTypeGroup}
+			ids := []string{model.NewId(), model.NewId(), model.NewId(), model.NewId()}
+			members := make([]*model.ChannelMemberLastViewed, len(ids))
+			for i, id := range ids {
+				members[i] = &model.ChannelMemberLastViewed{UserId: id}
+			}
+			channels := &mocks.ChannelStore{}
+			channels.On("Get", channel.Id, true).Return(channel, nil).Once()
+			channels.On("GetMembersWithLastViewedAtSince", mock.Anything, channel.Id, int64(0), "", 0).Return(members, nil).Once()
+			preferences := &mocks.PreferenceStore{}
+			stored := model.Preferences{
+				{UserId: ids[0], Value: "false"},
+				{UserId: ids[1], Value: "123"},
+				{UserId: ids[2], Value: "invalid"},
+			}
+			var err error
+			if fail {
+				err = errors.New("database unavailable")
+			}
+			preferences.On("GetCategoryAndNameForUsers", ids, model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts).Return(stored, err).Once()
+			stores := th.App.Srv().Store().(*mocks.Store)
+			stores.On("Channel").Return(channels)
+			stores.On("Preference").Return(preferences)
+			gotChannel, gotMembers, prefs, appErr := th.App.loadReadReceiptInputs(th.Context, channel.Id)
+			if fail {
+				require.NotNil(t, appErr)
+				require.Equal(t, "app.preference.get.app_error", appErr.Id)
+				require.Equal(t, http.StatusInternalServerError, appErr.StatusCode)
+				require.Nil(t, gotChannel)
+				require.Nil(t, gotMembers)
+				require.Nil(t, prefs, "failed reads must not expose partially defaulted inputs")
+			} else {
+				require.Nil(t, appErr)
+				require.Equal(t, channel, gotChannel)
+				require.Equal(t, members, gotMembers)
+				require.Equal(t, map[string]model.ReadReceiptsPref{
+					ids[0]: {}, ids[1]: {On: true, Since: 123}, ids[2]: {}, ids[3]: {On: true},
+				}, prefs)
+			}
+			channels.AssertExpectations(t)
+			preferences.AssertExpectations(t)
+		})
+	}
+}
