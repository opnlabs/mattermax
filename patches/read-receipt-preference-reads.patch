+// BenchmarkReadReceiptPreferenceInputs measures only preference loading/parsing
+// through the SQL store, excluding channel membership, HTTP and event delivery.
+func BenchmarkReadReceiptPreferenceInputs(b *testing.B) {
+	if len(storeTypes) == 0 {
+		b.Fatal("PostgreSQL store is required")
+	}
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			for _, members := range []int{2, 4, 8} {
+				b.Run(fmt.Sprintf("members=%d", members), func(b *testing.B) {
+					users := make([]string, members)
+					category, name := model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts
+					expected := make(map[string]model.ReadReceiptsPref, members)
+					for i := range users {
+						users[i] = model.NewId()
+						pref := model.Preference{UserId: users[i], Category: category, Name: name, Value: "0"}
+						if i%3 == 0 {
+							pref.Value = "false"
+						}
+						if i%3 == 1 {
+							expected[users[i]] = model.ParseReadReceiptsPref(nil, model.GetMillis())
+							continue
+						}
+						if err := st.Store.Preference().Save(model.Preferences{pref}); err != nil {
+							b.Fatal(err)
+						}
+						expected[users[i]] = model.ParseReadReceiptsPref(&pref, model.GetMillis())
+					}
+					b.Cleanup(func() {
+						for _, id := range users {
+							if err := st.Store.Preference().PermanentDeleteByUser(id); err != nil {
+								b.Error(err)
+							}
+						}
+					})
+					for _, variant := range []string{"legacy", "batch"} {
+						b.Run(variant, func(b *testing.B) {
+							lookup := func() (map[string]model.ReadReceiptsPref, error) {
+								now := model.GetMillis()
+								result := make(map[string]model.ReadReceiptsPref, len(users))
+								if variant == "legacy" {
+									for _, id := range users {
+										pref, err := st.Store.Preference().Get(id, category, name)
+										if err != nil && !errors.Is(err, sql.ErrNoRows) {
+											return nil, err
+										}
+										result[id] = model.ParseReadReceiptsPref(pref, now)
+									}
+								} else {
+									for _, id := range users {
+										result[id] = model.ParseReadReceiptsPref(nil, now)
+									}
+									stored, err := st.Store.Preference().GetCategoryAndNameForUsers(users, category, name)
+									if err != nil {
+										return nil, err
+									}
+									for i := range stored {
+										result[stored[i].UserId] = model.ParseReadReceiptsPref(&stored[i], now)
+									}
+								}
+								return result, nil
+							}
+							got, err := lookup()
+							if err != nil || !reflect.DeepEqual(expected, got) {
+								b.Fatalf("preferences=%v expected=%v error=%v", got, expected, err)
+							}
+							b.ReportAllocs()
+							b.ResetTimer()
+							for i := 0; i < b.N; i++ {
+								got, err := lookup()
+								if err != nil || len(got) != members {
+									b.Fatalf("preferences=%v error=%v", got, err)
+								}
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
