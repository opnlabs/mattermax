+func TestTeamThreadUnreadAggregation(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, rctx request.CTX, ss store.Store, db storetest.SqlStore) {
+		user, otherUser := model.NewId(), model.NewId()
+		teamA, teamB, teamAbsent := model.NewId(), model.NewId(), model.NewId()
+		channelA, channelB, missingChannel, dmChannel := model.NewId(), model.NewId(), model.NewId(), model.NewId()
+		var ids []string
+		t.Cleanup(func() {
+			for _, id := range ids {
+				_, err := db.GetMaster().Exec("DELETE FROM PostsPriority WHERE PostId = ?", id)
+				require.NoError(t, err)
+				_, err = db.GetMaster().Exec("DELETE FROM ThreadMemberships WHERE PostId = ?", id)
+				require.NoError(t, err)
+				_, err = db.GetMaster().Exec("DELETE FROM Threads WHERE PostId = ?", id)
+				require.NoError(t, err)
+			}
+			_, err := db.GetMaster().Exec("DELETE FROM ChannelMembers WHERE UserId IN (?, ?)", user, otherUser)
+			require.NoError(t, err)
+		})
+		for _, channel := range []string{channelA, channelB} {
+			_, err := db.GetMaster().Exec("INSERT INTO ChannelMembers (ChannelId,UserId) VALUES (?, ?)", channel, user)
+			require.NoError(t, err)
+		}
+		add := func(team any, channel string, lastReply, lastViewed, mentions, deleted, following any, urgent bool) string {
+			t.Helper()
+			id := model.NewId()
+			ids = append(ids, id)
+			_, err := db.GetMaster().Exec("INSERT INTO Threads (PostId,ChannelId,ThreadTeamId,LastReplyAt,ThreadDeleteAt) VALUES (?,?,?,?,?)", id, channel, team, lastReply, deleted)
+			require.NoError(t, err)
+			_, err = db.GetMaster().Exec("INSERT INTO ThreadMemberships (PostId,UserId,Following,LastViewed,UnreadMentions) VALUES (?,?,?,?,?)", id, user, following, lastViewed, mentions)
+			require.NoError(t, err)
+			if urgent {
+				_, err = db.GetMaster().Exec("INSERT INTO PostsPriority (PostId,ChannelId,Priority) VALUES (?,?,?)", id, channel, model.PostPriorityUrgent)
+				require.NoError(t, err)
+			}
+			return id
+		}
+		first := add(teamA, channelA, 100, 0, 2, 0, true, true)
+		add(teamA, channelA, 100, 100, 3, 0, true, false)
+		add(teamA, channelA, 100, 0, 7, 0, false, true)
+		add(teamA, channelA, 100, 0, 11, 1, true, true)
+		add(teamA, missingChannel, 100, 0, 13, 0, true, true)
+		add(teamA, channelA, nil, 0, nil, nil, true, false)
+		add(teamA, channelA, 100, nil, 4, 0, true, true)
+		add(teamA, channelA, 100, 0, 17, 0, nil, true)
+		add(teamB, channelB, 100, 100, nil, 0, true, false)
+		add(teamB, channelB, 100, 0, -3, 0, true, true)
+		add("", dmChannel, 100, 0, 1, 0, true, true)
+		add(nil, channelA, 100, 0, 19, 0, true, true)
+		_, err := db.GetMaster().Exec("INSERT INTO ThreadMemberships (PostId,UserId,Following,LastViewed,UnreadMentions) VALUES (?,?,true,0,100)", first, otherUser)
+		require.NoError(t, err)
+		orphan := model.NewId()
+		ids = append(ids, orphan)
+		_, err = db.GetMaster().Exec("INSERT INTO ThreadMemberships (PostId,UserId,Following,LastViewed,UnreadMentions) VALUES (?,?,true,0,100)", orphan, user)
+		require.NoError(t, err)
+		for _, urgent := range []bool{false, true} {
+			t.Run(fmt.Sprintf("urgent=%t", urgent), func(t *testing.T) {
+				expected := map[string]*model.TeamUnread{
+					teamA: {ThreadCount: 1, ThreadMentionCount: 9},
+					teamB: {ThreadCount: 1, ThreadMentionCount: -3},
+					"":    {ThreadCount: 1, ThreadMentionCount: 1},
+				}
+				if urgent {
+					expected[teamA].ThreadUrgentMentionCount = 6
+					expected[teamB].ThreadUrgentMentionCount = -3
+					expected[""].ThreadUrgentMentionCount = 1
+				}
+				for _, teams := range [][]string{nil, {}, {teamAbsent}, {teamA}, {teamA, teamB, "", teamA, teamAbsent}} {
+					want := make(map[string]*model.TeamUnread)
+					for _, id := range teams {
+						if value, ok := expected[id]; ok {
+							want[id] = value
+						}
+					}
+					got, err := ss.Thread().GetTeamsUnreadForUser(user, teams, urgent)
+					require.NoError(t, err)
+					require.Equal(t, want, got)
+				}
+			})
+		}
+		// A matching membership still produces a zero-valued group after all rows are read.
+		_, err = db.GetMaster().Exec("UPDATE ThreadMemberships SET LastViewed=200, UnreadMentions=0 WHERE UserId=?", user)
+		require.NoError(t, err)
+		got, err := ss.Thread().GetTeamsUnreadForUser(user, []string{teamA, teamB}, true)
+		require.NoError(t, err)
+		require.Equal(t, map[string]*model.TeamUnread{teamA: {}, teamB: {}}, got)
+	})
+}
+
+func BenchmarkTeamThreadUnreadAggregation(b *testing.B) {
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			pool := st.SqlStore.GetReplica().DB()
+			if pool != st.SqlStore.GetMaster().DB() {
+				b.Fatal("benchmark requires one database pool")
+			}
+			oldOpen, oldIdle := pool.Stats().MaxOpenConnections, *st.SqlSettings.MaxIdleConns
+			pool.SetMaxOpenConns(8)
+			pool.SetMaxIdleConns(8)
+			b.Cleanup(func() { pool.SetMaxOpenConns(oldOpen); pool.SetMaxIdleConns(oldIdle) })
+			for _, n := range []int{0, 10, 1000} {
+				b.Run(fmt.Sprintf("threads=%d", n), func(b *testing.B) {
+					user, channel, team, prefix := model.NewId(), model.NewId(), model.NewId(), model.NewId()[:20]
+					exec := func(query string, args ...any) {
+						b.Helper()
+						_, err := st.SqlStore.GetMaster().Exec(query, args...)
+						if err != nil {
+							b.Fatal(err)
+						}
+					}
+					exec("INSERT INTO ChannelMembers (ChannelId,UserId) VALUES (?,?)", channel, user)
+					exec("INSERT INTO Threads (PostId,ChannelId,ThreadTeamId,LastReplyAt,ThreadDeleteAt) SELECT ? || lpad(i::text,6,'0'),?,?,100,0 FROM generate_series(1,?) i", prefix, channel, team, n)
+					exec("INSERT INTO ThreadMemberships (PostId,UserId,Following,LastViewed,UnreadMentions) SELECT PostId,?,true,CASE WHEN right(PostId,6)::int % 2=0 THEN 100 ELSE 0 END,right(PostId,6)::int % 3 FROM Threads WHERE ChannelId=?", user, channel)
+					exec("INSERT INTO PostsPriority (PostId,ChannelId,Priority) SELECT PostId,ChannelId,? FROM Threads WHERE ChannelId=? AND right(PostId,6)::int % 4=0", model.PostPriorityUrgent, channel)
+					b.Cleanup(func() {
+						exec("DELETE FROM PostsPriority WHERE ChannelId=?", channel)
+						exec("DELETE FROM ThreadMemberships WHERE UserId=?", user)
+						exec("DELETE FROM Threads WHERE ChannelId=?", channel)
+						exec("DELETE FROM ChannelMembers WHERE UserId=?", user)
+					})
+					var count, mentions, urgentMentions int64
+					for i := 1; i <= n; i++ {
+						if i%2 != 0 {
+							count++
+						}
+						mentions += int64(i % 3)
+						if i%4 == 0 {
+							urgentMentions += int64(i % 3)
+						}
+					}
+					for _, urgent := range []bool{false, true} {
+						b.Run(fmt.Sprintf("urgent=%t", urgent), func(b *testing.B) {
+							for _, mode := range []string{"serial", "parallel"} {
+								b.Run(mode, func(b *testing.B) {
+									check := func(got map[string]*model.TeamUnread, err error) {
+										if err != nil {
+											b.Fatal(err)
+										}
+										if n == 0 {
+											if got == nil || len(got) != 0 {
+												b.Fatal("incorrect empty map")
+											}
+											return
+										}
+										value := got[team]
+										wantUrgent := int64(0)
+										if urgent {
+											wantUrgent = urgentMentions
+										}
+										if len(got) != 1 || value == nil || value.TeamId != "" || value.ThreadCount != count || value.ThreadMentionCount != mentions || value.ThreadUrgentMentionCount != wantUrgent {
+											b.Fatalf("incorrect counts: %#v", got)
+										}
+									}
+									check(st.Store.Thread().GetTeamsUnreadForUser(user, []string{team}, urgent))
+									b.ReportAllocs()
+									b.ResetTimer()
+									if mode == "serial" {
+										for range b.N {
+											check(st.Store.Thread().GetTeamsUnreadForUser(user, []string{team}, urgent))
+										}
+									} else {
+										b.RunParallel(func(pb *testing.PB) {
+											for pb.Next() {
+												check(st.Store.Thread().GetTeamsUnreadForUser(user, []string{team}, urgent))
+											}
+										})
+									}
+								})
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
