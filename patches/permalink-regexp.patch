+func TestPermalinkPathBoundaries(t *testing.T) {
+	const base = "https://chat.example.com"
+	const id = "dppezk51jp8afbhwxf1jpag66r"
+	for _, tc := range []struct {
+		name, url, site string
+		want            bool
+	}{
+		{"one character team", base + "/a/pl/" + id, base, true},
+		{"maximum team", base + "/" + strings.Repeat("a", 64) + "/pl/" + id, base, true},
+		{"team too long", base + "/" + strings.Repeat("a", 65) + "/pl/" + id, base, false},
+		{"empty team", base + "//pl/" + id, base, false},
+		{"team punctuation", base + "/team_0-9/pl/" + id, base, true},
+		{"uppercase team", base + "/Team/pl/" + id, base, false},
+		{"uppercase id", base + "/team/pl/" + strings.ToUpper(id), base, false},
+		{"extra id", base + "/team/pl/" + id + "a", base, false},
+		{"query", base + "/team/pl/" + id + "?foo=bar", base, false},
+		{"fragment", base + "/team/pl/" + id + "#foo", base, false},
+		{"extra slash", base + "//team/pl/" + id, base, false},
+		{"unicode whitespace", "\u2003" + base + "/team/pl/" + id + "\u2003", base, true},
+		{"subpath", base + "/chat/team/pl/" + id, base + "/chat", true},
+		{"empty site relative", "/team/pl/" + id, "", true},
+		{"legacy prefix without separator", base + "team/pl/" + id, base, true},
+		{"external host", "https://other.example.com/team/pl/" + id, base, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) { require.Equal(t, tc.want, looksLikeAPermalink(tc.url, tc.site)) })
+	}
+}
+
+// BenchmarkPermalinkHistory exercises real stored pages with configured SiteURL.
+// External URLs are controls for the existing prefix rejection path.
+func BenchmarkPermalinkHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.ServiceSettings.EnableLinkPreviews = false
+		*cfg.ServiceSettings.EnablePermalinkPreviews = true
+		*cfg.ServiceSettings.AllowedUntrustedInternalConnections = "127.0.0.1"
+	})
+	image, err := testutils.ReadTestFile("test.png")
+	if err != nil {
+		b.Fatal(err)
+	}
+	var fetches atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fetches.Add(1)
+		w.Header().Set("Content-Type", "image/png")
+		_, _ = w.Write(image)
+	}))
+	defer server.Close()
+	target, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "linked target"})
+	if err != nil {
+		b.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, siteURL, message, imageURL string
+		permalink                        bool
+	}{
+		{name: "plain", siteURL: "https://chat.example.invalid", message: "The deploy is ready for review."},
+		{name: "external_image", siteURL: "https://chat.example.invalid", message: "![status](" + server.URL + "/image.png)", imageURL: server.URL + "/image.png"},
+		{name: "same_site_image", siteURL: server.URL, message: "![status](" + server.URL + "/image.png)", imageURL: server.URL + "/image.png"},
+		{name: "subpath_image", siteURL: server.URL + "/chat", message: "![status](" + server.URL + "/chat/image.png)", imageURL: server.URL + "/chat/image.png"},
+		{name: "same_site_link", siteURL: server.URL, message: server.URL + "/api/v4/system/ping"},
+		{name: "permalink", siteURL: server.URL, message: server.URL + "/" + th.BasicTeam.Name + "/pl/" + target.Id, permalink: true},
+	} {
+		b.Run(tc.name, func(b *testing.B) {
+			th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.SiteURL = tc.siteURL })
+			list := model.NewPostList()
+			for range 60 {
+				post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: tc.message})
+				if err != nil {
+					b.Fatal(err)
+				}
+				list.AddPost(post)
+			}
+			check := func(result *model.PostList) {
+				for id := range list.Posts {
+					post := result.Posts[id]
+					if post == nil || post.Metadata == nil {
+						b.Fatal("missing post metadata")
+					}
+					expectedImages := 0
+					if tc.imageURL != "" {
+						expectedImages = 1
+					}
+					if len(post.Metadata.Images) != expectedImages {
+						b.Fatal("incorrect image count")
+					}
+					if tc.imageURL != "" {
+						dims := post.Metadata.Images[tc.imageURL]
+						if dims == nil || dims.Width != 408 || dims.Height != 336 {
+							b.Fatal("incorrect image dimensions")
+						}
+					}
+					if tc.permalink {
+						if len(post.Metadata.Embeds) != 1 || post.Metadata.Embeds[0].Type != model.PostEmbedPermalink {
+							b.Fatal("missing permalink embed")
+						}
+						link, ok := post.Metadata.Embeds[0].Data.(*model.PreviewPost)
+						if !ok || link.Post == nil || link.PostID != target.Id || link.Post.Id != target.Id {
+							b.Fatal("incorrect permalink target")
+						}
+					} else if len(post.Metadata.Embeds) != 0 {
+						b.Fatal("unexpected embed")
+					}
+				}
+			}
+			check(th.App.PreparePostListForClient(th.Context, list))
+			warmed := fetches.Load()
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				check(th.App.PreparePostListForClient(th.Context, list))
+			}
+			b.StopTimer()
+			if fetches.Load() != warmed {
+				b.Fatal("unexpected image fetch during timed loop")
+			}
+		})
+	}
+}
