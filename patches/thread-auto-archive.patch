+
+func (a *App) checkThreadArchived(rctx request.CTX, rootID string, archiveDays int) *model.AppError {
+	root, err := a.Srv().Store().Post().GetSingle(rctx, rootID, false)
+	if err != nil {
+		var nfErr *store.ErrNotFound
+		if errors.As(err, &nfErr) {
+			return nil
+		}
+		return model.NewAppError("checkThreadArchived", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	thread, err := a.Srv().Store().Thread().Get(rootID)
+	if err != nil {
+		return model.NewAppError("checkThreadArchived", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	lastActivityAt := root.CreateAt
+	if thread != nil {
+		lastActivityAt = max(lastActivityAt, thread.LastReplyAt)
+	}
+
+	if model.GetMillis()-lastActivityAt < int64(archiveDays)*24*time.Hour.Milliseconds() {
+		return nil
+	}
+	return model.NewAppError("createPost", "api.post.create_post.thread_archived.app_error", map[string]any{"Count": archiveDays}, "", http.StatusForbidden)
 }
 
 func (a *App) checkSlowmode(post *model.Post, channel *model.Channel, slowmodeSeconds int) *model.AppError {
