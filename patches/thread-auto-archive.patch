+
+const day = 24 * 60 * 60 * 1000;
+const now = new Date('2026-11-12T12:00:00Z').getTime();
+
+function makeState(channelId: string, channelType: ChannelType, channelPermissions: string[], lastReplyAt: number) {
+    return {
+        entities: {
+            channels: {
+                channels: {[channelId]: TestHelper.getChannelMock({id: channelId, team_id: 'team_id', type: channelType})},
+                roles: {[channelId]: new Set(['channel_role'])},
+            },
+            posts: {
+                posts: {
+                    root: TestHelper.getPostMock({id: 'root', channel_id: channelId, type: '', create_at: now - (10 * day)}),
+                    reply: TestHelper.getPostMock({id: 'reply', channel_id: channelId, root_id: 'root', type: '', create_at: lastReplyAt}),
+                },
+                postsInThread: {root: ['reply']},
+            },
+            roles: {roles: {channel_role: {permissions: channelPermissions}}},
+            teams: {
+                currentTeamId: 'team_id',
+                myMembers: {team_id: TestHelper.getTeamMembershipMock({team_id: 'team_id', roles: ''})},
+            },
+            users: {
+                currentUserId: 'user_id',
+                profiles: {user_id: TestHelper.getUserMock({id: 'user_id', roles: ''})},
+            },
+        },
+    };
+}
+
+async function renderThread(state: ReturnType<typeof makeState>) {
+    renderWithContext(<CreateComment threadId='root'/>, state);
+    await act(async () => {
+        await Promise.resolve();
+    });
+}
+
+describe('thread auto-archive in the thread view', () => {
+    let getRules: jest.SpyInstance;
+
+    beforeEach(() => {
+        jest.useFakeTimers({now, doNotFake: ['queueMicrotask', 'nextTick']});
+        getRules = jest.spyOn(Client4, 'getChannelPostingRules').mockResolvedValue({slowmode_seconds: 0, thread_archive_days: 3});
+    });
+
+    afterEach(() => {
+        getRules.mockRestore();
+        jest.useRealTimers();
+    });
+
+    it('replaces the reply box with a notice once the thread has gone without replies for the period', async () => {
+        await renderThread(makeState('archived_channel', 'O', [Permissions.CREATE_POST], now - (4 * day)));
+
+        expect(screen.getByText('This thread was archived after 3 days without replies')).toBeInTheDocument();
+        expect(screen.queryByTestId('reply-box')).not.toBeInTheDocument();
+    });
+
+    it('keeps the reply box while the last reply is newer than the period', async () => {
+        await renderThread(makeState('active_channel', 'O', [Permissions.CREATE_POST], now - (2 * day)));
+
+        expect(screen.getByTestId('reply-box')).toBeInTheDocument();
+        expect(screen.queryByTestId('thread-archived-notice')).not.toBeInTheDocument();
+    });
+
+    it('keeps the reply box for channel admins so they can reopen the thread', async () => {
+        await renderThread(makeState('admin_channel', 'P', [Permissions.CREATE_POST, Permissions.MANAGE_CHANNEL_ROLES], now - (4 * day)));
+
+        expect(screen.getByTestId('reply-box')).toBeInTheDocument();
+        expect(screen.queryByTestId('thread-archived-notice')).not.toBeInTheDocument();
+    });
+
+    it('does not archive threads in direct messages', async () => {
+        await renderThread(makeState('dm_channel', 'D', [Permissions.CREATE_POST], now - (4 * day)));
+
+        expect(getRules).not.toHaveBeenCalled();
+        expect(screen.getByTestId('reply-box')).toBeInTheDocument();
+    });
+});
