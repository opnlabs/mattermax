+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React, {useState} from 'react';
+import {FormattedMessage} from 'react-intl';
+import {useSelector} from 'react-redux';
+
+import {ArchiveOutlineIcon} from '@mattermost/compass-icons/components';
+import type {Channel} from '@mattermost/types/channels';
+import type {Post} from '@mattermost/types/posts';
+
+import {Permissions} from 'mattermost-redux/constants';
+import {getPostsInThread} from 'mattermost-redux/selectors/entities/posts';
+import {haveIChannelPermission} from 'mattermost-redux/selectors/entities/roles';
+import {getThread} from 'mattermost-redux/selectors/entities/threads';
+
+import BasicSeparator from 'components/widgets/separator/basic-separator';
+
+import type {GlobalState} from 'types/store';
+
+import {useChannelPostingRules} from './use_channel_posting_rules';
+import {isPostingRulesChannel} from './use_slowmode';
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000;
+
+function getThreadLastActivityAt(state: GlobalState, rootPost: Post) {
+    let lastActivityAt = Math.max(rootPost.create_at, rootPost.last_reply_at ?? 0, getThread(state, rootPost.id)?.last_reply_at ?? 0);
+    for (const replyId of getPostsInThread(state)[rootPost.id] ?? []) {
+        lastActivityAt = Math.max(lastActivityAt, state.entities.posts.posts[replyId]?.create_at ?? 0);
+    }
+    return lastActivityAt;
+}
+
+export function useArchivedThreadDays(rootPost?: Post, channel?: Channel | null) {
+    const [now] = useState(Date.now);
+    const postingRulesChannel = isPostingRulesChannel(channel ?? undefined) ? channel : undefined;
+    const rules = useChannelPostingRules(rootPost ? postingRulesChannel?.id : undefined);
+    const archiveDays = rules?.thread_archive_days ?? 0;
+    const exempt = useSelector((state: GlobalState) => !postingRulesChannel || haveIChannelPermission(state, postingRulesChannel.team_id, postingRulesChannel.id, Permissions.MANAGE_CHANNEL_ROLES));
+    const lastActivityAt = useSelector((state: GlobalState) => (rootPost && archiveDays && !exempt ? getThreadLastActivityAt(state, rootPost) : 0));
+
+    if (!lastActivityAt || now - lastActivityAt < archiveDays * DAY_IN_MILLISECONDS) {
+        return 0;
+    }
+    return archiveDays;
+}
+
+export default function ThreadArchivedNotice({days}: {days: number}) {
+    return (
+        <div
+            className='channel-archived-warning__container'
+            data-testid='thread-archived-notice'
+        >
+            <BasicSeparator/>
+            <div className='channel-archived-warning__content'>
+                <ArchiveOutlineIcon
+                    size={20}
+                    color={'rgba(var(--center-channel-color-rgb), 0.75)'}
+                />
+                <FormattedMessage
+                    id='channel_posting_rules.thread_archived'
+                    defaultMessage='This thread was archived after {days, plural, one {# day} other {# days}} without replies'
+                    values={{days}}
+                />
+            </div>
+        </div>
+    );
+}
