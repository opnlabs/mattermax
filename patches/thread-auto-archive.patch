+func TestThreadAutoArchive(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	channel := th.CreatePublicChannel(t)
+	_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{ThreadArchiveDays: 1})
+	require.NoError(t, err)
+	member, memberClient := newChannelMemberClient(t, th, channel)
+
+	day := int64(24 * 60 * 60 * 1000)
+	savePost := func(t *testing.T, channelID, rootID string, createAt int64) *model.Post {
+		t.Helper()
+		post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{
+			ChannelId: channelID,
+			RootId:    rootID,
+			UserId:    th.BasicUser2.Id,
+			Message:   "message_" + model.NewId(),
+			CreateAt:  createAt,
+		})
+		require.NoError(t, err)
+		return post
+	}
+
+	t.Run("a reply to a thread with no replies for longer than the period is rejected", func(t *testing.T) {
+		root := savePost(t, channel.Id, "", model.GetMillis()-2*day)
+		savePost(t, channel.Id, root.Id, model.GetMillis()-day-60*1000)
+
+		err := postMessage(memberClient, channel.Id, root.Id)
+		CheckErrorID(t, err, "api.post.create_post.thread_archived.app_error")
+		var appErr *model.AppError
+		require.ErrorAs(t, err, &appErr)
+		require.Equal(t, http.StatusForbidden, appErr.StatusCode)
+		require.Equal(t, "This thread was archived after 1 day without replies.", appErr.Message)
+	})
+
+	t.Run("a recent reply keeps an old thread open", func(t *testing.T) {
+		root := savePost(t, channel.Id, "", model.GetMillis()-3*day)
+		savePost(t, channel.Id, root.Id, model.GetMillis()-60*60*1000)
+		require.NoError(t, postMessage(memberClient, channel.Id, root.Id))
+	})
+
+	t.Run("a new thread without replies is open", func(t *testing.T) {
+		root := savePost(t, channel.Id, "", model.GetMillis()-60*60*1000)
+		require.NoError(t, postMessage(memberClient, channel.Id, root.Id))
+	})
+
+	t.Run("root posts and reactions are unaffected", func(t *testing.T) {
+		root := savePost(t, channel.Id, "", model.GetMillis()-2*day)
+		require.NoError(t, postMessage(memberClient, channel.Id, ""))
+		_, _, err := memberClient.SaveReaction(context.Background(), &model.Reaction{UserId: member.Id, PostId: root.Id, EmojiName: "smile"})
+		require.NoError(t, err)
+	})
+
+	t.Run("a channel admin can reply, which reopens the thread", func(t *testing.T) {
+		root := savePost(t, channel.Id, "", model.GetMillis()-2*day)
+		CheckErrorID(t, postMessage(memberClient, channel.Id, root.Id), "api.post.create_post.thread_archived.app_error")
+		require.NoError(t, postMessage(th.Client, channel.Id, root.Id))
+		require.NoError(t, postMessage(memberClient, channel.Id, root.Id))
+	})
+
+	t.Run("threads in direct messages are never archived", func(t *testing.T) {
+		dm := th.CreateDmChannel(t, th.BasicUser2)
+		require.NoError(t, th.App.Srv().Store().System().SaveOrUpdate(&model.System{Name: "channel_posting_rules_" + dm.Id, Value: `{"thread_archive_days":1}`}))
+		root := savePost(t, dm.Id, "", model.GetMillis()-2*day)
+		require.NoError(t, postMessage(th.Client, dm.Id, root.Id))
+	})
+
+	t.Run("a period outside the allowed options is rejected", func(t *testing.T) {
+		_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{ThreadArchiveDays: 2})
+		CheckErrorID(t, err, "model.channel_posting_rules.thread_archive_days.app_error")
+	})
+}
