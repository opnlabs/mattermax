+    test('should load the members of matching group channels when the search term changes', async () => {
+        jest.useFakeTimers();
+        try {
+            const groupChannels = [{id: 'gm_id', type: 'G'}];
+            const props = {
+                ...baseProps,
+                actions: {
+                    ...baseProps.actions,
+                    searchGroupChannels: jest.fn().mockResolvedValue({data: groupChannels}),
+                    loadProfilesForGroupChannels: jest.fn(),
+                },
+            };
+            const {rerender} = renderWithContext(<MoreDirectChannels {...props}/>);
+            rerender(
+                <MoreDirectChannels
+                    {...props}
+                    searchTerm='gm'
+                />,
+            );
+            await act(async () => {
+                jest.runAllTimers();
+            });
+
+            await waitFor(() => {
+                expect(props.actions.loadProfilesForGroupChannels).toHaveBeenCalledWith(groupChannels);
+            });
+            expect(props.actions.searchGroupChannels).toHaveBeenCalledWith('gm');
+        } finally {
+            jest.useRealTimers();
+        }
+    });
+
