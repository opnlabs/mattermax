+    test.each(['false', 'true'])('honors name locking without a license when set to %s', (locked) => {
+        const state = mergeObjects(baseState, {
+            entities: {
+                general: {
+                    config: {
+                        LockTeammateNameDisplay: locked,
+                        TeammateNameDisplay: General.TEAMMATE_NAME_DISPLAY.SHOW_USERNAME,
+                    },
+                    license: {IsLicensed: 'false'},
+                },
+                preferences: {myPreferences: {
+                    [`${Preferences.CATEGORY_DISPLAY_SETTINGS}--${Preferences.NAME_NAME_FORMAT}`]: {
+                        value: General.TEAMMATE_NAME_DISPLAY.SHOW_FULLNAME,
+                    },
+                }},
+            },
+        });
+        expect(makeMapStateToProps()(state, ownProps).lockTeammateNameDisplay).toBe(locked === 'true');
+        renderWithContext(
+            <UserSettingsDisplay
+                {...ownProps}
+                activeSection={Preferences.NAME_NAME_FORMAT}
+                updateSection={jest.fn()}
+                closeModal={jest.fn()}
+                collapseModal={jest.fn()}
+            />,
+            state,
+        );
+        if (locked === 'true') {
+            expect(screen.queryByRole('radio')).not.toBeInTheDocument();
+            expect(screen.getByText(/This field is handled through your System Administrator/)).toBeInTheDocument();
+            expect(screen.queryByRole('button', {name: 'Save'})).not.toBeInTheDocument();
+        } else {
+            expect(screen.getByRole('radio', {name: 'Show first and last name'})).toBeChecked();
+        }
+    });
 });
