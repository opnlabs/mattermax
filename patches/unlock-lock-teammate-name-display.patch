+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import AdminDefinition from './admin_definition';
+
+test('name locking is visible without a license', () => {
+    const schema = AdminDefinition.site.subsections.users_and_teams.schema;
+    if (!('settings' in schema) || !schema.settings) {
+        throw new Error('Expected Users and Teams settings');
+    }
+    const setting = schema.settings.find((item) => item.key === 'TeamSettings.LockTeammateNameDisplay');
+    expect(setting).toBeDefined();
+    expect(setting?.isHidden).toBeUndefined();
+    expect(setting?.isDisabled).toBeDefined();
+});
