+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"slices"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+type postPreparationData struct {
+	reactions map[string][]*model.Reaction
+	files     map[string]preparedPostFile
+}
+
+type preparedPostFile struct {
+	info   *model.FileInfo
+	shared bool
+}
+
+const postFileMetadataBatchSize = 1000
+
+// preparePostListFileMetadata uses the existing file cache and batches its
+// misses. A failed batch leaves the caller on its ordinary per-post path.
+func (a *App) preparePostListFileMetadata(list *model.PostList) map[string]preparedPostFile {
+	if len(list.Posts) < 2 {
+		return nil
+	}
+	posts, count := 0, 0
+	for _, post := range list.Posts {
+		if post.DeleteAt <= 0 && len(post.FileIds) > 0 {
+			posts++
+			count += len(post.FileIds)
+		}
+	}
+	if posts < 2 {
+		return nil
+	}
+	prepared := make(map[string]preparedPostFile, count)
+	ids := make([]string, 0, count)
+	for _, post := range list.Posts {
+		if post.DeleteAt > 0 {
+			continue
+		}
+		for _, id := range post.FileIds {
+			if entry, ok := prepared[id]; ok {
+				entry.shared = true
+				prepared[id] = entry
+			} else {
+				prepared[id] = preparedPostFile{}
+				ids = append(ids, id)
+			}
+		}
+	}
+	for start := 0; start < len(ids); start += postFileMetadataBatchSize {
+		end := min(start+postFileMetadataBatchSize, len(ids))
+		infos, err := a.Srv().Store().FileInfo().GetByIds(ids[start:end], false, true, false)
+		if err != nil {
+			return nil
+		}
+		for _, info := range infos {
+			if entry, ok := prepared[info.Id]; ok {
+				entry.info = info
+				prepared[info.Id] = entry
+			}
+		}
+	}
+	return prepared
+}
+
+func preparedFileInfosForPost(ids []string, prepared map[string]preparedPostFile) []*model.FileInfo {
+	var infos []*model.FileInfo
+	var seen map[string]bool
+	for _, id := range ids {
+		entry := prepared[id]
+		if entry.info == nil {
+			continue
+		}
+		info := entry.info
+		if entry.shared {
+			if seen[id] {
+				continue
+			}
+			if seen == nil {
+				seen = make(map[string]bool)
+			}
+			seen[id] = true
+			// Filtering and preview generation mutate FileInfo. Repeated IDs need
+			// independent values, just as separate cache reads would return.
+			copy := *info
+			if info.MiniPreview != nil {
+				data := slices.Clone(*info.MiniPreview)
+				copy.MiniPreview = &data
+			}
+			if info.RemoteId != nil {
+				remote := *info.RemoteId
+				copy.RemoteId = &remote
+			}
+			info = &copy
+		}
+		infos = append(infos, info)
+	}
+	return infos
+}
