+// BenchmarkAttachmentHistory uses stored text attachments in real history
+// preparation. Only file-cache purges are outside the cold-case timer.
+func BenchmarkAttachmentHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableLinkPreviews = false })
+	for _, tc := range []struct{ posts, files int }{{1, 2}, {10, 2}, {60, 2}, {60, 0}} {
+		b.Run(fmt.Sprintf("posts=%d/files=%d", tc.posts, tc.files), func(b *testing.B) {
+			list := model.NewPostList()
+			for range tc.posts {
+				post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "attachment history"})
+				if err != nil {
+					b.Fatal(err)
+				}
+				ids := make([]string, tc.files)
+				for i := range ids {
+					info, err := th.App.Srv().Store().FileInfo().Save(th.Context, &model.FileInfo{CreatorId: post.UserId, PostId: post.Id, Name: fmt.Sprintf("attachment-%d.txt", i), Path: fmt.Sprintf("benchmark/%s/%d.txt", post.Id, i), MimeType: "text/plain"})
+					if err != nil {
+						b.Fatal(err)
+					}
+					ids[len(ids)-i-1] = info.Id
+				}
+				updated := post.Clone()
+				updated.FileIds = ids
+				post, err = th.App.Srv().Store().Post().Update(th.Context, updated, post)
+				if err != nil {
+					b.Fatal(err)
+				}
+				list.AddPost(post)
+				list.AddOrder(post.Id)
+			}
+			check := func(result *model.PostList) {
+				if len(result.Order) != tc.posts {
+					b.Fatal("incorrect history order")
+				}
+				for id, original := range list.Posts {
+					post := result.Posts[id]
+					if post == nil || post.Metadata == nil || len(post.Metadata.Files) != tc.files {
+						b.Fatal("incorrect attachment count")
+					}
+					for i, info := range post.Metadata.Files {
+						if info.Id != original.FileIds[i] || info.PostId != id || info.DeleteAt != 0 {
+							b.Fatal("incorrect attachment metadata/order")
+						}
+					}
+				}
+			}
+			for _, mode := range []string{"cold", "warm"} {
+				b.Run(mode, func(b *testing.B) {
+					check(th.App.PreparePostListForClient(th.Context, list))
+					b.ReportAllocs()
+					b.ResetTimer()
+					for range b.N {
+						if mode == "cold" {
+							b.StopTimer()
+							th.App.Srv().Store().FileInfo().ClearCaches()
+							b.StartTimer()
+						}
+						check(th.App.PreparePostListForClient(th.Context, list))
+					}
+				})
+			}
+		})
+	}
+}
