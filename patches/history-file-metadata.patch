+
+func setupFileHistoryMock(t *testing.T) (*TestHelper, *mocks.FileInfoStore) {
+	th := SetupConfigWithStoreMock(t, func(cfg *model.Config) {
+		*cfg.ServiceSettings.EnableCustomEmoji = false
+		*cfg.ServiceSettings.EnableLinkPreviews = false
+		*cfg.ServiceSettings.PostPriority = false
+	})
+	files := &mocks.FileInfoStore{}
+	th.App.Srv().Store().(*mocks.Store).On("FileInfo").Return(files)
+	return th, files
+}
+
+func TestAttachmentHistoryBatch(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(fmt.Sprintf("bulk error=%t", fail), func(t *testing.T) {
+			th, files := setupFileHistoryMock(t)
+			list := model.NewPostList()
+			all := []*model.FileInfo{}
+			expected := map[string][]string{}
+			for range 2 {
+				p := &model.Post{Id: model.NewId(), Message: "files"}
+				if len(list.Posts) == 0 {
+					p.DeleteAt = -1
+				}
+				first := &model.FileInfo{Id: model.NewId(), PostId: p.Id, Name: "first.txt", MimeType: "text/plain"}
+				second := &model.FileInfo{Id: model.NewId(), PostId: p.Id, Name: "second.txt", MimeType: "text/plain"}
+				p.FileIds = []string{second.Id, model.NewId(), first.Id, second.Id}
+				expected[p.Id] = []string{second.Id, first.Id}
+				all = append(all, first, second)
+				list.AddPost(p)
+				list.AddOrder(p.Id)
+				if fail {
+					files.On("GetByIds", []string(p.FileIds), false, true, false).Return([]*model.FileInfo{first, second}, nil).Once()
+				}
+			}
+			bulk := files.On("GetByIds", mock.MatchedBy(func(ids []string) bool { return len(ids) == 6 }), false, true, false).Once()
+			if fail {
+				bulk.Return(nil, errors.New("bulk unavailable"))
+			} else {
+				bulk.Return(all, nil)
+			}
+			result := th.App.PreparePostListForClient(th.Context, list)
+			require.Equal(t, list.Order, result.Order)
+			for id, want := range expected {
+				require.Len(t, result.Posts[id].Metadata.Files, 2)
+				for i, info := range result.Posts[id].Metadata.Files {
+					require.Equal(t, want[i], info.Id)
+					require.Equal(t, id, info.PostId)
+				}
+				require.Nil(t, list.Posts[id].Metadata)
+			}
+			files.AssertExpectations(t)
+		})
+	}
+}
+
+func TestAttachmentHistorySharedFileIsolation(t *testing.T) {
+	th, files := setupFileHistoryMock(t)
+	preview := []byte{1, 2}
+	remote := "remote"
+	info := &model.FileInfo{Id: model.NewId(), Name: "image.png", MimeType: "image/png", MiniPreview: &preview, RemoteId: &remote}
+	list := model.NewPostList()
+	for range 2 {
+		p := &model.Post{Id: model.NewId(), FileIds: []string{info.Id}}
+		list.AddPost(p)
+		list.AddOrder(p.Id)
+	}
+	files.On("GetByIds", []string{info.Id}, false, true, false).Return([]*model.FileInfo{info}, nil).Once()
+	result := th.App.PreparePostListForClient(th.Context, list)
+	first := result.Posts[list.Order[0]].Metadata.Files[0]
+	second := result.Posts[list.Order[1]].Metadata.Files[0]
+	first.Name = "changed"
+	(*first.MiniPreview)[0] = 9
+	*first.RemoteId = "changed"
+	require.Equal(t, "image.png", second.Name)
+	require.EqualValues(t, 1, (*second.MiniPreview)[0])
+	require.Equal(t, "remote", *second.RemoteId)
+	require.Equal(t, "image.png", info.Name)
+	require.EqualValues(t, 1, (*info.MiniPreview)[0])
+	require.Equal(t, "remote", *info.RemoteId)
+	files.AssertExpectations(t)
+}
+
+func TestAttachmentHistoryRetries(t *testing.T) {
+	for _, mode := range []string{"pending preview", "hidden burn", "deleted"} {
+		t.Run(mode, func(t *testing.T) {
+			th, files := setupFileHistoryMock(t)
+			list := model.NewPostList()
+			bulkFiles := []*model.FileInfo{}
+			for range 2 {
+				p := &model.Post{Id: model.NewId(), FileIds: []string{model.NewId()}, Message: "files", UserId: model.NewId()}
+				info := &model.FileInfo{Id: p.FileIds[0], PostId: p.Id, Name: "file.txt", MimeType: "text/plain"}
+				if len(list.Posts) == 0 {
+					switch mode {
+					case "pending preview":
+						info.MimeType = "image/png"
+						info.Name = "missing.png"
+						info.Path = "missing-preview-source.png"
+					case "hidden burn":
+						p.Type = model.PostTypeBurnOnRead
+					case "deleted":
+						p.DeleteAt = 1
+					}
+					files.On("GetByIds", []string(p.FileIds), false, true, false).Return([]*model.FileInfo{info}, nil).Once()
+				}
+				if p.DeleteAt == 0 {
+					bulkFiles = append(bulkFiles, info)
+				}
+				list.AddPost(p)
+				list.AddOrder(p.Id)
+			}
+			// A deleted post leaves only one eligible post, so no bulk read is used.
+			if mode == "deleted" {
+				p := list.Posts[list.Order[1]]
+				files.On("GetByIds", []string(p.FileIds), false, true, false).Return(bulkFiles, nil).Once()
+			} else {
+				files.On("GetByIds", mock.MatchedBy(func(ids []string) bool { return len(ids) == 2 }), false, true, false).Return(bulkFiles, nil).Once()
+			}
+			result := th.App.PreparePostListForClient(th.Context.WithSession(&model.Session{UserId: model.NewId()}), list)
+			if mode == "deleted" {
+				require.Empty(t, result.Posts[list.Order[0]].Message)
+			}
+			files.AssertExpectations(t)
+		})
+	}
+}
+
+func TestAttachmentHistoryBoundedReads(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(fmt.Sprintf("later batch error=%t", fail), func(t *testing.T) {
+			th, files := setupFileHistoryMock(t)
+			list := model.NewPostList()
+			ids := make([]string, postFileMetadataBatchSize+1)
+			for i := range ids {
+				ids[i] = model.NewId()
+			}
+			first := &model.Post{Id: model.NewId(), FileIds: ids[:postFileMetadataBatchSize]}
+			second := &model.Post{Id: model.NewId(), FileIds: []string{ids[postFileMetadataBatchSize], ids[0]}}
+			list.AddPost(first)
+			list.AddPost(second)
+			seen := map[string]bool{}
+			calls := 0
+			files.On("GetByIds", mock.MatchedBy(func(batch []string) bool { return len(batch) > 0 && len(batch) <= postFileMetadataBatchSize }), false, true, false).
+				Run(func(args mock.Arguments) {
+					calls++
+					for _, id := range args.Get(0).([]string) {
+						require.False(t, seen[id])
+						seen[id] = true
+					}
+				}).
+				Return(nil, func([]string, bool, bool, bool) error {
+					if fail && calls == 2 {
+						return errors.New("later batch unavailable")
+					}
+					return nil
+				}).Twice()
+			prepared := th.App.preparePostListFileMetadata(list)
+			require.Len(t, seen, len(ids))
+			if fail {
+				require.Nil(t, prepared)
+			} else {
+				require.Len(t, prepared, len(ids))
+				require.True(t, prepared[ids[0]].shared)
+			}
+			files.AssertExpectations(t)
+		})
+	}
+}
+
+func TestAttachmentHistoryContentLimit(t *testing.T) {
+	th, files := setupFileHistoryMock(t)
+	th.App.Srv().SetLicense(model.NewTestLicense("cloud"))
+	systems := &mocks.SystemStore{}
+	th.App.Srv().Store().(*mocks.Store).On("System").Return(systems)
+	systems.On("GetByName", model.SystemLastAccessibleFileTime).Return(&model.System{Name: model.SystemLastAccessibleFileTime, Value: "10"}, nil)
+	preview := []byte{1, 2}
+	raw := &model.FileInfo{Id: model.NewId(), CreateAt: 1, Name: "old.txt", MimeType: "text/plain", Path: "private/path", Content: "private content", MiniPreview: &preview}
+	list := model.NewPostList()
+	for range 2 {
+		p := &model.Post{Id: model.NewId(), FileIds: []string{raw.Id}}
+		list.AddPost(p)
+		list.AddOrder(p.Id)
+	}
+	files.On("GetByIds", []string{raw.Id}, false, true, false).Return([]*model.FileInfo{raw}, nil).Once()
+	result := th.App.PreparePostListForClient(th.Context, list)
+	for _, p := range result.Posts {
+		require.Len(t, p.Metadata.Files, 1)
+		info := p.Metadata.Files[0]
+		require.True(t, info.Archived)
+		require.Empty(t, info.Path)
+		require.Empty(t, info.Content)
+		require.Nil(t, info.MiniPreview)
+	}
+	require.False(t, raw.Archived)
+	require.Equal(t, "private/path", raw.Path)
+	require.Equal(t, "private content", raw.Content)
+	require.NotNil(t, raw.MiniPreview)
+	files.AssertExpectations(t)
+}
