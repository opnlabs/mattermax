+// BenchmarkPriorityAcknowledgementHistory validates real metadata on stored,
+// ordered pages. Priority reads are enabled; no files, reactions or links.
+func BenchmarkPriorityAcknowledgementHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableLinkPreviews = false })
+	if !th.App.IsPostPriorityEnabled() {
+		b.Fatal("priority reads must be enabled")
+	}
+	for _, density := range []string{"empty", "sparse", "dense"} {
+		b.Run(density, func(b *testing.B) {
+			for _, size := range []int{1, 60} {
+				b.Run(fmt.Sprintf("posts=%d", size), func(b *testing.B) {
+					list := model.NewPostList()
+					hasPriority := map[string]bool{}
+					for i := range size {
+						post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "query metadata"})
+						if err != nil {
+							b.Fatal(err)
+						}
+						list.AddPost(post)
+						list.AddOrder(post.Id)
+						if density == "empty" || (density == "sparse" && i%20 != 0) {
+							continue
+						}
+						_, err = th.App.Srv().Store().PostPriority().Save(&model.PostPriority{PostId: post.Id, ChannelId: post.ChannelId, Priority: new("important"), RequestedAck: new(true), PersistentNotifications: new(false)})
+						if err != nil {
+							b.Fatal(err)
+						}
+						_, err = th.App.Srv().Store().PostAcknowledgement().SaveWithModel(&model.PostAcknowledgement{PostId: post.Id, UserId: post.UserId, ChannelId: post.ChannelId, AcknowledgedAt: 1234})
+						if err != nil {
+							b.Fatal(err)
+						}
+						hasPriority[post.Id] = true
+					}
+					check := func(result *model.PostList) {
+						if len(result.Order) != size || len(result.Posts) != size {
+							b.Fatal("incorrect page size")
+						}
+						for i, id := range list.Order {
+							p := result.Posts[id]
+							if result.Order[i] != id || p == nil || p.Metadata == nil || p.Message != "query metadata" {
+								b.Fatal("incorrect ordered page")
+							}
+							if hasPriority[id] {
+								priority := p.Metadata.Priority
+								if priority == nil || priority.PostId != id || priority.ChannelId != th.BasicChannel.Id || priority.Priority == nil || *priority.Priority != "important" || priority.RequestedAck == nil || !*priority.RequestedAck || priority.PersistentNotifications == nil || *priority.PersistentNotifications {
+									b.Fatal("incorrect priority metadata")
+								}
+								acks := p.Metadata.Acknowledgements
+								if len(acks) != 1 || acks[0].PostId != id || acks[0].UserId != th.BasicUser.Id || acks[0].ChannelId != th.BasicChannel.Id || acks[0].AcknowledgedAt != 1234 {
+									b.Fatal("incorrect acknowledgement metadata")
+								}
+							} else if p.Metadata.Priority != nil || len(p.Metadata.Acknowledgements) != 0 {
+								b.Fatal("unexpected metadata")
+							}
+						}
+					}
+					check(th.App.PreparePostListForClient(th.Context, list))
+					b.ReportAllocs()
+					b.ResetTimer()
+					for range b.N {
+						check(th.App.PreparePostListForClient(th.Context, list))
+					}
+				})
+			}
+		})
+	}
+}
