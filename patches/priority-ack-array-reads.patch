+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+)
+
+func TestPriorityAcknowledgementArrayReads(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, rctx request.CTX, ss store.Store, db storetest.SqlStore) {
+		channel := model.NewId()
+		ids := make([]string, 401)
+		for i := range ids {
+			ids[i] = model.NewId()
+		}
+		priorities := map[string]*model.PostPriority{}
+		acks := map[string][]*model.PostAcknowledgement{}
+		t.Cleanup(func() {
+			_, err := db.GetMaster().Exec("DELETE FROM PostsPriority WHERE ChannelId = ?", channel)
+			require.NoError(t, err)
+			_, err = db.GetMaster().Exec("DELETE FROM PostAcknowledgements WHERE ChannelId = ?", channel)
+			require.NoError(t, err)
+		})
+		for n, position := range []int{0, 199, 200, 399, 400} {
+			id := ids[position]
+			p := &model.PostPriority{PostId: id, ChannelId: channel, Priority: new("important")}
+			if n > 0 {
+				p.RequestedAck = new(n == 1 || n == 4)
+				p.PersistentNotifications = new(n == 2 || n == 4)
+			}
+			_, err := db.GetMaster().Exec("INSERT INTO PostsPriority(PostId,ChannelId,Priority,RequestedAck,PersistentNotifications) VALUES (?,?,?,?,?)", id, channel, *p.Priority, p.RequestedAck, p.PersistentNotifications)
+			require.NoError(t, err)
+			priorities[id] = p
+			for j, timestamp := range []any{int64(10), int64(-10), int64(0), nil} {
+				user := model.NewId()
+				var remote *string
+				if j%2 != 0 {
+					remote = new("")
+				}
+				if n%2 != 0 {
+					remote = new(model.NewId())
+				}
+				_, err = db.GetMaster().Exec("INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt,RemoteId) VALUES (?,?,?,?,?)", id, user, channel, timestamp, remote)
+				require.NoError(t, err)
+				if j < 2 {
+					acks[id] = append(acks[id], &model.PostAcknowledgement{PostId: id, UserId: user, ChannelId: channel, AcknowledgedAt: timestamp.(int64), RemoteId: remote})
+				}
+			}
+		}
+		cases := []struct {
+			name string
+			ids  []string
+		}{
+			{"nil", nil}, {"empty", []string{}}, {"missing", []string{model.NewId()}},
+			{"escaped missing IDs", []string{"", "quote'id", "comma,id", `back\slash`, "{braces}"}},
+			{"one", ids[:1]}, {"199", ids[:199]}, {"200", ids[:200]}, {"201", ids[:201]}, {"400", ids[:400]}, {"401", ids},
+			{"same batch duplicates", []string{ids[0], ids[0], ids[199]}},
+			{"cross batch duplicate", append(append([]string{}, ids[:200]...), ids[0])},
+		}
+		for _, tc := range cases {
+			t.Run(tc.name, func(t *testing.T) {
+				var wantPriority []*model.PostPriority
+				var wantAcks []*model.PostAcknowledgement
+				for start := 0; start < len(tc.ids); start += 200 {
+					end := min(start+200, len(tc.ids))
+					seen := map[string]bool{}
+					for _, id := range tc.ids[start:end] {
+						if seen[id] {
+							continue
+						}
+						seen[id] = true
+						if p := priorities[id]; p != nil {
+							wantPriority = append(wantPriority, p)
+						}
+						wantAcks = append(wantAcks, acks[id]...)
+					}
+				}
+				gotPriority, err := ss.PostPriority().GetForPosts(tc.ids)
+				require.NoError(t, err)
+				require.ElementsMatch(t, wantPriority, gotPriority)
+				gotAcks, err := ss.PostAcknowledgement().GetForPosts(tc.ids)
+				require.NoError(t, err)
+				require.ElementsMatch(t, wantAcks, gotAcks)
+				if len(tc.ids) == 0 {
+					require.Nil(t, gotPriority)
+					require.Nil(t, gotAcks)
+				}
+			})
+		}
+		// A second-batch database failure must discard successful first-batch rows.
+		bad := append(append([]string{}, ids[:200]...), string([]byte{0xff}))
+		gotPriority, err := ss.PostPriority().GetForPosts(bad)
+		require.Error(t, err)
+		require.Nil(t, gotPriority)
+		gotAcks, err := ss.PostAcknowledgement().GetForPosts(bad)
+		require.Error(t, err)
+		require.Nil(t, gotAcks)
+	})
+}
+
+func BenchmarkPriorityAcknowledgementReads(b *testing.B) {
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			for _, density := range []string{"empty", "sparse", "dense"} {
+				b.Run(density, func(b *testing.B) {
+					for _, size := range []int{1, 60, 200, 201} {
+						b.Run(fmt.Sprintf("ids=%d", size), func(b *testing.B) {
+							channel := model.NewId()
+							ids := make([]string, size)
+							var wantPriority []*model.PostPriority
+							var wantAcks []*model.PostAcknowledgement
+							b.Cleanup(func() {
+								_, err := st.SqlStore.GetMaster().Exec("DELETE FROM PostsPriority WHERE ChannelId = ?", channel)
+								if err != nil {
+									b.Error(err)
+								}
+								_, err = st.SqlStore.GetMaster().Exec("DELETE FROM PostAcknowledgements WHERE ChannelId = ?", channel)
+								if err != nil {
+									b.Error(err)
+								}
+							})
+							for i := range ids {
+								ids[i] = model.NewId()
+								if density == "empty" || (density == "sparse" && i%20 != 0) {
+									continue
+								}
+								p := &model.PostPriority{PostId: ids[i], ChannelId: channel, Priority: new("important"), RequestedAck: new(true), PersistentNotifications: new(false)}
+								_, err := st.SqlStore.GetMaster().Exec("INSERT INTO PostsPriority(PostId,ChannelId,Priority,RequestedAck,PersistentNotifications) VALUES (?,?,?,?,?)", p.PostId, channel, *p.Priority, *p.RequestedAck, *p.PersistentNotifications)
+								if err != nil {
+									b.Fatal(err)
+								}
+								wantPriority = append(wantPriority, p)
+								ack := &model.PostAcknowledgement{PostId: ids[i], UserId: model.NewId(), ChannelId: channel, AcknowledgedAt: 1234, RemoteId: new(model.NewId())}
+								_, err = st.SqlStore.GetMaster().Exec("INSERT INTO PostAcknowledgements(PostId,UserId,ChannelId,AcknowledgedAt,RemoteId) VALUES (?,?,?,?,?)", ack.PostId, ack.UserId, channel, ack.AcknowledgedAt, *ack.RemoteId)
+								if err != nil {
+									b.Fatal(err)
+								}
+								wantAcks = append(wantAcks, ack)
+							}
+							ackByPost := map[string]*model.PostAcknowledgement{}
+							for _, ack := range wantAcks {
+								ackByPost[ack.PostId] = ack
+							}
+							priorityIDs := map[string]bool{}
+							for _, p := range wantPriority {
+								priorityIDs[p.PostId] = true
+							}
+							check := func() {
+								priorities, err := st.Store.PostPriority().GetForPosts(ids)
+								if err != nil || len(priorities) != len(wantPriority) {
+									b.Fatal("incorrect priority rows", err)
+								}
+								acknowledgements, err := st.Store.PostAcknowledgement().GetForPosts(ids)
+								if err != nil || len(acknowledgements) != len(wantAcks) {
+									b.Fatal("incorrect acknowledgement rows", err)
+								}
+								for _, p := range priorities {
+									if !priorityIDs[p.PostId] || p.ChannelId != channel || p.Priority == nil || *p.Priority != "important" || p.RequestedAck == nil || !*p.RequestedAck || p.PersistentNotifications == nil || *p.PersistentNotifications {
+										b.Fatal("incorrect priority metadata")
+									}
+								}
+								for _, a := range acknowledgements {
+									if !priorityIDs[a.PostId] || a.ChannelId != channel || a.AcknowledgedAt != 1234 || a.RemoteId == nil || ackByPost[a.PostId] == nil || a.UserId != ackByPost[a.PostId].UserId || *a.RemoteId != *ackByPost[a.PostId].RemoteId {
+										b.Fatal("incorrect acknowledgement metadata")
+									}
+								}
+							}
+							check()
+							b.ReportAllocs()
+							b.ResetTimer()
+							for range b.N {
+								check()
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
