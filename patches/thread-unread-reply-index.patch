+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+	"github.com/stretchr/testify/require"
+)
+
+// Compare all three callers with the retained non-null primary-key count,
+// including boundary, null, deleted and empty-root behavior.
+func TestThreadUnreadReplyCountCompatibility(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, rctx request.CTX, ss store.Store, db storetest.SqlStore) {
+		user, err := ss.User().Save(rctx, &model.User{Email: model.NewId() + "@example.com", Username: model.NewId()})
+		require.NoError(t, err)
+		channel, err := ss.Channel().Save(rctx, &model.Channel{Name: model.NewId(), DisplayName: model.NewId(), Type: model.ChannelTypeOpen}, 999)
+		require.NoError(t, err)
+		_, err = ss.Channel().SaveMember(rctx, &model.ChannelMember{ChannelId: channel.Id, UserId: user.Id, NotifyProps: model.GetDefaultChannelNotifyProps()})
+		require.NoError(t, err)
+		root, err := ss.Post().Save(rctx, &model.Post{ChannelId: channel.Id, UserId: user.Id, Message: "root", CreateAt: 100})
+		require.NoError(t, err)
+		emptyCreated := false
+		t.Cleanup(func() {
+			_, e := db.GetMaster().Exec("DELETE FROM Posts WHERE Id=? OR RootId=?", root.Id, root.Id)
+			require.NoError(t, e)
+			if emptyCreated {
+				_, e = db.GetMaster().Exec("DELETE FROM Posts WHERE Id='' ")
+				require.NoError(t, e)
+			}
+			for _, item := range []struct {
+				q   string
+				arg string
+			}{
+				{"DELETE FROM ThreadMemberships WHERE UserId=?", user.Id},
+				{"DELETE FROM Threads WHERE ChannelId=?", channel.Id},
+				{"DELETE FROM ChannelMembers WHERE ChannelId=?", channel.Id},
+				{"DELETE FROM Channels WHERE Id=?", channel.Id},
+				{"DELETE FROM Users WHERE Id=?", user.Id},
+			} {
+				_, e = db.GetMaster().Exec(item.q, item.arg)
+				require.NoError(t, e)
+			}
+		})
+		_, err = ss.Post().Save(rctx, &model.Post{ChannelId: channel.Id, UserId: user.Id, RootId: root.Id, Message: "reply", CreateAt: 200})
+		require.NoError(t, err)
+		membership, err := ss.Thread().MaintainMembership(user.Id, root.Id, store.ThreadMembershipOpts{Following: true, UpdateFollowing: true})
+		require.NoError(t, err)
+		for _, row := range []struct{ created, deleted any }{{100, 0}, {201, 0}, {202, 1}, {203, nil}, {nil, 0}, {-1, 0}} {
+			_, err = db.GetMaster().Exec("INSERT INTO Posts(Id,RootId,CreateAt,DeleteAt) VALUES (?,?,?,?)", model.NewId(), root.Id, row.created, row.deleted)
+			require.NoError(t, err)
+		}
+		legacy := func(id string, viewed int64, deleted bool) int64 {
+			t.Helper()
+			q := "SELECT COUNT(Id) FROM Posts WHERE RootId=? AND CreateAt>?"
+			if !deleted {
+				q += " AND DeleteAt=0"
+			}
+			var n int64
+			require.NoError(t, db.GetMaster().Get(&n, q, id, viewed))
+			return n
+		}
+		for _, viewed := range []int64{-2, 0, 100, 200, 1000} {
+			membership.LastViewed = viewed
+			_, err = ss.Thread().UpdateMembership(membership)
+			require.NoError(t, err)
+			n, err := ss.Thread().GetThreadUnreadReplyCount(membership)
+			require.NoError(t, err)
+			require.Equal(t, legacy(root.Id, viewed, false), n)
+			thread, err := ss.Thread().GetThreadForUser(rctx, membership, false, false)
+			require.NoError(t, err)
+			require.Equal(t, n, thread.UnreadReplies)
+			for _, deleted := range []bool{false, true} {
+				threads, err := ss.Thread().GetThreadsForUser(rctx, user.Id, "", model.GetUserThreadsOpts{Deleted: deleted})
+				require.NoError(t, err)
+				require.Len(t, threads, 1)
+				require.Equal(t, root.Id, threads[0].Post.Id)
+				require.Equal(t, legacy(root.Id, viewed, deleted), threads[0].UnreadReplies)
+			}
+		}
+		for _, id := range []string{model.NewId(), ""} {
+			m := &model.ThreadMembership{PostId: id, UserId: user.Id, Following: true}
+			n, err := ss.Thread().GetThreadUnreadReplyCount(m)
+			require.NoError(t, err)
+			require.Equal(t, legacy(id, 0, false), n)
+		}
+		// A stored empty-ID root exercises the correlated fallback as well.
+		_, err = db.GetMaster().Exec("INSERT INTO Posts (Id,RootId,ChannelId,UserId,CreateAt,UpdateAt,DeleteAt,Message,Type,Props,Hashtags,Filenames,FileIds,RemoteId) VALUES ('','',?,?,100,100,0,'empty root','','{}','','[]','[]','')", channel.Id, user.Id)
+		require.NoError(t, err)
+		emptyCreated = true
+		_, err = db.GetMaster().Exec("INSERT INTO Threads(PostId,ChannelId,ReplyCount,LastReplyAt,Participants,ThreadTeamId) VALUES ('',?,0,200,?,'')", channel.Id, model.StringArray{user.Id})
+		require.NoError(t, err)
+		_, err = db.GetMaster().Exec("INSERT INTO ThreadMemberships(PostId,UserId,Following,LastViewed,LastUpdated,UnreadMentions) VALUES ('',?,true,0,0,0)", user.Id)
+		require.NoError(t, err)
+		threads, err := ss.Thread().GetThreadsForUser(rctx, user.Id, "", model.GetUserThreadsOpts{})
+		require.NoError(t, err)
+		require.Len(t, threads, 2)
+		found := false
+		for _, thread := range threads {
+			if thread.PostId == "" {
+				found = true
+				require.Equal(t, legacy("", 0, false), thread.UnreadReplies)
+			}
+		}
+		require.True(t, found)
+
+	})
+}
+
+func TestMigration000244(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, _ request.CTX, _ store.Store, db storetest.SqlStore) {
+		check := func(old, new bool) {
+			t.Helper()
+			for name, wanted := range map[string]bool{"idx_posts_root_id_delete_at": old, "idx_posts_root_id_delete_at_create_at": new} {
+				var present bool
+				require.NoError(t, db.GetMaster().Get(&present, "SELECT EXISTS (SELECT 1 FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid WHERE c.relname=? AND c.relnamespace=current_schema()::regnamespace AND i.indisready AND i.indisvalid)", name))
+				require.Equal(t, wanted, present, name)
+			}
+		}
+		// Each concurrent statement has its own nontransactional migration.
+		// Upgrade builds the replacement before removing the old index;
+		// downgrade restores the old index before removing the replacement.
+		check(false, true)
+		for _, step := range []struct {
+			file     string
+			old, new bool
+		}{
+			{"000245_replace_posts_root_delete_index.down.sql", true, true},
+			{"000244_posts_root_delete_create_at.down.sql", true, false},
+			{"000244_posts_root_delete_create_at.up.sql", true, true},
+			{"000245_replace_posts_root_delete_index.up.sql", false, true},
+		} {
+			_, err := db.GetMaster().Exec(readMigrationSQL(t, step.file))
+			require.NoError(t, err)
+			check(step.old, step.new)
+		}
+	})
+}
