diff --git a/server/channels/store/sqlstore/thread_unread_reply_benchmark_test.go b/server/channels/store/sqlstore/thread_unread_reply_benchmark_test.go
new file mode 100644
index 000000000000..d36742ed29cc
--- /dev/null
+++ b/server/channels/store/sqlstore/thread_unread_reply_benchmark_test.go
@@ -0,0 +1,177 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/lib/pq"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+// BenchmarkThreadUnreadReplies validates counts and complete page identity on
+// fresh, interleaved reply rows. Setup, index changes and cleanup are untimed.
+func BenchmarkThreadUnreadReplies(b *testing.B) {
+	if len(storeTypes) == 0 {
+		b.Fatal("PostgreSQL store required")
+	}
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			before := os.Getenv("MATTERMAX_UNREAD_INDEX_VARIANT") == "before"
+			if before {
+				if _, err := st.SqlStore.GetMaster().ExecNoTimeout("DROP INDEX IF EXISTS idx_posts_root_id_delete_at_create_at"); err != nil {
+					b.Fatal(err)
+				}
+
+				if _, err := st.SqlStore.GetMaster().ExecNoTimeout("CREATE INDEX IF NOT EXISTS idx_posts_root_id_delete_at ON Posts(RootId,DeleteAt)"); err != nil {
+					b.Fatal(err)
+				}
+			}
+			var present bool
+			if err := st.SqlStore.GetMaster().Get(&present, "SELECT to_regclass('idx_posts_root_id_delete_at_create_at') IS NOT NULL"); err != nil {
+				b.Fatal(err)
+			}
+			if present == before {
+				b.Fatal("unexpected index state")
+			}
+			for _, replies := range []int{0, 100, 1000} {
+				b.Run(fmt.Sprintf("replies=%d", replies), func(b *testing.B) {
+					rctx := request.TestContext(b)
+					user := model.NewId()
+					channel, err := st.Store.Channel().Save(rctx, &model.Channel{Name: model.NewId(), DisplayName: "Unread benchmark", Type: model.ChannelTypeOpen}, 999)
+					if err != nil {
+						b.Fatal(err)
+					}
+					if _, err = st.Store.Channel().SaveMember(rctx, &model.ChannelMember{ChannelId: channel.Id, UserId: user, NotifyProps: model.GetDefaultChannelNotifyProps()}); err != nil {
+						b.Fatal(err)
+					}
+					const base = int64(1000000)
+					roots := make([]*model.Post, 30)
+					for i := range roots {
+						roots[i] = &model.Post{ChannelId: channel.Id, UserId: user, CreateAt: base, Message: strings.Repeat("root message ", 100)}
+					}
+					if _, _, err = st.Store.Post().SaveMultiple(rctx, roots); err != nil {
+						b.Fatal(err)
+					}
+					ids := make(model.StringArray, len(roots))
+					indices := make(map[string]uint, len(roots))
+					for i, p := range roots {
+						ids[i] = p.Id
+						indices[p.Id] = uint(i)
+					}
+					if _, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Threads(PostId,ChannelId,ReplyCount,LastReplyAt,Participants,ThreadTeamId)
+                        SELECT id,?,?,?,? ,'' FROM unnest(?::varchar[]) id`, channel.Id, replies, base+int64(replies), model.StringArray{user}, pq.Array([]string(ids))); err != nil {
+						b.Fatal(err)
+					}
+					if _, err = st.SqlStore.GetMaster().Exec(`INSERT INTO ThreadMemberships(PostId,UserId,Following,LastViewed,LastUpdated,UnreadMentions)
+                        SELECT id,?,true,0,0,0 FROM unnest(?::varchar[]) id`, user, pq.Array([]string(ids))); err != nil {
+						b.Fatal(err)
+					}
+					if replies > 0 {
+						// n is the outer input so replies from different roots
+						// share heap pages, rather than forming contiguous runs.
+						if _, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Posts(Id,RootId,ChannelId,UserId,CreateAt,UpdateAt,DeleteAt,Message,Type,Props,Hashtags,Filenames,FileIds,RemoteId)
+                            SELECT substr(md5(id||n::text),1,26),id,?,?,?::bigint+n,?::bigint+n,CASE WHEN n%7=0 THEN 1 ELSE 0 END,repeat('reply ',100),'','{}','','[]','[]',''
+                            FROM generate_series(1,?) n CROSS JOIN unnest(?::varchar[]) id ORDER BY n,id`, channel.Id, user, base, base, replies, pq.Array([]string(ids))); err != nil {
+							b.Fatal(err)
+						}
+					}
+					// Analyze leaves freshly inserted pages non-all-visible.
+					if _, err = st.SqlStore.GetMaster().ExecNoTimeout("ANALYZE Posts"); err != nil {
+						b.Fatal(err)
+					}
+					b.Cleanup(func() {
+						for _, q := range []string{"DELETE FROM Posts WHERE ChannelId=?", "DELETE FROM ThreadMemberships WHERE UserId=?", "DELETE FROM Threads WHERE ChannelId=?", "DELETE FROM ChannelMembers WHERE ChannelId=?", "DELETE FROM Channels WHERE Id=?"} {
+							arg := channel.Id
+							if strings.Contains(q, "UserId") {
+								arg = user
+							}
+							if _, err := st.SqlStore.GetMaster().Exec(q, arg); err != nil {
+								b.Error(err)
+							}
+						}
+					})
+					for _, read := range []string{"mostly_read", "all_read"} {
+						viewed := base + int64(replies*9/10)
+						if read == "all_read" {
+							viewed = base + int64(replies)
+						}
+						var expected int64
+						for n := 1; n <= replies; n++ {
+							if base+int64(n) > viewed && n%7 != 0 {
+								expected++
+							}
+						}
+						if _, err = st.SqlStore.GetMaster().Exec("UPDATE ThreadMemberships SET LastViewed=? WHERE UserId=?", viewed, user); err != nil {
+							b.Fatal(err)
+						}
+						membership := &model.ThreadMembership{PostId: roots[0].Id, UserId: user, Following: true, LastViewed: viewed}
+						for _, method := range []string{"count", "single", "page", "totals_control", "reply_total_control"} {
+							b.Run(read+"/"+method, func(b *testing.B) {
+								lookup := func() {
+									switch method {
+									case "count":
+										n, err := st.Store.Thread().GetThreadUnreadReplyCount(membership)
+										if err != nil || n != expected {
+											b.Fatalf("count=%d want=%d err=%v", n, expected, err)
+										}
+									case "single":
+										thread, err := st.Store.Thread().GetThreadForUser(rctx, membership, false, false)
+										if err != nil {
+											b.Fatal(err)
+										}
+										if thread.Post.Id != roots[0].Id || thread.Post.Message != roots[0].Message || thread.UnreadReplies != expected {
+											b.Fatal("incorrect single response")
+										}
+									case "page":
+										threads, err := st.Store.Thread().GetThreadsForUser(rctx, user, "", model.GetUserThreadsOpts{PageSize: 30})
+										if err != nil {
+											b.Fatal(err)
+										}
+										if len(threads) != len(roots) {
+											b.Fatal("incorrect page size")
+										}
+										var seen uint32
+										for _, thread := range threads {
+											i, ok := indices[thread.Post.Id]
+											if !ok || seen&(1<<i) != 0 || thread.UnreadReplies != expected || thread.Post.Message != roots[0].Message {
+												b.Fatal("incorrect page data")
+											}
+											seen |= 1 << i
+										}
+
+									case "reply_total_control":
+										post, err := st.Store.Post().GetSingle(rctx, roots[0].Id, false)
+										if err != nil {
+											b.Fatal(err)
+										}
+										if post.Id != roots[0].Id || post.ReplyCount != int64(replies-replies/7) {
+											b.Fatal("incorrect reply-count control")
+										}
+									case "totals_control":
+										n, err := st.Store.Thread().GetTotalThreads(user, "", model.GetUserThreadsOpts{})
+										if err != nil || n != int64(len(roots)) {
+											b.Fatalf("total=%d err=%v", n, err)
+										}
+									}
+								}
+								lookup()
+								b.ReportAllocs()
+								b.ResetTimer()
+								for i := 0; i < b.N; i++ {
+									lookup()
+								}
+							})
+						}
+					}
+				})
+			}
+		})
+	}
+}
