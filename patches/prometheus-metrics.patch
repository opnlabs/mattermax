+type scrapeResult struct {
+	status int
+	body   string
+}
+
+func scrapeURL(client *http.Client, url string) (scrapeResult, error) {
+	resp, err := client.Get(url)
+	if err != nil {
+		return scrapeResult{}, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	return scrapeResult{status: resp.StatusCode, body: string(body)}, err
+}
+
+func parseExposition(body string) (map[string]*dto.MetricFamily, error) {
+	parser := expfmt.NewTextParser(prommodel.LegacyValidation)
+	return parser.TextToMetricFamilies(strings.NewReader(body))
+}
+
+func storeTimeCount(tb testing.TB, body, method string) uint64 {
+	families, err := parseExposition(body)
+	require.NoError(tb, err)
+	var count uint64
+	for _, metric := range families["mattermost_db_store_time"].GetMetric() {
+		labels := map[string]string{}
+		for _, l := range metric.Label {
+			labels[l.GetName()] = l.GetValue()
+		}
+		if labels["method"] == method && labels["success"] == "true" {
+			count += metric.GetHistogram().GetSampleCount()
+		}
+	}
+	return count
+}
