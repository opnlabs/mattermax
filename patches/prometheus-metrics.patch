+	globalThreadsLoad      *prometheus.HistogramVec
+	mobileLoad             *prometheus.HistogramVec
+	mobileChannelSwitch    *prometheus.HistogramVec
+	mobileTeamSwitch       *prometheus.HistogramVec
+}
+
+func newClientMetrics(f promauto.Factory) clientMetrics {
+	histogram := func(subsystem, name, help string, buckets []float64, labels ...string) *prometheus.HistogramVec {
+		return f.NewHistogramVec(prometheus.HistogramOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help, Buckets: buckets}, labels)
+	}
+	web := func(name, help string, labels ...string) *prometheus.HistogramVec {
+		return histogram("webapp", name, help, clientBuckets, append([]string{"platform", "agent"}, labels...)...)
+	}
+	mobile := func(name, help string) *prometheus.HistogramVec {
+		return histogram("mobileapp", name, help, clientBuckets, "platform")
+	}
+
+	return clientMetrics{
+		longTasks:              f.NewCounterVec(prometheus.CounterOpts{Namespace: metricsNamespace, Subsystem: "webapp", Name: "long_tasks", Help: "Total number of long tasks reported by web clients."}, []string{"platform", "agent"}),
+		timeToFirstByte:        web("time_to_first_byte", "Time to first byte reported by web clients, in seconds."),
+		timeToLastByte:         web("time_to_last_byte", "Time to last byte reported by web clients, in seconds."),
+		domInteractive:         web("dom_interactive", "Time until the DOM is interactive reported by web clients, in seconds."),
+		splashScreen:           web("splash_screen", "Time until the splash screen ends reported by web clients, in seconds.", "page_type"),
+		firstContentfulPaint:   web("first_contentful_paint", "First contentful paint reported by web clients, in seconds."),
+		largestContentfulPaint: web("largest_contentful_paint", "Largest contentful paint reported by web clients, in seconds.", "region"),
+		interactionToNextPaint: web("interaction_to_next_paint", "Interaction to next paint reported by web clients, in seconds.", "interaction"),
+		cumulativeLayoutShift:  histogram("webapp", "cumulative_layout_shift", "Cumulative layout shift score reported by web clients.", layoutShiftBuckets, "platform", "agent"),
+		pageLoad:               web("page_load", "Page load time reported by web clients, in seconds."),
+		channelSwitch:          web("channel_switch", "Channel switch time reported by web clients, in seconds.", "fresh"),
+		teamSwitch:             web("team_switch", "Team switch time reported by web clients, in seconds.", "fresh"),
+		rhsLoad:                web("rhs_load", "Right-hand sidebar load time reported by web clients, in seconds."),
+		globalThreadsLoad:      web("global_threads_load", "Threads view load time reported by web clients, in seconds."),
+		mobileLoad:             mobile("mobile_load", "App load time reported by mobile clients, in seconds."),
+		mobileChannelSwitch:    mobile("mobile_channel_switch", "Channel switch time reported by mobile clients, in seconds."),
+		mobileTeamSwitch:       mobile("mobile_team_switch", "Team switch time reported by mobile clients, in seconds."),
+	}
+}
+
+func (m *prometheusMetrics) observeClient(h *prometheus.HistogramVec, limit, value float64, labels ...string) {
+	if m.enabled.Load() && value >= 0 && value <= limit {
+		h.WithLabelValues(labels...).Observe(value)
+	}
+}
+
+func (m *prometheusMetrics) IncrementClientLongTasks(platform, agent, _ string, inc float64) {
+	if m.enabled.Load() && inc >= 0 && inc <= maxClientLongTasks && inc == math.Trunc(inc) {
+		m.client.longTasks.WithLabelValues(platform, agent).Add(inc)
+	}
+}
