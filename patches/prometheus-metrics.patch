+func TestPrometheusMetricsNotifications(t *testing.T) {
+	th := setupPrometheusMetrics(t, func(cfg *model.Config) {
+		*cfg.MetricsSettings.EnableNotificationMetrics = true
+	})
+
+	client2 := th.CreateClient()
+	th.LoginBasic2WithClient(t, client2)
+	conn := dialPostedAckWebSocket(t, th, client2)
+	dm := th.CreateDmChannel(t, th.BasicUser2)
+	websocketSent := map[string]string{"type": string(model.NotificationTypeWebsocket), "platform": model.NotificationNoPlatform}
+
+	sendAndAck := func(seq int) {
+		post, _, err := th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: dm.Id, Message: "notify"})
+		require.NoError(t, err)
+		require.NoError(t, conn.WriteJSON(model.WebSocketRequest{Seq: int64(seq), Action: string(model.WebsocketPostedNotifyAck), Data: map[string]any{"post_id": post.Id}}))
+	}
+
+	sendAndAck(1)
+	require.Eventually(t, func() bool {
+		return metricValue(t, th, "mattermost_notifications_total", websocketSent) >= 1 &&
+			metricValue(t, th, "mattermost_notifications_total_ack", websocketSent) >= 1
+	}, 10*time.Second, 100*time.Millisecond)
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.EnableNotificationMetrics = false })
+	sent := metricValue(t, th, "mattermost_notifications_total", websocketSent)
+	acked := metricValue(t, th, "mattermost_notifications_total_ack", websocketSent)
+	sendAndAck(2)
+	time.Sleep(time.Second)
+	assert.Equal(t, sent, metricValue(t, th, "mattermost_notifications_total", websocketSent))
+	assert.Equal(t, acked, metricValue(t, th, "mattermost_notifications_total_ack", websocketSent))
+
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.MetricsSettings.EnableNotificationMetrics = true
+		*cfg.EmailSettings.SendPushNotifications = true
+		*cfg.EmailSettings.PushNotificationServer = "http://127.0.0.1:1"
+	})
+	mobile := th.CreateClient()
+	_, _, err := mobile.LoginWithDevice(th.Context.Context(), th.BasicUser2.Email, th.BasicUser2.Password, model.PushNotifyAppleReactNative+":"+model.NewId())
+	require.NoError(t, err)
+	ack, err := json.Marshal(model.PushNotificationAck{Id: model.NewId(), ClientPlatform: "ios", NotificationType: model.PushTypeMessage, ClientReceivedAt: model.GetMillis()})
+	require.NoError(t, err)
+	resp, _ := mobile.DoAPIPost(th.Context.Context(), "/notifications/ack", string(ack))
+	require.NotNil(t, resp)
+	assert.Equal(t, 1.0, metricValue(t, th, "mattermost_notifications_total_ack", map[string]string{"type": string(model.NotificationTypePush), "platform": "ios"}))
+}
