+func TestPrometheusMetricsFailedBind(t *testing.T) {
+	th := setupPrometheusMetrics(t, nil)
+
+	held, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer held.Close()
+
+	th.LoginBasic(t)
+	_, _, err = th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "before"})
+	require.NoError(t, err)
+	posts := metricValue(t, th, "mattermost_post_total", nil)
+	require.Positive(t, posts)
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.ListenAddress = held.Addr().String() })
+	require.NoError(t, th.TestLogger.Flush())
+	assert.Contains(t, th.LogBuffer.String(), "Failed to reset metrics")
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = false })
+	before := recordedValues(t, th, "mattermost_")
+	_, _, err = th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "while disabled"})
+	require.NoError(t, err)
+	_, err = th.Client.SubmitClientMetrics(th.Context.Context(), pageLoadReport(1000))
+	require.NoError(t, err)
+	time.Sleep(500 * time.Millisecond)
+	assert.Equal(t, before, recordedValues(t, th, "mattermost_"))
+
+	free, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	addr := free.Addr().String()
+	require.NoError(t, free.Close())
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.MetricsSettings.ListenAddress = addr
+		*cfg.MetricsSettings.Enable = true
+	})
+
+	resp, err := http.Get("http://" + addr + "/metrics")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	assert.Contains(t, string(body), fmt.Sprintf("mattermost_post_total %v", posts))
+
+	_, _, err = th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "after"})
+	require.NoError(t, err)
+	assert.Equal(t, posts+1, metricValue(t, th, "mattermost_post_total", nil))
+}
