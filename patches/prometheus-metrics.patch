+func setupPrometheusMetrics(t *testing.T, updateConfig func(*model.Config)) *TestHelper {
+	platform.RegisterMetricsInterface(platform.NewPrometheusMetrics)
+	t.Cleanup(func() { platform.RegisterMetricsInterface(platform.NewPrometheusMetrics) })
+
+	th := SetupWithServerOptions(t, []app.Option{app.StartMetrics}).InitBasic(t)
+	require.Nil(t, th.App.Srv().License())
+
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.MetricsSettings.ListenAddress = "localhost:0"
+		*cfg.MetricsSettings.EnableClientMetrics = true
+		if updateConfig != nil {
+			updateConfig(cfg)
+		}
+		*cfg.MetricsSettings.Enable = true
+	})
+	return th
+}
+
+func scrapeMetricsRouter(t *testing.T, th *TestHelper) string {
+	router := th.Server.Platform().GetMetricsRouter()
+	require.NotNil(t, router)
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+	require.Equal(t, http.StatusOK, rec.Code)
+	return rec.Body.String()
+}
+
+func parseMetrics(t *testing.T, body string) map[string]*dto.MetricFamily {
+	parser := expfmt.NewTextParser(prommodel.LegacyValidation)
+	families, err := parser.TextToMetricFamilies(strings.NewReader(body))
+	require.NoError(t, err)
+	return families
+}
+
+func metricLabels(metric *dto.Metric) map[string]string {
+	labels := map[string]string{}
+	for _, l := range metric.Label {
+		labels[l.GetName()] = l.GetValue()
+	}
+	return labels
+}
+
+func metricValue(t *testing.T, th *TestHelper, family string, match map[string]string) float64 {
+	var total float64
+	for _, metric := range parseMetrics(t, scrapeMetricsRouter(t, th))[family].GetMetric() {
+		labels := metricLabels(metric)
+		matches := true
+		for k, v := range match {
+			matches = matches && labels[k] == v
+		}
+		if !matches {
+			continue
+		}
+		switch {
+		case metric.Counter != nil:
+			total += metric.GetCounter().GetValue()
+		case metric.Histogram != nil:
+			total += float64(metric.GetHistogram().GetSampleCount())
+		case metric.Gauge != nil:
+			total += metric.GetGauge().GetValue()
+		}
+	}
+	return total
+}
+
+func recordedValues(t *testing.T, th *TestHelper, prefixes ...string) map[string]float64 {
+	values := map[string]float64{}
+	for name, family := range parseMetrics(t, scrapeMetricsRouter(t, th)) {
+		if strings.HasPrefix(name, "mattermost_process_") || !slices.ContainsFunc(prefixes, func(p string) bool { return strings.HasPrefix(name, p) }) {
+			continue
+		}
+		for _, metric := range family.Metric {
+			key := name + fmt.Sprint(metricLabels(metric))
+			switch {
+			case metric.Counter != nil:
+				values[key] = metric.GetCounter().GetValue()
+			case metric.Histogram != nil:
+				values[key+"_count"] = float64(metric.GetHistogram().GetSampleCount())
+				values[key+"_sum"] = metric.GetHistogram().GetSampleSum()
+			}
+		}
+	}
+	return values
+}
+
+func performanceReport(counters, histograms []*model.MetricSample) *model.PerformanceReport {
+	now := time.Now()
+	return &model.PerformanceReport{
+		Version:    "0.1.0",
+		Labels:     map[string]string{"platform": "linux", "agent": "chrome"},
+		Start:      float64(now.Add(-time.Minute).UnixMilli()),
+		End:        float64(now.UnixMilli()),
+		Counters:   counters,
+		Histograms: histograms,
+	}
+}
+
+func pageLoadReport(ms float64) *model.PerformanceReport {
+	return performanceReport(nil, []*model.MetricSample{{Metric: model.ClientPageLoadDuration, Value: ms}})
+}
