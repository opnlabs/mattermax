+}
+
+func (m *prometheusMetrics) DecrementWebSocketBroadcastUsersRegistered(hub string, amount float64) {
+	m.websocketUsersRegistered.WithLabelValues(hub).Sub(amount)
+}
+
+func disconnectCodeLabel(code string) string {
+	n, err := strconv.Atoi(code)
+	if err != nil || !((n >= 1000 && n <= 1016) || n == 4000 || n == 4001) {
+		return ""
+	}
+	return strconv.Itoa(n)
+}
+
+func (m *prometheusMetrics) IncrementWebsocketReconnectEventWithDisconnectErrCode(eventType string, disconnectErrCode string) {
+	if m.enabled.Load() {
+		m.websocketReconnects.WithLabelValues(eventType, disconnectCodeLabel(disconnectErrCode)).Inc()
+	}
+}
