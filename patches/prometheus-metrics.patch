+func TestPrometheusMetricsServer(t *testing.T) {
+	logs := &mlog.Buffer{}
+	logger, err := mlog.NewLogger()
+	require.NoError(t, err)
+	require.NoError(t, mlog.AddWriterTarget(logger, logs, true, mlog.LvlWarn))
+	logger.LockConfiguration()
+
+	th := Setup(t, StartMetrics(), SetLogger(logger))
+	defer th.Shutdown(t)
+	client := &http.Client{Timeout: 10 * time.Second}
+
+	addr := th.Service.metrics.listenAddr
+	res, err := scrapeURL(client, "http://"+addr+"/metrics")
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, res.status)
+	for _, want := range []string{"go_goroutines", "mattermost_process_open_fds", `go_sql_open_connections{db_name="master"}`, "mattermost_system_server_start_time"} {
+		assert.Contains(t, res.body, want)
+	}
+	before := storeTimeCount(t, res.body, "UserStore.Save")
+
+	th.CreateUserOrGuest(t, false)
+
+	res, err = scrapeURL(client, "http://"+addr+"/metrics")
+	require.NoError(t, err)
+	assert.GreaterOrEqual(t, storeTimeCount(t, res.body, "UserStore.Save"), before+1)
+
+	th.Service.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = false })
+	_, err = scrapeURL(client, "http://"+addr+"/metrics")
+	require.Error(t, err)
+
+	th.Service.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = true })
+	res, err = scrapeURL(client, "http://"+th.Service.metrics.listenAddr+"/metrics")
+	require.NoError(t, err)
+	assert.Equal(t, http.StatusOK, res.status)
+	assert.Contains(t, res.body, "mattermost_db_store_time")
+
+	const warning = "listens on every network interface"
+	require.NoError(t, logger.Flush())
+	assert.NotContains(t, logs.String(), warning)
+
+	th.Service.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.ListenAddress = ":0" })
+	require.NoError(t, logger.Flush())
+	assert.Equal(t, 1, strings.Count(logs.String(), warning))
+}
