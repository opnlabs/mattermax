+}
+
+func (m *prometheusMetrics) ObserveStoreMethodDuration(method, success string, elapsed float64) {
+	if m.enabled.Load() {
+		m.storeTime.WithLabelValues(method, success).Observe(elapsed)
+	}
+}
+
+func (m *prometheusMetrics) ObserveEnabledUsers(users int64) {
+	if m.enabled.Load() {
+		m.activeUsers.Set(float64(users))
+	}
+}
+
+func (m *prometheusMetrics) IncrementJobActive(jobType string) {
+	m.jobsActive.WithLabelValues(jobType).Inc()
+}
