+func dialPostedAckWebSocket(t *testing.T, th *TestHelper, client *model.Client4) *websocket.Conn {
+	url := fmt.Sprintf("ws://localhost:%d%s/websocket?posted_ack=true", th.App.Srv().ListenAddr.Port, model.APIURLSuffix)
+	conn, _, err := websocket.DefaultDialer.Dial(url, http.Header{"Authorization": []string{"Bearer " + client.AuthToken}})
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	go func() {
+		for {
+			if _, _, err := conn.ReadMessage(); err != nil {
+				return
+			}
+		}
+	}()
+	return conn
+}
