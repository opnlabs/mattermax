+	}
+}
+
+func httpMethodLabel(method string) string {
+	switch method {
+	case http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodHead, http.MethodOptions:
+		return method
+	}
+	return "other"
+}
+
+func (m *prometheusMetrics) ObserveAPIEndpointDuration(endpoint, method, statusCode, originClient, pageLoadContext string, elapsed float64) {
+	if m.enabled.Load() {
+		m.apiTime.WithLabelValues(endpoint, httpMethodLabel(method), statusCode, originClient, pageLoadContext).Observe(elapsed)
+	}
+}
+
+func (m *prometheusMetrics) IncrementEtagHitCounter(route string) {
+	if m.enabled.Load() {
+		m.etagHits.WithLabelValues(route).Inc()
+	}
+}
+
+func (m *prometheusMetrics) IncrementEtagMissCounter(route string) {
+	if m.enabled.Load() {
+		m.etagMisses.WithLabelValues(route).Inc()
+	}
+}
+
+func (m *prometheusMetrics) IncrementHTTPWebSockets(originClient string) {
+	m.httpWebSockets.WithLabelValues(originClient).Inc()
+}
+
+func (m *prometheusMetrics) DecrementHTTPWebSockets(originClient string) {
+	m.httpWebSockets.WithLabelValues(originClient).Dec()
+}
+
+func websocketEventLabel(eventType model.WebsocketEventType) string {
+	s := string(eventType)
+	if strings.HasPrefix(s, websocketMessagePluginPrefix) {
+		return "custom"
+	}
+	if s == "" || len(s) > 64 {
+		return "other"
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c < 'a' || c > 'z') && (c < '0' || c > '9') && c != '_' {
+			return "other"
+		}
+	}
+	return s
+}
+
+func (m *prometheusMetrics) IncrementWebsocketEvent(eventType model.WebsocketEventType) {
+	if m.enabled.Load() {
+		m.websocketEvents.WithLabelValues(websocketEventLabel(eventType)).Inc()
+	}
+}
+
+func (m *prometheusMetrics) IncrementWebSocketBroadcast(eventType model.WebsocketEventType) {
+	if m.enabled.Load() {
+		m.websocketBroadcasts.WithLabelValues(websocketEventLabel(eventType)).Inc()
+	}
+}
