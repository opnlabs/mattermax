+func TestPrometheusMetricsPluginAggregation(t *testing.T) {
+	platform.RegisterMetricsInterface(platform.NewPrometheusMetrics)
+	th := SetupWithServerOptions(t, []app.Option{app.StartMetrics})
+	th.ConfigStore.SetReadOnlyFF(false)
+	defer th.ConfigStore.SetReadOnlyFF(true)
+	th.App.UpdateConfig(func(cfg *model.Config) {
+		*cfg.PluginSettings.Enable = true
+		cfg.FeatureFlags.AggregatePluginMetrics = true
+		*cfg.MetricsSettings.ListenAddress = "localhost:0"
+		*cfg.MetricsSettings.Enable = true
+	})
+
+	pluginID := "com.mattermax.metrics_aggregation_test"
+	pluginDir, err := filepath.Abs(*th.App.Config().PluginSettings.Directory)
+	require.NoError(t, err)
+	require.NoError(t, os.MkdirAll(filepath.Join(pluginDir, pluginID), 0700))
+	utils.CompileGo(t, `
+package main
+
+import (
+	"net/http"
+	"sync/atomic"
+
+	"github.com/mattermost/mattermost/server/public/plugin"
+)
+
+type MetricsPlugin struct {
+	plugin.MattermostPlugin
+	calls atomic.Int64
+}
+
+func (p *MetricsPlugin) ServeMetrics(_ *plugin.Context, w http.ResponseWriter, _ *http.Request) {
+	switch p.calls.Add(1) {
+	case 1:
+		w.Write([]byte("# TYPE metrics_plugin_requests_total counter\nmetrics_plugin_requests_total 7\n"))
+	case 2:
+		w.Write([]byte("this is { not metrics\n"))
+	default:
+		w.Write([]byte("# TYPE go_goroutines gauge\ngo_goroutines 5\n"))
+	}
+}
+
+func main() {
+	plugin.ClientMain(&MetricsPlugin{})
+}
+`, filepath.Join(pluginDir, pluginID, "backend.exe"))
+	require.NoError(t, os.WriteFile(filepath.Join(pluginDir, pluginID, "plugin.json"), []byte(`{"id": "`+pluginID+`", "server": {"executable": "backend.exe"}}`), 0600))
+	_, activated, err := th.App.GetPluginsEnvironment().Activate(pluginID)
+	require.NoError(t, err)
+	require.True(t, activated)
+
+	parser := expfmt.NewTextParser(prommodel.LegacyValidation)
+
+	valid := scrapeMetricsRouter(t, th)
+	families, err := parser.TextToMetricFamilies(strings.NewReader(valid))
+	require.NoError(t, err)
+	require.Contains(t, families, "metrics_plugin_requests_total")
+	assert.Equal(t, map[string]string{"plugin_id": pluginID}, metricLabels(families["metrics_plugin_requests_total"].Metric[0]))
+	assert.Contains(t, families, "mattermost_http_requests_total")
+
+	malformed := scrapeMetricsRouter(t, th)
+	families, err = parser.TextToMetricFamilies(strings.NewReader(malformed))
+	require.NoError(t, err)
+	assert.NotContains(t, families, "metrics_plugin_requests_total")
+	assert.Contains(t, families, "mattermost_http_requests_total")
+	assert.Contains(t, families, "go_goroutines")
+
+	colliding := scrapeMetricsRouter(t, th)
+	assert.Equal(t, 2, strings.Count(colliding, "# TYPE go_goroutines gauge"))
+	_, err = parser.TextToMetricFamilies(strings.NewReader(colliding))
+	assert.Error(t, err)
+}
