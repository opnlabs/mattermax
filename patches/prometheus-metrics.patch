+func TestPrometheusMetricsHostileValues(t *testing.T) {
+	th := setupPrometheusMetrics(t, nil)
+	clientFamilies := []string{"mattermost_webapp_", "mattermost_mobileapp_"}
+
+	rejected := map[string]*model.PerformanceReport{
+		"long tasks -1":       performanceReport([]*model.MetricSample{{Metric: model.ClientLongTasks, Value: -1}}, nil),
+		"long tasks 2.5":      performanceReport([]*model.MetricSample{{Metric: model.ClientLongTasks, Value: 2.5}}, nil),
+		"long tasks 1e9":      performanceReport([]*model.MetricSample{{Metric: model.ClientLongTasks, Value: 1e9}}, nil),
+		"page load -5":        pageLoadReport(-5),
+		"page load 1e308":     pageLoadReport(1e308),
+		"layout shift 1e6":    performanceReport(nil, []*model.MetricSample{{Metric: model.ClientCumulativeLayoutShift, Value: 1e6}}),
+		"mobile load 1e12 ms": performanceReport(nil, []*model.MetricSample{{Metric: model.MobileClientLoadDuration, Value: 1e12}}),
+	}
+	for name, report := range rejected {
+		t.Run(name, func(t *testing.T) {
+			before := recordedValues(t, th, clientFamilies...)
+			resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), report)
+			require.NoError(t, err)
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+			assert.Equal(t, before, recordedValues(t, th, clientFamilies...))
+		})
+	}
+
+	invalid := map[string]string{
+		"null counter":   `{"version":"0.1.0","start":%[1]d,"end":%[1]d,"counters":[null]}`,
+		"null histogram": `{"version":"0.1.0","start":%[1]d,"end":%[1]d,"histograms":[null]}`,
+	}
+	for name, body := range invalid {
+		t.Run(name, func(t *testing.T) {
+			before := recordedValues(t, th, clientFamilies...)
+			resp, err := th.Client.DoAPIPost(th.Context.Context(), "/client_perf", fmt.Sprintf(body, model.GetMillis()))
+			require.Error(t, err)
+			require.Equal(t, http.StatusBadRequest, resp.StatusCode)
+			assert.Equal(t, before, recordedValues(t, th, clientFamilies...))
+		})
+	}
+
+	t.Run("501 histograms", func(t *testing.T) {
+		samples := make([]*model.MetricSample, 501)
+		for i := range samples {
+			samples[i] = &model.MetricSample{Metric: model.ClientPageLoadDuration, Value: 1000}
+		}
+		before := recordedValues(t, th, clientFamilies...)
+		resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), performanceReport(nil, samples))
+		require.Error(t, err)
+		require.Equal(t, http.StatusBadRequest, resp.StatusCode)
+		assert.Equal(t, before, recordedValues(t, th, clientFamilies...))
+	})
+
+	t.Run("valid sample beside an invalid one", func(t *testing.T) {
+		before := metricValue(t, th, "mattermost_webapp_page_load", nil)
+		resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), performanceReport(nil, []*model.MetricSample{
+			{Metric: model.ClientPageLoadDuration, Value: 2000},
+			{Metric: model.ClientPageLoadDuration, Value: -2000},
+		}))
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+		assert.Equal(t, before+1, metricValue(t, th, "mattermost_webapp_page_load", nil))
+	})
+
+	resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), pageLoadReport(1000))
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	assert.NotContains(t, th.LogBuffer.String(), "panic")
+}
