+func TestPrometheusMetricsLint(t *testing.T) {
+	m := newTestPrometheusMetrics(t, true)
+	callWithZeroArgs(m, "Register", "RegisterDBCollector", "UnregisterDBCollector", "GetLoggerMetricsCollector")
+	_, err := m.GetLoggerMetricsCollector().LoggedCounter("console")
+	require.NoError(t, err)
+
+	problems, err := testutil.GatherAndLint(m.registry)
+	require.NoError(t, err)
+
+	documentedNames := map[string]bool{
+		"mattermost_http_websockets_total":               true,
+		"mattermost_db_master_connections_total":         true,
+		"mattermost_db_read_replica_connections_total":   true,
+		"mattermost_db_search_replica_connections_total": true,
+		"mattermost_notifications_total_ack":             true,
+		"mattermost_notifications_success":               true,
+		"mattermost_notifications_error":                 true,
+		"mattermost_notifications_not_sent":              true,
+		"mattermost_notifications_unsupported":           true,
+		"mattermost_webapp_long_tasks":                   true,
+	}
+	var unexpected []promlint.Problem
+	for _, p := range problems {
+		if documentedNames[p.Metric] {
+			continue
+		}
+		unexpected = append(unexpected, p)
+	}
+	assert.Empty(t, unexpected)
+}
