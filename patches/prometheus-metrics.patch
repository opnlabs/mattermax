+		m.memCacheMisses.WithLabelValues(cacheName).Add(amount)
+	}
+}
+
+func (m *prometheusMetrics) IncrementMemCacheHitCounterSession() {
+	m.IncrementMemCacheHitCounter("Session")
+}
+
+func (m *prometheusMetrics) IncrementMemCacheMissCounterSession() {
+	m.IncrementMemCacheMissCounter("Session")
+}
