diff --git a/server/channels/app/platform/metrics_prometheus.go b/server/channels/app/platform/metrics_prometheus.go
new file mode 100644
index 000000000000..2ad61f9269eb
--- /dev/null
+++ b/server/channels/app/platform/metrics_prometheus.go
@@ -0,0 +1,584 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package platform
+
+import (
+	"database/sql"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/mattermost/logr/v2"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/collectors"
+	"github.com/prometheus/client_golang/prometheus/promauto"
+	"github.com/prometheus/client_golang/prometheus/promhttp"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/v8/einterfaces"
+)
+
+const metricsNamespace = "mattermost"
+
+var storeTimeBuckets = append([]float64{0.001, 0.0025}, prometheus.DefBuckets...)
+
+type prometheusMetrics struct {
+	ps       *PlatformService
+	registry *prometheus.Registry
+	enabled  atomic.Bool
+
+	httpRequests prometheus.Counter
+	httpErrors   prometheus.Counter
+	apiTime      *prometheus.HistogramVec
+	etagHits     *prometheus.CounterVec
+	etagMisses   *prometheus.CounterVec
+
+	httpWebSockets           *prometheus.GaugeVec
+	websocketEvents          *prometheus.CounterVec
+	websocketBroadcasts      *prometheus.CounterVec
+	websocketBufferSize      *prometheus.GaugeVec
+	websocketUsersRegistered *prometheus.GaugeVec
+	websocketReconnects      *prometheus.CounterVec
+
+	posts               prometheus.Counter
+	webhookPosts        prometheus.Counter
+	postEmails          prometheus.Counter
+	postPushes          prometheus.Counter
+	postFileAttachments prometheus.Counter
+	logins              prometheus.Counter
+	loginFailures       prometheus.Counter
+
+	memCacheHits          *prometheus.CounterVec
+	memCacheMisses        *prometheus.CounterVec
+	memCacheInvalidations *prometheus.CounterVec
+
+	storeTime   *prometheus.HistogramVec
+	activeUsers prometheus.Gauge
+	jobsActive  *prometheus.GaugeVec
+
+	postsSearches   prometheus.Counter
+	postsSearchTime prometheus.Histogram
+	filesSearches   prometheus.Counter
+	filesSearchTime prometheus.Histogram
+
+	pluginHookTime            *prometheus.HistogramVec
+	pluginMultiHookTime       *prometheus.HistogramVec
+	pluginMultiHookServerTime prometheus.Histogram
+	pluginAPITime             *prometheus.HistogramVec
+
+	loggerQueueUsed *prometheus.GaugeVec
+	loggerLogged    *prometheus.CounterVec
+	loggerErrors    *prometheus.CounterVec
+	loggerDropped   *prometheus.CounterVec
+	loggerBlocked   *prometheus.CounterVec
+
+	notifications           *prometheus.CounterVec
+	notificationAcks        *prometheus.CounterVec
+	notificationSuccesses   *prometheus.CounterVec
+	notificationErrors      *prometheus.CounterVec
+	notificationNotSent     *prometheus.CounterVec
+	notificationUnsupported *prometheus.CounterVec
+
+	client clientMetrics
+
+	dbMu         sync.Mutex
+	dbCollectors map[string]prometheus.Collector
+}
+
+var _ einterfaces.MetricsInterface = (*prometheusMetrics)(nil)
+
+func init() {
+	RegisterMetricsInterface(NewPrometheusMetrics)
+}
+
+func NewPrometheusMetrics(ps *PlatformService, _, _ string) einterfaces.MetricsInterface {
+	m := &prometheusMetrics{
+		ps:           ps,
+		registry:     prometheus.NewRegistry(),
+		dbCollectors: map[string]prometheus.Collector{},
+	}
+	f := promauto.With(m.registry)
+
+	counter := func(subsystem, name, help string) prometheus.Counter {
+		return f.NewCounter(prometheus.CounterOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help})
+	}
+	counterVec := func(subsystem, name, help string, labels ...string) *prometheus.CounterVec {
+		return f.NewCounterVec(prometheus.CounterOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help}, labels)
+	}
+	gaugeVec := func(subsystem, name, help string, labels ...string) *prometheus.GaugeVec {
+		return f.NewGaugeVec(prometheus.GaugeOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help}, labels)
+	}
+	histogram := func(subsystem, name, help string) prometheus.Histogram {
+		return f.NewHistogram(prometheus.HistogramOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help})
+	}
+	histogramVec := func(subsystem, name, help string, buckets []float64, labels ...string) *prometheus.HistogramVec {
+		return f.NewHistogramVec(prometheus.HistogramOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help, Buckets: buckets}, labels)
+	}
+	gaugeFunc := func(subsystem, name, help string, fn func() float64) {
+		f.NewGaugeFunc(prometheus.GaugeOpts{Namespace: metricsNamespace, Subsystem: subsystem, Name: name, Help: help}, fn)
+	}
+
+	m.httpRequests = counter("http", "requests_total", "Total number of HTTP requests.")
+	m.httpErrors = counter("http", "errors_total", "Total number of HTTP errors.")
+	m.apiTime = histogramVec("api", "time", "Time to execute an API handler, in seconds.", prometheus.DefBuckets, "handler", "method", "status_code", "origin_client", "page_load_context")
+	m.etagHits = counterVec("cache", "etag_hit_total", "Total number of ETag cache hits.", "route")
+	m.etagMisses = counterVec("cache", "etag_miss_total", "Total number of ETag cache misses.", "route")
+
+	m.httpWebSockets = gaugeVec("http", "websockets_total", "Number of open websocket connections.", "origin_client")
+	m.websocketEvents = counterVec("websocket", "event_total", "Total number of websocket events published.", "type")
+	m.websocketBroadcasts = counterVec("websocket", "broadcasts_total", "Total number of websocket messages sent to connections.", "name")
+	m.websocketBufferSize = gaugeVec("websocket", "broadcast_buffer_size", "Number of events waiting in a websocket hub's broadcast buffer.", "hub")
+	m.websocketUsersRegistered = gaugeVec("websocket", "broadcast_buffer_users_registered", "Number of connections registered with a websocket hub.", "hub")
+	m.websocketReconnects = counterVec("websocket", "reconnects_total", "Total number of websocket reconnections.", "type", "disconnect_err_code")
+
+	m.posts = counter("post", "total", "Total number of posts created.")
+	m.webhookPosts = counter("post", "webhooks_total", "Total number of posts created by webhooks.")
+	m.postEmails = counter("post", "emails_sent_total", "Total number of email notifications sent for posts.")
+	m.postPushes = counter("post", "pushes_sent_total", "Total number of push notifications sent for posts.")
+	m.postFileAttachments = counter("post", "file_attachments_total", "Total number of files attached to posts.")
+	m.logins = counter("login", "logins_total", "Total number of successful logins.")
+	m.loginFailures = counter("login", "logins_fail_total", "Total number of failed logins.")
+
+	m.memCacheHits = counterVec("cache", "mem_hit_total", "Total number of in-memory cache hits.", "name")
+	m.memCacheMisses = counterVec("cache", "mem_miss_total", "Total number of in-memory cache misses.", "name")
+	m.memCacheInvalidations = counterVec("cache", "mem_invalidation_total", "Total number of in-memory cache invalidations.", "name")
+
+	m.storeTime = histogramVec("db", "store_time", "Time to execute a store method, in seconds.", storeTimeBuckets, "method", "success")
+	m.activeUsers = f.NewGauge(prometheus.GaugeOpts{Namespace: metricsNamespace, Subsystem: "db", Name: "active_users", Help: "Number of users who are not deleted."})
+	m.jobsActive = gaugeVec("jobs", "active", "Number of jobs running.", "type")
+	gaugeFunc("db", "master_connections_total", "Number of open connections to the master database.", func() float64 {
+		if ps.sqlStore == nil {
+			return 0
+		}
+		return float64(ps.sqlStore.TotalMasterDbConnections())
+	})
+	gaugeFunc("db", "read_replica_connections_total", "Number of open connections to read replicas.", func() float64 {
+		if ps.sqlStore == nil {
+			return 0
+		}
+		return float64(ps.sqlStore.TotalReadDbConnections())
+	})
+	gaugeFunc("db", "search_replica_connections_total", "Number of open connections to search replicas.", func() float64 {
+		if ps.sqlStore == nil {
+			return 0
+		}
+		return float64(ps.sqlStore.TotalSearchDbConnections())
+	})
+
+	m.postsSearches = counter("search", "posts_searches_total", "Total number of post searches.")
+	m.postsSearchTime = histogram("search", "posts_searches_duration_seconds", "Time to search posts, in seconds.")
+	m.filesSearches = counter("search", "files_searches_total", "Total number of file searches.")
+	m.filesSearchTime = histogram("search", "files_searches_duration_seconds", "Time to search files, in seconds.")
+
+	m.pluginHookTime = histogramVec("plugin", "hook_time", "Time to execute a plugin hook, in seconds.", prometheus.DefBuckets, "plugin_id", "hook_name", "success")
+	m.pluginMultiHookTime = histogramVec("plugin", "multi_hook_time", "Time to execute one plugin's part of a multi-plugin hook, in seconds.", prometheus.DefBuckets, "plugin_id")
+	m.pluginMultiHookServerTime = histogram("plugin", "multi_hook_server_time", "Time to execute a multi-plugin hook across all plugins, in seconds.")
+	m.pluginAPITime = histogramVec("plugin", "api_time", "Time to execute a plugin API call, in seconds.", prometheus.DefBuckets, "plugin_id", "api_name", "success")
+
+	m.loggerQueueUsed = gaugeVec("logging", "logger_queue_used", "Number of log records waiting in a log target's queue.", "target")
+	m.loggerLogged = counterVec("logging", "logger_logged_total", "Total number of log records written by a log target.", "target")
+	m.loggerErrors = counterVec("logging", "logger_error_total", "Total number of errors in a log target.", "target")
+	m.loggerDropped = counterVec("logging", "logger_dropped_total", "Total number of log records dropped by a log target.", "target")
+	m.loggerBlocked = counterVec("logging", "logger_blocked_total", "Total number of times a log target's queue was full.", "target")
+
+	m.notifications = counterVec("notifications", "total", "Total number of notifications sent.", "type", "platform")
+	m.notificationAcks = counterVec("notifications", "total_ack", "Total number of notifications acknowledged by clients.", "type", "platform")
+	m.notificationSuccesses = counterVec("notifications", "success", "Total number of notifications delivered.", "type", "platform")
+	m.notificationErrors = counterVec("notifications", "error", "Total number of notifications that failed.", "type", "reason", "platform")
+	m.notificationNotSent = counterVec("notifications", "not_sent", "Total number of notifications not sent.", "type", "reason", "platform")
+	m.notificationUnsupported = counterVec("notifications", "unsupported", "Total number of notifications not sent because the client does not support them.", "type", "reason", "platform")
+
+	m.client = newClientMetrics(f)
+
+	f.NewGauge(prometheus.GaugeOpts{Namespace: metricsNamespace, Subsystem: "system", Name: "server_start_time", Help: "Time the server started, in Unix seconds."}).Set(float64(ps.startTime.Unix()))
+	m.registry.MustRegister(
+		collectors.NewGoCollector(),
+		collectors.NewProcessCollector(collectors.ProcessCollectorOpts{Namespace: metricsNamespace}),
+	)
+
+	m.enabled.Store(ps.startMetrics && *ps.Config().MetricsSettings.Enable)
+	ps.AddConfigListener(func(_, cfg *model.Config) {
+		m.enabled.Store(ps.startMetrics && *cfg.MetricsSettings.Enable)
+	})
+
+	return m
+}
+
+func (m *prometheusMetrics) Register() {
+	addr := *m.ps.Config().MetricsSettings.ListenAddress
+	if host, _, err := net.SplitHostPort(addr); err == nil && (host == "" || host == "0.0.0.0" || host == "::") {
+		m.ps.Log().Warn("The metrics and profiling server listens on every network interface. Its port must stay private: bind it to a loopback or private address, firewall it, and never route it through a public proxy.", mlog.String("address", addr))
+	}
+	m.ps.HandleMetrics("/metrics", promhttp.HandlerFor(m.registry, promhttp.HandlerOpts{}))
+}
+
+func canonicalDBName(name string) string {
+	if rest, ok := strings.CutPrefix(name, "searchreplica-"); ok {
+		return "search-replica-" + rest
+	}
+	return name
+}
+
+func (m *prometheusMetrics) RegisterDBCollector(db *sql.DB, name string) {
+	name = canonicalDBName(name)
+	m.dbMu.Lock()
+	defer m.dbMu.Unlock()
+
+	if old, ok := m.dbCollectors[name]; ok {
+		m.registry.Unregister(old)
+		delete(m.dbCollectors, name)
+	}
+	c := collectors.NewDBStatsCollector(db, name)
+	if err := m.registry.Register(c); err != nil {
+		mlog.Warn("Failed to register database metrics collector", mlog.String("db_name", name), mlog.Err(err))
+		return
+	}
+	m.dbCollectors[name] = c
+}
+
+func (m *prometheusMetrics) UnregisterDBCollector(_ *sql.DB, name string) {
+	name = canonicalDBName(name)
+	m.dbMu.Lock()
+	defer m.dbMu.Unlock()
+
+	if c, ok := m.dbCollectors[name]; ok {
+		m.registry.Unregister(c)
+		delete(m.dbCollectors, name)
+	}
+}
+
+func (m *prometheusMetrics) inc(c prometheus.Counter) {
+	if m.enabled.Load() {
+		c.Inc()
+	}
+}
+
+func (m *prometheusMetrics) IncrementPostCreate()    { m.inc(m.posts) }
+func (m *prometheusMetrics) IncrementWebhookPost()   { m.inc(m.webhookPosts) }
+func (m *prometheusMetrics) IncrementPostSentEmail() { m.inc(m.postEmails) }
+func (m *prometheusMetrics) IncrementPostSentPush()  { m.inc(m.postPushes) }
+func (m *prometheusMetrics) IncrementHTTPRequest()   { m.inc(m.httpRequests) }
+func (m *prometheusMetrics) IncrementHTTPError()     { m.inc(m.httpErrors) }
+func (m *prometheusMetrics) IncrementLogin()         { m.inc(m.logins) }
+func (m *prometheusMetrics) IncrementLoginFail()     { m.inc(m.loginFailures) }
+
+func (m *prometheusMetrics) IncrementPostsSearchCounter() { m.inc(m.postsSearches) }
+func (m *prometheusMetrics) IncrementFilesSearchCounter() { m.inc(m.filesSearches) }
+
