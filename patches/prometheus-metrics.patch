+func TestPrometheusMetricsDisabledRecordsNothing(t *testing.T) {
+	th := setupPrometheusMetrics(t, nil)
+	recorded := []string{"mattermost_"}
+
+	th.LoginBasic(t)
+	_, _, err := th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "before"})
+	require.NoError(t, err)
+	_, err = th.Client.SubmitClientMetrics(th.Context.Context(), pageLoadReport(1000))
+	require.NoError(t, err)
+	require.Positive(t, metricValue(t, th, "mattermost_webapp_page_load", nil))
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = false })
+	before := recordedValues(t, th, recorded...)
+	postsBefore := metricValue(t, th, "mattermost_post_total", nil)
+
+	_, _, err = th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "while disabled"})
+	require.NoError(t, err)
+	_, _, err = th.Client.GetMe(th.Context.Context(), "")
+	require.NoError(t, err)
+	resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), pageLoadReport(1000))
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	time.Sleep(500 * time.Millisecond)
+	assert.Equal(t, before, recordedValues(t, th, recorded...))
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = true })
+	_, _, err = th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "after"})
+	require.NoError(t, err)
+	assert.Equal(t, postsBefore+1, metricValue(t, th, "mattermost_post_total", nil))
+}
