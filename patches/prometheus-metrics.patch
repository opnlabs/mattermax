+)
+
+func newTestPrometheusMetrics(tb testing.TB, enabled bool) *prometheusMetrics {
+	configStore := config.NewTestMemoryStore()
+	cfg := configStore.Get().Clone()
+	*cfg.MetricsSettings.Enable = enabled
+	_, _, err := configStore.Set(cfg)
+	require.NoError(tb, err)
+	tb.Cleanup(func() { configStore.Close() })
+
+	ps := &PlatformService{configStore: configStore, startMetrics: true, startTime: time.Now()}
+	return NewPrometheusMetrics(ps, "", "").(*prometheusMetrics)
+}
+
+func setMetricsEnabled(tb testing.TB, m *prometheusMetrics, enabled bool) {
+	cfg := m.ps.configStore.Get().Clone()
+	*cfg.MetricsSettings.Enable = enabled
+	_, _, err := m.ps.configStore.Set(cfg)
+	require.NoError(tb, err)
+}
+
+func gatherFamilies(tb testing.TB, g prometheus.Gatherer) map[string]*dto.MetricFamily {
+	families, err := g.Gather()
+	require.NoError(tb, err)
+	byName := make(map[string]*dto.MetricFamily, len(families))
+	for _, f := range families {
+		byName[f.GetName()] = f
+	}
+	return byName
+}
+
+func labelNames(f *dto.MetricFamily) []string {
+	names := []string{}
+	for _, metric := range f.Metric {
+		for _, l := range metric.Label {
+			if !slices.Contains(names, l.GetName()) {
+				names = append(names, l.GetName())
+			}
+		}
+	}
+	slices.Sort(names)
+	return names
+}
+
+func labelValues(tb testing.TB, m *prometheusMetrics, family, label string) []string {
+	f := gatherFamilies(tb, m.registry)[family]
+	values := []string{}
+	if f == nil {
+		return values
+	}
+	for _, metric := range f.Metric {
+		for _, l := range metric.Label {
+			if l.GetName() == label {
+				values = append(values, l.GetValue())
+			}
+		}
+	}
+	slices.Sort(values)
+	return values
+}
+
+func seriesCount(tb testing.TB, m *prometheusMetrics, family string) int {
+	f := gatherFamilies(tb, m.registry)[family]
+	if f == nil {
+		return 0
+	}
+	return len(f.Metric)
+}
+
+func callWithZeroArgs(m *prometheusMetrics, skip ...string) {
+	v := reflect.ValueOf(einterfaces.MetricsInterface(m))
+	ifaceType := reflect.TypeFor[einterfaces.MetricsInterface]()
+	for i := 0; i < ifaceType.NumMethod(); i++ {
+		method := ifaceType.Method(i)
+		if slices.Contains(skip, method.Name) {
+			continue
+		}
+		args := make([]reflect.Value, method.Type.NumIn())
+		for j := range args {
+			args[j] = reflect.Zero(method.Type.In(j))
+		}
+		v.MethodByName(method.Name).Call(args)
+	}
+}
+
+func TestPrometheusMetricsSchema(t *testing.T) {
+	m := newTestPrometheusMetrics(t, true)
+
+	callWithZeroArgs(m, "Register", "RegisterDBCollector", "UnregisterDBCollector", "GetLoggerMetricsCollector")
+	db, err := sql.Open(model.DatabaseDriverPostgres, "postgres://localhost/unused")
+	require.NoError(t, err)
+	defer db.Close()
+	m.RegisterDBCollector(db, "master")
+	collector := m.GetLoggerMetricsCollector()
+	_, err = collector.QueueSizeGauge("console")
+	require.NoError(t, err)
+	_, err = collector.LoggedCounter("console")
+	require.NoError(t, err)
+	_, err = collector.ErrorCounter("console")
+	require.NoError(t, err)
+	_, err = collector.DroppedCounter("console")
+	require.NoError(t, err)
+	_, err = collector.BlockedCounter("console")
+	require.NoError(t, err)
+
+	none := []string{}
+	expected := map[string][]string{
+		"mattermost_http_requests_total":                         none,
+		"mattermost_http_errors_total":                           none,
+		"mattermost_api_time":                                    {"handler", "method", "origin_client", "page_load_context", "status_code"},
+		"mattermost_cache_etag_hit_total":                        {"route"},
+		"mattermost_cache_etag_miss_total":                       {"route"},
+		"mattermost_http_websockets_total":                       {"origin_client"},
+		"mattermost_websocket_event_total":                       {"type"},
+		"mattermost_websocket_broadcasts_total":                  {"name"},
+		"mattermost_websocket_broadcast_buffer_size":             {"hub"},
+		"mattermost_websocket_broadcast_buffer_users_registered": {"hub"},
+		"mattermost_websocket_reconnects_total":                  {"disconnect_err_code", "type"},
+		"mattermost_post_total":                                  none,
+		"mattermost_post_webhooks_total":                         none,
