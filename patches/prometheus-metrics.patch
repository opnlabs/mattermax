+func TestPrometheusMetricsWithoutLicense(t *testing.T) {
+	th := setupPrometheusMetrics(t, nil)
+
+	th.LoginBasic(t)
+	post, _, err := th.Client.CreatePost(th.Context.Context(), &model.Post{ChannelId: th.BasicChannel.Id, Message: "metrics without a license"})
+	require.NoError(t, err)
+	_, _, err = th.Client.SearchPosts(th.Context.Context(), th.BasicTeam.Id, "metrics", false)
+	require.NoError(t, err)
+	resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), pageLoadReport(1500))
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+
+	assert.Positive(t, metricValue(t, th, "mattermost_http_requests_total", nil))
+	assert.GreaterOrEqual(t, metricValue(t, th, "mattermost_api_time", map[string]string{"handler": "createPost", "method": http.MethodPost}), 1.0)
+	assert.GreaterOrEqual(t, metricValue(t, th, "mattermost_post_total", nil), 1.0)
+	assert.GreaterOrEqual(t, metricValue(t, th, "mattermost_login_logins_total", nil), 1.0)
+	assert.GreaterOrEqual(t, metricValue(t, th, "mattermost_search_posts_searches_total", nil), 1.0)
+	assert.GreaterOrEqual(t, metricValue(t, th, "mattermost_webapp_page_load", map[string]string{"platform": "linux", "agent": "chrome"}), 1.0)
+
+	body := scrapeMetricsRouter(t, th)
+	for _, id := range []string{th.BasicUser.Id, th.BasicUser2.Id, th.SystemAdminUser.Id, th.BasicChannel.Id, th.BasicTeam.Id, post.Id} {
+		assert.NotContains(t, body, id)
+	}
+}
