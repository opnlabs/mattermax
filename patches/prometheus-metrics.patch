+func TestPrometheusMetricsHostileLabels(t *testing.T) {
+	th := setupPrometheusMetrics(t, nil)
+
+	platforms := []string{"linux", "macos", "ios", "android", "windows", "other"}
+	agents := []string{"desktop", "firefox", "chrome", "safari", "edge", "other"}
+	rng := rand.New(rand.NewSource(1))
+	pick := func(valid []string) string {
+		if rng.Intn(3) == 0 {
+			return valid[rng.Intn(len(valid))]
+		}
+		return model.NewId() + "/" + th.BasicUser.Id
+	}
+
+	for range 50 {
+		labels := map[string]string{
+			"region":                pick(slices.Sorted(maps.Keys(model.AcceptedLCPRegions))),
+			"interaction":           pick([]string{"keyboard", "pointer", "other"}),
+			"network_request_group": model.NewId(),
+		}
+		report := performanceReport(
+			[]*model.MetricSample{{Metric: model.ClientLongTasks, Value: 1}},
+			[]*model.MetricSample{
+				{Metric: model.ClientLargestContentfulPaint, Value: 900, Labels: labels},
+				{Metric: model.ClientInteractionToNextPaint, Value: 90, Labels: labels},
+				{Metric: model.ClientChannelSwitchDuration, Value: 400, Labels: map[string]string{"fresh": pick([]string{"true", "false"})}},
+				{Metric: model.MobileClientNetworkRequestsAverageSpeed, Value: 10, Labels: labels},
+			},
+		)
+		report.Labels = map[string]string{"platform": pick(platforms), "agent": pick(agents), "network_request_group": model.NewId()}
+		resp, err := th.Client.SubmitClientMetrics(th.Context.Context(), report)
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+	}
+
+	const buckets = 8 + 3
+	bounds := map[string]int{
+		"mattermost_webapp_long_tasks":                6 * 6,
+		"mattermost_webapp_largest_contentful_paint":  6 * 6 * 10 * buckets,
+		"mattermost_webapp_interaction_to_next_paint": 6 * 6 * 3 * buckets,
+		"mattermost_webapp_channel_switch":            6 * 6 * 3 * buckets,
+	}
+	families := parseMetrics(t, scrapeMetricsRouter(t, th))
+	total := 0
+	for name, family := range families {
+		if !strings.HasPrefix(name, "mattermost_webapp_") && !strings.HasPrefix(name, "mattermost_mobileapp_") {
+			continue
+		}
+		require.Contains(t, bounds, name)
+		series := len(family.Metric)
+		if family.GetType() == dto.MetricType_HISTOGRAM {
+			series *= buckets
+		}
+		assert.LessOrEqual(t, series, bounds[name], name)
+		total += series
+		for _, metric := range family.Metric {
+			labels := metricLabels(metric)
+			assert.Contains(t, platforms, labels["platform"])
+			assert.Contains(t, agents, labels["agent"])
+			if region, ok := labels["region"]; ok {
+				assert.Contains(t, model.AcceptedLCPRegions, region)
+			}
+			if interaction, ok := labels["interaction"]; ok {
+				assert.Contains(t, []string{"keyboard", "pointer", "other"}, interaction)
+			}
+		}
+	}
+	assert.Positive(t, total)
+	assert.NotContains(t, scrapeMetricsRouter(t, th), th.BasicUser.Id)
+}
