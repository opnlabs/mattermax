+func TestPrometheusMetricsConcurrentReload(t *testing.T) {
+	th := Setup(t, StartMetrics()).InitBasic(t)
+	defer th.Shutdown(t)
+	m := th.Service.metricsIFace.(*prometheusMetrics)
+
+	addrs := []string{freeLocalAddr(t), freeLocalAddr(t)}
+	th.Service.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.ListenAddress = addrs[0] })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	var workers sync.WaitGroup
+	var parsed, failed atomic.Int64
+	var parseErrors sync.Map
+
+	for i := range 16 {
+		workers.Go(func() {
+			rctx := request.EmptyContext(th.Service.Log())
+			for ctx.Err() == nil {
+				_, _ = th.Service.Store.User().Get(rctx, th.BasicUser.Id)
+				_, _ = th.Service.Store.Team().Get(th.BasicTeam.Id)
+				th.Service.Publish(model.NewWebSocketEvent(model.WebsocketEventTyping, "", th.BasicChannel.Id, "", nil, ""))
+				m.ObserveClientPageLoadDuration("linux", "chrome", "", float64(i))
+				m.IncrementClientLongTasks("linux", "chrome", "", 1)
+			}
+		})
+	}
+
+	workers.Go(func() {
+		client := &http.Client{Timeout: 5 * time.Second}
+		for ctx.Err() == nil {
+			for _, addr := range addrs {
+				res, err := scrapeURL(client, "http://"+addr+"/metrics")
+				if err != nil || res.status != http.StatusOK {
+					continue
+				}
+				if _, err := parseExposition(res.body); err != nil {
+					failed.Add(1)
+					parseErrors.Store(err.Error(), true)
+					continue
+				}
+				parsed.Add(1)
+			}
+		}
+	})
+
+	workers.Go(func() {
+		for ctx.Err() == nil {
+			db, err := sql.Open(model.DatabaseDriverPostgres, "postgres://localhost/unused")
+			if err != nil {
+				continue
+			}
+			m.RegisterDBCollector(db, "replica-0")
+			m.UnregisterDBCollector(db, "replica-0")
+			db.Close()
+		}
+	})
+
+	for i := range 10 {
+		time.Sleep(200 * time.Millisecond)
+		th.Service.UpdateConfig(func(cfg *model.Config) {
+			if i%2 == 0 {
+				*cfg.MetricsSettings.ListenAddress = addrs[(i/2+1)%2]
+			} else {
+				*cfg.MetricsSettings.Enable = !*cfg.MetricsSettings.Enable
+			}
+		})
+	}
+	th.Service.UpdateConfig(func(cfg *model.Config) { *cfg.MetricsSettings.Enable = true })
+	time.Sleep(200 * time.Millisecond)
+	cancel()
+	workers.Wait()
+
+	parseErrors.Range(func(k, _ any) bool {
+		t.Errorf("scrape did not parse: %v", k)
+		return true
+	})
+	assert.Zero(t, failed.Load())
+	assert.Positive(t, parsed.Load())
+}
