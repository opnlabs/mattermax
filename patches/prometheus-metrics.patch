+func TestPrometheusMetricsDBCollectors(t *testing.T) {
+	m := newTestPrometheusMetrics(t, true)
+	openDB := func(maxOpen int) *sql.DB {
+		db, err := sql.Open(model.DatabaseDriverPostgres, "postgres://localhost/unused")
+		require.NoError(t, err)
+		db.SetMaxOpenConns(maxOpen)
+		t.Cleanup(func() { db.Close() })
+		return db
+	}
+	maxOpen := func(dbName string) []float64 {
+		values := []float64{}
+		for _, metric := range gatherFamilies(t, m.registry)["go_sql_max_open_connections"].GetMetric() {
+			if metric.Label[0].GetValue() == dbName {
+				values = append(values, metric.GetGauge().GetValue())
+			}
+		}
+		return values
+	}
+
+	master := openDB(7)
+	m.RegisterDBCollector(master, "master")
+	m.UnregisterDBCollector(master, "master")
+	assert.Empty(t, maxOpen("master"))
+	m.RegisterDBCollector(master, "master")
+	m.RegisterDBCollector(master, "master")
+	assert.Equal(t, []float64{7}, maxOpen("master"))
+	assert.Contains(t, labelValues(t, m, "go_sql_open_connections", "db_name"), "master")
+
+	first, second := openDB(3), openDB(5)
+	m.RegisterDBCollector(first, "searchreplica-0")
+	assert.Equal(t, []float64{3}, maxOpen("search-replica-0"))
+	m.UnregisterDBCollector(first, "search-replica-0")
+	m.RegisterDBCollector(second, "search-replica-0")
+	assert.Equal(t, []float64{5}, maxOpen("search-replica-0"))
+	assert.Equal(t, []string{"master", "search-replica-0"}, labelValues(t, m, "go_sql_open_connections", "db_name"))
+}
