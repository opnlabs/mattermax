+func countingWebsocketHandler(received *atomic.Int64) http.HandlerFunc {
+	marker := `"` + string(model.WebsocketEventTyping) + `"`
+	return func(w http.ResponseWriter, req *http.Request) {
+		upgrader := &websocket.Upgrader{}
+		conn, err := upgrader.Upgrade(w, req, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		for {
+			_, msg, err := conn.ReadMessage()
+			if err != nil {
+				return
+			}
+			if strings.Contains(string(msg), marker) {
+				received.Add(1)
+			}
+		}
+	}
+}
+
+func BenchmarkPrometheusWebsocketPublish(b *testing.B) {
+	for _, name := range benchVariantOrder {
+		b.Run(name, func(b *testing.B) {
+			var options []Option
+			switch name {
+			case "nil":
+				RegisterMetricsInterface(func(*PlatformService, string, string) einterfaces.MetricsInterface { return nil })
+				defer RegisterMetricsInterface(NewPrometheusMetrics)
+			case "on":
+				options = append(options, StartMetrics())
+			}
+			th := Setup(b, options...).InitBasic(b)
+			defer th.Shutdown(b)
+
+			var received atomic.Int64
+			server := httptest.NewServer(countingWebsocketHandler(&received))
+			defer server.Close()
+			session, err := th.Service.CreateSession(th.Context, &model.Session{UserId: th.BasicUser.Id, ExpiresAt: model.GetMillis() + time.Hour.Milliseconds()})
+			require.NoError(b, err)
+
+			waitFor := func(target int64) {
+				deadline := time.Now().Add(60 * time.Second)
+				for received.Load() < target {
+					if time.Now().After(deadline) {
+						b.Fatalf("received %d of %d messages", received.Load(), target)
+					}
+					time.Sleep(20 * time.Microsecond)
+				}
+			}
+			publish := func() {
+				th.Service.Publish(model.NewWebSocketEvent(model.WebsocketEventTyping, "", "", th.BasicUser.Id, nil, ""))
+			}
+
+			conns := 0
+			for _, target := range []int{1, 100, 1000} {
+				for ; conns < target; conns++ {
+					c, _, err := websocket.DefaultDialer.Dial("ws://"+server.Listener.Addr().String(), nil)
+					require.NoError(b, err)
+					wc := th.Service.NewWebConn(&WebConnConfig{WebSocket: c, Session: *session, TFunc: i18n.IdentityTfunc(), Locale: "en", ConnectionID: model.NewId(), Active: true}, th.Suite, &hookRunner{})
+					require.NoError(b, th.Service.HubRegister(wc))
+					go wc.Pump()
+				}
+				base := received.Load()
+				publish()
+				waitFor(base + int64(conns))
+
+				b.Run(fmt.Sprintf("conns=%d", conns), func(b *testing.B) {
+					const window = 32
+					base := received.Load()
+					b.ReportAllocs()
+					b.ResetTimer()
+					for i := range b.N {
+						publish()
+						if (i+1)%window == 0 || i == b.N-1 {
+							waitFor(base + int64(conns)*int64(i+1))
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func BenchmarkPrometheusConcurrentScrape(b *testing.B) {
+	dbStore, _ := setupDBStore(b)
+	rctx := request.TestContext(b)
+	for _, series := range []int{10000, 50000} {
+		variants := benchmarkMetricsVariants(b)
+		variants["on_noscrape"] = variants["on"]
+		for _, name := range append(benchVariantOrder, "on_noscrape") {
+			metrics := variants[name]
+			if m, ok := metrics.(*prometheusMetrics); ok && name != "on_noscrape" {
+				enabled := m.enabled.Load()
+				m.enabled.Store(true)
+				for i := range series / (len(storeTimeBuckets) + 3) {
+					m.ObserveStoreMethodDuration(fmt.Sprintf("FillStore.Method%d", i), "true", 0.01)
+				}
+				m.enabled.Store(enabled)
+			}
+			layer := timerlayer.New(benchStore{dbStore}, metrics)
+
+			b.Run(fmt.Sprintf("series=%d/%s", series, name), func(b *testing.B) {
+				stop := make(chan struct{})
+				var scrapes atomic.Int64
+				var scrapeNanos atomic.Int64
+				var scraper sync.WaitGroup
+				if m, ok := metrics.(*prometheusMetrics); ok && name != "on_noscrape" {
+					handler := promhttp.HandlerFor(m.registry, promhttp.HandlerOpts{})
+					scraper.Go(func() {
+						for {
+							select {
+							case <-stop:
+								return
+							default:
+							}
+							start := time.Now()
+							rec := httptest.NewRecorder()
+							handler.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+							scrapeNanos.Add(int64(time.Since(start)))
+							scrapes.Add(1)
+						}
+					})
+				}
+
+				b.ReportAllocs()
+				b.ResetTimer()
+				b.RunParallel(func(pb *testing.PB) {
+					for pb.Next() {
+						_, _ = layer.User().Get(rctx, "id")
+						if metrics != nil {
+							metrics.IncrementWebSocketBroadcast(model.WebsocketEventPosted)
+						}
+					}
+				})
+				b.StopTimer()
+				close(stop)
+				scraper.Wait()
+				if n := scrapes.Load(); n > 0 {
+					b.ReportMetric(float64(scrapeNanos.Load())/float64(n)/1e6, "ms/scrape")
+					b.ReportMetric(float64(n), "scrapes")
+				}
+			})
+		}
+	}
+}
