+func (m *prometheusMetrics) ObservePluginHookDuration(pluginID, hookName string, success bool, elapsed float64) {
+	if m.enabled.Load() {
+		m.pluginHookTime.WithLabelValues(pluginID, hookName, strconv.FormatBool(success)).Observe(elapsed)
+	}
