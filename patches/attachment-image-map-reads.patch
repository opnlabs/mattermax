+func TestAttachmentImageMapURLsOwnershipAndFallback(t *testing.T) {
+	m := map[string]any{"image_url": "original", "fields": []any{map[string]any{"title": "title", "value": "value", "short": true}}}
+	p := attachmentMapPost([]any{m})
+	first, second := p.InteractiveBlocksImageURLs(false), p.InteractiveBlocksImageURLs(false)
+	first[0] = "changed"
+	if second[0] != "original" || m["image_url"] != "original" {
+		t.Fatal("URL outputs share mutable state")
+	}
+	calls := 0
+	p = attachmentMapPost([]any{m, map[string]any{"text": attachmentMapMarshalProbe{&calls}, "image_url": "custom"}})
+	p.AddProp(PostPropsMmBlocks, []any{map[string]any{"type": "image", "url": "prefix"}})
+	want := legacyAttachmentImageMapURLs(p, true)
+	count := calls
+	calls = 0
+	got := p.InteractiveBlocksImageURLs(true)
+	if !reflect.DeepEqual(got, want) || calls != count || calls != 1 {
+		t.Fatalf("fallback changed result/calls: got%#v want%#v calls%d want%d", got, want, calls, count)
+	}
