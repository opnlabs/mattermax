+func TestAttachmentImageMapURLsGenerated(t *testing.T) {
+	r := rand.New(rand.NewSource(43))
+	fast := 0
+	for n := 0; n < 100000; n++ {
+		m := map[string]any{"image_url": "image", "thumb_url": "thumb", "author_icon": "image", "footer_icon": "footer"}
+		fields := make([]any, r.Intn(12))
+		for i := range fields {
+			fields[i] = map[string]any{"title": "title", "value": float64(r.Intn(100)), "short": r.Intn(2) == 0}
+		}
+		m["fields"] = fields
+		switch r.Intn(12) {
+		case 0:
+			m["fields"] = []any{map[string]any{"short": "true"}}
+		case 1:
+			m["fields"] = []any{map[string]any{"value": map[string]any{"nested": true}}}
+		case 2:
+			m["text"] = "invalid\xff"
+		case 3:
+			m["unknown"] = true
+		case 4:
+			m["actions"] = []any{nil, map[string]any{"type": "button", "name": "Go"}}
+		case 5:
+			m["id"] = float64(1 << 63)
+		}
+		raw := []any{m}
+		if _, _, _, ok := validateAttachmentMap(m); ok {
+			fast++
+		}
+		p := attachmentMapPost(raw)
+		if got, want := p.InteractiveBlocksImageURLs(false), legacyAttachmentImageMapURLs(p, false); !reflect.DeepEqual(got, want) {
+			t.Fatalf("iteration %d got %#v want %#v", n, got, want)
+		}
+	}
+	if fast < 40000 {
+		t.Fatalf("fast path only exercised %d times", fast)
+	}
