+package model
+
+// appendAttachmentMapImageURLs processes elements in Attachments' decoding order.
+// Supported maps only need their four URL fields; fallback keeps JSON coercions
+// and custom marshaling without validating earlier elements a second time.
+func appendAttachmentMapImageURLs(out []string, attachments []any) []string {
+	for _, value := range attachments {
+		if m, ok := value.(map[string]any); ok {
+			if _, _, _, valid := validateAttachmentMap(m); valid {
+				for _, key := range [...]string{"image_url", "thumb_url", "author_icon", "footer_icon"} {
+					if url := attachmentMapText(m[key]); url != "" {
+						out = append(out, url)
+					}
+				}
+				continue
+			}
+		}
+		if decoded, ok := decodeAttachmentJSON(value); ok {
+			out = appendAttachmentsImageURLs(out, []*MessageAttachment{decoded})
+		}
+	}
+	return out
+}
