+func TestAttachmentImageMapURLsMarshalOrder(t *testing.T) {
+	first := map[string]any{"image_url": "before"}
+	last := map[string]any{"image_url": "last-before"}
+	calls := 0
+	callback := attachmentImageMapMarshalFunc(func() ([]byte, error) {
+		calls++
+		first["image_url"] = "after"
+		last["image_url"] = "last-after"
+		return []byte(`{"image_url":"callback"}`), nil
+	})
+	p := attachmentMapPost([]any{first, callback, last})
+	want := legacyAttachmentImageMapURLs(p, false)
+	count := calls
+	first["image_url"], last["image_url"], calls = "before", "last-before", 0
+	got := p.InteractiveBlocksImageURLs(false)
+	if !reflect.DeepEqual(got, want) || calls != count || calls != 1 {
+		t.Fatalf("callback order changed: got %#v want %#v calls %d want %d", got, want, calls, count)
+	}
+	if !reflect.DeepEqual(got, []string{"before", "callback", "last-after"}) {
+		t.Fatalf("incorrect ordered URL snapshots: %#v", got)
+	}
+}
+
+func TestAttachmentImageMapURLsConcurrentProps(t *testing.T) {
+	p := attachmentMapPost([]any{map[string]any{"image_url": "image"}})
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 10000; i++ {
+			p.AddProp(PostPropsAttachments, []any{map[string]any{"image_url": "image"}})
+			p.AddProp("other", i)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 10000; i++ {
+			if got := p.InteractiveBlocksImageURLs(false); !reflect.DeepEqual(got, []string{"image"}) {
+				t.Errorf("incorrect concurrent read: %#v", got)
+				return
+			}
+		}
+	}()
+	wg.Wait()
+}
