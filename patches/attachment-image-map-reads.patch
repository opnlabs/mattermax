+func BenchmarkAttachmentImageMapURLs(b *testing.B) {
+	for _, kind := range []string{"plain", "typed", "fields=0", "fields=8", "fields=64", "urls", "actions", "unknown", "structured", "malformed", "mixed-late"} {
+		b.Run(kind, func(b *testing.B) {
+			n := 8
+			if kind == "fields=0" {
+				n = 0
+			}
+			if kind == "fields=64" {
+				n = 64
+			}
+			fields := make([]any, n)
+			for i := range fields {
+				fields[i] = map[string]any{"title": "Metric", "value": "observed value", "short": true}
+			}
+			m := map[string]any{"fallback": "report", "text": "observations", "fields": fields}
+			var raw any = []any{m}
+			switch kind {
+			case "plain":
+				raw = nil
+			case "typed":
+				raw = []*MessageAttachment{{ImageURL: "typed"}}
+			case "urls":
+				m["image_url"] = "image"
+				m["thumb_url"] = "thumb"
+				m["author_icon"] = "image"
+				m["footer_icon"] = "footer"
+			case "actions":
+				m["actions"] = []any{map[string]any{"id": "view", "type": "button", "name": "View"}}
+			case "unknown":
+				m["unknown"] = true
+			case "structured":
+				fields[n-1].(map[string]any)["value"] = map[string]any{"nested": "value"}
+			case "malformed":
+				fields[n-1].(map[string]any)["short"] = nil
+			case "mixed-late":
+				raw = []any{m, map[string]any{"unknown": true, "image_url": "fallback"}}
+			}
+			p := attachmentMapPost(raw)
+			if !reflect.DeepEqual(p.InteractiveBlocksImageURLs(false), legacyAttachmentImageMapURLs(p, false)) {
+				b.Fatal("fixture mismatch")
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				attachmentImageMapBenchmarkResult = p.InteractiveBlocksImageURLs(false)
+			}
+		})
+	}
+}
