+func TestAttachmentImageMapURLs(t *testing.T) {
+	urls := func() map[string]any {
+		return map[string]any{"image_url": "https://image.test/a", "thumb_url": "https://image.test/b", "author_icon": "https://image.test/a", "footer_icon": "https://image.test/c"}
+	}
+	cases := []any{nil, []any{}, []any(nil), []*MessageAttachment(nil), []*MessageAttachment{{ImageURL: "typed", ThumbURL: "thumb"}, nil}, []any{nil, map[string]any(nil), urls()}, []any{urls(), urls()}}
+	for _, mutate := range []func(map[string]any){
+		func(m map[string]any) {
+			m["fields"] = []any{nil, map[string]any{"title": "title", "value": true, "short": true}}
+		},
+		func(m map[string]any) { m["fields"] = []any{map[string]any{"short": "TRUE"}} },
+		func(m map[string]any) { m["fields"] = []any{map[string]any{"short": nil}} },
+		func(m map[string]any) { m["fields"] = []any{map[string]any{"short": "invalid"}} },
+		func(m map[string]any) {
+			m["fields"] = []any{map[string]any{"value": map[string]any{"nested": "value"}}}
+		},
+		func(m map[string]any) { m["fields"] = []any{map[string]any{"unknown": func() {}}} },
+		func(m map[string]any) { m["actions"] = []any{nil, nil} },
+		func(m map[string]any) {
+			m["actions"] = []any{map[string]any{"id": "view", "type": "button", "name": "View"}}
+		},
+		func(m map[string]any) { m["image_url"] = "bad\xff bytes" },
+		func(m map[string]any) { m["text"] = "bad\xff bytes" },
+		func(m map[string]any) { m["id"] = float64(1 << 63) },
+		func(m map[string]any) { m["id"] = json.Number("9223372036854775807") },
+		func(m map[string]any) { m["ts"] = math.NaN() },
+		func(m map[string]any) { m["unknown"] = func() {} },
+		func(m map[string]any) { m["image_url"] = nil },
+	} {
+		m := urls()
+		mutate(m)
+		cases = append(cases, []any{m}, []any{urls(), m})
+	}
+	for i, raw := range cases {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			p := attachmentMapPost(raw)
+			p.AddProp(PostPropsMmBlocks, []any{map[string]any{"type": "image", "url": "mm-prefix"}})
+			p.AddProp(PostPropsBlockKitBlocks, []any{map[string]any{"type": "image", "image_url": "bk-prefix"}})
+			p.AddProp(PostPropsAdaptiveCards, []any{map[string]any{"type": "AdaptiveCard", "body": []any{map[string]any{"type": "Image", "url": "ac-prefix"}}}})
+			for _, enabled := range []bool{false, true} {
+				got, want := p.InteractiveBlocksImageURLs(enabled), legacyAttachmentImageMapURLs(p, enabled)
+				if !reflect.DeepEqual(got, want) {
+					t.Fatalf("enabled=%v got %#v want %#v", enabled, got, want)
+				}
+			}
+		})
+	}
+	if got := (&Post{}).InteractiveBlocksImageURLs(true); got != nil {
+		t.Fatalf("empty post got %#v", got)
+	}
