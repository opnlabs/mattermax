+// decodeAttachmentJSON retains the fallback's normalization and nil filtering.
+func decodeAttachmentJSON(attachment any) (*MessageAttachment, bool) {
+	if enc, err := json.Marshal(attachment); err == nil {
+		var decoded MessageAttachment
+		if json.Unmarshal(enc, &decoded) == nil {
+			// Ignoring nil actions
+			i := 0
+			for _, action := range decoded.Actions {
+				if action != nil {
+					decoded.Actions[i] = action
+					i++
+				}
+			}
+			decoded.Actions = decoded.Actions[:i]
+
+			// Ignoring nil fields
+			i = 0
+			for _, field := range decoded.Fields {
+				if field != nil {
+					decoded.Fields[i] = field
+					i++
+				}
+			}
+			decoded.Fields = decoded.Fields[:i]
+			return &decoded, true
+		}
+	}
+	return nil, false
+}
