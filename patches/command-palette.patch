+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {Permissions, Preferences} from 'mattermost-redux/constants';
+
+import CustomStatusModal from 'components/custom_status/custom_status_modal';
+import DndCustomTimePicker from 'components/dnd_custom_time_picker_modal';
+import ResetStatusModal from 'components/reset_status_modal';
+import UserSettingsModal from 'components/user_settings/modal';
+
+import mockStore from 'tests/test_store';
+import {getHistory} from 'utils/browser_history';
+import {ActionTypes, ModalIdentifiers} from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+import {listPaletteCommands, runPaletteCommand, runPaletteSlashCommand} from './commands';
+import type {PaletteCommandId} from './commands';
+
+jest.mock('mattermost-redux/actions/users', () => ({
+    ...jest.requireActual('mattermost-redux/actions/users'),
+    setStatus: (status: unknown) => ({type: 'MOCK_SET_STATUS', status}),
+    unsetCustomStatus: () => ({type: 'MOCK_UNSET_CUSTOM_STATUS'}),
+}));
+
+jest.mock('actions/views/create_comment', () => ({
+    submitCommand: jest.fn((channelId: string, rootId: string, draft: {message: string}) => ({type: 'MOCK_SUBMIT_COMMAND', channelId, rootId, message: draft.message})),
+}));
+
+jest.mock('utils/browser_history', () => {
+    const history = {push: jest.fn()};
+    return {getHistory: () => history};
+});
+
+const NOW = new Date('2026-11-12T10:00:00Z');
+
+function makeState({
+    roles = 'system_user',
+    collapsedThreads = 'always_on',
+    customStatus,
+    status = 'online',
+    autoResetPref,
+}: {roles?: string; collapsedThreads?: string; customStatus?: object; status?: string; autoResetPref?: string} = {}) {
+    const preferences: Record<string, {category: string; name: string; user_id: string; value: string}> = {};
+    if (autoResetPref !== undefined) {
+        preferences[`${Preferences.CATEGORY_AUTO_RESET_MANUAL_STATUS}--user1`] = {category: Preferences.CATEGORY_AUTO_RESET_MANUAL_STATUS, name: 'user1', user_id: 'user1', value: autoResetPref};
+    }
+
+    return {
+        entities: {
+            general: {config: {CollapsedThreads: collapsedThreads, EnableCustomUserStatuses: 'true'}},
+            users: {
+                currentUserId: 'user1',
+                profiles: {
+                    user1: {
+                        id: 'user1',
+                        roles,
+                        timezone: {useAutomaticTimezone: 'false', manualTimezone: 'UTC', automaticTimezone: ''},
+                        props: customStatus ? {customStatus: JSON.stringify(customStatus)} : {},
+                    },
+                },
+                statuses: {user1: status},
+            },
+            roles: {
+                roles: {
+                    system_user: {name: 'system_user', permissions: []},
+                    system_admin: {name: 'system_admin', permissions: [Permissions.SYSCONSOLE_READ_PERMISSIONS[0]]},
+                },
+            },
+            teams: {currentTeamId: 'team1', teams: {team1: {id: 'team1', name: 'myteam'}}},
+            channels: {currentChannelId: 'channel1'},
+            preferences: {myPreferences: preferences},
+        },
+    } as unknown as GlobalState;
+}
+
+function ids(state: GlobalState) {
+    return listPaletteCommands(state).map(({id}) => id);
+}
+
+async function run(id: PaletteCommandId, state = makeState()) {
+    const store = mockStore(state);
+    const result = await store.dispatch(runPaletteCommand(id));
+    return {actions: store.getActions(), result};
+}
+
+describe('listPaletteCommands', () => {
+    test('shows the System Console only to users who can read it', () => {
+        expect(ids(makeState())).not.toContain('open_system_console');
+        expect(ids(makeState({roles: 'system_user system_admin'}))).toContain('open_system_console');
+    });
+
+    test('shows Threads only when collapsed reply threads are on', () => {
+        expect(ids(makeState())).toContain('open_threads');
+        expect(ids(makeState({collapsedThreads: 'disabled'}))).not.toContain('open_threads');
+    });
+
+    test('offers to clear the custom status only when one is set', () => {
+        expect(ids(makeState())).not.toContain('custom_status_clear');
+        expect(ids(makeState({customStatus: {emoji: 'calendar', text: 'In a meeting', duration: ''}}))).toContain('custom_status_clear');
+    });
+});
+
+describe('runPaletteCommand', () => {
+    beforeEach(() => {
+        jest.useFakeTimers({now: NOW});
+    });
+
+    afterEach(() => {
+        jest.useRealTimers();
+    });
+
+    test.each([
+        ['status_online', 'online'],
+        ['status_away', 'away'],
+        ['status_offline', 'offline'],
+    ] as Array<[PaletteCommandId, string]>)('%s sets the status to %s', async (id, status) => {
+        const {actions} = await run(id);
+        expect(actions).toEqual([{type: 'MOCK_SET_STATUS', status: {user_id: 'user1', status}}]);
+    });
+
+    test.each([
+        ['status_dnd_dont_clear', 0],
+        ['status_dnd_30_minutes', Date.parse('2026-11-12T10:30:00Z') / 1000],
+        ['status_dnd_1_hour', Date.parse('2026-11-12T11:00:00Z') / 1000],
+        ['status_dnd_2_hours', Date.parse('2026-11-12T12:00:00Z') / 1000],
+        ['status_dnd_tomorrow', Date.parse('2026-11-13T09:00:00Z') / 1000],
+    ] as Array<[PaletteCommandId, number]>)('%s sets do not disturb until %d', async (id, endTime) => {
+        const {actions} = await run(id);
+        expect(actions).toEqual([{type: 'MOCK_SET_STATUS', status: {user_id: 'user1', status: 'dnd', dnd_end_time: endTime}}]);
+    });
+
+    test('asks for confirmation before changing an out of office status', async () => {
+        const {actions} = await run('status_dnd_1_hour', makeState({status: 'ooo', autoResetPref: ''}));
+        expect(actions).toEqual([expect.objectContaining({type: ActionTypes.MODAL_OPEN, modalId: ModalIdentifiers.RESET_STATUS, dialogType: ResetStatusModal, dialogProps: {newStatus: 'dnd'}})]);
+    });
+
+    test.each([
+        ['status_dnd_custom', ModalIdentifiers.DND_CUSTOM_TIME_PICKER, DndCustomTimePicker],
+        ['custom_status_set', ModalIdentifiers.CUSTOM_STATUS, CustomStatusModal],
+    ] as Array<[PaletteCommandId, string, unknown]>)('%s opens the %s modal', async (id, modalId, dialogType) => {
+        const {actions} = await run(id);
+        expect(actions).toEqual([expect.objectContaining({type: ActionTypes.MODAL_OPEN, modalId, dialogType})]);
+    });
+
+    test.each([
+        ['open_settings', true],
+        ['open_profile', false],
+    ] as Array<[PaletteCommandId, boolean]>)('%s opens user settings', async (id, isContentProductSettings) => {
+        const {actions} = await run(id);
+        expect(actions).toEqual([expect.objectContaining({
+            type: ActionTypes.MODAL_OPEN,
+            modalId: ModalIdentifiers.USER_SETTINGS,
+            dialogType: UserSettingsModal,
+            dialogProps: {isContentProductSettings},
+        })]);
+    });
+
+    test('custom_status_clear clears the custom status', async () => {
+        const {actions} = await run('custom_status_clear');
+        expect(actions).toEqual([{type: 'MOCK_UNSET_CUSTOM_STATUS'}]);
+    });
+
+    test.each([
+        ['open_threads', '/myteam/threads'],
+        ['open_drafts', '/myteam/drafts'],
+        ['open_system_console', '/admin_console'],
+    ] as Array<[PaletteCommandId, string]>)('%s navigates to %s', async (id, path) => {
+        const {actions, result} = await run(id);
+        expect(actions).toEqual([]);
+        expect(result).toEqual({data: true});
+        expect(getHistory().push).toHaveBeenLastCalledWith(path);
+    });
+});
+
+describe('runPaletteSlashCommand', () => {
+    test('runs the command in the current channel', async () => {
+        const store = mockStore(makeState());
+        await store.dispatch(runPaletteSlashCommand('/away '));
+        expect(store.getActions()).toEqual([{type: 'MOCK_SUBMIT_COMMAND', channelId: 'channel1', rootId: '', message: '/away'}]);
+    });
+});
