+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {Moment} from 'moment-timezone';
+import moment from 'moment-timezone';
+import {defineMessage} from 'react-intl';
+import type {MessageDescriptor} from 'react-intl';
+
+import {setStatus, unsetCustomStatus} from 'mattermost-redux/actions/users';
+import {Permissions, Preferences} from 'mattermost-redux/constants';
+import {getCurrentChannelId} from 'mattermost-redux/selectors/entities/channels';
+import {get as getPreference, isCollapsedThreadsEnabled} from 'mattermost-redux/selectors/entities/preferences';
+import {haveISystemPermission} from 'mattermost-redux/selectors/entities/roles_helpers';
+import {getCurrentRelativeTeamUrl} from 'mattermost-redux/selectors/entities/teams';
+import {getCurrentTimezone} from 'mattermost-redux/selectors/entities/timezone';
+import {getCurrentUserId, getStatusForUserId} from 'mattermost-redux/selectors/entities/users';
+
+import {submitCommand} from 'actions/views/create_comment';
+import {openModal} from 'actions/views/modals';
+import {isCustomStatusEnabled, isCustomStatusExpired, makeGetCustomStatus} from 'selectors/views/custom_status';
+
+import CustomStatusModal from 'components/custom_status/custom_status_modal';
+import DndCustomTimePicker from 'components/dnd_custom_time_picker_modal';
+import ResetStatusModal from 'components/reset_status_modal';
+import UserSettingsModal from 'components/user_settings/modal';
+
+import {getHistory} from 'utils/browser_history';
+import {ModalIdentifiers, UserStatuses} from 'utils/constants';
+import {getCurrentDateTimeForTimezone, getCurrentMomentForTimezone} from 'utils/timezone';
+
+import type {ActionFuncAsync, GlobalState} from 'types/store';
+
+export const SLASH_COMMAND_PREFIX = '>/';
+
+export type PaletteCommandId =
+    'status_online' |
+    'status_away' |
+    'status_dnd_dont_clear' |
+    'status_dnd_30_minutes' |
+    'status_dnd_1_hour' |
+    'status_dnd_2_hours' |
+    'status_dnd_tomorrow' |
+    'status_dnd_custom' |
+    'status_offline' |
+    'custom_status_set' |
+    'custom_status_clear' |
+    'open_settings' |
+    'open_profile' |
+    'open_threads' |
+    'open_drafts' |
+    'open_system_console' |
+    'slash_command';
+
+export type PaletteCommand = {
+    id: PaletteCommandId;
+    label: MessageDescriptor;
+    icon: string;
+    opensModal?: boolean;
+};
+
+const COMMANDS: PaletteCommand[] = [
+    {id: 'status_online', icon: 'icon-check-circle CommandPalette__online', label: defineMessage({id: 'command_palette.status_online', defaultMessage: 'Set status: Online'})},
+    {id: 'status_away', icon: 'icon-clock CommandPalette__away', label: defineMessage({id: 'command_palette.status_away', defaultMessage: 'Set status: Away'})},
+    {id: 'status_dnd_dont_clear', icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_dont_clear', defaultMessage: 'Set status: Do not disturb (don\'t clear)'})},
+    {id: 'status_dnd_30_minutes', icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_30_minutes', defaultMessage: 'Set status: Do not disturb for 30 mins'})},
+    {id: 'status_dnd_1_hour', icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_1_hour', defaultMessage: 'Set status: Do not disturb for 1 hour'})},
+    {id: 'status_dnd_2_hours', icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_2_hours', defaultMessage: 'Set status: Do not disturb for 2 hours'})},
+    {id: 'status_dnd_tomorrow', icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_tomorrow', defaultMessage: 'Set status: Do not disturb until tomorrow 9 AM'})},
+    {id: 'status_dnd_custom', opensModal: true, icon: 'icon-minus-circle CommandPalette__dnd', label: defineMessage({id: 'command_palette.status_dnd_custom', defaultMessage: 'Set status: Do not disturb until a custom time'})},
+    {id: 'status_offline', icon: 'icon-circle-outline', label: defineMessage({id: 'command_palette.status_offline', defaultMessage: 'Set status: Offline'})},
+    {id: 'custom_status_set', opensModal: true, icon: 'icon-emoticon-happy-outline', label: defineMessage({id: 'command_palette.custom_status_set', defaultMessage: 'Set custom status'})},
+    {id: 'custom_status_clear', icon: 'icon-close-circle', label: defineMessage({id: 'command_palette.custom_status_clear', defaultMessage: 'Clear custom status'})},
+    {id: 'open_settings', opensModal: true, icon: 'icon-cog-outline', label: defineMessage({id: 'command_palette.open_settings', defaultMessage: 'Open Settings'})},
+    {id: 'open_profile', opensModal: true, icon: 'icon-account-outline', label: defineMessage({id: 'command_palette.open_profile', defaultMessage: 'Open Profile'})},
+    {id: 'open_threads', icon: 'icon-message-text-outline', label: defineMessage({id: 'command_palette.open_threads', defaultMessage: 'Open Threads'})},
+    {id: 'open_drafts', icon: 'icon-pencil-outline', label: defineMessage({id: 'command_palette.open_drafts', defaultMessage: 'Open Drafts'})},
+    {id: 'open_system_console', icon: 'icon-application-cog', label: defineMessage({id: 'command_palette.open_system_console', defaultMessage: 'Open System Console'})},
+    {id: 'slash_command', icon: 'icon-slash-forward', label: defineMessage({id: 'command_palette.slash_command', defaultMessage: 'Run a slash command'})},
+];
+
+const getCustomStatus = makeGetCustomStatus();
+
+function hasCustomStatus(state: GlobalState) {
+    const customStatus = getCustomStatus(state);
+    return Boolean(customStatus && (customStatus.text || customStatus.emoji) && !isCustomStatusExpired(state, customStatus));
+}
+
+function canOpenSystemConsole(state: GlobalState) {
+    return Permissions.SYSCONSOLE_READ_PERMISSIONS.some((permission) => haveISystemPermission(state, {permission}));
+}
+
+export function listPaletteCommands(state: GlobalState): PaletteCommand[] {
+    return COMMANDS.filter(({id}) => {
+        switch (id) {
+        case 'custom_status_set':
+            return isCustomStatusEnabled(state);
+        case 'custom_status_clear':
+            return isCustomStatusEnabled(state) && hasCustomStatus(state);
+        case 'open_threads':
+            return isCollapsedThreadsEnabled(state);
+        case 'open_system_console':
+            return canOpenSystemConsole(state);
+        default:
+            return true;
+        }
+    });
+}
+
+const DND_END_TIMES: Partial<Record<PaletteCommandId, (now: Moment) => Moment>> = {
+    status_dnd_dont_clear: () => moment(0),
+    status_dnd_30_minutes: (now) => now.add(30, 'minutes'),
+    status_dnd_1_hour: (now) => now.add(1, 'hour'),
+    status_dnd_2_hours: (now) => now.add(2, 'hours'),
+    status_dnd_tomorrow: (now) => now.add(1, 'day').set({hour: 9, minute: 0, second: 0}),
+};
+
+const PLAIN_STATUSES: Partial<Record<PaletteCommandId, string>> = {
+    status_online: UserStatuses.ONLINE,
+    status_away: UserStatuses.AWAY,
+    status_offline: UserStatuses.OFFLINE,
+};
+
+function shouldConfirmStatusChange(state: GlobalState, userId: string) {
+    const autoResetPref = getPreference(state, Preferences.CATEGORY_AUTO_RESET_MANUAL_STATUS, userId, '');
+    return autoResetPref === '' && getStatusForUserId(state, userId) === UserStatuses.OUT_OF_OFFICE;
+}
+
+function openUserSettings(isContentProductSettings: boolean) {
+    return openModal({
+        modalId: ModalIdentifiers.USER_SETTINGS,
+        dialogType: UserSettingsModal,
+        dialogProps: {isContentProductSettings},
+    });
+}
+
+export function runPaletteCommand(id: PaletteCommandId): ActionFuncAsync<boolean> {
+    return async (dispatch, getState) => {
+        const state = getState();
+        const userId = getCurrentUserId(state);
+        const timezone = getCurrentTimezone(state);
+
+        const plainStatus = PLAIN_STATUSES[id];
+        const dndEndTime = DND_END_TIMES[id];
+        const isStatusCommand = Boolean(plainStatus || dndEndTime) || id === 'status_dnd_custom';
+        if (isStatusCommand && shouldConfirmStatusChange(state, userId)) {
+            dispatch(openModal({
+                modalId: ModalIdentifiers.RESET_STATUS,
+                dialogType: ResetStatusModal,
+                dialogProps: {newStatus: plainStatus ?? UserStatuses.DND},
+            }));
+            return {data: true};
+        }
+
+        if (plainStatus) {
+            dispatch(setStatus({user_id: userId, status: plainStatus}));
+            return {data: true};
+        }
+
+        if (dndEndTime) {
+            const endTime = dndEndTime(getCurrentMomentForTimezone(timezone));
+            dispatch(setStatus({user_id: userId, status: UserStatuses.DND, dnd_end_time: endTime.utc().unix()}));
+            return {data: true};
+        }
+
+        switch (id) {
+        case 'status_dnd_custom':
+            dispatch(openModal({
+                modalId: ModalIdentifiers.DND_CUSTOM_TIME_PICKER,
+                dialogType: DndCustomTimePicker,
+                dialogProps: {currentDate: timezone ? getCurrentDateTimeForTimezone(timezone) : new Date()},
+            }));
+            break;
+        case 'custom_status_set':
+            dispatch(openModal({modalId: ModalIdentifiers.CUSTOM_STATUS, dialogType: CustomStatusModal}));
+            break;
+        case 'custom_status_clear':
+            dispatch(unsetCustomStatus());
+            break;
+        case 'open_settings':
+            dispatch(openUserSettings(true));
+            break;
+        case 'open_profile':
+            dispatch(openUserSettings(false));
+            break;
+        case 'open_threads':
+            getHistory().push(`${getCurrentRelativeTeamUrl(state)}/threads`);
+            break;
+        case 'open_drafts':
+            getHistory().push(`${getCurrentRelativeTeamUrl(state)}/drafts`);
+            break;
+        case 'open_system_console':
+            getHistory().push('/admin_console');
+            break;
+        default:
+            return {data: false};
+        }
+
+        return {data: true};
+    };
+}
+
+export function runPaletteSlashCommand(message: string): ActionFuncAsync {
+    return async (dispatch, getState) => {
+        const channelId = getCurrentChannelId(getState());
+        const now = Date.now();
+        try {
+            return await dispatch(submitCommand(channelId, '', {
+                message: message.trim(),
+                fileInfos: [],
+                uploadsInProgress: [],
+                channelId,
+                rootId: '',
+                createAt: now,
+                updateAt: now,
+            }));
+        } catch (error) {
+            return {error};
+        }
+    };
+}
