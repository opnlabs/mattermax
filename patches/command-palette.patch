+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+import {defineMessage, FormattedMessage} from 'react-intl';
+
+import type {AutocompleteSuggestion} from '@mattermost/types/integrations';
+
+import {getCurrentChannelId} from 'mattermost-redux/selectors/entities/channels';
+import {getCurrentTeamId} from 'mattermost-redux/selectors/entities/teams';
+
+import globalStore from 'stores/redux_store';
+
+import CommandProvider from 'components/suggestion/command_provider/command_provider';
+import Provider from 'components/suggestion/provider';
+import type {ResultsCallback} from 'components/suggestion/provider';
+import {SuggestionContainer} from 'components/suggestion/suggestion';
+import type {SuggestionProps} from 'components/suggestion/suggestion';
+import type {Loading, ProviderResults} from 'components/suggestion/suggestion_results';
+
+import {Constants} from 'utils/constants';
+import {getIntl} from 'utils/i18n';
+
+import {listPaletteCommands, SLASH_COMMAND_PREFIX} from './commands';
+import type {PaletteCommand} from './commands';
+
+import './command_palette.scss';
+
+export const PALETTE_PREFIX = '>';
+
+const {EXECUTE_CURRENT_COMMAND_ITEM_ID, OPEN_COMMAND_IN_MODAL_ITEM_ID} = Constants.Integrations;
+
+export type PaletteCommandItem = {
+    paletteCommand: PaletteCommand;
+};
+
+export function isPaletteCommandItem(item: unknown): item is PaletteCommandItem {
+    return Boolean(item && typeof item === 'object' && 'paletteCommand' in item);
+}
+
+export function isSlashCommandSuggestion(item: unknown): item is AutocompleteSuggestion {
+    return Boolean(item && typeof item === 'object' && 'Complete' in item);
+}
+
+const PaletteCommandSuggestion = React.forwardRef<HTMLLIElement, SuggestionProps<PaletteCommandItem>>((props, ref) => {
+    const {icon, label} = props.item.paletteCommand;
+
+    return (
+        <SuggestionContainer
+            ref={ref}
+            {...props}
+        >
+            <span className='suggestion-list__icon suggestion-list__icon--large'>
+                <i
+                    className={`icon ${icon}`}
+                    aria-hidden='true'
+                />
+            </span>
+            <div className='suggestion-list__ellipsis suggestion-list__flex'>
+                <span className='suggestion-list__main'>
+                    <FormattedMessage {...label}/>
+                </span>
+            </div>
+        </SuggestionContainer>
+    );
+});
+PaletteCommandSuggestion.displayName = 'PaletteCommandSuggestion';
+
+function termFor(command: PaletteCommand) {
+    return command.id === 'slash_command' ? SLASH_COMMAND_PREFIX : PALETTE_PREFIX + command.id;
+}
+
+type SlashCommandList = {
+    terms: string[];
+    items: Array<AutocompleteSuggestion | Loading>;
+};
+
+function toPaletteList<List extends SlashCommandList>(list: List): List {
+    const terms: string[] = [];
+    const items: List['items'] = [];
+    list.terms.forEach((term, index) => {
+        if (term.endsWith(OPEN_COMMAND_IN_MODAL_ITEM_ID)) {
+            return;
+        }
+        const command = term.endsWith(EXECUTE_CURRENT_COMMAND_ITEM_ID) ? term.slice(0, -EXECUTE_CURRENT_COMMAND_ITEM_ID.length) : term;
+        terms.push(PALETTE_PREFIX + command);
+        items.push(list.items[index]);
+    });
+    return {...list, terms, items};
+}
+
+function toPaletteResults(results: ProviderResults<AutocompleteSuggestion>): ProviderResults<AutocompleteSuggestion> {
+    const matchedPretext = PALETTE_PREFIX + results.matchedPretext;
+
+    if ('groups' in results) {
+        return {...results, matchedPretext, groups: results.groups.map(toPaletteList)};
+    }
+
+    return {...toPaletteList(results), matchedPretext};
+}
+
+export function getSlashCommandToRun(item: AutocompleteSuggestion) {
+    if (!item.Complete.endsWith(EXECUTE_CURRENT_COMMAND_ITEM_ID)) {
+        return null;
+    }
+    return item.Complete.slice(0, -EXECUTE_CURRENT_COMMAND_ITEM_ID.length);
+}
+
+export default class CommandPaletteProvider extends Provider {
+    private commandProvider: CommandProvider | null = null;
+
+    handlePretextChanged(pretext: string, resultsCallback: ResultsCallback<PaletteCommandItem | AutocompleteSuggestion>) {
+        if (!pretext.startsWith(PALETTE_PREFIX)) {
+            return false;
+        }
+
+        if (pretext.startsWith(SLASH_COMMAND_PREFIX)) {
+            return this.handleSlashCommand(pretext, resultsCallback);
+        }
+
+        const intl = getIntl();
+        const words = pretext.substring(PALETTE_PREFIX.length).toLowerCase().split(/\s+/).filter(Boolean);
+        const commands = listPaletteCommands(globalStore.getState()).filter((command) => {
+            const label = intl.formatMessage(command.label).toLowerCase();
+            return words.every((word) => label.includes(word));
+        });
+
+        resultsCallback({
+            matchedPretext: pretext,
+            groups: [{
+                key: 'commandPalette',
+                label: defineMessage({id: 'suggestion.commands', defaultMessage: 'Commands'}),
+                terms: commands.map(termFor),
+                items: commands.map((paletteCommand) => ({paletteCommand})),
+                component: PaletteCommandSuggestion,
+            }],
+        });
+
+        return true;
+    }
+
+    handleCompleteWord(term: string, matchedPretext: string, callback: (pretext: string) => void) {
+        if (term === SLASH_COMMAND_PREFIX) {
+            callback(SLASH_COMMAND_PREFIX);
+        } else if (term.startsWith(SLASH_COMMAND_PREFIX)) {
+            callback(term + ' ');
+        }
+    }
+
+    private handleSlashCommand(pretext: string, resultsCallback: ResultsCallback<AutocompleteSuggestion>) {
+        const state = globalStore.getState();
+        const props = {teamId: getCurrentTeamId(state), channelId: getCurrentChannelId(state)};
+
+        if (this.commandProvider) {
+            this.commandProvider.setProps(props);
+        } else {
+            this.commandProvider = new CommandProvider(props);
+        }
+
+        return this.commandProvider.handlePretextChanged(
+            pretext.substring(PALETTE_PREFIX.length),
+            (results) => resultsCallback(toPaletteResults(results)),
+        );
+    }
+}
