+func TestContentFlaggingWithoutLicense(t *testing.T) {
+	th := Setup(t).InitBasic(t)
+	th.RemoveLicense(t)
+	require.Nil(t, th.App.License())
+
+	reviewer := th.BasicUser
+	reviewerClient := th.Client
+
+	resp, err := th.SystemAdminClient.SaveContentFlaggingSettings(context.Background(), &model.ContentFlaggingSettingsRequest{
+		ContentFlaggingSettingsBase: model.ContentFlaggingSettingsBase{
+			EnableContentFlagging: new(true),
+		},
+		ReviewerSettings: &model.ReviewSettingsRequest{
+			ReviewerSettings: model.ReviewerSettings{
+				CommonReviewers: new(true),
+			},
+			ReviewerIDsSettings: model.ReviewerIDsSettings{
+				CommonReviewerIds: []string{reviewer.Id},
+			},
+		},
+	})
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+
+	authorClient := th.CreateClient()
+	th.LoginBasic2WithClient(t, authorClient)
+	post := th.CreatePostWithClient(t, authorClient, th.BasicChannel)
+
+	reporter := th.CreateUser(t)
+	th.LinkUserToTeam(t, reporter, th.BasicTeam)
+	th.AddUserToChannel(t, reporter, th.BasicChannel)
+	reporterClient := th.CreateClient()
+	_, _, err = reporterClient.Login(context.Background(), reporter.Email, reporter.Password)
+	require.NoError(t, err)
+
+	status, resp, err := reporterClient.GetTeamPostFlaggingFeatureStatus(context.Background(), th.BasicTeam.Id)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.True(t, status["enabled"])
+
+	flagPostViaAPI(t, reporterClient, post.Id)
+
+	bot, appErr := th.App.GetUserByUsername(model.ContentFlaggingBotUsername)
+	require.Nil(t, appErr)
+	reviewChannel, _, err := reviewerClient.CreateDirectChannel(context.Background(), reviewer.Id, bot.Id)
+	require.NoError(t, err)
+
+	require.EventuallyWithT(t, func(c *assert.CollectT) {
+		posts, _, err := reviewerClient.GetPostsForChannel(context.Background(), reviewChannel.Id, 0, 60, "", false, false)
+		require.NoError(c, err)
+		var found bool
+		for _, p := range posts.Posts {
+			if p.Type == model.ContentFlaggingPostType && p.GetProp(app.POST_PROP_KEY_FLAGGED_POST_ID) == post.Id {
+				found = true
+			}
+		}
+		assert.True(c, found)
+	}, 10*time.Second, 100*time.Millisecond)
+
+	flaggedPost, resp, err := reviewerClient.GetContentFlaggedPost(context.Background(), post.Id)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.Equal(t, post.Message, flaggedPost.Message)
+
+	resp, err = reviewerClient.RemoveFlaggedPost(context.Background(), post.Id, &model.FlagContentActionRequest{Comment: "Removed by review"})
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+
+	statusValue, appErr := th.App.GetPostContentFlaggingPropertyValue(th.Context, post.Id, app.ContentFlaggingPropertyNameStatus)
+	require.Nil(t, appErr)
+	require.Equal(t, `"`+model.ContentFlaggingStatusRemoved+`"`, string(statusValue.Value))
+
+	_, resp, err = authorClient.GetPost(context.Background(), post.Id, "")
+	require.Error(t, err)
+	require.Equal(t, http.StatusNotFound, resp.StatusCode)
+}
