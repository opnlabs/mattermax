+// GetForPosts decodes each cached entry once and batches only cache misses.
+func (s LocalCacheReactionStore) GetForPosts(postIDs []string, allowFromCache bool) (map[string][]*model.Reaction, error) {
+	if !allowFromCache {
+		return s.ReactionStore.GetForPosts(postIDs, false)
+	}
+	result := make(map[string][]*model.Reaction, len(postIDs))
+	missing := make([]string, 0, len(postIDs))
+	for _, id := range postIDs {
+		if _, ok := result[id]; ok {
+			continue
+		}
+		var reactions []*model.Reaction
+		result[id] = nil
+		if err := s.rootStore.doStandardReadCache(s.rootStore.reactionCache, id, &reactions); err == nil {
+			result[id] = reactions
+		} else {
+			missing = append(missing, id)
+		}
+	}
+	if len(missing) > 0 {
+		fetched, err := s.ReactionStore.GetForPosts(missing, false)
+		if err != nil {
+			return nil, err
+		}
+		for _, id := range missing {
+			result[id] = fetched[id]
+			s.rootStore.doStandardAddToCache(s.rootStore.reactionCache, id, fetched[id])
+		}
+	}
+	return result, nil
+}
