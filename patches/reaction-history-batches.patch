+		}
+		for _, id := range []string{ids[0], ids[1000]} {
+			for i := 0; i < 3; i++ {
+				_, err := sqlStore.GetMaster().Exec("INSERT INTO Reactions (UserId, PostId, EmojiName, CreateAt, UpdateAt, DeleteAt, RemoteId, ChannelId) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", model.NewId(), id, "smile", 100+i, 200+i, 0, "remote", "channel")
+				require.NoError(t, err)
+			}
+			_, err := sqlStore.GetMaster().Exec("INSERT INTO Reactions (UserId, PostId, EmojiName, CreateAt, UpdateAt, DeleteAt, RemoteId, ChannelId) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", model.NewId(), id, "heart", 90, 200, 300, "", "channel")
+			require.NoError(t, err)
+		}
+		// Legacy rows permit NULL timestamps; use the same COALESCE as GetForPost.
+		_, err := sqlStore.GetMaster().Exec("INSERT INTO Reactions (UserId, PostId, EmojiName, CreateAt, UpdateAt, DeleteAt, ChannelId) VALUES (?, ?, ?, ?, NULL, NULL, ?)", model.NewId(), ids[0], "tada", 99, "channel")
+		require.NoError(t, err)
+		t.Cleanup(func() {
+			for _, id := range []string{ids[0], ids[1000]} {
+				_, _ = sqlStore.GetMaster().Exec("DELETE FROM Reactions WHERE PostId = ?", id)
+			}
+		})
+		got, err := ss.Reaction().GetForPosts(append(ids, ids[0]), false)
+		require.NoError(t, err)
+		require.Len(t, got, len(ids))
+		for _, id := range ids {
+			want, err := ss.Reaction().GetForPost(id, false)
+			require.NoError(t, err)
+			require.Equal(t, want, got[id])
+		}
+		require.Len(t, got[ids[0]], 4)
+		require.EqualValues(t, 99, got[ids[0]][0].UpdateAt)
+		require.NotNil(t, got[ids[1000]][0].RemoteId)
+		require.Equal(t, "remote", *got[ids[1000]][0].RemoteId)
+		empty, err := ss.Reaction().GetForPosts(nil, false)
+		require.NoError(t, err)
+		require.Empty(t, empty)
+	})
+}
