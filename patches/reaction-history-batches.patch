+// BenchmarkReactionHistory prepares real stored history pages. Cache purges are
+// outside the timer; cold measures SQL/cache fills, warm measures cached reads.
+// No files, custom emoji or remote links are included.
+func BenchmarkReactionHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableLinkPreviews = false })
+	cached, ok := th.App.Srv().Store().(localcachelayer.LocalCacheStore)
+	if !ok {
+		b.Fatal("expected real local-cache store")
+	}
+	for _, size := range []int{1, 10, 60} {
+		b.Run(fmt.Sprintf("posts=%d", size), func(b *testing.B) {
+			list := model.NewPostList()
+			for range size {
+				post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "reaction history"})
+				if err != nil {
+					b.Fatal(err)
+				}
+				for _, emoji := range []string{"smile", "heart", "tada"} {
+					_, err := th.App.Srv().Store().Reaction().Save(&model.Reaction{PostId: post.Id, ChannelId: post.ChannelId, UserId: post.UserId, EmojiName: emoji})
+					if err != nil {
+						b.Fatal(err)
+					}
+				}
+				post.HasReactions = true
+				list.AddPost(post)
+				list.AddOrder(post.Id)
+			}
+			check := func(result *model.PostList) {
+				if len(result.Order) != size {
+					b.Fatal("incorrect history order")
+				}
+				for id := range list.Posts {
+					p := result.Posts[id]
+					if p == nil || p.Metadata == nil || len(p.Metadata.Reactions) != 3 {
+						b.Fatal("missing reaction metadata")
+					}
+					for _, r := range p.Metadata.Reactions {
+						if r.PostId != id || r.DeleteAt != 0 {
+							b.Fatal("incorrect reaction metadata")
+						}
+					}
+				}
+			}
+			for _, mode := range []string{"cold", "warm"} {
+				b.Run(mode, func(b *testing.B) {
+					check(th.App.PreparePostListForClient(th.Context, list))
+					b.ReportAllocs()
+					b.ResetTimer()
+					for range b.N {
+						if mode == "cold" {
+							b.StopTimer()
+							cached.Invalidate()
+							b.StartTimer()
+						}
+						check(th.App.PreparePostListForClient(th.Context, list))
+					}
+				})
+			}
+		})
+	}
+}
