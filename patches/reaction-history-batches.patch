+func TestReactionHistoryHiddenAndEmpty(t *testing.T) {
+	th := SetupConfigWithStoreMock(t, func(cfg *model.Config) {
+		*cfg.ServiceSettings.EnableCustomEmoji = false
+		*cfg.ServiceSettings.PostPriority = false
+	})
+	rctx := th.Context.WithSession(&model.Session{UserId: model.NewId()})
+	empty := &model.Post{Id: model.NewId(), HasReactions: true}
+	hidden := &model.Post{Id: model.NewId(), Type: model.PostTypeBurnOnRead, UserId: model.NewId(), HasReactions: true}
+	list := model.NewPostList()
+	list.AddPost(empty)
+	list.AddPost(hidden)
+	rs := &mocks.ReactionStore{}
+	th.App.Srv().Store().(*mocks.Store).On("Reaction").Return(rs)
+	rs.On("GetForPosts", mock.Anything, true).Return(map[string][]*model.Reaction{
+		empty.Id:  nil,
+		hidden.Id: {{PostId: hidden.Id, EmojiName: "smile"}},
+	}, nil).Once()
+	got := th.App.PreparePostListForClient(rctx, list)
+	require.Nil(t, got.Posts[empty.Id].Metadata.Reactions)
+	require.Nil(t, got.Posts[hidden.Id].Metadata.Reactions)
+	require.Zero(t, got.Posts[hidden.Id].Metadata.ExpireAt)
+	rs.AssertExpectations(t)
+	rs.AssertNotCalled(t, "GetForPost", mock.Anything, mock.Anything)
+	// A single eligible post keeps its existing single-post cache lookup.
+	single := model.NewPostList()
+	single.AddPost(empty)
+	rs.On("GetForPost", empty.Id, true).Return([]*model.Reaction{}, nil).Once()
+	got = th.App.PreparePostListForClient(rctx, single)
+	require.NotNil(t, got.Posts[empty.Id].Metadata.Reactions)
+	require.Empty(t, got.Posts[empty.Id].Metadata.Reactions)
+	rs.AssertExpectations(t)
+	rs.AssertNumberOfCalls(t, "GetForPosts", 1)
+}
