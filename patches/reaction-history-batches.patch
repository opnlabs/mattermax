+func TestPrepareReactionHistory(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(fmt.Sprintf("bulk failure=%t", fail), func(t *testing.T) {
+			th := SetupConfigWithStoreMock(t, func(cfg *model.Config) {
+				*cfg.ServiceSettings.EnableCustomEmoji = false
+				*cfg.ServiceSettings.PostPriority = false
+			})
+			list := model.NewPostList()
+			reactions := make(map[string][]*model.Reaction)
+			for range 3 {
+				p := &model.Post{Id: model.NewId(), Message: "history", HasReactions: true}
+				list.AddPost(p)
+				reactions[p.Id] = []*model.Reaction{{PostId: p.Id, EmojiName: "smile"}}
+			}
+			deleted := &model.Post{Id: model.NewId(), DeleteAt: 1, HasReactions: true, Message: "deleted"}
+			list.AddPost(deleted)
+			rs := &mocks.ReactionStore{}
+			th.App.Srv().Store().(*mocks.Store).On("Reaction").Return(rs)
+			rs.On("GetForPosts", mock.MatchedBy(func(ids []string) bool {
+				if len(ids) != 3 {
+					return false
+				}
+				for _, id := range ids {
+					if id == deleted.Id {
+						return false
+					}
+				}
+				return true
+			}), true).Return(func([]string, bool) map[string][]*model.Reaction {
+				if fail {
+					return nil
+				}
+				return reactions
+			}, func([]string, bool) error {
+				if fail {
+					return errors.New("bulk failed")
+				}
+				return nil
+			}).Once()
+			if fail {
+				for id, r := range reactions {
+					rs.On("GetForPost", id, true).Return(r, nil).Once()
+				}
+			}
+			got := th.App.PreparePostListForClient(th.Context, list)
+			for id, want := range reactions {
+				require.Equal(t, want, got.Posts[id].Metadata.Reactions)
+				require.Nil(t, list.Posts[id].Metadata)
+			}
+			require.Empty(t, got.Posts[deleted.Id].Message)
+			require.Nil(t, got.Posts[deleted.Id].Metadata.Reactions)
+			rs.AssertExpectations(t)
+			if !fail {
+				rs.AssertNotCalled(t, "GetForPost", mock.Anything, mock.Anything)
+			}
+		})
+	}
+}
