+func TestReactionBulkCache(t *testing.T) {
+	mockStore := getMockStore(t)
+	base := mockStore.Reaction().(*mocks.ReactionStore)
+	base.ExpectedCalls = nil
+	base.On("Save", &model.Reaction{PostId: "a"}).Return(&model.Reaction{PostId: "a"}, nil).Once()
+	base.On("Delete", &model.Reaction{PostId: "a"}).Return(&model.Reaction{PostId: "a"}, nil).Once()
+	cached, err := NewLocalCacheLayer(mockStore, nil, nil, getMockCacheProvider(), mlog.CreateConsoleTestLogger(t))
+	require.NoError(t, err)
+	active := []*model.Reaction{{PostId: "a", EmojiName: "smile"}}
+	base.On("GetForPosts", []string{"a", "empty"}, false).Return(map[string][]*model.Reaction{"a": active, "empty": nil}, nil).Once()
+	first, err := cached.Reaction().GetForPosts([]string{"a", "empty", "a"}, true)
+	require.NoError(t, err)
+	require.Equal(t, active, first["a"])
+	require.Contains(t, first, "empty")
+	require.Nil(t, first["empty"])
+	// Bulk fills are visible to existing single-post readers, including empty hits.
+	hit, err := cached.Reaction().GetForPost("a", true)
+	require.NoError(t, err)
+	require.Equal(t, active, hit)
+	empty, err := cached.Reaction().GetForPost("empty", true)
+	require.NoError(t, err)
+	require.Nil(t, empty)
+	base.On("GetForPosts", []string{"b"}, false).Return(map[string][]*model.Reaction{"b": active}, nil).Once()
+	_, err = cached.Reaction().GetForPosts([]string{"a", "b", "empty"}, true)
+	require.NoError(t, err)
+	// Existing Save/Delete invalidation also invalidates batch-filled entries.
+	_, err = cached.Reaction().Delete(&model.Reaction{PostId: "a"})
+	require.NoError(t, err)
+	base.On("GetForPosts", []string{"a"}, false).Return(map[string][]*model.Reaction{"a": nil}, nil).Once()
+	cleared, err := cached.Reaction().GetForPosts([]string{"a", "empty"}, true)
+	require.NoError(t, err)
+	require.Nil(t, cleared["a"])
+	_, err = cached.Reaction().Save(&model.Reaction{PostId: "a"})
+	require.NoError(t, err)
+	base.On("GetForPosts", []string{"a"}, false).Return(nil, errors.New("unavailable")).Once()
+	_, err = cached.Reaction().GetForPosts([]string{"a", "empty"}, true)
+	require.Error(t, err)
+	base.On("GetForPosts", []string{"a"}, false).Return(map[string][]*model.Reaction{"a": active}, nil).Once()
+	_, err = cached.Reaction().GetForPosts([]string{"a", "empty"}, true)
+	require.NoError(t, err)
+	// Explicit cache bypass must reach SQL even when every entry is cached.
+	base.On("GetForPosts", []string{"a", "empty"}, false).Return(map[string][]*model.Reaction{"a": nil, "empty": nil}, nil).Once()
+	_, err = cached.Reaction().GetForPosts([]string{"a", "empty"}, false)
+	require.NoError(t, err)
+	base.AssertExpectations(t)
+	base.AssertNotCalled(t, "GetForPost", "a", false)
+}
