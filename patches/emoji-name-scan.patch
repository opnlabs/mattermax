 server/channels/app/post_metadata.go        |  28 +++-
 2 files changed, 174 insertions(+), 6 deletions(-)
 create mode 100644 server/channels/app/emoji_name_scan_test.go

diff --git a/server/channels/app/emoji_name_scan_test.go b/server/channels/app/emoji_name_scan_test.go
