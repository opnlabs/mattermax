+func (s *RetryLayerPostStore) GetThreadLastActivityAt(rctx request.CTX, rootID string) (int64, error) {
+
+	tries := 0
+	for {
+		result, err := s.PostStore.GetThreadLastActivityAt(rctx, rootID)
+		if err == nil {
+			return result, nil
+		}
+		if !isRepeatableError(err) {
+			return result, err
+		}
+		tries++
+		if tries >= 3 {
+			err = errors.Wrap(err, "giving up after 3 consecutive repeatable transaction failures")
+			return result, err
+		}
+		timepkg.Sleep(100 * timepkg.Millisecond)
+	}
+
+}
