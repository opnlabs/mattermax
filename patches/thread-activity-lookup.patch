+// GetThreadLastActivityAt provides a mock function with given fields: rctx, rootID
+func (_m *PostStore) GetThreadLastActivityAt(rctx request.CTX, rootID string) (int64, error) {
+	ret := _m.Called(rctx, rootID)
+
+	if len(ret) == 0 {
+		panic("no return value specified for GetThreadLastActivityAt")
+	}
+
+	var r0 int64
+	var r1 error
+	if rf, ok := ret.Get(0).(func(request.CTX, string) (int64, error)); ok {
+		return rf(rctx, rootID)
+	}
+	if rf, ok := ret.Get(0).(func(request.CTX, string) int64); ok {
+		r0 = rf(rctx, rootID)
+	} else {
+		r0 = ret.Get(0).(int64)
+	}
+
+	if rf, ok := ret.Get(1).(func(request.CTX, string) error); ok {
+		r1 = rf(rctx, rootID)
+	} else {
+		r1 = ret.Error(1)
+	}
+
+	return r0, r1
+}
