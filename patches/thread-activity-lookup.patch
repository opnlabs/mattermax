+// GetThreadLastActivityAt reads only the timestamps needed for auto-archive.
+// Avoid hydrating the post, counting replies or decoding thread participants.
+func (s *SqlPostStore) GetThreadLastActivityAt(rctx request.CTX, rootID string) (int64, error) {
+	query := s.getQueryBuilder().
+		Select("GREATEST(Posts.CreateAt, COALESCE(Threads.LastReplyAt, 0))").
+		From("Posts").
+		LeftJoin("Threads ON Threads.PostId = Posts.Id").
+		Where(sq.Eq{"Posts.Id": rootID, "Posts.DeleteAt": 0})
+	var lastActivityAt int64
+	if err := s.DBXFromContext(rctx.Context()).GetBuilder(&lastActivityAt, query); err != nil {
+		if err == sql.ErrNoRows {
+			return 0, store.NewErrNotFound("Post", rootID)
+		}
+		return 0, errors.Wrapf(err, "failed to get thread activity for post id=%s", rootID)
+	}
+	return lastActivityAt, nil
+}
