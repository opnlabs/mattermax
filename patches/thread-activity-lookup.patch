+func TestThreadLastActivityLookup(t *testing.T) {
+	StoreTest(t, func(t *testing.T, rctx request.CTX, ss store.Store) {
+		channel, err := ss.Channel().Save(rctx, &model.Channel{TeamId: model.NewId(), Name: "activity-" + model.NewId(), DisplayName: "Activity test", Type: model.ChannelTypeOpen}, -1)
+		require.NoError(t, err)
+		root, err := ss.Post().Save(rctx, &model.Post{ChannelId: channel.Id, UserId: model.NewId(), Message: "activity root"})
+		require.NoError(t, err)
+		sqlStore := ss.(*SqlStore)
+		lookup := func(want int64) {
+			t.Helper()
+			got, err := ss.Post().GetThreadLastActivityAt(rctx, root.Id)
+			require.NoError(t, err)
+			require.Equal(t, want, got)
+		}
+		lookup(root.CreateAt) // No Threads row yet.
+		reply, err := ss.Post().Save(rctx, &model.Post{ChannelId: root.ChannelId, UserId: root.UserId, RootId: root.Id, Message: "recent reply", CreateAt: root.CreateAt + 1000})
+		require.NoError(t, err)
+		lookup(reply.CreateAt)
+		_, err = sqlStore.GetMaster().Exec("UPDATE Threads SET LastReplyAt=? WHERE PostId=?", root.CreateAt-1000, root.Id)
+		require.NoError(t, err)
+		lookup(root.CreateAt) // Imported metadata may precede the root.
+		_, err = sqlStore.GetMaster().Exec("UPDATE Threads SET LastReplyAt=? WHERE PostId=?", reply.CreateAt, root.Id)
+		require.NoError(t, err)
+		require.NoError(t, ss.Post().Delete(rctx, reply.Id, model.GetMillis(), root.UserId))
+		// Deletion can recompute metadata; use the existing read path as oracle.
+		legacyRoot, err := ss.Post().GetSingle(rctx, root.Id, false)
+		require.NoError(t, err)
+		thread, err := ss.Thread().Get(root.Id)
+		require.NoError(t, err)
+		want := legacyRoot.CreateAt
+		if thread != nil {
+			want = max(want, thread.LastReplyAt)
+		}
+		lookup(want)
+		_, err = ss.Post().GetThreadLastActivityAt(rctx, model.NewId())
+		var notFound *store.ErrNotFound
+		require.ErrorAs(t, err, &notFound)
+		require.NoError(t, ss.Post().Delete(rctx, root.Id, model.GetMillis(), root.UserId))
+		_, err = ss.Post().GetThreadLastActivityAt(rctx, root.Id)
+		require.ErrorAs(t, err, &notFound)
+	})
+}
