+// BenchmarkThreadActivityLookup compares the two store paths used to decide
+// auto-archive, including database/driver cost but excluding HTTP and posting.
+func BenchmarkThreadActivityLookup(b *testing.B) {
+	if len(storeTypes) == 0 {
+		b.Fatal("PostgreSQL store is required")
+	}
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			for _, replies := range []int{0, 1000, 10000} {
+				b.Run(fmt.Sprintf("replies=%d", replies), func(b *testing.B) {
+					rctx := request.TestContext(b)
+					channel, err := st.Store.Channel().Save(rctx, &model.Channel{TeamId: model.NewId(), Name: "activity-" + model.NewId(), DisplayName: "Activity benchmark", Type: model.ChannelTypeOpen}, -1)
+					if err != nil {
+						b.Fatal(err)
+					}
+					root, err := st.Store.Post().Save(rctx, &model.Post{ChannelId: channel.Id, UserId: model.NewId(), Message: strings.Repeat("root message ", 100)})
+					if err != nil {
+						b.Fatal(err)
+					}
+					b.Cleanup(func() {
+						if _, err := st.SqlStore.GetMaster().Exec("DELETE FROM Channels WHERE Id=?", channel.Id); err != nil {
+							b.Error(err)
+						}
+						if _, err := st.SqlStore.GetMaster().Exec("DELETE FROM Posts WHERE Id=? OR RootId=?", root.Id, root.Id); err != nil {
+							b.Error(err)
+						}
+						if _, err := st.SqlStore.GetMaster().Exec("DELETE FROM Threads WHERE PostId=?", root.Id); err != nil {
+							b.Error(err)
+						}
+					})
+					expected := root.CreateAt
+					if replies > 0 {
+						// Seed outside timing; preserve current full-table indexes. Participant
+						// data is representative only of this synthetic test, not a real channel.
+						_, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Posts(Id,RootId,ChannelId,UserId,CreateAt,UpdateAt,DeleteAt,Message,Type,Props,Hashtags,Filenames,FileIds,RemoteId)
+       SELECT substr(md5(? || n::text),1,26),?,?,?,CAST(? AS bigint)+n,CAST(? AS bigint)+n,0,'benchmark reply','','{}','','','[]','' FROM generate_series(1,?) n`, root.Id, root.Id, root.ChannelId, root.UserId, root.CreateAt, root.CreateAt, replies)
+						if err != nil {
+							b.Fatal(err)
+						}
+						expected += int64(replies)
+						_, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Threads(PostId,ChannelId,ReplyCount,LastReplyAt,Participants,ThreadTeamId) VALUES(?,?,?,?,?,'')`, root.Id, root.ChannelId, replies, expected, model.StringArray{root.UserId})
+						if err != nil {
+							b.Fatal(err)
+						}
+					}
+					for _, variant := range []string{"legacy", "scalar"} {
+						b.Run(variant, func(b *testing.B) {
+							lookup := func() (int64, error) {
+								if variant == "scalar" {
+									return st.Store.Post().GetThreadLastActivityAt(rctx, root.Id)
+								}
+								post, err := st.Store.Post().GetSingle(rctx, root.Id, false)
+								if err != nil {
+									return 0, err
+								}
+								thread, err := st.Store.Thread().Get(root.Id)
+								if err != nil {
+									return 0, err
+								}
+								if thread != nil {
+									return max(post.CreateAt, thread.LastReplyAt), nil
+								}
+								return post.CreateAt, nil
+							}
+							got, err := lookup()
+							if err != nil || got != expected {
+								b.Fatalf("activity=%d want=%d error=%v", got, expected, err)
+							}
+							b.ReportAllocs()
+							b.ResetTimer()
+							for i := 0; i < b.N; i++ {
+								got, err := lookup()
+								if err != nil || got != expected {
+									b.Fatalf("activity=%d want=%d error=%v", got, expected, err)
+								}
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
