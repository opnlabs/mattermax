+func TestAnonymousURLsWithoutLicense(t *testing.T) {
+	th := Setup(t).InitBasic(t)
+	th.RemoveLicense(t)
+	require.Nil(t, th.App.Channels().License())
+
+	existingChannel := th.BasicChannel
+	existingTeam := th.BasicTeam
+
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.PrivacySettings.UseAnonymousURLs = true })
+
+	channelName := GenerateTestChannelName()
+	channel, resp, err := th.Client.CreateChannel(context.Background(), &model.Channel{DisplayName: "Anonymous Channel", Name: channelName, Type: model.ChannelTypeOpen, TeamId: existingTeam.Id})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+	require.NotEqual(t, channelName, channel.Name)
+	require.True(t, model.IsValidId(channel.Name))
+
+	teamName := GenerateTestTeamName()
+	team, resp, err := th.Client.CreateTeam(context.Background(), &model.Team{DisplayName: "Anonymous Team", Name: teamName, Type: model.TeamOpen})
+	require.NoError(t, err)
+	CheckCreatedStatus(t, resp)
+	require.NotEqual(t, teamName, team.Name)
+	require.True(t, model.IsValidId(team.Name))
+
+	patchedChannel, _, err := th.Client.PatchChannel(context.Background(), existingChannel.Id, &model.ChannelPatch{DisplayName: model.NewPointer("Renamed Channel")})
+	require.NoError(t, err)
+	require.Equal(t, existingChannel.Name, patchedChannel.Name)
+
+	patchedTeam, _, err := th.SystemAdminClient.PatchTeam(context.Background(), existingTeam.Id, &model.TeamPatch{DisplayName: model.NewPointer("Renamed Team")})
+	require.NoError(t, err)
+	require.Equal(t, existingTeam.Name, patchedTeam.Name)
+
+	fetchedChannel, _, err := th.Client.GetChannelByName(context.Background(), existingChannel.Name, existingTeam.Id, "")
+	require.NoError(t, err)
+	require.Equal(t, existingChannel.Id, fetchedChannel.Id)
+
+	fetchedTeam, _, err := th.Client.GetTeamByName(context.Background(), existingTeam.Name, "")
+	require.NoError(t, err)
+	require.Equal(t, existingTeam.Id, fetchedTeam.Id)
+}
