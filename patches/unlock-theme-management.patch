diff --git a/webapp/channels/src/components/admin_console/admin_definition_theme_settings.test.tsx b/webapp/channels/src/components/admin_console/admin_definition_theme_settings.test.tsx
index e7cdf580c2e6..daca787d78ac 100644
--- a/webapp/channels/src/components/admin_console/admin_definition_theme_settings.test.tsx
+++ b/webapp/channels/src/components/admin_console/admin_definition_theme_settings.test.tsx
@@ -39,6 +39,18 @@ describe('AdminDefinition - graduated theme and onboarding settings', () => {
         expect(findSetting(experimentalSettings, key)).toBeUndefined();
     });
 
+    test.each([
+        'ThemeSettings.EnableThemeSelection',
+        'ThemeSettings.AllowCustomThemes',
+        'ThemeSettings.AllowedThemes',
+        'ThemeSettings.DefaultTheme',
+    ])('%s is shown without a license', (key) => {
+        const isHidden = findSetting(customizationSettings, key)?.isHidden;
+        const hidden = typeof isHidden === 'function' ? isHidden({}, {}, {IsLicensed: 'false'}) : Boolean(isHidden);
+
+        expect(hidden).toBe(false);
+    });
+
