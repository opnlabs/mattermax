+func TestSlowmodeLastPostLookup(t *testing.T) {
+	StoreTest(t, func(t *testing.T, rctx request.CTX, ss store.Store) {
+		channel, err := ss.Channel().Save(rctx, &model.Channel{TeamId: model.NewId(), DisplayName: "Slowmode lookup", Name: "slowmode-" + model.NewId(), Type: model.ChannelTypeOpen}, -1)
+		require.NoError(t, err)
+		userID, otherUser, otherChannel := model.NewId(), model.NewId(), model.NewId()
+		since := model.GetMillis() - 60000
+		latest := func(since int64) int64 {
+			t.Helper()
+			at, err := ss.Post().GetLastCreateAtForUserInChannel(channel.Id, userID, since)
+			require.NoError(t, err)
+			return at
+		}
+		save := func(uid, cid string, at int64, kind string) *model.Post {
+			t.Helper()
+			p, err := ss.Post().Save(rctx, &model.Post{ChannelId: cid, UserId: uid, CreateAt: at, Message: "slowmode lookup fixture", Type: kind})
+			require.NoError(t, err)
+			return p
+		}
+		require.Zero(t, latest(since))
+		save(userID, channel.Id, since, "")
+		save(otherUser, channel.Id, since+30000, "")
+		save(userID, otherChannel, since+30000, "")
+		save(userID, channel.Id, since+30000, "system_join_channel")
+		require.Zero(t, latest(since), "cutoff, other authors/channels and system messages must not start the interval")
+		save(userID, channel.Id, since+1, "")
+		require.Equal(t, since+1, latest(since))
+		post := save(userID, channel.Id, since+20000, "")
+		require.Equal(t, post.CreateAt, latest(since))
+		require.NoError(t, ss.Post().Delete(rctx, post.Id, model.GetMillis(), userID))
+		require.Equal(t, post.CreateAt, latest(since), "deleted posts must retain the cooldown")
+		require.Zero(t, latest(post.CreateAt), "the lower timestamp bound is exclusive")
+
+		sqlStore := ss.(*SqlStore)
+		var valid bool
+		require.NoError(t, sqlStore.GetMaster().Get(&valid, `SELECT i.indisvalid AND i.indisready FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relname='idx_posts_channel_user_create_at' AND n.nspname=current_schema()`))
+		require.True(t, valid, "the online migration must leave a usable index")
+	})
+}
