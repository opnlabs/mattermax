--- /dev/null
+++ b/server/channels/db/migrations/postgres/000243_posts_channel_user_create_at.down.sql
@@ -0,0 +1,2 @@
+-- morph:nontransactional
+DROP INDEX CONCURRENTLY IF EXISTS idx_posts_channel_user_create_at;
diff --git a/server/channels/db/migrations/postgres/000243_posts_channel_user_create_at.up.sql b/server/channels/db/migrations/postgres/000243_posts_channel_user_create_at.up.sql
new file mode 100644
index 000000000000..a6cc9bb546ae
--- /dev/null
+++ b/server/channels/db/migrations/postgres/000243_posts_channel_user_create_at.up.sql
@@ -0,0 +1,4 @@
+-- morph:nontransactional
+CREATE INDEX CONCURRENTLY idx_posts_channel_user_create_at
+    ON posts (channelid, userid, createat)
