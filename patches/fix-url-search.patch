diff --git a/server/channels/store/sqlstore/utils.go b/server/channels/store/sqlstore/utils.go
index 2f36cf21da94..aa1a752d7f3b 100644
--- a/server/channels/store/sqlstore/utils.go
+++ b/server/channels/store/sqlstore/utils.go
@@ -248,6 +248,27 @@ func expandNumericTerms(terms string) string {
 	return strings.Join(fields, " ")
 }
 
+var urlPathTermRegex = regexp.MustCompile(`^[^\s"/]+\.[^\s"/]+/[^\s"]*$`)
+
+// expandURLPathTerms rewrites each unquoted "host/path" term to
+// "(host/path|host/path/)". Postgres indexes a whole URL, trailing slash
+// included, as one lexeme, and the search parser strips trailing punctuation
+// from terms, so the URL is matched both with and without the slash.
+func expandURLPathTerms(terms string) string {
+	fields := strings.Fields(terms)
+	inQuote := false
+	for i, f := range fields {
+		if !inQuote && urlPathTermRegex.MatchString(f) && !strings.HasSuffix(f, ":*") {
+			base := strings.TrimRight(f, "/")
+			fields[i] = "(" + base + "|" + base + "/)"
+		}
+		if strings.Count(f, `"`)%2 == 1 {
+			inQuote = !inQuote
+		}
+	}
+	return strings.Join(fields, " ")
+}
