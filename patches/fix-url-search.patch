+func TestExpandURLPathTerms(t *testing.T) {
+	testCases := []struct {
+		name     string
+		input    string
+		expected string
+	}{
+		{"url with path", "example.com/a-b/c", "(example.com/a-b/c|example.com/a-b/c/)"},
+		{"url with trailing slash", "example.com/a-b/c/", "(example.com/a-b/c|example.com/a-b/c/)"},
+		{"url with other terms", "see example.com/docs today", "see (example.com/docs|example.com/docs/) today"},
+		{"domain only", "example.com", "example.com"},
+		{"domain with slash only", "example.com/", "(example.com|example.com/)"},
+		{"path without a domain", "docs/guide", "docs/guide"},
+		{"wildcard url", "example.com/docs:*", "example.com/docs:*"},
+		{"url inside a quoted phrase", `"see example.com/docs"`, `"see example.com/docs"`},
+		{"url after a quoted phrase", `"see this" example.com/docs`, `"see this" (example.com/docs|example.com/docs/)`},
+		{"no urls", "flight today", "flight today"},
+		{"empty string", "", ""},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.expected, expandURLPathTerms(tc.input))
+		})
+	}
+}
