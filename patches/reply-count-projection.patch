+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"fmt"
+	"os"
+	"testing"
+
+	"github.com/lib/pq"
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	sq "github.com/mattermost/squirrel"
+)
+
+// BenchmarkReplyCountProjection checks aggregate and real Save/SaveMultiple
+// outputs. Seeding, visibility preparation, plans and cleanup are untimed.
+func BenchmarkReplyCountProjection(b *testing.B) {
+	if len(storeTypes) == 0 {
+		b.Fatal("PostgreSQL store required")
+	}
+	for _, st := range storeTypes {
+		b.Run(st.Name, func(b *testing.B) {
+			var definitions string
+			if err := st.SqlStore.GetMaster().Get(&definitions, "SELECT COALESCE(json_agg(indexdef ORDER BY indexname)::text,'[]') FROM pg_indexes WHERE schemaname=current_schema() AND tablename='posts'"); err != nil {
+				b.Fatal(err)
+			}
+			b.Logf("reply_count_indexes: %s", definitions)
+			for _, history := range []int{0, 1000, 10000} {
+				b.Run(fmt.Sprintf("initial_replies=%d", history), func(b *testing.B) {
+					for _, rootCount := range []int{1, 10} {
+						b.Run(fmt.Sprintf("roots=%d", rootCount), func(b *testing.B) {
+							for _, visibility := range []string{"vacuumed", "fresh"} {
+								b.Run(visibility, func(b *testing.B) {
+									rctx := request.TestContext(b)
+									user := model.NewId()
+									channel, err := st.Store.Channel().Save(rctx, &model.Channel{Name: model.NewId(), DisplayName: "Reply count benchmark", Type: model.ChannelTypeOpen}, 999)
+									if err != nil {
+										b.Fatal(err)
+									}
+									const base = int64(1000000)
+									roots := make([]*model.Post, rootCount)
+									for i := range roots {
+										roots[i] = &model.Post{ChannelId: channel.Id, UserId: user, Message: "root", CreateAt: base}
+									}
+									if _, _, err = st.Store.Post().SaveMultiple(rctx, roots); err != nil {
+										b.Fatal(err)
+									}
+									ids := make([]string, len(roots))
+									posts := make([]*model.Post, len(roots))
+									for i, root := range roots {
+										ids[i] = root.Id
+										posts[i] = &model.Post{RootId: root.Id}
+									}
+									b.Cleanup(func() {
+										for _, q := range []string{"DELETE FROM Posts WHERE ChannelId=?", "DELETE FROM Threads WHERE ChannelId=?", "DELETE FROM Channels WHERE Id=?"} {
+											if _, e := st.SqlStore.GetMaster().Exec(q, channel.Id); e != nil {
+												b.Error(e)
+											}
+										}
+									})
+									if history > 0 {
+										if _, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Posts(Id,RootId,ChannelId,UserId,CreateAt,UpdateAt,DeleteAt,Message,Type,Props,Hashtags,Filenames,FileIds,RemoteId)
+                                            SELECT substr(md5(id||n::text),1,26),id,?,?,?::bigint+n,?::bigint+n,CASE WHEN n%7=0 THEN 1 ELSE 0 END,repeat('history reply ',50),'','{}','','[]','[]',''
+                                            FROM generate_series(1,?) n CROSS JOIN unnest(?::varchar[]) id ORDER BY n,id`, channel.Id, user, base, base, history, pq.Array(ids)); err != nil {
+											b.Fatal(err)
+										}
+										if _, err = st.SqlStore.GetMaster().Exec(`INSERT INTO Threads(PostId,ChannelId,ReplyCount,LastReplyAt,Participants,ThreadTeamId)
+                                            SELECT id,?,?,?,? ,'' FROM unnest(?::varchar[]) id`, channel.Id, history-history/7, base+int64(history), model.StringArray{user}, pq.Array(ids)); err != nil {
+											b.Fatal(err)
+										}
+									}
+									if visibility == "vacuumed" {
+										_, err = st.SqlStore.GetMaster().ExecNoTimeout("VACUUM ANALYZE Posts")
+									} else {
+										_, err = st.SqlStore.GetMaster().ExecNoTimeout("ANALYZE Posts")
+									}
+									if err != nil {
+										b.Fatal(err)
+									}
+									plan := func(label string) {
+										b.Helper()
+										projection := "RootId, COUNT(*) AS Count"
+										if os.Getenv("MATTERMAX_REPLY_COUNT_VARIANT") == "before" {
+											projection = "RootId, COUNT(Id) AS Count"
+										}
+										query := st.SqlStore.getQueryBuilder().Select(projection).From("Posts").Where(sq.Eq{"RootId": ids}).Where(sq.Eq{"Posts.DeleteAt": 0}).GroupBy("RootId")
+										text, args, err := query.ToSql()
+										if err != nil {
+											b.Fatal(err)
+										}
+										var result string
+										if err = st.SqlStore.GetMaster().Get(&result, "EXPLAIN(ANALYZE,BUFFERS,FORMAT JSON) "+text, args...); err != nil {
+											b.Fatal(err)
+										}
+										b.Logf("reply_count_plan %s: %s", label, result)
+									}
+									for _, method := range []string{"populate", "save", "root_control"} {
+										b.Run(method, func(b *testing.B) {
+											expected := make(map[string]int64, len(ids))
+											for _, id := range ids {
+												var n int64
+												if err := st.SqlStore.GetMaster().Get(&n, "SELECT COUNT(Id) FROM Posts WHERE RootId=? AND DeleteAt=0", id); err != nil {
+													b.Fatal(err)
+												}
+												expected[id] = n
+											}
+											lookup := func() {
+												switch method {
+												case "populate":
+													if err := st.Store.Post().(*SqlPostStore).populateReplyCount(posts); err != nil {
+														b.Fatal(err)
+													}
+													for _, post := range posts {
+														if post.ReplyCount != expected[post.RootId] {
+															b.Fatal("incorrect aggregate count")
+														}
+													}
+												case "save":
+													input := make([]*model.Post, len(ids))
+													for i, id := range ids {
+														input[i] = &model.Post{RootId: id, ChannelId: channel.Id, UserId: user, Message: "new reply"}
+													}
+													var saved []*model.Post
+													if len(ids) == 1 {
+														post, err := st.Store.Post().Save(rctx, input[0])
+														if err != nil {
+															b.Fatal(err)
+														}
+														saved = []*model.Post{post}
+													} else {
+														var err error
+														saved, _, err = st.Store.Post().SaveMultiple(rctx, input)
+														if err != nil {
+															b.Fatal(err)
+														}
+													}
+													if len(saved) != len(ids) {
+														b.Fatal("incorrect save size")
+													}
+													for i, post := range saved {
+														expected[ids[i]]++
+														if post.Id == "" || post.RootId != ids[i] || post.Message != "new reply" || post.ReplyCount != expected[ids[i]] {
+															b.Fatal("incorrect saved reply")
+														}
+													}
+												case "root_control":
+													post, err := st.Store.Post().Save(rctx, &model.Post{ChannelId: channel.Id, UserId: user, Message: "new root"})
+													if err != nil {
+														b.Fatal(err)
+													}
+													if post.Id == "" || post.RootId != "" || post.ReplyCount != 0 {
+														b.Fatal("incorrect root control")
+													}
+												}
+											}
+											plan("before " + method)
+											lookup()
+											b.ReportAllocs()
+											b.ResetTimer()
+											for i := 0; i < b.N; i++ {
+												lookup()
+											}
+											b.StopTimer()
+											plan("after " + method)
+										})
+									}
+								})
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
