+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package sqlstore
+
+import (
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReplyCountProjection(t *testing.T) {
+	StoreTestWithSqlStore(t, func(t *testing.T, _ request.CTX, ss store.Store, db storetest.SqlStore) {
+		roots := []string{model.NewId(), model.NewId()}
+		t.Cleanup(func() {
+			for _, id := range roots {
+				_, err := db.GetMaster().Exec("DELETE FROM Posts WHERE RootId=?", id)
+				require.NoError(t, err)
+			}
+		})
+		for i, root := range roots {
+			for n := 0; n < 4+i; n++ {
+				var deleted any = int64(0)
+				if n == 1 {
+					deleted = int64(1)
+				}
+				if n == 2 {
+					deleted = nil
+				}
+				_, err := db.GetMaster().Exec("INSERT INTO Posts(Id,RootId,DeleteAt) VALUES (?,?,?)", model.NewId(), root, deleted)
+				require.NoError(t, err)
+			}
+		}
+		var nonNull bool
+		require.NoError(t, db.GetMaster().Get(&nonNull, "SELECT attnotnull FROM pg_attribute WHERE attrelid='posts'::regclass AND attname='id'"))
+		require.True(t, nonNull)
+		posts := []*model.Post{{RootId: roots[0], ReplyCount: 99}, {RootId: roots[1], ReplyCount: 99}, {RootId: roots[0], ReplyCount: 99}, {RootId: model.NewId(), ReplyCount: 99}, {ReplyCount: 99}}
+		expected := make(map[string]int64)
+		for _, post := range posts {
+			if post.RootId != "" {
+				require.NoError(t, db.GetMaster().Get(&post.ReplyCount, "SELECT COUNT(Id) FROM Posts WHERE RootId=? AND DeleteAt=0", post.RootId))
+				expected[post.RootId] = post.ReplyCount
+			}
+			post.ReplyCount = 99
+		}
+		concrete := ss.Post().(*SqlPostStore)
+		oldLimit := concrete.maxInsertParams
+		concrete.maxInsertParams = 2
+		t.Cleanup(func() { concrete.maxInsertParams = oldLimit })
+		require.NoError(t, concrete.populateReplyCount(posts))
+		for _, post := range posts {
+			require.Equal(t, expected[post.RootId], post.ReplyCount)
+		}
+		require.NoError(t, concrete.populateReplyCount(nil))
+		require.NoError(t, concrete.populateReplyCount([]*model.Post{}))
+	})
+}
