@@ -0,0 +1,176 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {AnyAction} from 'redux';
+
+import type {Post} from '@mattermost/types/posts';
+
+import {UserTypes} from 'mattermost-redux/action_types';
+import {Client4} from 'mattermost-redux/client';
+import {General, Posts, Preferences} from 'mattermost-redux/constants';
+import {createSelector} from 'mattermost-redux/selectors/create_selector';
+import {getChannel} from 'mattermost-redux/selectors/entities/channels';
+import {getConfig} from 'mattermost-redux/selectors/entities/general';
+import {getAllPosts, getRecentPostsChunkInChannel} from 'mattermost-redux/selectors/entities/posts';
+import {get as getPreference} from 'mattermost-redux/selectors/entities/preferences';
+import {getCurrentUserId} from 'mattermost-redux/selectors/entities/users';
+import reducerRegistry from 'mattermost-redux/store/reducer_registry';
+import {isFromWebhook, isPostEphemeral, isPostPendingOrFailed, isSystemMessage} from 'mattermost-redux/utils/post_utils';
+
+import type {GlobalState, ThunkActionFunc} from 'types/store';
+
+export const READ_RECEIPT_EVENT = 'read_receipt';
+export const READ_RECEIPTS_RECEIVED = 'READ_RECEIPTS_RECEIVED';
+export const READ_RECEIPT_RECEIVED = 'READ_RECEIPT_RECEIVED';
+export const PREFERENCE_NAME_READ_RECEIPTS = 'read_receipts';
+
+const STATE_KEY = 'readReceipts';
+
+export type ChannelReadReceipts = {
+    otherMemberCount: number;
+    lastViewedAt: Record<string, number>;
+};
+
+export type ReadReceiptsState = Record<string, ChannelReadReceipts>;
+
+export type ReadReceiptAnchor = {
+    kind: 'seen' | 'partial';
+    postId: string;
+    userIds: string[];
+};
+
+export type ReadReceiptAnchors = {
+    seen?: ReadReceiptAnchor;
+    partial?: ReadReceiptAnchor;
+};
+
+export function reducer(state: ReadReceiptsState = {}, action: AnyAction): ReadReceiptsState {
+    switch (action.type) {
+    case READ_RECEIPTS_RECEIVED:
+        return {
+            ...state,
+            [action.channelId]: {
+                otherMemberCount: action.otherMemberCount,
+                lastViewedAt: action.lastViewedAt,
+            },
+        };
+    case READ_RECEIPT_RECEIVED: {
+        const current = state[action.channelId];
+        if (!current || (current.lastViewedAt[action.userId] ?? 0) >= action.lastViewedAt) {
+            return state;
+        }
+        return {
+            ...state,
+            [action.channelId]: {
+                ...current,
+                lastViewedAt: {...current.lastViewedAt, [action.userId]: action.lastViewedAt},
+            },
+        };
+    }
+    case UserTypes.LOGOUT_SUCCESS:
+        return {};
+    default:
+        return state;
+    }
+}
+
+let registered = false;
+
+export function registerReadReceiptsReducer() {
+    if (!registered) {
+        reducerRegistry.register(STATE_KEY, reducer);
+        registered = true;
+    }
+}
+
+export function receivedReadReceipt(channelId: string, userId: string, lastViewedAt: number) {
+    return {type: READ_RECEIPT_RECEIVED, channelId, userId, lastViewedAt};
+}
+
+export function fetchReadReceipts(channelId: string): ThunkActionFunc<Promise<void>> {
+    return async (dispatch) => {
+        let data;
+        try {
+            const response = await fetch(`${Client4.getChannelRoute(channelId)}/read_receipts`, Client4.getOptions({method: 'get'}));
+            if (!response.ok) {
+                return;
+            }
+            data = await response.json();
+        } catch {
+            return;
+        }
+        dispatch({
+            type: READ_RECEIPTS_RECEIVED,
+            channelId,
+            otherMemberCount: data.other_member_count,
+            lastViewedAt: data.last_viewed_at ?? {},
+        });
+    };
+}
+
+function getReadReceipts(state: GlobalState, channelId: string): ChannelReadReceipts | undefined {
+    return (state as GlobalState & {[STATE_KEY]?: ReadReceiptsState})[STATE_KEY]?.[channelId];
+}
+
+export function isReadReceiptsActive(state: GlobalState, channelId: string): boolean {
+    if (getConfig(state).EnableReadReceipts !== 'true') {
+        return false;
+    }
+    const channel = getChannel(state, channelId);
+    if (channel?.type !== General.DM_CHANNEL && channel?.type !== General.GM_CHANNEL) {
+        return false;
+    }
+    return getPreference(state, Preferences.CATEGORY_DISPLAY_SETTINGS, PREFERENCE_NAME_READ_RECEIPTS, '') !== 'false';
+}
+
+function countsAsOwnPost(post: Post, currentUserId: string): boolean {
+    return post.user_id === currentUserId &&
+        post.state !== Posts.POST_DELETED &&
+        post.type !== Posts.POST_TYPES.BURN_ON_READ &&
+        !isSystemMessage(post) &&
+        !isPostEphemeral(post) &&
+        !isPostPendingOrFailed(post) &&
+        !isFromWebhook(post);
+}
+
+export function makeGetReadReceiptAnchors() {
+    return createSelector(
+        'makeGetReadReceiptAnchors',
+        isReadReceiptsActive,
+        (state: GlobalState, channelId: string) => getRecentPostsChunkInChannel(state, channelId)?.order,
+        getAllPosts,
+        getReadReceipts,
+        getCurrentUserId,
+        (active, order, posts, receipts, currentUserId): ReadReceiptAnchors | null => {
+            if (!active || !order || !receipts || receipts.otherMemberCount <= 0) {
+                return null;
+            }
+
+            const readerIds = Object.keys(receipts.lastViewedAt);
+            const seenPossible = readerIds.length >= receipts.otherMemberCount;
+            let partial: ReadReceiptAnchor | undefined;
+            let newest = true;
+
+            for (const postId of order) {
+                const post = posts[postId];
+                if (!post || !countsAsOwnPost(post, currentUserId)) {
+                    continue;
+                }
+
+                const userIds = readerIds.filter((userId) => receipts.lastViewedAt[userId] >= post.create_at);
+                if (seenPossible && userIds.length >= receipts.otherMemberCount) {
+                    return {seen: {kind: 'seen', postId, userIds}, partial};
+                }
+                if (newest && userIds.length > 0) {
+                    partial = {kind: 'partial', postId, userIds};
+                }
+                newest = false;
+                if (!seenPossible) {
+                    break;
+                }
+            }
+
+            return partial ? {partial} : null;
+        },
+    );
+}
