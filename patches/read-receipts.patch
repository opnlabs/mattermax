diff --git a/server/public/model/read_receipts.go b/server/public/model/read_receipts.go
new file mode 100644
index 000000000000..44ddc56be534
--- /dev/null
+++ b/server/public/model/read_receipts.go
@@ -0,0 +1,48 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package model
+
+import (
+	"strconv"
+	"strings"
+)
+
+const (
+	WebsocketEventReadReceipt  WebsocketEventType = "read_receipt"
+	PreferenceNameReadReceipts                    = "read_receipts"
+)
+
+type ChannelReadReceipts struct {
+	ChannelId        string           `json:"channel_id"`
+	OtherMemberCount int              `json:"other_member_count"`
+	LastViewedAt     map[string]int64 `json:"last_viewed_at"`
+}
+
+type ReadReceiptsPref struct {
+	On    bool
+	Since int64
+}
+
+func ParseReadReceiptsPref(p *Preference, now int64) ReadReceiptsPref {
+	if p == nil {
+		return ReadReceiptsPref{On: true}
+	}
+	if p.Value == "" || strings.Trim(p.Value, "0123456789") != "" {
+		return ReadReceiptsPref{}
+	}
+	since, err := strconv.ParseInt(p.Value, 10, 64)
+	if err != nil || since > now {
+		return ReadReceiptsPref{}
+	}
+	return ReadReceiptsPref{On: true, Since: since}
+}
+
+// ReadReceiptVisible reports whether viewer may see reader's watermark.
+func ReadReceiptVisible(enabled bool, channelType ChannelType, viewer, reader ReadReceiptsPref, readerLastViewedAt int64) bool {
+	return enabled &&
+		(channelType == ChannelTypeDirect || channelType == ChannelTypeGroup) &&
+		viewer.On &&
+		reader.On &&
+		readerLastViewedAt >= reader.Since
+}
