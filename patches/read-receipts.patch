+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import type {Post} from '@mattermost/types/posts';
+import type {DeepPartial} from '@mattermost/types/utilities';
+
+import {renderWithContext, screen, userEvent} from 'tests/react_testing_utils';
+import {Locations} from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+import PostReadReceipt from './post_read_receipt';
+import type {ChannelReadReceipts} from './state';
+
+const ME = 'me';
+const CHANNEL = 'channel1';
+
+function post(id: string, createAt: number): Post {
+    return {id, user_id: ME, channel_id: CHANNEL, create_at: createAt, type: '', state: '', props: {}} as unknown as Post;
+}
+
+const older = post('older', 100);
+const newest = post('newest', 300);
+
+function makeState(channelType: string, receipts: ChannelReadReceipts, enabled = 'true') {
+    return {
+        entities: {
+            general: {config: {EnableReadReceipts: enabled, TeammateNameDisplay: 'username'}},
+            channels: {channels: {[CHANNEL]: {id: CHANNEL, type: channelType}}},
+            posts: {
+                posts: {older, newest},
+                postsInChannel: {[CHANNEL]: [{order: ['newest', 'older'], recent: true}]},
+            },
+            users: {
+                currentUserId: ME,
+                profiles: {
+                    u2: {id: 'u2', username: 'alice'},
+                    u3: {id: 'u3', username: 'bob'},
+                    u4: {id: 'u4', username: 'carol'},
+                },
+            },
+        },
+        readReceipts: {[CHANNEL]: receipts},
+    } as unknown as DeepPartial<GlobalState>;
+}
+
+function renderReceipt(p: Post, state: DeepPartial<GlobalState>, location: keyof typeof Locations = Locations.CENTER) {
+    return renderWithContext(
+        <PostReadReceipt
+            post={p}
+            location={location}
+        />,
+        state,
+        {pluginReducers: ['readReceipts']},
+    );
+}
+
+describe('PostReadReceipt', () => {
+    test('DM shows Seen under the newest own post the other member has read', () => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {u2: 300}});
+
+        renderReceipt(newest, state);
+        expect(screen.getByText('Seen')).toBeInTheDocument();
+    });
+
+    test('DM shows nothing under an older own post', () => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {u2: 300}});
+
+        const {container} = renderReceipt(older, state);
+        expect(container).toBeEmptyDOMElement();
+    });
+
+    test('DM with the newest post unread moves Seen to the older post', () => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {u2: 200}});
+
+        renderReceipt(older, state);
+        expect(screen.getByText('Seen')).toBeInTheDocument();
+    });
+
+    test('DM shows nothing when the other member is not in the receipts', () => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {}});
+
+        const {container} = renderReceipt(newest, state);
+        expect(container).toBeEmptyDOMElement();
+    });
+
+    test('GM partial read shows Seen by N with the readers on hover', async () => {
+        const state = makeState('G', {otherMemberCount: 3, lastViewedAt: {u2: 300, u3: 300, u4: 100}});
+
+        renderReceipt(newest, state);
+        const label = screen.getByText('Seen by 2');
+
+        await userEvent.hover(label);
+        expect(await screen.findByText('Seen by alice and bob')).toBeInTheDocument();
+    });
+
+    test('GM older post read by everyone shows Seen with every reader on hover', async () => {
+        const state = makeState('G', {otherMemberCount: 3, lastViewedAt: {u2: 300, u3: 300, u4: 100}});
+
+        renderReceipt(older, state);
+        const label = screen.getByText('Seen');
+
+        await userEvent.hover(label);
+        expect(await screen.findByText('Seen by alice, bob, and carol')).toBeInTheDocument();
+    });
+
+    test.each([
+        Locations.RHS_ROOT,
+        Locations.RHS_COMMENT,
+        Locations.SEARCH,
+    ])('shows nothing in %s', (location) => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {u2: 300}});
+
+        const {container} = renderReceipt(newest, state, location);
+        expect(container).toBeEmptyDOMElement();
+    });
+
+    test('shows nothing when the switch is off', () => {
+        const state = makeState('D', {otherMemberCount: 1, lastViewedAt: {u2: 300}}, 'false');
+
+        const {container} = renderReceipt(newest, state);
+        expect(container).toBeEmptyDOMElement();
+    });
+});
