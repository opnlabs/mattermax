diff --git a/server/channels/app/read_receipts.go b/server/channels/app/read_receipts.go
new file mode 100644
index 000000000000..1c3f2c031f78
--- /dev/null
+++ b/server/channels/app/read_receipts.go
@@ -0,0 +1,157 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"net/http"
+	"slices"
+	"strconv"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+)
+
+func (a *App) loadReadReceiptInputs(rctx request.CTX, channelID string) (*model.Channel, []*model.ChannelMemberLastViewed, map[string]model.ReadReceiptsPref, *model.AppError) {
+	channel, err := a.Srv().Store().Channel().Get(channelID, true)
+	if err != nil {
+		return nil, nil, nil, model.NewAppError("loadReadReceiptInputs", "app.channel.get.find.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+	if !channel.IsGroupOrDirect() {
+		return channel, nil, nil, nil
+	}
+
+	members, err := a.Srv().Store().Channel().GetMembersWithLastViewedAtSince(rctx, channelID, 0, "", 0)
+	if err != nil {
+		return nil, nil, nil, model.NewAppError("loadReadReceiptInputs", "app.channel.get_members.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	now := model.GetMillis()
+	prefs := make(map[string]model.ReadReceiptsPref, len(members))
+	for _, m := range members {
+		pref, err := a.Srv().Store().Preference().Get(m.UserId, model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts)
+		if err != nil && !isNotFoundError(err) {
+			return nil, nil, nil, model.NewAppError("loadReadReceiptInputs", "app.preference.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+		}
+		prefs[m.UserId] = model.ParseReadReceiptsPref(pref, now)
+	}
+
+	return channel, members, prefs, nil
+}
+
+func (a *App) GetChannelReadReceipts(rctx request.CTX, channelID, viewerID string) (*model.ChannelReadReceipts, *model.AppError) {
+	receipts := &model.ChannelReadReceipts{ChannelId: channelID, LastViewedAt: map[string]int64{}}
+	enabled := *a.Config().TeamSettings.EnableReadReceipts
+	if !enabled {
+		return receipts, nil
+	}
+
+	channel, members, prefs, appErr := a.loadReadReceiptInputs(rctx, channelID)
+	if appErr != nil {
+		return nil, appErr
+	}
+
+	viewer, isMember := prefs[viewerID]
+	if !isMember {
+		return receipts, nil
+	}
+	receipts.OtherMemberCount = len(members) - 1
+
+	for _, m := range members {
+		if m.UserId == viewerID {
+			continue
+		}
+		if model.ReadReceiptVisible(enabled, channel.Type, viewer, prefs[m.UserId], m.LastViewedAt) {
+			receipts.LastViewedAt[m.UserId] = m.LastViewedAt
+		}
+	}
+
+	return receipts, nil
+}
+
+func (a *App) publishReadReceipts(rctx request.CTX, readerID string, channelIDs []string, times map[string]int64) {
+	enabled := *a.Config().TeamSettings.EnableReadReceipts
+	if !enabled {
+		return
+	}
+
+	for _, channelID := range channelIDs {
+		channel, members, prefs, appErr := a.loadReadReceiptInputs(rctx, channelID)
+		if appErr != nil {
+			rctx.Logger().Warn("Failed to load read receipt inputs", mlog.String("channel_id", channelID), mlog.Err(appErr))
+			continue
+		}
+		if !channel.IsGroupOrDirect() {
+			continue
+		}
+
+		reader, isMember := prefs[readerID]
+		if !isMember {
+			continue
+		}
+
+		lastViewedAt := times[channelID]
+		omit := map[string]bool{readerID: true}
+		for _, m := range members {
+			if !model.ReadReceiptVisible(enabled, channel.Type, prefs[m.UserId], reader, lastViewedAt) {
+				omit[m.UserId] = true
+			}
+		}
+		if len(omit) == len(members) {
+			continue
+		}
+
+		message := model.NewWebSocketEvent(model.WebsocketEventReadReceipt, "", channelID, "", omit, "")
+		message.Add("user_id", readerID)
+		message.Add("last_viewed_at", lastViewedAt)
+		a.Publish(message)
+	}
+}
+
+func isReadReceiptsPref(p model.Preference) bool {
+	return p.Category == model.PreferenceCategoryDisplaySettings && p.Name == model.PreferenceNameReadReceipts
+}
+
+func (a *App) readReceiptsOnValue(userID string) (string, *model.AppError) {
+	stored, err := a.Srv().Store().Preference().Get(userID, model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts)
+	if err != nil && !isNotFoundError(err) {
+		return "", model.NewAppError("readReceiptsOnValue", "app.preference.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+	now := model.GetMillis()
+	if stored == nil {
+		return "0", nil
+	}
+	if model.ParseReadReceiptsPref(stored, now).On {
+		return stored.Value, nil
+	}
+	return strconv.FormatInt(now, 10), nil
+}
+
+func (a *App) stampReadReceiptsPrefs(userID string, preferences model.Preferences) (model.Preferences, *model.AppError) {
+	stamped := slices.Clone(preferences)
+	for i, p := range stamped {
+		if !isReadReceiptsPref(p) || p.Value == "false" {
+			continue
+		}
+		value, appErr := a.readReceiptsOnValue(userID)
+		if appErr != nil {
+			return nil, appErr
+		}
+		stamped[i].Value = value
+	}
+	return stamped, nil
+}
+
+// A missing row means on since 0, so deleting would expose reads made while off.
+func (a *App) resetReadReceiptsPref(userID string) *model.AppError {
+	value, appErr := a.readReceiptsOnValue(userID)
+	if appErr != nil {
+		return appErr
+	}
+	pref := model.Preference{UserId: userID, Category: model.PreferenceCategoryDisplaySettings, Name: model.PreferenceNameReadReceipts, Value: value}
+	if err := a.Srv().Store().Preference().Save(model.Preferences{pref}); err != nil {
+		return model.NewAppError("resetReadReceiptsPref", "app.preference.save.updating.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+	return nil
+}
