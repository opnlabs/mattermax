+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React, {useCallback, useState} from 'react';
+import {FormattedMessage} from 'react-intl';
+
+import type {PreferenceType} from '@mattermost/types/preferences';
+import type {UserProfile} from '@mattermost/types/users';
+
+import {Preferences} from 'mattermost-redux/constants';
+
+import {PREFERENCE_NAME_READ_RECEIPTS} from 'components/read_receipts/state';
+import SettingItem from 'components/setting_item';
+import SettingItemMax from 'components/setting_item_max';
+
+const SECTION = 'readReceipts';
+
+type OnOff = 'on' | 'off';
+
+export type OwnProps = {
+    user: UserProfile;
+    adminMode?: boolean;
+    activeSection?: string;
+    updateSection: (section: string) => void;
+};
+
+type Props = OwnProps & {
+    enabled: boolean;
+    readReceipts: string;
+    actions: {
+        savePreferences: (userId: string, preferences: PreferenceType[]) => void;
+    };
+};
+
+const title = (
+    <FormattedMessage
+        id='user.settings.display.readReceiptsTitle'
+        defaultMessage='Read receipts'
+    />
+);
+
+const options: Array<{value: OnOff; inputId: string; messageId: string; defaultMessage: string}> = [
+    {value: 'on', inputId: 'readReceiptsOn', messageId: 'user.settings.advance.on', defaultMessage: 'On'},
+    {value: 'off', inputId: 'readReceiptsOff', messageId: 'user.settings.advance.off', defaultMessage: 'Off'},
+];
+
+const ReadReceipts = ({user, adminMode, activeSection, updateSection, enabled, readReceipts, actions}: Props) => {
+    const saved: OnOff = readReceipts === 'false' ? 'off' : 'on';
+    const [value, setValue] = useState<OnOff>(saved);
+
+    const handleChange = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+        setValue(e.currentTarget.value as OnOff);
+    }, []);
+
+    const handleUpdateSection = useCallback((section: string) => {
+        setValue(saved);
+        updateSection(section);
+    }, [saved, updateSection]);
+
+    const submit = useCallback(() => {
+        if (value !== saved) {
+            actions.savePreferences(user.id, [{
+                user_id: user.id,
+                category: Preferences.CATEGORY_DISPLAY_SETTINGS,
+                name: PREFERENCE_NAME_READ_RECEIPTS,
+                value: String(value === 'on'),
+            }]);
+        }
+        updateSection('');
+    }, [actions, saved, updateSection, user.id, value]);
+
+    if (!enabled || adminMode) {
+        return null;
+    }
+
+    const input = (
+        <fieldset key='readReceiptsSetting'>
+            <legend className='form-legend hidden-label'>{title}</legend>
+            {options.map((option) => (
+                <div
+                    className='radio'
+                    key={option.value}
+                >
+                    <label>
+                        <input
+                            id={option.inputId}
+                            type='radio'
+                            name='readReceipts'
+                            value={option.value}
+                            checked={value === option.value}
+                            onChange={handleChange}
+                        />
+                        <FormattedMessage
+                            id={option.messageId}
+                            defaultMessage={option.defaultMessage}
+                        />
+                    </label>
+                    <br/>
+                </div>
+            ))}
+            <div className='mt-5'>
+                <FormattedMessage
+                    id='user.settings.display.readReceiptsDesc'
+                    defaultMessage='When on, people in your direct and group messages can see when you have read their messages, and you can see when they have read yours. When off, neither happens.'
+                />
+            </div>
+        </fieldset>
+    );
+
+    return (
+        <div>
+            <SettingItem
+                active={activeSection === SECTION}
+                areAllSectionsInactive={activeSection === ''}
+                title={title}
+                describe={saved === 'on' ? (
+                    <FormattedMessage
+                        id='user.settings.advance.on'
+                        defaultMessage='On'
+                    />
+                ) : (
+                    <FormattedMessage
+                        id='user.settings.advance.off'
+                        defaultMessage='Off'
+                    />
+                )}
+                section={SECTION}
+                updateSection={handleUpdateSection}
+                max={(
+                    <SettingItemMax
+                        title={title}
+                        inputs={[input]}
+                        submit={submit}
+                        updateSection={handleUpdateSection}
+                        disableEnterSubmit={true}
+                    />
+                )}
+            />
+            <div className='divider-dark'/>
+        </div>
+    );
+};
+
+export default ReadReceipts;
