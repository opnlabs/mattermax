+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+import {FormattedMessage, useIntl} from 'react-intl';
+import {shallowEqual, useSelector} from 'react-redux';
+
+import {WithTooltip} from '@mattermost/shared/components/tooltip';
+import type {Post} from '@mattermost/types/posts';
+
+import {getTeammateNameDisplaySetting} from 'mattermost-redux/selectors/entities/preferences';
+import {getUser} from 'mattermost-redux/selectors/entities/users';
+import {displayUsername} from 'mattermost-redux/utils/user_utils';
+
+import {Locations} from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+import {isReadReceiptsActive, makeGetReadReceiptAnchors} from './state';
+import type {ReadReceiptAnchor} from './state';
+
+import './post_read_receipt.scss';
+
+const getReadReceiptAnchors = makeGetReadReceiptAnchors();
+
+const noUserIds: string[] = [];
+
+type Props = {
+    post: Post;
+    location: keyof typeof Locations;
+};
+
+function selectAnchor(state: GlobalState, post: Post): ReadReceiptAnchor | undefined {
+    if (!isReadReceiptsActive(state, post.channel_id)) {
+        return undefined;
+    }
+    const anchors = getReadReceiptAnchors(state, post.channel_id);
+    if (anchors?.seen?.postId === post.id) {
+        return anchors.seen;
+    }
+    if (anchors?.partial?.postId === post.id) {
+        return anchors.partial;
+    }
+    return undefined;
+}
+
+export default function PostReadReceipt({post, location}: Props) {
+    const intl = useIntl();
+    const anchor = useSelector((state: GlobalState) => (location === Locations.CENTER ? selectAnchor(state, post) : undefined));
+    const userIds = anchor?.userIds ?? noUserIds;
+    const names = useSelector((state: GlobalState) => {
+        const nameDisplay = getTeammateNameDisplaySetting(state);
+        return userIds.map((userId) => displayUsername(getUser(state, userId), nameDisplay));
+    }, shallowEqual);
+
+    if (!anchor) {
+        return null;
+    }
+
+    const label = anchor.kind === 'seen' ? (
+        <FormattedMessage
+            id='post.readReceipt.seen'
+            defaultMessage='Seen'
+        />
+    ) : (
+        <FormattedMessage
+            id='post.readReceipt.seenBy'
+            defaultMessage='Seen by {count}'
+            values={{count: userIds.length}}
+        />
+    );
+
+    if (anchor.kind === 'seen' && userIds.length < 2) {
+        return <div className='post-read-receipt'><span>{label}</span></div>;
+    }
+
+    return (
+        <div className='post-read-receipt'>
+            <WithTooltip
+                title={intl.formatMessage(
+                    {id: 'post.readReceipt.readers', defaultMessage: 'Seen by {names}'},
+                    {names: intl.formatList(names, {type: 'conjunction'})},
+                )}
+            >
+                <span>{label}</span>
+            </WithTooltip>
+        </div>
+    );
+}
