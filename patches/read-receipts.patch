+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {Post} from '@mattermost/types/posts';
+
+import {UserTypes} from 'mattermost-redux/action_types';
+
+import type {GlobalState} from 'types/store';
+
+import {
+    READ_RECEIPTS_RECEIVED,
+    makeGetReadReceiptAnchors,
+    receivedReadReceipt,
+    reducer,
+} from './state';
+import type {ChannelReadReceipts} from './state';
+
+const ME = 'me';
+const CHANNEL = 'channel1';
+
+function post(id: string, createAt: number, override: Partial<Post> = {}): Post {
+    return {id, user_id: ME, channel_id: CHANNEL, create_at: createAt, type: '', state: '', props: {}, ...override} as Post;
+}
+
+type StateOptions = {
+    channelType?: string;
+    enabled?: string;
+    ownSetting?: string;
+    posts: Post[];
+    receipts?: ChannelReadReceipts;
+};
+
+function makeState({channelType = 'D', enabled = 'true', ownSetting, posts, receipts}: StateOptions): GlobalState {
+    const sorted = [...posts].sort((a, b) => b.create_at - a.create_at);
+    return {
+        entities: {
+            general: {config: {EnableReadReceipts: enabled}},
+            channels: {channels: {[CHANNEL]: {id: CHANNEL, type: channelType}}},
+            posts: {
+                posts: Object.fromEntries(posts.map((p) => [p.id, p])),
+                postsInChannel: {[CHANNEL]: [{order: sorted.map((p) => p.id), recent: true}]},
+            },
+            preferences: {
+                myPreferences: ownSetting === undefined ? {} : {
+                    'display_settings--read_receipts': {user_id: ME, category: 'display_settings', name: 'read_receipts', value: ownSetting},
+                },
+            },
+            users: {currentUserId: ME},
+        },
+        readReceipts: receipts ? {[CHANNEL]: receipts} : {},
+    } as unknown as GlobalState;
+}
+
+describe('read receipts reducer', () => {
+    test('replaces a channel entry on fetch', () => {
+        const state = reducer({[CHANNEL]: {otherMemberCount: 1, lastViewedAt: {u2: 500}}}, {
+            type: READ_RECEIPTS_RECEIVED,
+            channelId: CHANNEL,
+            otherMemberCount: 2,
+            lastViewedAt: {u3: 100},
+        });
+
+        expect(state).toEqual({[CHANNEL]: {otherMemberCount: 2, lastViewedAt: {u3: 100}}});
+    });
+
+    test('merges an event and never moves a watermark backwards', () => {
+        let state = reducer({[CHANNEL]: {otherMemberCount: 2, lastViewedAt: {u2: 500}}}, receivedReadReceipt(CHANNEL, 'u2', 700));
+        state = reducer(state, receivedReadReceipt(CHANNEL, 'u3', 300));
+        const afterStale = reducer(state, receivedReadReceipt(CHANNEL, 'u2', 600));
+
+        expect(afterStale).toBe(state);
+        expect(state).toEqual({[CHANNEL]: {otherMemberCount: 2, lastViewedAt: {u2: 700, u3: 300}}});
+    });
+
+    test('ignores events for channels that were never fetched', () => {
+        const state = {};
+        expect(reducer(state, receivedReadReceipt(CHANNEL, 'u2', 700))).toBe(state);
+    });
+
+    test('resets on logout', () => {
+        expect(reducer({[CHANNEL]: {otherMemberCount: 1, lastViewedAt: {u2: 1}}}, {type: UserTypes.LOGOUT_SUCCESS})).toEqual({});
+    });
+});
+
+describe('makeGetReadReceiptAnchors', () => {
+    const getAnchors = makeGetReadReceiptAnchors();
+
+    test('DM read up to the newest own post shows Seen there', () => {
+        const state = makeState({
+            posts: [post('a', 100), post('b', 200, {user_id: 'u2'}), post('c', 300)],
+            receipts: {otherMemberCount: 1, lastViewedAt: {u2: 300}},
+        });
+
+        expect(getAnchors(state, CHANNEL)).toEqual({seen: {kind: 'seen', postId: 'c', userIds: ['u2']}, partial: undefined});
+    });
+
+    test('DM read up to an older own post shows Seen on that post', () => {
+        const state = makeState({
+            posts: [post('a', 100), post('b', 300)],
+            receipts: {otherMemberCount: 1, lastViewedAt: {u2: 200}},
+        });
+
+        expect(getAnchors(state, CHANNEL)?.seen?.postId).toBe('a');
+        expect(getAnchors(state, CHANNEL)?.partial).toBeUndefined();
+    });
+
+    test('DM with nothing read shows nothing', () => {
+        const state = makeState({
+            posts: [post('a', 100)],
+            receipts: {otherMemberCount: 1, lastViewedAt: {u2: 50}},
+        });
+
+        expect(getAnchors(state, CHANNEL)).toBeNull();
+    });
+
+    test('newer posts from others do not take the indicator', () => {
+        const state = makeState({
+            posts: [post('a', 300), post('b', 400, {user_id: 'u2'})],
+            receipts: {otherMemberCount: 1, lastViewedAt: {u2: 400}},
+        });
+
+        expect(getAnchors(state, CHANNEL)?.seen?.postId).toBe('a');
+    });
+
+    test('GM read by everyone shows Seen with all readers', () => {
+        const state = makeState({
+            channelType: 'G',
+            posts: [post('a', 100), post('b', 300)],
+            receipts: {otherMemberCount: 3, lastViewedAt: {u2: 300, u3: 400, u4: 300}},
+        });
+
+        expect(getAnchors(state, CHANNEL)).toEqual({seen: {kind: 'seen', postId: 'b', userIds: ['u2', 'u3', 'u4']}, partial: undefined});
+    });
+
