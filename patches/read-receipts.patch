+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {useCallback, useEffect} from 'react';
+import {useDispatch, useSelector} from 'react-redux';
+
+import type {WebSocketMessage} from '@mattermost/client';
+
+import {useWebSocket} from 'utils/use_websocket';
+
+import type {GlobalState} from 'types/store';
+
+import {
+    READ_RECEIPT_EVENT,
+    fetchReadReceipts,
+    isReadReceiptsActive,
+    receivedReadReceipt,
+    registerReadReceiptsReducer,
+} from './state';
+
+type Props = {
+    channelId: string;
+};
+
+type ReadReceiptMessage = {
+    event: string;
+    broadcast: {channel_id: string};
+    data: {user_id: string; last_viewed_at: number};
+};
+
+export default function ReadReceiptsSync({channelId}: Props) {
+    const dispatch = useDispatch();
+    const active = useSelector((state: GlobalState) => isReadReceiptsActive(state, channelId));
+    const lastConnectAt = useSelector((state: GlobalState) => state.websocket.lastConnectAt);
+
+    useEffect(() => {
+        registerReadReceiptsReducer();
+    }, []);
+
+    useEffect(() => {
+        if (active) {
+            dispatch(fetchReadReceipts(channelId));
+        }
+    }, [active, channelId, lastConnectAt, dispatch]);
+
+    useWebSocket({
+        handler: useCallback((msg: WebSocketMessage) => {
+            const {event, broadcast, data} = msg as unknown as ReadReceiptMessage;
+            if (event === READ_RECEIPT_EVENT) {
+                dispatch(receivedReadReceipt(broadcast.channel_id, data.user_id, data.last_viewed_at));
+            }
+        }, [dispatch]),
+    });
+
+    return null;
+}
