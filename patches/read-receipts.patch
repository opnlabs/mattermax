+func getReadReceipts(t *testing.T, client *model.Client4, channelID string) (*model.ChannelReadReceipts, *model.Response) {
+	t.Helper()
+	r, err := client.DoAPIGet(context.Background(), "/channels/"+channelID+"/read_receipts", "")
+	if err != nil {
+		return nil, model.BuildResponse(r)
+	}
+	defer closeBody(r)
+	var receipts model.ChannelReadReceipts
+	require.NoError(t, json.NewDecoder(r.Body).Decode(&receipts))
+	return &receipts, model.BuildResponse(r)
+}
+
+func requireReadReceipts(t *testing.T, client *model.Client4, channelID string, otherMemberCount int, want map[string]int64) {
+	t.Helper()
+	receipts, resp := getReadReceipts(t, client, channelID)
+	CheckOKStatus(t, resp)
+	assert.Equal(t, channelID, receipts.ChannelId)
+	assert.Equal(t, otherMemberCount, receipts.OtherMemberCount)
+	assert.Equal(t, want, receipts.LastViewedAt)
+}
+
+func setReadReceiptsPref(t *testing.T, client *model.Client4, userID, value string) {
+	t.Helper()
+	_, err := client.UpdatePreferences(context.Background(), userID, model.Preferences{{
+		UserId:   userID,
+		Category: model.PreferenceCategoryDisplaySettings,
+		Name:     model.PreferenceNameReadReceipts,
+		Value:    value,
+	}})
+	require.NoError(t, err)
+}
+
+func clearReadReceiptsPref(t *testing.T, client *model.Client4, userID string) {
+	t.Helper()
+	_, err := client.DeletePreferences(context.Background(), userID, model.Preferences{{
+		UserId:   userID,
+		Category: model.PreferenceCategoryDisplaySettings,
+		Name:     model.PreferenceNameReadReceipts,
+	}})
+	require.NoError(t, err)
+}
+
+func postReadReceiptMessage(t *testing.T, client *model.Client4, channelID string) *model.Post {
+	t.Helper()
+	post, _, err := client.CreatePost(context.Background(), &model.Post{ChannelId: channelID, Message: model.NewId()})
+	require.NoError(t, err)
+	return post
+}
+
+func viewReadReceiptChannel(t *testing.T, client *model.Client4, channelID string) {
+	t.Helper()
+	_, _, err := client.ViewChannel(context.Background(), "me", &model.ChannelView{ChannelId: channelID})
+	require.NoError(t, err)
+}
+
+func loggedInClient(t *testing.T, th *TestHelper, user *model.User) *model.Client4 {
+	t.Helper()
+	client := th.CreateClient()
+	_, _, err := client.Login(context.Background(), user.Email, user.Password)
+	require.NoError(t, err)
+	return client
+}
+
+func setReadReceiptsEnabled(th *TestHelper, enabled bool) {
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.TeamSettings.EnableReadReceipts = enabled })
+}
+
+const noReadReceiptWait = 2 * time.Second
+
+func nextReadReceipt(t *testing.T, ws *model.WebSocketClient, channelID string, timeout time.Duration) *model.WebSocketEvent {
+	t.Helper()
+	deadline := time.After(timeout)
+	for {
+		select {
+		case ev := <-ws.EventChannel:
+			if ev.EventType() == model.WebsocketEventReadReceipt && ev.GetBroadcast().ChannelId == channelID {
+				return ev
+			}
+		case <-deadline:
+			return nil
+		}
+	}
+}
+
+func requireReadReceiptEvent(t *testing.T, ws *model.WebSocketClient, channelID, readerID string, lastViewedAt int64) {
+	t.Helper()
+	ev := nextReadReceipt(t, ws, channelID, 5*time.Second)
+	require.NotNil(t, ev, "expected a read_receipt event")
+	assert.Equal(t, readerID, ev.GetData()["user_id"])
+	assert.EqualValues(t, lastViewedAt, ev.GetData()["last_viewed_at"])
+}
+
+func requireNoReadReceiptEvent(t *testing.T, ws *model.WebSocketClient, channelID string) {
+	t.Helper()
+	assert.Nil(t, nextReadReceipt(t, ws, channelID, noReadReceiptWait), "expected no read_receipt event")
+}
+
+func TestGetChannelReadReceiptsAPI(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	setReadReceiptsEnabled(th, true)
+
+	user1, user2 := th.BasicUser, th.BasicUser2
+	client1 := th.Client
+	client2 := loggedInClient(t, th, user2)
+
+	dm := th.CreateDmChannel(t, user2)
+	first := postReadReceiptMessage(t, client1, dm.Id)
+	viewReadReceiptChannel(t, client2, dm.Id)
+
+	t.Run("both on, each member sees the other", func(t *testing.T) {
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{user2.Id: first.CreateAt})
+		requireReadReceipts(t, client2, dm.Id, 1, map[string]int64{user1.Id: first.CreateAt})
+	})
+
+	t.Run("switch off", func(t *testing.T) {
+		setReadReceiptsEnabled(th, false)
+		defer setReadReceiptsEnabled(th, true)
+		requireReadReceipts(t, client1, dm.Id, 0, map[string]int64{})
+	})
+
+	t.Run("public channel", func(t *testing.T) {
+		postReadReceiptMessage(t, client1, th.BasicChannel.Id)
+		viewReadReceiptChannel(t, client2, th.BasicChannel.Id)
+		receipts, resp := getReadReceipts(t, client1, th.BasicChannel.Id)
+		CheckOKStatus(t, resp)
+		assert.Empty(t, receipts.LastViewedAt)
+	})
+
+	t.Run("private channel", func(t *testing.T) {
+		postReadReceiptMessage(t, client1, th.BasicPrivateChannel.Id)
+		viewReadReceiptChannel(t, client2, th.BasicPrivateChannel.Id)
+		receipts, resp := getReadReceipts(t, client1, th.BasicPrivateChannel.Id)
+		CheckOKStatus(t, resp)
+		assert.Empty(t, receipts.LastViewedAt)
+	})
+
+	t.Run("viewer opted out sees nothing and is not seen", func(t *testing.T) {
+		setReadReceiptsPref(t, client1, user1.Id, "false")
+		defer clearReadReceiptsPref(t, client1, user1.Id)
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+		requireReadReceipts(t, client2, dm.Id, 1, map[string]int64{})
+	})
+
+	t.Run("reader opted out", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		defer clearReadReceiptsPref(t, client2, user2.Id)
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+	})
+
+	t.Run("re-enable floor hides reads before the reader turned receipts back on", func(t *testing.T) {
+		defer clearReadReceiptsPref(t, client2, user2.Id)
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		older := postReadReceiptMessage(t, client1, dm.Id)
+		viewReadReceiptChannel(t, client2, dm.Id)
+
+		setReadReceiptsPref(t, client2, user2.Id, "true")
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+
+		time.Sleep(5 * time.Millisecond)
+		newer := postReadReceiptMessage(t, client1, dm.Id)
+		require.Greater(t, newer.CreateAt, older.CreateAt)
+		viewReadReceiptChannel(t, client2, dm.Id)
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{user2.Id: newer.CreateAt})
+	})
+
+	t.Run("group message hides only the member who opted out", func(t *testing.T) {
+		user3, user4 := th.CreateUser(t), th.CreateUser(t)
+		client3, client4 := loggedInClient(t, th, user3), loggedInClient(t, th, user4)
+		gm, appErr := th.App.CreateGroupChannel(th.Context, []string{user1.Id, user2.Id, user3.Id, user4.Id}, user1.Id)
+		require.Nil(t, appErr)
+
+		setReadReceiptsPref(t, client4, user4.Id, "false")
+		post := postReadReceiptMessage(t, client1, gm.Id)
+		viewReadReceiptChannel(t, client2, gm.Id)
+		viewReadReceiptChannel(t, client3, gm.Id)
+		viewReadReceiptChannel(t, client4, gm.Id)
+
+		requireReadReceipts(t, client1, gm.Id, 3, map[string]int64{user2.Id: post.CreateAt, user3.Id: post.CreateAt})
+		requireReadReceipts(t, client4, gm.Id, 3, map[string]int64{})
+	})
+
+	t.Run("non-member regular user is forbidden", func(t *testing.T) {
+		outsider := th.CreateUser(t)
+		_, resp := getReadReceipts(t, loggedInClient(t, th, outsider), dm.Id)
+		CheckForbiddenStatus(t, resp)
+	})
+
+	t.Run("system admin who is not a member sees nothing", func(t *testing.T) {
+		requireReadReceipts(t, th.SystemAdminClient, dm.Id, 0, map[string]int64{})
+	})
+}
+
+func storedReadReceiptsPref(t *testing.T, th *TestHelper, userID string) string {
+	t.Helper()
+	pref, err := th.App.Srv().Store().Preference().Get(userID, model.PreferenceCategoryDisplaySettings, model.PreferenceNameReadReceipts)
+	require.NoError(t, err)
+	return pref.Value
+}
+
+func requireServerStamp(t *testing.T, value string, before, after int64) {
+	t.Helper()
+	stamp, err := strconv.ParseInt(value, 10, 64)
+	require.NoError(t, err, "stored value %q is not a timestamp", value)
+	require.GreaterOrEqual(t, stamp, before)
+	require.LessOrEqual(t, stamp, after)
+}
+
+func TestReadReceiptsPrefServerStamp(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	setReadReceiptsEnabled(th, true)
+
+	user1, user2 := th.BasicUser, th.BasicUser2
+	client1 := th.Client
+	client2 := loggedInClient(t, th, user2)
+	dm := th.CreateDmChannel(t, user2)
+
+	for name, value := range map[string]string{
+		"true":           "true",
+		"far future":     strconv.FormatInt(model.GetMillis()+365*24*time.Hour.Milliseconds(), 10),
+		"past timestamp": "1",
+		"garbage":        "maybe",
+	} {
+		t.Run("turning on with "+name+" stores the server time", func(t *testing.T) {
+			setReadReceiptsPref(t, client2, user2.Id, "false")
+			before := model.GetMillis()
+			setReadReceiptsPref(t, client2, user2.Id, value)
+			requireServerStamp(t, storedReadReceiptsPref(t, th, user2.Id), before, model.GetMillis())
+		})
+	}
+
+	t.Run("re-saving on keeps the floor", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		setReadReceiptsPref(t, client2, user2.Id, "true")
+		floor := storedReadReceiptsPref(t, th, user2.Id)
+
+		time.Sleep(5 * time.Millisecond)
+		setReadReceiptsPref(t, client2, user2.Id, "true")
+		setReadReceiptsPref(t, client2, user2.Id, "1")
+		assert.Equal(t, floor, storedReadReceiptsPref(t, th, user2.Id))
+	})
+
+	t.Run("saving on with no row keeps the default floor", func(t *testing.T) {
+		user3 := th.CreateUser(t)
+		client3 := loggedInClient(t, th, user3)
+		setReadReceiptsPref(t, client3, user3.Id, strconv.FormatInt(model.GetMillis()+time.Hour.Milliseconds(), 10))
+		assert.Equal(t, "0", storedReadReceiptsPref(t, th, user3.Id))
+	})
+
+	t.Run("deleting the preference does not lower the floor", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		before := model.GetMillis()
+		clearReadReceiptsPref(t, client2, user2.Id)
+		requireServerStamp(t, storedReadReceiptsPref(t, th, user2.Id), before, model.GetMillis())
+	})
+
+	t.Run("a client-chosen floor cannot expose reads made while off", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		postReadReceiptMessage(t, client1, dm.Id)
+		viewReadReceiptChannel(t, client2, dm.Id)
+
+		setReadReceiptsPref(t, client2, user2.Id, "1")
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+	})
+
+	t.Run("a far-future floor does not let a reader see receipts while hiding their own", func(t *testing.T) {
+		post := postReadReceiptMessage(t, client2, dm.Id)
+		viewReadReceiptChannel(t, client1, dm.Id)
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		setReadReceiptsPref(t, client2, user2.Id, strconv.FormatInt(model.GetMillis()+365*24*time.Hour.Milliseconds(), 10))
+
+		requireReadReceipts(t, client2, dm.Id, 1, map[string]int64{user1.Id: post.CreateAt})
+		time.Sleep(5 * time.Millisecond)
+		newer := postReadReceiptMessage(t, client1, dm.Id)
+		viewReadReceiptChannel(t, client2, dm.Id)
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{user2.Id: newer.CreateAt})
+	})
+
+	t.Run("a legacy true value written before the fix exposes nothing", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		old := postReadReceiptMessage(t, client1, dm.Id)
+		viewReadReceiptChannel(t, client2, dm.Id)
+		require.NoError(t, th.App.Srv().Store().Preference().Save(model.Preferences{{
+			UserId:   user2.Id,
+			Category: model.PreferenceCategoryDisplaySettings,
+			Name:     model.PreferenceNameReadReceipts,
+			Value:    "true",
+		}}))
+
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+		requireReadReceipts(t, client2, dm.Id, 1, map[string]int64{})
+
+		setReadReceiptsPref(t, client2, user2.Id, "true")
+		requireReadReceipts(t, client1, dm.Id, 1, map[string]int64{})
+		requireServerStamp(t, storedReadReceiptsPref(t, th, user2.Id), old.CreateAt, model.GetMillis())
+	})
+}
