+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import type {CloudState} from '@mattermost/types/cloud';
+import type {AdminConfig} from '@mattermost/types/config';
+
+import {RESOURCE_KEYS} from 'mattermost-redux/constants/permissions_sysconsole';
+
+import {renderWithContext, screen} from 'tests/react_testing_utils';
+
+import AdminDefinition from './admin_definition';
+import SchemaAdminSettings from './schema_admin_settings';
+import type {AdminDefinitionSetting, AdminDefinitionSubSection, AdminDefinitionSubSectionSchema, ConsoleAccess} from './types';
+
+type DisabledCheck = (config: object, state: object, license: undefined, enterpriseReady: boolean, consoleAccess: ConsoleAccess) => boolean;
+
+const READ_RECEIPTS_KEY = 'TeamSettings.EnableReadReceipts';
+
+function settingsOf(subsection: AdminDefinitionSubSection): AdminDefinitionSetting[] {
+    const schema = subsection.schema;
+
+    return schema && 'settings' in schema && schema.settings ? schema.settings : [];
+}
+
+function writeAccessTo(resourceKey: string): ConsoleAccess {
+    return {read: {}, write: {[resourceKey]: true}};
+}
+
+describe('AdminDefinition - Enable read receipts setting', () => {
+    const usersAndTeams = AdminDefinition.site.subsections.users_and_teams;
+    const getSetting = () => settingsOf(usersAndTeams).find((setting) => setting.key === READ_RECEIPTS_KEY);
+
+    test('sits right after Enable last active time on the Users and Teams page', () => {
+        const keys = settingsOf(usersAndTeams).map((setting) => setting.key);
+
+        expect(getSetting()?.type).toBe('bool');
+        expect(keys.indexOf(READ_RECEIPTS_KEY)).toBe(keys.indexOf('TeamSettings.EnableLastActiveTime') + 1);
+    });
+
+    test('is gated on write access to the Users and Teams console resource', () => {
+        const isDisabled = getSetting()?.isDisabled as DisabledCheck;
+
+        expect(isDisabled({}, {}, undefined, true, writeAccessTo(RESOURCE_KEYS.SITE.USERS_AND_TEAMS))).toBe(false);
+        expect(isDisabled({}, {}, undefined, true, writeAccessTo(RESOURCE_KEYS.SITE.CUSTOMIZATION))).toBe(true);
+    });
+
+    test('renders with its label, help text and saved value', () => {
+        const schema = usersAndTeams.schema as AdminDefinitionSubSectionSchema;
+
+        renderWithContext(
+            <SchemaAdminSettings
+                cloud={{} as CloudState}
+                consoleAccess={writeAccessTo(RESOURCE_KEYS.SITE.USERS_AND_TEAMS)}
+                editRole={jest.fn()}
+                enterpriseReady={false}
+                isCurrentUserSystemAdmin={true}
+                isDisabled={false}
+                license={{}}
+                roles={{}}
+                setNavigationBlocked={jest.fn()}
+                config={{TeamSettings: {EnableReadReceipts: true}} as unknown as Partial<AdminConfig>}
+                environmentConfig={{}}
+                schema={{...schema, settings: settingsOf(usersAndTeams).filter((setting) => setting.key === READ_RECEIPTS_KEY)} as AdminDefinitionSubSectionSchema}
+                patchConfig={jest.fn()}
+            />,
+        );
+
+        expect(screen.getByText('Enable read receipts:')).toBeInTheDocument();
+        expect(screen.getByText(/Read receipts never appear in channels\./)).toBeInTheDocument();
+        expect(screen.getByTestId('TeamSettings.EnableReadReceiptstrue')).toBeChecked();
+    });
+});
