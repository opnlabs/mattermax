+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {connect} from 'react-redux';
+import {bindActionCreators} from 'redux';
+import type {Dispatch} from 'redux';
+
+import {savePreferences} from 'mattermost-redux/actions/preferences';
+import {Preferences} from 'mattermost-redux/constants';
+import {getConfig} from 'mattermost-redux/selectors/entities/general';
+import {get} from 'mattermost-redux/selectors/entities/preferences';
+
+import {PREFERENCE_NAME_READ_RECEIPTS} from 'components/read_receipts/state';
+
+import type {GlobalState} from 'types/store';
+
+import ReadReceipts from './read_receipts';
+
+function mapStateToProps(state: GlobalState) {
+    return {
+        enabled: getConfig(state).EnableReadReceipts === 'true',
+        readReceipts: get(state, Preferences.CATEGORY_DISPLAY_SETTINGS, PREFERENCE_NAME_READ_RECEIPTS, ''),
+    };
+}
+
+function mapDispatchToProps(dispatch: Dispatch) {
+    return {
+        actions: bindActionCreators({
+            savePreferences,
+        }, dispatch),
+    };
+}
+
+export default connect(mapStateToProps, mapDispatchToProps)(ReadReceipts);
