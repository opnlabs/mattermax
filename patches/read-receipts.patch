+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import type {UserProfile} from '@mattermost/types/users';
+import type {DeepPartial} from '@mattermost/types/utilities';
+
+import {renderWithContext, screen, userEvent} from 'tests/react_testing_utils';
+
+import type {GlobalState} from 'types/store';
+
+import ReadReceipts from './read_receipts';
+
+import ConnectedReadReceipts from './index';
+
+const user = {id: 'user_id', username: 'username'} as UserProfile;
+
+function makeState(enabled: string, ownSetting?: string) {
+    return {
+        entities: {
+            general: {config: {EnableReadReceipts: enabled}},
+            preferences: {
+                myPreferences: ownSetting === undefined ? {} : {
+                    'display_settings--read_receipts': {user_id: user.id, category: 'display_settings', name: 'read_receipts', value: ownSetting},
+                },
+            },
+            users: {currentUserId: user.id},
+        },
+    } as unknown as DeepPartial<GlobalState>;
+}
+
+describe('ReadReceipts setting', () => {
+    test('is hidden when the admin switch is off', () => {
+        const {container} = renderWithContext(
+            <ConnectedReadReceipts
+                user={user}
+                activeSection=''
+                updateSection={jest.fn()}
+            />,
+            makeState('false'),
+        );
+
+        expect(container).toBeEmptyDOMElement();
+    });
+
+    test('is hidden when an admin edits another user', () => {
+        const {container} = renderWithContext(
+            <ConnectedReadReceipts
+                user={user}
+                adminMode={true}
+                activeSection=''
+                updateSection={jest.fn()}
+            />,
+            makeState('true'),
+        );
+
+        expect(container).toBeEmptyDOMElement();
+    });
+
+    test('shows On by default when the admin switch is on', () => {
+        renderWithContext(
+            <ConnectedReadReceipts
+                user={user}
+                activeSection=''
+                updateSection={jest.fn()}
+            />,
+            makeState('true'),
+        );
+
+        expect(screen.getByText('Read receipts')).toBeInTheDocument();
+        expect(screen.getByText('On')).toBeInTheDocument();
+    });
+
+    test('shows Off after the user turned it off', () => {
+        renderWithContext(
+            <ConnectedReadReceipts
+                user={user}
+                activeSection=''
+                updateSection={jest.fn()}
+            />,
+            makeState('true', 'false'),
+        );
+
+        expect(screen.getByText('Off')).toBeInTheDocument();
+    });
+
+    function renderOpen(readReceipts: string) {
+        const savePreferences = jest.fn();
+        const updateSection = jest.fn();
+        renderWithContext(
+            <ReadReceipts
+                user={user}
+                activeSection='readReceipts'
+                updateSection={updateSection}
+                enabled={true}
+                readReceipts={readReceipts}
+                actions={{savePreferences}}
+            />,
+        );
+        return {savePreferences, updateSection};
+    }
+
+    test('saving Off stores false', async () => {
+        const {savePreferences, updateSection} = renderOpen('');
+
+        await userEvent.click(screen.getByLabelText('Off'));
+        await userEvent.click(screen.getByRole('button', {name: 'Save'}));
+
+        expect(savePreferences).toHaveBeenCalledWith(user.id, [{
+            user_id: user.id,
+            category: 'display_settings',
+            name: 'read_receipts',
+            value: 'false',
+        }]);
+        expect(updateSection).toHaveBeenCalledWith('');
+    });
+
+    test('saving On stores true and leaves the time to the server', async () => {
+        const {savePreferences} = renderOpen('false');
+
+        await userEvent.click(screen.getByLabelText('On'));
+        await userEvent.click(screen.getByRole('button', {name: 'Save'}));
+
+        expect(savePreferences).toHaveBeenCalledWith(user.id, [{
+            user_id: user.id,
+            category: 'display_settings',
+            name: 'read_receipts',
+            value: 'true',
+        }]);
+    });
+
+    test('saving without a change stores nothing', async () => {
+        const {savePreferences, updateSection} = renderOpen('');
+
+        await userEvent.click(screen.getByRole('button', {name: 'Save'}));
+
+        expect(savePreferences).not.toHaveBeenCalled();
+        expect(updateSection).toHaveBeenCalledWith('');
+    });
+});
