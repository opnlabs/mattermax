+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import type {WebSocketMessage} from '@mattermost/client';
+import type {DeepPartial} from '@mattermost/types/utilities';
+
+import WebSocketClient from 'client/web_websocket_client';
+import {act, renderWithContext, waitFor} from 'tests/react_testing_utils';
+
+import type {GlobalState} from 'types/store';
+
+import ReadReceiptsSync from './read_receipts_sync';
+import {READ_RECEIPT_RECEIVED} from './state';
+
+const CHANNEL = 'channel1';
+
+function makeState({channelType = 'D', ownSetting, lastConnectAt = 1}: {channelType?: string; ownSetting?: string; lastConnectAt?: number} = {}) {
+    return {
+        entities: {
+            general: {config: {EnableReadReceipts: 'true'}},
+            channels: {channels: {[CHANNEL]: {id: CHANNEL, type: channelType}}},
+            preferences: {
+                myPreferences: ownSetting === undefined ? {} : {
+                    'display_settings--read_receipts': {user_id: 'me', category: 'display_settings', name: 'read_receipts', value: ownSetting},
+                },
+            },
+            users: {currentUserId: 'me'},
+        },
+        websocket: {lastConnectAt},
+    } as unknown as DeepPartial<GlobalState>;
+}
+
+describe('ReadReceiptsSync', () => {
+    let fetchSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+        fetchSpy = jest.spyOn(globalThis, 'fetch').mockResolvedValue({
+            ok: true,
+            json: async () => ({channel_id: CHANNEL, other_member_count: 1, last_viewed_at: {u2: 500}}),
+        } as Response);
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    function readReceiptFetches() {
+        return fetchSpy.mock.calls.filter(([url]) => String(url).endsWith(`/channels/${CHANNEL}/read_receipts`));
+    }
+
+    test('registers its reducer and stores fetched receipts for an active DM', async () => {
+        const {store} = renderWithContext(<ReadReceiptsSync channelId={CHANNEL}/>, makeState());
+
+        await waitFor(() => {
+            expect((store.getState() as GlobalState & {readReceipts: unknown}).readReceipts).toEqual({
+                [CHANNEL]: {otherMemberCount: 1, lastViewedAt: {u2: 500}},
+            });
+        });
+        expect(readReceiptFetches()).toHaveLength(1);
+    });
+
+    test('does not fetch for a public channel', async () => {
+        renderWithContext(<ReadReceiptsSync channelId={CHANNEL}/>, makeState({channelType: 'O'}), {useMockedStore: true});
+
+        await act(async () => {});
+        expect(readReceiptFetches()).toHaveLength(0);
+    });
+
+    test('refetches after the websocket reconnects', async () => {
+        const {updateStoreState} = renderWithContext(<ReadReceiptsSync channelId={CHANNEL}/>, makeState(), {useMockedStore: true});
+        await waitFor(() => expect(readReceiptFetches()).toHaveLength(1));
+
+        updateStoreState({websocket: {lastConnectAt: 2}});
+        await waitFor(() => expect(readReceiptFetches()).toHaveLength(2));
+    });
+
+    test('fetches when the user turns read receipts back on', async () => {
+        const {replaceStoreState} = renderWithContext(<ReadReceiptsSync channelId={CHANNEL}/>, makeState({ownSetting: 'false'}), {useMockedStore: true});
+        await act(async () => {});
+        expect(readReceiptFetches()).toHaveLength(0);
+
+        replaceStoreState(makeState({ownSetting: '1762934400000'}));
+        await waitFor(() => expect(readReceiptFetches()).toHaveLength(1));
+    });
+
+    test('dispatches read_receipt events and ignores other events', async () => {
+        const listeners: Array<(msg: WebSocketMessage) => void> = [];
+        jest.spyOn(WebSocketClient, 'addMessageListener').mockImplementation((listener) => {
+            listeners.push(listener);
+        });
+
+        const {store} = renderWithContext(<ReadReceiptsSync channelId={CHANNEL}/>, makeState(), {useMockedStore: true});
+        await waitFor(() => expect(listeners).not.toHaveLength(0));
+
+        act(() => {
+            listeners.forEach((listener) => {
+                listener({event: 'typing', data: {user_id: 'u2'}, broadcast: {channel_id: CHANNEL}, seq: 1} as unknown as WebSocketMessage);
+                listener({event: 'read_receipt', data: {user_id: 'u2', last_viewed_at: 900}, broadcast: {channel_id: CHANNEL}, seq: 2} as unknown as WebSocketMessage);
+            });
+        });
+
+        const actions = (store as unknown as {getActions: () => Array<{type: string}>}).getActions();
+        const receiptActions = actions.filter((action) => action.type === READ_RECEIPT_RECEIVED);
+        expect(receiptActions).toEqual([{type: READ_RECEIPT_RECEIVED, channelId: CHANNEL, userId: 'u2', lastViewedAt: 900}]);
+    });
+});
