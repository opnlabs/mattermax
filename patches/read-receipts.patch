@@ -0,0 +1,86 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package model
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestReadReceiptVisible(t *testing.T) {
+	off := ReadReceiptsPref{}
+	on := ReadReceiptsPref{On: true}
+	onSince := ReadReceiptsPref{On: true, Since: 1000}
+
+	anyType := []ChannelType{ChannelTypeOpen, ChannelTypePrivate, ChannelTypeDirect, ChannelTypeGroup}
+	directOrGroup := []ChannelType{ChannelTypeDirect, ChannelTypeGroup}
+	anyPref := []ReadReceiptsPref{off, on, onSince}
+	anyWatermark := []int64{0, 999, 1000, 5000}
+
+	rows := []struct {
+		name       string
+		enabled    []bool
+		types      []ChannelType
+		viewer     []ReadReceiptsPref
+		reader     []ReadReceiptsPref
+		watermarks []int64
+		want       bool
+	}{
+		{"switch off", []bool{false}, anyType, anyPref, anyPref, anyWatermark, false},
+		{"open or private channel", []bool{true}, []ChannelType{ChannelTypeOpen, ChannelTypePrivate}, anyPref, anyPref, anyWatermark, false},
+		{"viewer off", []bool{true}, directOrGroup, []ReadReceiptsPref{off}, anyPref, anyWatermark, false},
+		{"reader off", []bool{true}, directOrGroup, []ReadReceiptsPref{on, onSince}, []ReadReceiptsPref{off}, anyWatermark, false},
+		{"reader watermark before re-enable", []bool{true}, directOrGroup, []ReadReceiptsPref{on, onSince}, []ReadReceiptsPref{onSince}, []int64{0, 999}, false},
+		{"reader watermark at or after re-enable", []bool{true}, directOrGroup, []ReadReceiptsPref{on, onSince}, []ReadReceiptsPref{onSince}, []int64{1000, 5000}, true},
+		{"reader on since 0", []bool{true}, directOrGroup, []ReadReceiptsPref{on, onSince}, []ReadReceiptsPref{on}, anyWatermark, true},
+	}
+
+	for _, row := range rows {
+		for _, enabled := range row.enabled {
+			for _, channelType := range row.types {
+				for _, viewer := range row.viewer {
+					for _, reader := range row.reader {
+						for _, watermark := range row.watermarks {
+							name := fmt.Sprintf("%s/E=%v T=%s V=%+v R=%+v W=%d", row.name, enabled, channelType, viewer, reader, watermark)
+							t.Run(name, func(t *testing.T) {
+								assert.Equal(t, row.want, ReadReceiptVisible(enabled, channelType, viewer, reader, watermark))
+							})
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestParseReadReceiptsPref(t *testing.T) {
+	const now = int64(1762934400000)
+	for _, tc := range []struct {
+		name string
+		pref *Preference
+		want ReadReceiptsPref
+	}{
+		{"no row", nil, ReadReceiptsPref{On: true}},
+		{"false", &Preference{Value: "false"}, ReadReceiptsPref{}},
+		{"true", &Preference{Value: "true"}, ReadReceiptsPref{}},
+		{"junk", &Preference{Value: "maybe"}, ReadReceiptsPref{}},
+		{"empty", &Preference{Value: ""}, ReadReceiptsPref{}},
+		{"negative", &Preference{Value: "-5"}, ReadReceiptsPref{}},
+		{"signed", &Preference{Value: "+5"}, ReadReceiptsPref{}},
+		{"decimal", &Preference{Value: "1.5"}, ReadReceiptsPref{}},
+		{"padded", &Preference{Value: " 5"}, ReadReceiptsPref{}},
+		{"overflow", &Preference{Value: "99999999999999999999"}, ReadReceiptsPref{}},
+		{"future", &Preference{Value: "1762934400001"}, ReadReceiptsPref{}},
+		{"far future", &Preference{Value: "9223372036854775807"}, ReadReceiptsPref{}},
+		{"zero", &Preference{Value: "0"}, ReadReceiptsPref{On: true}},
+		{"past", &Preference{Value: "1762934399999"}, ReadReceiptsPref{On: true, Since: 1762934399999}},
+		{"now", &Preference{Value: "1762934400000"}, ReadReceiptsPref{On: true, Since: now}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, ParseReadReceiptsPref(tc.pref, now))
+		})
+	}
+}
