+func TestReadReceiptWebsocketEvent(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	setReadReceiptsEnabled(th, true)
+
+	user1, user2 := th.BasicUser, th.BasicUser2
+	client1 := th.Client
+	client2 := loggedInClient(t, th, user2)
+	ws1 := th.CreateConnectedWebSocketClientWithClient(t, client1)
+	ws2 := th.CreateConnectedWebSocketClientWithClient(t, client2)
+	dm := th.CreateDmChannel(t, user2)
+
+	t.Run("reader viewing an unread DM notifies the other member only", func(t *testing.T) {
+		post := postReadReceiptMessage(t, client2, dm.Id)
+		requireReadReceiptEvent(t, ws1, dm.Id, user2.Id, post.CreateAt)
+
+		viewReadReceiptChannel(t, client1, dm.Id)
+		requireReadReceiptEvent(t, ws2, dm.Id, user1.Id, post.CreateAt)
+		requireNoReadReceiptEvent(t, ws1, dm.Id)
+	})
+
+	t.Run("posting in a DM notifies the other member", func(t *testing.T) {
+		post := postReadReceiptMessage(t, client1, dm.Id)
+		requireReadReceiptEvent(t, ws2, dm.Id, user1.Id, post.CreateAt)
+	})
+
+	t.Run("viewer opted out", func(t *testing.T) {
+		setReadReceiptsPref(t, client2, user2.Id, "false")
+		defer clearReadReceiptsPref(t, client2, user2.Id)
+		postReadReceiptMessage(t, client1, dm.Id)
+		requireNoReadReceiptEvent(t, ws2, dm.Id)
+	})
+
+	t.Run("reader opted out", func(t *testing.T) {
+		setReadReceiptsPref(t, client1, user1.Id, "false")
+		defer clearReadReceiptsPref(t, client1, user1.Id)
+		postReadReceiptMessage(t, client1, dm.Id)
+		requireNoReadReceiptEvent(t, ws2, dm.Id)
+	})
+
+	t.Run("switch off", func(t *testing.T) {
+		setReadReceiptsEnabled(th, false)
+		defer setReadReceiptsEnabled(th, true)
+		postReadReceiptMessage(t, client1, dm.Id)
+		requireNoReadReceiptEvent(t, ws2, dm.Id)
+	})
+
+	t.Run("public channel", func(t *testing.T) {
+		postReadReceiptMessage(t, client1, th.BasicChannel.Id)
+		requireNoReadReceiptEvent(t, ws2, th.BasicChannel.Id)
+	})
+
+	t.Run("group message omits the member who opted out", func(t *testing.T) {
+		user3 := th.CreateUser(t)
+		client3 := loggedInClient(t, th, user3)
+		ws3 := th.CreateConnectedWebSocketClientWithClient(t, client3)
+		gm, appErr := th.App.CreateGroupChannel(th.Context, []string{user1.Id, user2.Id, user3.Id}, user1.Id)
+		require.Nil(t, appErr)
+		setReadReceiptsPref(t, client3, user3.Id, "false")
+
+		post := postReadReceiptMessage(t, client1, gm.Id)
