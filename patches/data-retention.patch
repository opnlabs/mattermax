+func TestDataRetentionJobOutboxDrainBounds(t *testing.T) {
+	mainHelper.Parallel(t)
+	noFiles := func(s *model.DataRetentionSettings) { s.EnableFileDeletion = model.NewPointer(false) }
+
+	t.Run("cancel between outbox rows stops after the current row", func(t *testing.T) {
+		e := setupRetention(t, noFiles)
+		var posts []*model.Post
+		var files []*retentionFile
+		for range 3 {
+			p, f := e.burnOnReadPost(e.now - 3*24*retentionHour)
+			posts = append(posts, p)
+			files = append(files, f)
+		}
+		e.queueDeletedPosts(1, 3)
+
+		job := e.createJob(nil)
+		backend := e.cancelOnFirstRemove(job.Id)
+		e.worker(backend).DoJob(job)
+
+		assert.Equal(t, model.JobStatusCanceled, e.job(job.Id).Status)
+		assert.Len(t, backend().(hookRemoveBackend).calls(), 1, "only the first row's attachment was removed")
+		assert.Equal(t, int64(2), e.outboxRows(), "the remaining rows wait for the next run")
+		cleaned, objects := 0, 0
+		for i, p := range posts {
+			if e.count("Reactions", "PostId", p.Id) == 0 {
+				cleaned++
+			}
+			_, _, n := e.fileState(files[i])
+			objects += n
+		}
+		assert.Equal(t, 1, cleaned)
+		assert.Equal(t, 2, objects)
+
+		rerun := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, rerun.Status, rerun.Data["error"])
+		assert.Zero(t, e.outboxRows())
+		for i, p := range posts {
+			assert.Empty(t, e.dependentsLeft(p.Id))
+			row, _, n := e.fileState(files[i])
+			assert.False(t, row)
+			assert.Zero(t, n)
+		}
+	})
+
+	t.Run("cancel between groups of file removals inside one outbox row", func(t *testing.T) {
+		e := setupRetention(t, func(s *model.DataRetentionSettings) {
+			noFiles(s)
+			s.BatchSize = model.NewPointer(1)
+		})
+		var files []*retentionFile
+		for range 3 {
+			_, f := e.burnOnReadPost(e.now - 3*24*retentionHour)
+			files = append(files, f)
+		}
+		e.queueDeletedPosts(3, 1)
+
+		job := e.createJob(nil)
+		backend := e.cancelOnFirstRemove(job.Id)
+		e.worker(backend).DoJob(job)
+
+		assert.Equal(t, model.JobStatusCanceled, e.job(job.Id).Status)
+		assert.Len(t, backend().(hookRemoveBackend).calls(), 1, "one removal per batch before the next check")
+		assert.Equal(t, int64(1), e.outboxRows(), "the row stays queued")
+		objects := 0
+		for _, f := range files {
+			_, _, n := e.fileState(f)
+			objects += n
+		}
+		assert.Equal(t, 2, objects)
+
+		rerun := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, rerun.Status, rerun.Data["error"])
+		assert.Zero(t, e.outboxRows())
+		for _, f := range files {
+			row, _, n := e.fileState(f)
+			assert.False(t, row)
+			assert.Zero(t, n)
+		}
+	})
+}
