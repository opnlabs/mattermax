+
+	t.Run("burn-on-read objects already gone", func(t *testing.T) {
+		e := setupRetention(t, func(s *model.DataRetentionSettings) { s.EnableFileDeletion = model.NewPointer(false) })
+		bor := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+		_, err := e.th.Server.Store().TemporaryPost().Save(e.th.Context, &model.TemporaryPost{ID: bor.Id, Type: model.PostTypeBurnOnRead, ExpireAt: e.now + retentionHour, Message: "secret"})
+		require.NoError(t, err)
+		f := e.file(bor.Id, e.now, withImagePaths)
+		require.Nil(t, e.th.App.RemoveFile(f.info.Path))
+
+		job := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+		requireCounters(t, job, map[string]int64{"files_deleted_with_posts": 1, "files_failed": 0})
+		row, _, objects := e.fileState(f)
+		assert.False(t, row)
+		assert.Zero(t, objects)
+	})
+
+	t.Run("file objects already gone", func(t *testing.T) {
+		e := setupRetention(t, nil)
+		p := e.post(e.th.BasicChannel.Id, e.now)
+		f := e.file(p.Id, e.now-3*24*retentionHour)
+		require.Nil(t, e.th.App.RemoveFile(f.info.Path))
+
+		job := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+		requireCounters(t, job, map[string]int64{"files_deleted": 1, "files_failed": 0})
+		row, _, _ := e.fileState(f)
+		assert.False(t, row)
+	})
+
+	t.Run("an abandoned run is marked failed and replaced", func(t *testing.T) {
+		e := setupRetention(t, nil)
+		stale := e.saveRunningJob(e.now-time.Hour.Milliseconds(), e.now-time.Hour.Milliseconds())
+		p := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+
+		job := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+		assert.False(t, e.postExists(p.Id))
+		reaped := e.job(stale.Id)
+		assert.Equal(t, model.JobStatusError, reaped.Status)
+		assert.Contains(t, reaped.Data["error"], "superseded by "+job.Id)
+	})
+
+	t.Run("a live run keeps the new job pending", func(t *testing.T) {
+		e := setupRetention(t, nil)
+		running := e.saveRunningJob(e.now, e.now)
+		p := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+
+		job := e.run(nil, nil)
+		assert.Equal(t, model.JobStatusPending, job.Status)
+		assert.True(t, e.postExists(p.Id))
+		assert.Equal(t, model.JobStatusInProgress, e.job(running.Id).Status)
+	})
+}
