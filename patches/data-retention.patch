+	var nfErr *store.ErrNotFound
+	if err != nil && !errors.As(err, &nfErr) {
+		return retentionInternal("RemoveChannelsFromPolicy", err)
+	}
+	change := unchangedPeriod(policy)
+	change.RemovedChannelTeams = channelTeams(channels)
+	if appErr := s.pauseIfStricter("RemoveChannelsFromPolicy", change); appErr != nil {
+		return appErr
+	}
+	if err := s.store().RemoveChannels(policyID, channelIDs); err != nil {
+		return retentionInternal("RemoveChannelsFromPolicy", err)
