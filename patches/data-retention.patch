+func testDataRetentionSaveCopy(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) {
+	src := saveRetentionFile(t, rctx, ss, &model.FileInfo{PostId: model.NewId(), ChannelId: model.NewId(), CreateAt: 5, ThumbnailPath: "retention/thumb.jpg", Size: 9})
+	user := model.NewId()
+	copied, err := ss.FileInfo().SaveCopy(rctx, src.Id, user, 1234)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, ss.FileInfo().PermanentDelete(rctx, src.Id))
+		require.NoError(t, ss.FileInfo().PermanentDelete(rctx, copied.Id))
+	})
+
+	got, err := ss.FileInfo().GetFromMaster(copied.Id)
+	require.NoError(t, err)
+	assert.NotEqual(t, src.Id, got.Id)
+	assert.Equal(t, user, got.CreatorId)
+	assert.Equal(t, int64(1234), got.CreateAt)
+	assert.Equal(t, int64(1234), got.UpdateAt)
+	assert.Empty(t, got.PostId)
+	assert.Empty(t, got.ChannelId)
+	assert.Equal(t, src.Path, got.Path)
+	assert.Equal(t, src.ThumbnailPath, got.ThumbnailPath)
+	assert.Equal(t, src.Size, got.Size)
+
+	require.NoError(t, ss.FileInfo().SoftDeleteByIds([]string{src.Id}, 99))
+	_, err = ss.FileInfo().SaveCopy(rctx, src.Id, user, 1235)
+	var nfErr *store.ErrNotFound
+	require.True(t, errors.As(err, &nfErr), "a soft-deleted source cannot be copied: %v", err)
+	var n int64
+	require.NoError(t, s.GetMaster().Get(&n, "SELECT COUNT(*) FROM FileInfo WHERE Path = ?", src.Path))
+	assert.Equal(t, int64(2), n, "no new row")
+}
