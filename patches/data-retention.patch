+func (e *retentionEnv) fileState(f *retentionFile) (rowExists bool, deleteAt int64, objects int) {
+	var rows []int64
+	require.NoError(e.t, e.th.SQLStore.GetMaster().Select(&rows, "SELECT DeleteAt FROM FileInfo WHERE Id = ?", f.info.Id))
+	for _, p := range f.paths {
+		if e.objectExists(p) {
+			objects++
+		}
+	}
+	if len(rows) == 0 {
+		return false, 0, objects
