+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package api4
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func TestDataRetentionPoliciesWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	client := th.SystemAdminClient
+	ctx := context.Background()
+
+	newPolicy := func(name string, days *int64, teamIDs, channelIDs []string) *model.RetentionPolicyWithTeamAndChannelIDs {
+		return &model.RetentionPolicyWithTeamAndChannelIDs{
+			RetentionPolicy: model.RetentionPolicy{DisplayName: name, PostDurationDays: days},
+			TeamIDs:         teamIDs,
+			ChannelIDs:      channelIDs,
+		}
+	}
+
+	t.Run("post duration must be -1 or 1 to 36500 days", func(t *testing.T) {
+		for _, d := range []int64{0, -2, 36501} {
+			_, resp, err := client.CreateDataRetentionPolicy(ctx, newPolicy("bad", model.NewPointer(d), nil, nil))
+			require.Error(t, err, d)
+			CheckBadRequestStatus(t, resp)
+		}
+		_, resp, err := client.CreateDataRetentionPolicy(ctx, newPolicy("missing duration", nil, nil, nil))
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+
+		var created *model.RetentionPolicyWithTeamAndChannelCounts
+		for _, d := range []int64{-1, 30, 36500} {
+			created, resp, err = client.CreateDataRetentionPolicy(ctx, newPolicy("good", model.NewPointer(d), nil, nil))
+			require.NoError(t, err, d)
+			CheckCreatedStatus(t, resp)
+			assert.Equal(t, d, *created.PostDurationDays)
+		}
+
+		_, resp, err = client.PatchDataRetentionPolicy(ctx, &model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: created.ID, PostDurationDays: model.NewPointer[int64](0)}})
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+	})
+
+	t.Run("display name must have 1 to 64 characters", func(t *testing.T) {
+		_, resp, err := client.CreateDataRetentionPolicy(ctx, newPolicy("   ", model.NewPointer[int64](30), nil, nil))
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+
+		created, resp, err := client.CreateDataRetentionPolicy(ctx, newPolicy(strings.Repeat("保", 64), model.NewPointer[int64](30), nil, nil))
+		require.NoError(t, err)
+		CheckCreatedStatus(t, resp)
+
+		_, resp, err = client.CreateDataRetentionPolicy(ctx, newPolicy(strings.Repeat("保", 65), model.NewPointer[int64](30), nil, nil))
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+
+		_, resp, err = client.PatchDataRetentionPolicy(ctx, &model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: created.ID, DisplayName: "  "}})
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+	})
+
+	t.Run("missing policies give 404", func(t *testing.T) {
+		missing := model.NewId()
+		_, resp, err := client.GetDataRetentionPolicyByID(ctx, missing)
+		require.Error(t, err)
+		CheckNotFoundStatus(t, resp)
+		_, resp, err = client.PatchDataRetentionPolicy(ctx, &model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: missing, DisplayName: "x"}})
+		require.Error(t, err)
+		CheckNotFoundStatus(t, resp)
+		resp, err = client.DeleteDataRetentionPolicy(ctx, missing)
+		require.Error(t, err)
+		CheckNotFoundStatus(t, resp)
+		resp, err = client.AddTeamsToRetentionPolicy(ctx, missing, []string{th.BasicTeam.Id})
+		require.Error(t, err)
+		CheckNotFoundStatus(t, resp)
+		resp, err = client.AddChannelsToRetentionPolicy(ctx, missing, []string{th.BasicChannel.Id})
+		require.Error(t, err)
+		CheckNotFoundStatus(t, resp)
+	})
+
+	t.Run("direct, group and already assigned channels are rejected", func(t *testing.T) {
+		policy, _, err := client.CreateDataRetentionPolicy(ctx, newPolicy("channels", model.NewPointer[int64](30), nil, nil))
+		require.NoError(t, err)
+		other, _, err := client.CreateDataRetentionPolicy(ctx, newPolicy("other", model.NewPointer[int64](30), nil, []string{th.BasicChannel2.Id}))
+		require.NoError(t, err)
+		require.NotEqual(t, policy.ID, other.ID)
+
+		dm := th.CreateDmChannel(t, th.BasicUser2)
+		gm, _, err := client.CreateGroupChannel(ctx, []string{th.BasicUser.Id, th.BasicUser2.Id, th.SystemAdminUser.Id})
+		require.NoError(t, err)
+		for _, c := range []*model.Channel{dm, gm} {
+			resp, err := client.AddChannelsToRetentionPolicy(ctx, policy.ID, []string{c.Id})
+			require.Error(t, err)
+			CheckBadRequestStatus(t, resp)
+		}
+		_, resp, err := client.CreateDataRetentionPolicy(ctx, newPolicy("dm", model.NewPointer[int64](30), nil, []string{dm.Id}))
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+
+		resp, err = client.AddChannelsToRetentionPolicy(ctx, policy.ID, []string{th.BasicChannel.Id, th.BasicChannel2.Id})
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+		channels, _, err := client.GetChannelsForRetentionPolicy(ctx, policy.ID, 0, 100)
+		require.NoError(t, err)
+		assert.Zero(t, channels.TotalCount, "the valid channel was not added either")
+
+		resp, err = client.AddChannelsToRetentionPolicy(ctx, policy.ID, []string{model.NewId()})
+		require.Error(t, err)
+		CheckBadRequestStatus(t, resp)
+
+		resp, err = client.AddChannelsToRetentionPolicy(ctx, policy.ID, []string{th.BasicChannel.Id})
+		require.NoError(t, err)
+		CheckOKStatus(t, resp)
+	})
+
+	t.Run("deletion job is created as a manual run by the admin who asked", func(t *testing.T) {
+		job, resp, err := client.CreateJob(ctx, &model.Job{Type: model.JobTypeDataRetention, Data: model.StringMap{"trigger": "schedule", "phase": "done"}})
+		require.NoError(t, err)
+		CheckCreatedStatus(t, resp)
+		assert.Equal(t, model.JobTypeDataRetention, job.Type)
+		assert.Equal(t, model.StringMap{"trigger": "manual", "requested_by": th.SystemAdminUser.Id}, job.Data)
+	})
+}
