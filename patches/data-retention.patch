+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func TestPeriods(t *testing.T) {
+	assert.Equal(t, Forever, GlobalPeriod(false, model.NewPointer(24), nil))
+	assert.Equal(t, Period(24), GlobalPeriod(true, model.NewPointer(24), model.NewPointer(10)))
+	assert.Equal(t, Period(240), GlobalPeriod(true, model.NewPointer(0), model.NewPointer(10)))
+	assert.Equal(t, Period(365*24), GlobalPeriod(true, nil, nil))
+	assert.Equal(t, Forever, GlobalPeriod(true, model.NewPointer(876_001), nil), "longer than 100 years keeps forever")
+
+	assert.Equal(t, Forever, PolicyPeriod(model.NewPointer[int64](-1)))
+	assert.Equal(t, Forever, PolicyPeriod(model.NewPointer[int64](200_000_000_000)))
+	assert.Equal(t, Period(24), PolicyPeriod(model.NewPointer[int64](1)))
+}
+
+func TestPolicyChangeStricter(t *testing.T) {
+	const global = Period(240)
+	teams := map[string]Period{"short": 120, "forever": Forever}
+	cases := []struct {
+		name     string
+		change   PolicyChange
+		stricter bool
+	}{
+		{"period shortened", PolicyChange{OldPeriod: 480, NewPeriod: 240}, true},
+		{"keep forever becomes limited", PolicyChange{OldPeriod: Forever, NewPeriod: 480}, true},
+		{"period lengthened", PolicyChange{OldPeriod: 240, NewPeriod: 480}, false},
+		{"limited becomes keep forever", PolicyChange{OldPeriod: 240, NewPeriod: Forever}, false},
+		{"team joins a policy shorter than the global period", PolicyChange{OldPeriod: 120, NewPeriod: 120, AddedTeams: 1}, true},
+		{"team joins a policy as long as the global period", PolicyChange{OldPeriod: 240, NewPeriod: 240, AddedTeams: 1}, false},
+		{"team leaves a policy longer than the global period", PolicyChange{OldPeriod: 480, NewPeriod: 480, RemovedTeams: 1}, true},
+		{"team leaves a policy shorter than the global period", PolicyChange{OldPeriod: 120, NewPeriod: 120, RemovedTeams: 1}, false},
+		{"channel joins a policy shorter than its team policy", PolicyChange{OldPeriod: 72, NewPeriod: 72, AddedChannelTeams: []string{"short"}}, true},
+		{"channel joins a policy longer than its team policy", PolicyChange{OldPeriod: 168, NewPeriod: 168, AddedChannelTeams: []string{"short"}}, false},
+		{"channel without a team policy joins a policy longer than the global period", PolicyChange{OldPeriod: 480, NewPeriod: 480, AddedChannelTeams: []string{"none"}}, false},
+		{"channel in a keep-forever team joins a limited policy", PolicyChange{OldPeriod: 480, NewPeriod: 480, AddedChannelTeams: []string{"forever"}}, true},
+		{"channel leaves for a shorter team policy", PolicyChange{OldPeriod: 168, NewPeriod: 168, RemovedChannelTeams: []string{"short"}}, true},
+		{"channel leaves for a keep-forever team policy", PolicyChange{OldPeriod: 24, NewPeriod: 24, RemovedChannelTeams: []string{"forever"}}, false},
+		{"direct messages leave a keep-forever policy", PolicyChange{OldPeriod: Forever, NewPeriod: Forever, RemovedChannelTeams: []string{""}}, true},
+	}
+	for _, tc := range cases {
+		assert.Equal(t, tc.stricter, tc.change.Stricter(global, teams), tc.name)
+	}
+}
+
+func TestConfirmationCovers(t *testing.T) {
+	confirmed := confirmation{MessagePeriod: 240, FilePeriod: Forever, PreservePinned: true, PolicyEpoch: "a"}
+	cases := []struct {
+		name    string
+		current func(c *confirmation)
+		covered bool
+	}{
+		{"unchanged", func(c *confirmation) {}, true},
+		{"message period longer", func(c *confirmation) { c.MessagePeriod = 480 }, true},
+		{"message deletion off", func(c *confirmation) { c.MessagePeriod = Forever }, true},
+		{"message period shorter", func(c *confirmation) { c.MessagePeriod = 120 }, false},
+		{"file deletion on", func(c *confirmation) { c.FilePeriod = 24_000 }, false},
+		{"pinned posts no longer preserved", func(c *confirmation) { c.PreservePinned = false }, false},
+		{"a policy got stricter", func(c *confirmation) { c.PolicyEpoch = "b" }, false},
+	}
+	for _, tc := range cases {
+		current := confirmed
+		current.JobID = "other"
+		tc.current(&current)
+		assert.Equal(t, tc.covered, confirmed.covers(current), tc.name)
+	}
+	assert.True(t, confirmation{MessagePeriod: Forever, FilePeriod: Forever}.covers(confirmation{MessagePeriod: Forever, FilePeriod: Forever, PreservePinned: true}), "preserving pinned posts is looser")
+}
diff --git a/server/channels/jobs/data_retention/plan.go b/server/channels/jobs/data_retention/plan.go
new file mode 100644
index 000000000000..2e697a0c617d
--- /dev/null
+++ b/server/channels/jobs/data_retention/plan.go
@@ -0,0 +1,180 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"math"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+const (
+	MaxRetentionDays  = 36_500
+	maxRetentionHours = MaxRetentionDays * 24
+
+	ArmedSystemKey       = "MattermaxDataRetentionArmedBy"
+	PolicyEpochSystemKey = "MattermaxDataRetentionPolicyEpoch"
+
+	TriggerKey      = "trigger"
+	TriggerManual   = "manual"
+	triggerSchedule = "schedule"
+
+	abandonAfter = 15 * time.Minute
+)
+
+type runPlan struct {
+	Now            int64
+	MessageCutoff  int64
+	FileCutoff     int64
+	PreservePinned bool
+	BatchSize      int
+	IdsBatchSize   int
+	Pause          time.Duration
+}
+
+// Period is how long data is kept, in hours.
+type Period int64
+
+const Forever Period = math.MaxInt64
+
+func GlobalPeriod(enabled bool, hours, days *int) Period {
+	if !enabled {
+		return Forever
+	}
+	switch {
+	case hours != nil && *hours > 0:
+		if *hours > maxRetentionHours {
+			return Forever
+		}
+		return Period(*hours)
+	case days != nil && *days > 0:
+		if *days > MaxRetentionDays {
+			return Forever
+		}
+		return Period(*days) * 24
+	}
+	return 365 * 24
+}
+
+func PolicyPeriod(days *int64) Period {
+	if days == nil || *days < 0 || *days > MaxRetentionDays {
+		return Forever
+	}
+	return Period(*days) * 24
+}
+
+func CutoffFor(enabled bool, hours, days *int, now int64) int64 {
+	p := GlobalPeriod(enabled, hours, days)
+	if p == Forever {
+		return 0
+	}
+	c := now - int64(p)*int64(time.Hour/time.Millisecond)
+	if c <= 0 || c >= now {
+		return 0
+	}
+	return c
+}
+
+func planFor(s *model.DataRetentionSettings, now int64) runPlan {
+	return runPlan{
+		Now:            now,
+		MessageCutoff:  CutoffFor(*s.EnableMessageDeletion, s.MessageRetentionHours, s.MessageRetentionDays, now),
+		FileCutoff:     CutoffFor(*s.EnableFileDeletion, s.FileRetentionHours, s.FileRetentionDays, now),
+		PreservePinned: *s.PreservePinnedPosts,
+		BatchSize:      max(*s.BatchSize, 1),
+		IdsBatchSize:   max(*s.RetentionIdsBatchSize, 1),
+		Pause:          time.Duration(*s.TimeBetweenBatchesMilliseconds) * time.Millisecond,
+	}
+}
+
+func ValidatePostDuration(d *int64, onCreate bool) bool {
+	if d == nil {
+		return !onCreate
+	}
+	return *d == -1 || (*d >= 1 && *d <= MaxRetentionDays)
+}
+
+func unsafePolicies(policies []*model.RetentionPolicyWithTeamAndChannelCounts) []*model.RetentionPolicyWithTeamAndChannelCounts {
+	var unsafe []*model.RetentionPolicyWithTeamAndChannelCounts
+	for _, p := range policies {
+		if !ValidatePostDuration(p.PostDurationDays, true) {
+			unsafe = append(unsafe, p)
+		}
+	}
+	return unsafe
+}
+
+func isAbandoned(job *model.Job, now int64) bool {
+	return now-job.LastActivityAt >= abandonAfter.Milliseconds()
+}
+
+func shouldYield(self *model.Job, others []*model.Job, now int64) bool {
+	for _, o := range others {
+		if o.Id == self.Id || isAbandoned(o, now) {
+			continue
+		}
+		if o.CreateAt < self.CreateAt || (o.CreateAt == self.CreateAt && o.Id < self.Id) {
+			return true
+		}
+	}
+	return false
+}
+
+func safeRelative(p string) bool {
+	if p == "" || strings.HasPrefix(p, "/") {
+		return false
+	}
+	c := path.Clean(p)
+	return c != "." && c != ".." && !strings.HasPrefix(c, "../")
+}
+
+func filePaths(f *model.FileInfo) []string {
+	var paths []string
+	for _, p := range []string{f.Path, f.ThumbnailPath, f.PreviewPath} {
+		if p != "" {
+			paths = append(paths, p)
+		}
+	}
+	return paths
+}
+
+func removalPlan(files []*model.FileInfo, shared map[string]bool) []string {
+	seen := map[string]bool{}
+	var paths []string
+	for _, f := range files {
+		if shared[f.Path] {
+			continue
+		}
+		for _, p := range filePaths(f) {
+			if !seen[p] {
+				seen[p] = true
+				paths = append(paths, p)
+			}
+		}
+	}
+	return paths
+}
+
+type fileDecision int
+
+const (
+	fileKeep fileDecision = iota
+	fileDelete
+	fileDeleteSharedKept
+)
+
+func decideFile(f *model.FileInfo, shared, removed map[string]bool) fileDecision {
+	if shared[f.Path] {
+		return fileDeleteSharedKept
+	}
+	for _, p := range filePaths(f) {
+		if !removed[p] {
+			return fileKeep
+		}
+	}
+	return fileDelete
+}
