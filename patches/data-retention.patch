+	membersLeft := func() []string {
+		var users []string
+		require.NoError(t, s.GetMaster().Select(&users, "SELECT UserId FROM ThreadMemberships WHERE PostId = ?", root))
+		slices.Sort(users)
+		return users
+	}
+	all := []string{stale, active1, active2}
+	slices.Sort(all)
+
+	runThreads := func() {
+		cursor := model.RetentionPolicyCursor{}
+		for !(cursor.ChannelPoliciesDone && cursor.TeamPoliciesDone && cursor.GlobalPoliciesDone) {
+			_, cursor, err = ss.Thread().PermanentDeleteBatchForRetentionPolicies(model.RetentionPolicyBatchConfigs{Now: now, Limit: 1000}, cursor)
+			require.NoError(t, err)
+		}
+		for {
+			n, err := ss.Thread().DeleteOrphanedRows(1000)
+			require.NoError(t, err)
+			if n < 1000 {
+				break
+			}
+		}
+	}
+
+	runThreads()
+	assert.True(t, f.exists("Threads", "PostId", root), "live thread stays")
+	assert.Equal(t, all, membersLeft(), "every member of a live thread stays, including the stale one")
+
+	_, err = s.GetMaster().Exec("UPDATE Threads SET LastReplyAt = ? WHERE PostId = ?", now-31*day, root)
+	require.NoError(t, err)
+	runThreads()
+	assert.False(t, f.exists("Threads", "PostId", root))
+	assert.Empty(t, membersLeft(), "memberships go with their thread")
+}
