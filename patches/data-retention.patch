+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+)
+
+func TestLiveOthersReap(t *testing.T) {
+	rctx := request.EmptyContext(mlog.CreateConsoleTestLogger(t))
+	setup := func(t *testing.T, reapResult *model.Job) (*Worker, *storetest.Store, *model.Job) {
+		stale := &model.Job{Id: model.NewId(), Type: model.JobTypeDataRetention, Status: model.JobStatusInProgress, LastActivityAt: 1, Data: model.StringMap{"phase": "posts"}}
+		s := &storetest.Store{}
+		t.Cleanup(func() { s.JobStore.AssertExpectations(t) })
+		s.JobStore.On("GetByTypeAndData", mock.Anything, model.JobTypeDataRetention, map[string]string(nil), true, model.JobStatusInProgress, model.JobStatusCancelRequested).Return([]*model.Job{stale}, nil)
+		s.JobStore.On("UpdateOptimisticallyIfInactive", mock.MatchedBy(func(j *model.Job) bool {
+			return j.Id == stale.Id && j.Status == model.JobStatusError && j.Data["phase"] == "posts" && j.Data["error"] != ""
+		}), model.JobStatusInProgress, mock.MatchedBy(func(before int64) bool {
+			return model.GetMillis()-before >= abandonAfter.Milliseconds()
+		})).Return(reapResult, nil).Once()
+		return &Worker{store: s}, s, stale
+	}
+
+	t.Run("an abandoned run is reaped and not counted as live", func(t *testing.T) {
+		w, _, stale := setup(t, &model.Job{Status: model.JobStatusError})
+		live, err := w.liveOthers(rctx, "self")
+		require.NoError(t, err)
+		assert.Empty(t, live)
+		assert.Equal(t, model.JobStatusInProgress, stale.Status)
+		assert.NotContains(t, stale.Data, "error")
+	})
+
+	t.Run("a run that heartbeats before the reap is reread and counted as live", func(t *testing.T) {
+		w, s, stale := setup(t, nil)
+		fresh := *stale
+		fresh.LastActivityAt = model.GetMillis()
+		s.JobStore.On("Get", mock.Anything, stale.Id).Return(&fresh, nil).Once()
+
+		live, err := w.liveOthers(rctx, "self")
+		require.NoError(t, err)
+		require.Len(t, live, 1)
+		assert.Equal(t, fresh.LastActivityAt, live[0].LastActivityAt)
+		assert.True(t, shouldYield(&model.Job{Id: "self", CreateAt: stale.CreateAt + 1}, live, model.GetMillis()))
+	})
+
+	t.Run("a run that finished before the reap is not live", func(t *testing.T) {
+		w, s, stale := setup(t, nil)
+		done := *stale
+		done.Status = model.JobStatusSuccess
+		s.JobStore.On("Get", mock.Anything, stale.Id).Return(&done, nil).Once()
+
+		live, err := w.liveOthers(rctx, "self")
+		require.NoError(t, err)
+		assert.Empty(t, live)
+	})
+}
