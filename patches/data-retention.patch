+const (
+	retentionPolicyInvalidID  = "ent.data_retention.policies.invalid_policy"
+	retentionPolicyInternalID = "ent.data_retention.policies.internal_error"
+	retentionPolicyNameMax    = 64
+	retentionPage             = 100
+)
+
+type dataRetentionService struct {
+	app *App
+}
+
+func init() {
+	RegisterDataRetentionInterface(func(a *App) einterfaces.DataRetentionInterface {
+		return &dataRetentionService{app: a}
+	})
+}
+
+func retentionInvalid(where, details string) *model.AppError {
+	return model.NewAppError(where, retentionPolicyInvalidID, nil, details, http.StatusBadRequest)
+}
+
+func retentionInternal(where string, err error) *model.AppError {
+	return model.NewAppError(where, retentionPolicyInternalID, nil, "", http.StatusInternalServerError).Wrap(err)
+}
+
+func (s *dataRetentionService) store() store.RetentionPolicyStore {
+	return s.app.Srv().Store().RetentionPolicy()
+}
+
+func (s *dataRetentionService) GetGlobalPolicy() (*model.GlobalRetentionPolicy, *model.AppError) {
+	cfg := s.app.Config().DataRetentionSettings
+	now := model.GetMillis()
+	return &model.GlobalRetentionPolicy{
+		MessageDeletionEnabled: *cfg.EnableMessageDeletion,
+		FileDeletionEnabled:    *cfg.EnableFileDeletion,
+		MessageRetentionCutoff: data_retention.CutoffFor(*cfg.EnableMessageDeletion, cfg.MessageRetentionHours, cfg.MessageRetentionDays, now),
+		FileRetentionCutoff:    data_retention.CutoffFor(*cfg.EnableFileDeletion, cfg.FileRetentionHours, cfg.FileRetentionDays, now),
+	}, nil
+}
