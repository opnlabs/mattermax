+		"files_shared_kept":              1,
+		"files_deleted_with_posts":       3,
+	})
+	now, err := strconv.ParseInt(job.Data["now"], 10, 64)
+	require.NoError(t, err)
+	assert.Equal(t, strconv.FormatInt(now-24*retentionHour, 10), job.Data["message_cutoff"])
+	assert.Equal(t, strconv.FormatInt(now-48*retentionHour, 10), job.Data["file_cutoff"])
+	e.assertFixtureEndState(fx)
+
+	policy, appErr := e.th.App.GetGlobalRetentionPolicy()
+	require.Nil(t, appErr)
+	assert.True(t, policy.MessageDeletionEnabled)
+	assert.True(t, policy.FileDeletionEnabled)
+	assert.InDelta(t, now-24*retentionHour, policy.MessageRetentionCutoff, float64(5*time.Minute/time.Millisecond))
+	assert.InDelta(t, now-48*retentionHour, policy.FileRetentionCutoff, float64(5*time.Minute/time.Millisecond))
+
+	rerun := e.run(nil, nil)
+	require.Equal(t, model.JobStatusSuccess, rerun.Status, rerun.Data["error"])
+	requireCounters(t, rerun, zeroRetentionCounters)
+	e.assertFixtureEndState(fx)
+
+	t.Run("a scheduled post still sends its attachment", func(t *testing.T) {
+		time.Sleep(1100 * time.Millisecond)
+		e.th.App.ProcessScheduledPosts(e.th.Context)
+		var postIDs []string
+		require.NoError(t, e.th.SQLStore.GetMaster().Select(&postIDs, "SELECT Id FROM Posts WHERE Message = 'scheduled with attachment'"))
+		require.Len(t, postIDs, 1)
+		infos, err := e.th.Server.Store().FileInfo().GetForPost(postIDs[0], true, false, false)
+		require.NoError(t, err)
+		require.Len(t, infos, 1)
+		assert.Equal(t, fx.scheduledFile.info.Id, infos[0].Id)
+		assert.True(t, e.objectExists(fx.scheduledFile.info.Path))
+	})
+}
