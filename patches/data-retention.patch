+func testDataRetentionDeleteDependents(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) {
+	f := newRetentionFixture(t, rctx, ss, s)
+	inA, inB, outside := model.NewId(), model.NewId(), model.NewId()
+	files := map[string]*model.FileInfo{}
+	for _, id := range []string{inA, inB, outside} {
+		files[id] = insertRetentionDependents(t, rctx, ss, s, id)
+	}
+	t.Cleanup(func() {
+		for _, file := range files {
+			require.NoError(t, ss.FileInfo().PermanentDelete(rctx, file.Id))
+		}
+		for _, d := range retentionDependentTables {
+			_, err := s.GetMaster().Exec("DELETE FROM "+d.table+" WHERE "+d.column+" = ?", outside)
+			require.NoError(t, err)
+		}
+	})
+	row := &model.RetentionIdsForDeletion{Id: model.NewId(), TableName: "Posts", Ids: []string{inA, inB}}
+	_, err := s.GetMaster().Exec("INSERT INTO RetentionIdsForDeletion (Id, TableName, Ids) VALUES (?, ?, ?)", row.Id, row.TableName, "{"+inA+","+inB+"}")
+	require.NoError(t, err)
+
+	fileDeleteAt := func(id string) int64 {
+		var deleteAt int64
+		require.NoError(t, s.GetMaster().Get(&deleteAt, "SELECT DeleteAt FROM FileInfo WHERE Id = ?", id))
+		return deleteAt
+	}
+
+	t.Run("a failure rolls everything back", func(t *testing.T) {
+		_, err := s.GetMaster().Exec("ALTER TABLE PropertyValues RENAME TO PropertyValuesHidden")
+		require.NoError(t, err)
+		restored := false
+		restore := func() {
+			if !restored {
+				_, err := s.GetMaster().Exec("ALTER TABLE PropertyValuesHidden RENAME TO PropertyValues")
+				require.NoError(t, err)
+				restored = true
+			}
+		}
+		t.Cleanup(restore)
+
+		require.Error(t, ss.RetentionPolicy().DeleteDependentsForOutboxRow(row, 999))
+		restore()
+
+		assert.True(t, f.exists("RetentionIdsForDeletion", "Id", row.Id))
+		assert.Equal(t, int64(0), fileDeleteAt(files[inA].Id))
+		for _, d := range retentionDependentTables {
+			assert.True(t, f.exists(d.table, d.column, inA), d.table)
+		}
+	})
+
+	require.NoError(t, ss.RetentionPolicy().DeleteDependentsForOutboxRow(row, 999))
+	assert.False(t, f.exists("RetentionIdsForDeletion", "Id", row.Id))
+	for _, id := range []string{inA, inB} {
+		assert.Equal(t, int64(999), fileDeleteAt(files[id].Id), "attachment hidden")
+		for _, d := range retentionDependentTables {
+			assert.False(t, f.exists(d.table, d.column, id), d.table)
+		}
+	}
+	assert.Equal(t, int64(0), fileDeleteAt(files[outside].Id))
+	for _, d := range retentionDependentTables {
+		assert.True(t, f.exists(d.table, d.column, outside), d.table)
+	}
+
+	require.NoError(t, ss.RetentionPolicy().DeleteDependentsForOutboxRow(row, 1000), "repeating a consumed row is harmless")
+	assert.Equal(t, int64(999), fileDeleteAt(files[inA].Id))
+}
