+func testDataRetentionOrphanedMembershipBatch(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) {
+	orphan := model.NewId()
+	for range 4 {
+		_, err := s.GetMaster().Exec("INSERT INTO ThreadMemberships (PostId, UserId, Following, LastViewed, LastUpdated, UnreadMentions) VALUES (?, ?, true, 1, 1, 0)", orphan, model.NewId())
+		require.NoError(t, err)
+	}
+	t.Cleanup(func() {
+		_, err := s.GetMaster().Exec("DELETE FROM ThreadMemberships WHERE PostId = ?", orphan)
+		require.NoError(t, err)
+	})
+	left := func() int64 {
+		var n int64
+		require.NoError(t, s.GetMaster().Get(&n, "SELECT COUNT(*) FROM ThreadMemberships WHERE PostId = ?", orphan))
+		return n
+	}
+
+	for want := int64(3); want >= 0; want-- {
+		n, err := ss.Thread().DeleteOrphanedRows(1)
+		require.NoError(t, err)
+		require.Equal(t, int64(1), n, "one call deletes at most the batch")
+		require.Equal(t, want, left())
+	}
+	n, err := ss.Thread().DeleteOrphanedRows(1)
+	require.NoError(t, err)
+	assert.Zero(t, n)
+}
