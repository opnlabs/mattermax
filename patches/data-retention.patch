+)
+
+func (fs SqlFileInfoStore) GetForRetention(cutoff, afterCreateAt int64, afterID string, limit int) ([]*model.FileInfo, error) {
+	files := []*model.FileInfo{}
+
+	query := fs.getQueryBuilder().
+		Select("Id", "PostId", "CreatorId", "CreateAt", "DeleteAt", "Path", "ThumbnailPath", "PreviewPath").
+		From("FileInfo").
+		Where(sq.Lt{"CreateAt": cutoff}).
+		Where(sq.NotEq{"PostId": ""}).
+		Where(sq.NotEq{"CreatorId": model.BookmarkFileOwner}).
+		Where("(CreateAt, Id) > (?, ?)", afterCreateAt, afterID).
+		OrderBy("CreateAt ASC, Id ASC").
+		Limit(uint64(limit))
+
+	if err := fs.GetMaster().SelectBuilder(&files, query); err != nil {
+		return nil, errors.Wrap(err, "failed to find FileInfos for retention")
+	}
+
+	return files, nil
+}
+
+func (fs SqlFileInfoStore) GetForRetentionByPostIds(postIDs []string) ([]*model.FileInfo, error) {
+	if len(postIDs) == 0 {
+		return nil, nil
+	}
+
+	files := []*model.FileInfo{}
+	query := fs.getQueryBuilder().
+		Select("Id", "PostId", "CreatorId", "CreateAt", "DeleteAt", "Path", "ThumbnailPath", "PreviewPath").
+		From("FileInfo").
+		Where("PostId = ANY(?)", pq.Array(postIDs))
+
+	if err := fs.GetMaster().SelectBuilder(&files, query); err != nil {
+		return nil, errors.Wrap(err, "failed to find FileInfos of deleted posts")
+	}
+
+	return files, nil
+}
+
+func (fs SqlFileInfoStore) SoftDeleteByIds(ids []string, now int64) error {
+	if len(ids) == 0 {
+		return nil
+	}
+
+	if _, err := fs.GetMaster().Exec(`UPDATE FileInfo SET DeleteAt = ?, UpdateAt = ? WHERE Id = ANY(?) AND DeleteAt = 0`, now, now, pq.Array(ids)); err != nil {
+		return errors.Wrap(err, "failed to soft delete FileInfos")
+	}
+
+	return nil
+}
+
+func (fs SqlFileInfoStore) PermanentDeleteByIds(ids []string) error {
+	if len(ids) == 0 {
+		return nil
+	}
+
+	if _, err := fs.GetMaster().Exec(`DELETE FROM FileInfo WHERE Id = ANY(?)`, pq.Array(ids)); err != nil {
+		return errors.Wrap(err, "failed to delete FileInfos")
+	}
+
+	return nil
+}
+
+func (fs SqlFileInfoStore) GetPathsReferencedOutside(paths, excludeIDs []string) ([]string, error) {
+	if len(paths) == 0 {
+		return nil, nil
+	}
+
+	if excludeIDs == nil {
+		excludeIDs = []string{}
+	}
+
+	shared := []string{}
+	if err := fs.GetMaster().Select(&shared, `SELECT DISTINCT Path FROM FileInfo WHERE Path = ANY(?) AND NOT (Id = ANY(?))`, pq.Array(paths), pq.Array(excludeIDs)); err != nil {
+		return nil, errors.Wrap(err, "failed to find shared FileInfo paths")
+	}
+
+	return shared, nil
+}
+
+func (fs SqlFileInfoStore) SaveCopy(rctx request.CTX, sourceID, creatorID string, now int64) (info *model.FileInfo, err error) {
+	tx, err := fs.GetMaster().Begin()
+	if err != nil {
+		return nil, errors.Wrap(err, "begin_transaction")
+	}
+	defer finalizeTransactionX(tx, &err)
+
+	query := fs.getQueryBuilder().
+		Select(fs.queryFields...).
+		From("FileInfo").
+		Where(sq.Eq{"Id": sourceID, "DeleteAt": 0}).
+		Suffix("FOR SHARE")
+
+	info = &model.FileInfo{}
+	if err = tx.GetBuilder(info, query); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, store.NewErrNotFound("FileInfo", sourceID)
+		}
+		return nil, errors.Wrapf(err, "failed to get FileInfo with id=%s", sourceID)
+	}
+
+	info.Id = model.NewId()
+	info.CreatorId = creatorID
+	info.CreateAt = now
+	info.UpdateAt = now
+	info.PostId = ""
+	info.ChannelId = ""
+	info.PreSave()
+	if appErr := info.IsValid(); appErr != nil {
+		return nil, appErr
+	}
+
+	if _, err = tx.NamedExec(`
+		INSERT INTO FileInfo
+		(Id, CreatorId, PostId, ChannelId, CreateAt, UpdateAt, DeleteAt, Path, ThumbnailPath, PreviewPath,
+			Name, Extension, Size, MimeType, Width, Height, HasPreviewImage, MiniPreview, Content, RemoteId)
+		VALUES
+		(:Id, :CreatorId, :PostId, :ChannelId, :CreateAt, :UpdateAt, :DeleteAt, :Path, :ThumbnailPath, :PreviewPath,
+			:Name, :Extension, :Size, :MimeType, :Width, :Height, :HasPreviewImage, :MiniPreview, :Content, :RemoteId)`, info); err != nil {
+		return nil, errors.Wrap(err, "failed to save FileInfo")
+	}
+
+	if err = tx.Commit(); err != nil {
+		return nil, errors.Wrap(err, "commit_transaction")
+	}
+	return info, nil
+}
