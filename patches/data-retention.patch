+func TestDataRetentionJobLifecycle(t *testing.T) {
+	mainHelper.Parallel(t)
+
+	t.Run("an older run makes a younger one yield", func(t *testing.T) {
+		e := setupRetention(t, slowSettings)
+		ids := e.slowRetention(10)
+		j2 := e.createJob(nil)
+		done := make(chan struct{})
+		go func() { defer close(done); e.worker(nil).DoJob(j2) }()
+		e.waitFor("j2 running", func(j *model.Job) bool { return j.Status == model.JobStatusInProgress }, j2.Id)
+		j1 := e.saveRunningJob(j2.CreateAt-1, model.GetMillis())
+
+		select {
+		case <-done:
+		case <-time.After(20 * time.Second):
+			require.Fail(t, "younger run did not yield")
+		}
+		assert.Equal(t, model.JobStatusPending, e.job(j2.Id).Status)
+		assert.Equal(t, model.JobStatusInProgress, e.job(j1.Id).Status)
+		remaining := 0
+		for _, id := range ids {
+			if e.postExists(id) {
+				remaining++
+			}
+		}
+		assert.NotZero(t, remaining, "the younger run stopped early")
+	})
+
+	t.Run("cancel stops a run and a rerun finishes the work", func(t *testing.T) {
+		e := setupRetention(t, slowSettings)
+		ids := e.slowRetention(10)
+		job := e.createJob(nil)
+		done := make(chan struct{})
+		go func() { defer close(done); e.worker(nil).DoJob(job) }()
+		require.Eventually(t, func() bool { return e.remaining(ids) < len(ids) }, 20*time.Second, 5*time.Millisecond, "some posts deleted")
+		require.Nil(t, e.th.Server.Jobs.RequestCancellation(e.th.Context, job.Id))
+		<-done
+
+		canceled := e.job(job.Id)
+		assert.Equal(t, model.JobStatusCanceled, canceled.Status)
+		remaining := e.remaining(ids)
+		assert.NotZero(t, remaining, "canceled before finishing")
+		assert.Less(t, remaining, len(ids), "canceled after deleting some posts")
+
+		rerun := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, rerun.Status, rerun.Data["error"])
+		for _, id := range ids {
+			assert.False(t, e.postExists(id))
+		}
+		assert.Zero(t, e.outboxRows())
+	})
+
+	t.Run("Stop returns within a batch and the job resumes after Run", func(t *testing.T) {
+		e := setupRetention(t, slowSettings)
+		ids := e.slowRetention(15)
+		w := e.worker(nil)
+		go w.Run()
+		job := e.createJob(nil)
+		w.JobChannel() <- *job
+		e.waitFor("threads phase", func(j *model.Job) bool { return j.Data["phase"] == "threads" }, job.Id)
+
+		start := time.Now()
+		w.Stop()
+		assert.Less(t, time.Since(start), 2*time.Second)
+		pending := e.job(job.Id)
+		require.Equal(t, model.JobStatusPending, pending.Status)
+
+		go w.Run()
+		w.JobChannel() <- *pending
+		e.waitFor("resumed run finished", func(j *model.Job) bool { return j.Status == model.JobStatusSuccess }, job.Id)
+		w.Stop()
+		assert.Zero(t, e.remaining(ids), "the resumed run deleted every expired post")
+		for i := 0; i < len(ids); i += 2 {
+			assert.False(t, e.exists("Threads", "PostId", ids[i]), "thread %s deleted", ids[i])
+		}
+		assert.Zero(t, e.outboxRows())
+	})
+
+	t.Run("a run reaped by someone else stops without overwriting the status", func(t *testing.T) {
