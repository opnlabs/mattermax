+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+const hourMs = int64(3_600_000)
+
+func TestCutoffFor(t *testing.T) {
+	now := int64(1_800_000_000_000)
+
+	t.Run("disabled gives zero", func(t *testing.T) {
+		assert.Equal(t, int64(0), CutoffFor(false, model.NewPointer(24), nil, now))
+	})
+
+	t.Run("hours win over days", func(t *testing.T) {
+		assert.Equal(t, now-24*hourMs, CutoffFor(true, model.NewPointer(24), model.NewPointer(10), now))
+	})
+
+	t.Run("deprecated days", func(t *testing.T) {
+		assert.Equal(t, now-10*24*hourMs, CutoffFor(true, model.NewPointer(0), model.NewPointer(10), now))
+	})
+
+	t.Run("neither set falls back to 365 days", func(t *testing.T) {
+		assert.Equal(t, now-365*24*hourMs, CutoffFor(true, nil, nil, now))
+	})
+
+	t.Run("overflowing periods mean keep", func(t *testing.T) {
+		assert.Equal(t, int64(0), CutoffFor(true, model.NewPointer(2_562_047_788_016), nil, now))
+		assert.Equal(t, int64(0), CutoffFor(true, nil, model.NewPointer(106_751_991_168), now))
+		assert.Equal(t, int64(0), CutoffFor(true, model.NewPointer(math.MaxInt), nil, now))
+		assert.Equal(t, int64(0), CutoffFor(true, nil, model.NewPointer(math.MaxInt), now))
+		assert.Equal(t, int64(0), CutoffFor(true, model.NewPointer(876_001), nil, now))
+		assert.Equal(t, int64(0), CutoffFor(true, nil, model.NewPointer(36_501), now))
+	})
+
+	t.Run("100 years is the longest period", func(t *testing.T) {
+		assert.Equal(t, int64(0), CutoffFor(true, model.NewPointer(876_000), nil, now), "100 years before 2027 is before the epoch")
+		assert.Equal(t, int64(1000), CutoffFor(true, model.NewPointer(876_000), nil, 876_000*hourMs+1000))
+		assert.Equal(t, int64(0), CutoffFor(true, model.NewPointer(876_000), nil, 876_000*hourMs), "cutoff at the epoch is refused")
+	})
+
+	t.Run("never a cutoff outside (0, now)", func(t *testing.T) {
+		values := []*int{nil, model.NewPointer(math.MinInt), model.NewPointer(-1), model.NewPointer(0), model.NewPointer(1), model.NewPointer(876_000), model.NewPointer(876_001), model.NewPointer(36_500), model.NewPointer(36_501), model.NewPointer(2_562_047_788_016), model.NewPointer(106_751_991_168), model.NewPointer(math.MaxInt)}
+		nows := []int64{0, 1, hourMs, now, math.MaxInt64}
+		for _, n := range nows {
+			for _, h := range values {
+				for _, d := range values {
+					c := CutoffFor(true, h, d, n)
+					assert.True(t, c == 0 || (c > 0 && c < n), "now=%d hours=%v days=%v cutoff=%d", n, h, d, c)
+				}
+			}
+		}
+	})
+}
+
+func TestPlanFor(t *testing.T) {
+	cfg := &model.Config{}
+	cfg.SetDefaults()
+	s := &cfg.DataRetentionSettings
+	now := int64(1_800_000_000_000)
+
+	p := planFor(s, now)
+	assert.Equal(t, runPlan{Now: now, BatchSize: 3000, IdsBatchSize: 100, Pause: 100 * time.Millisecond}, p, "defaults delete nothing globally")
+
+	s.EnableMessageDeletion = model.NewPointer(true)
+	s.MessageRetentionHours = model.NewPointer(24)
+	s.MessageRetentionDays = model.NewPointer(0)
+	s.EnableFileDeletion = model.NewPointer(true)
+	s.FileRetentionHours = model.NewPointer(48)
+	s.FileRetentionDays = model.NewPointer(0)
+	s.PreservePinnedPosts = model.NewPointer(true)
+	p = planFor(s, now)
+	assert.Equal(t, now-24*hourMs, p.MessageCutoff)
+	assert.Equal(t, now-48*hourMs, p.FileCutoff)
+	assert.True(t, p.PreservePinned)
+}
+
+func TestValidatePostDuration(t *testing.T) {
+	for _, d := range []int64{-1, 1, 36_500} {
+		assert.True(t, ValidatePostDuration(&d, true), d)
+	}
+	for _, d := range []int64{36_501, 200_000_000_000, 0, -2, math.MinInt64} {
+		assert.False(t, ValidatePostDuration(&d, true), d)
+		assert.False(t, ValidatePostDuration(&d, false), d)
+	}
+	assert.False(t, ValidatePostDuration(nil, true), "nil is required on create")
+	assert.True(t, ValidatePostDuration(nil, false), "nil means unchanged on patch")
+}
+
+func TestUnsafePolicies(t *testing.T) {
+	policy := func(name string, d *int64) *model.RetentionPolicyWithTeamAndChannelCounts {
+		return &model.RetentionPolicyWithTeamAndChannelCounts{RetentionPolicy: model.RetentionPolicy{DisplayName: name, PostDurationDays: d}}
+	}
+	policies := []*model.RetentionPolicyWithTeamAndChannelCounts{
+		policy("forever", model.NewPointer[int64](-1)),
+		policy("zero", model.NewPointer[int64](0)),
+		policy("one", model.NewPointer[int64](1)),
+		policy("below", model.NewPointer[int64](-5)),
+		policy("max", model.NewPointer[int64](36_500)),
+		policy("huge", model.NewPointer[int64](200_000_000_000)),
+	}
+	var names []string
+	for _, p := range unsafePolicies(policies) {
+		names = append(names, p.DisplayName)
+	}
+	assert.Equal(t, []string{"zero", "below", "huge"}, names)
+}
+
+func TestIsAbandoned(t *testing.T) {
+	now := model.GetMillis()
+	assert.False(t, isAbandoned(&model.Job{LastActivityAt: now - (14 * time.Minute).Milliseconds()}, now))
+	assert.True(t, isAbandoned(&model.Job{LastActivityAt: now - (16 * time.Minute).Milliseconds()}, now))
+}
+
+func TestShouldYield(t *testing.T) {
+	now := model.GetMillis()
+	self := &model.Job{Id: "b", CreateAt: 100, LastActivityAt: now}
+	older := &model.Job{Id: "a", CreateAt: 50, LastActivityAt: now}
+	sameTimeSmallerID := &model.Job{Id: "a", CreateAt: 100, LastActivityAt: now}
+	younger := &model.Job{Id: "c", CreateAt: 200, LastActivityAt: now}
+	abandonedOlder := &model.Job{Id: "a", CreateAt: 50, LastActivityAt: now - time.Hour.Milliseconds()}
+
+	assert.True(t, shouldYield(self, []*model.Job{older}, now))
+	assert.True(t, shouldYield(self, []*model.Job{sameTimeSmallerID}, now))
+	assert.False(t, shouldYield(self, []*model.Job{younger}, now))
+	assert.False(t, shouldYield(self, []*model.Job{abandonedOlder}, now))
+	assert.False(t, shouldYield(self, []*model.Job{self}, now))
+	assert.False(t, shouldYield(older, []*model.Job{self}, now), "exactly one of two runs continues")
+}
+
+func TestSafeRelative(t *testing.T) {
+	for _, p := range []string{"", ".", "./", "/etc/passwd", "../x", "a/../../x", ".."} {
+		assert.False(t, safeRelative(p), p)
+	}
+	for _, p := range []string{"20260101/teams/x/y/z.pdf", "data/a/b_thumb.jpg", "a/../b"} {
+		assert.True(t, safeRelative(p), p)
+	}
+}
+
+func TestRemovalPlan(t *testing.T) {
+	pdf := &model.FileInfo{Id: "pdf", Path: "d/pdf/a.pdf"}
+	img := &model.FileInfo{Id: "img", Path: "d/img/a.png", ThumbnailPath: "d/img/a_thumb.png", PreviewPath: "d/img/a_preview.png"}
+	copyA := &model.FileInfo{Id: "c1", Path: "d/shared/x.txt"}
+	copyB := &model.FileInfo{Id: "c2", Path: "d/shared/x.txt"}
+	outsideShared := &model.FileInfo{Id: "o", Path: "d/outside/y.txt"}
+
+	t.Run("empty thumbnail and preview yield one path", func(t *testing.T) {
+		assert.Equal(t, []string{"d/pdf/a.pdf"}, removalPlan([]*model.FileInfo{pdf}, nil))
+	})
+
+	t.Run("image yields all three paths", func(t *testing.T) {
+		assert.Equal(t, []string{"d/img/a.png", "d/img/a_thumb.png", "d/img/a_preview.png"}, removalPlan([]*model.FileInfo{img}, nil))
+	})
+
+	t.Run("two candidates sharing a path yield one removal", func(t *testing.T) {
+		assert.Equal(t, []string{"d/shared/x.txt"}, removalPlan([]*model.FileInfo{copyA, copyB}, nil))
+	})
+
+	t.Run("failed shared removal keeps both rows", func(t *testing.T) {
+		removed := map[string]bool{}
+		assert.Equal(t, fileKeep, decideFile(copyA, nil, removed))
+		assert.Equal(t, fileKeep, decideFile(copyB, nil, removed))
+		removed["d/shared/x.txt"] = true
+		assert.Equal(t, fileDelete, decideFile(copyA, nil, removed))
+		assert.Equal(t, fileDelete, decideFile(copyB, nil, removed))
+	})
+
+	t.Run("a row is deleted only when every path was removed", func(t *testing.T) {
+		removed := map[string]bool{"d/img/a.png": true, "d/img/a_thumb.png": true}
+		assert.Equal(t, fileKeep, decideFile(img, nil, removed))
+		removed["d/img/a_preview.png"] = true
+		assert.Equal(t, fileDelete, decideFile(img, nil, removed))
+	})
+
+	t.Run("path referenced outside yields no removal and the row is deleted", func(t *testing.T) {
+		shared := map[string]bool{"d/outside/y.txt": true}
+		assert.Empty(t, removalPlan([]*model.FileInfo{outsideShared}, shared))
+		assert.Equal(t, fileDeleteSharedKept, decideFile(outsideShared, shared, map[string]bool{}))
+	})
+}
+
+func TestNeverUsesUnsafeMembershipDeletion(t *testing.T) {
+	files, err := filepath.Glob("*.go")
+	require.NoError(t, err)
+	require.NotEmpty(t, files)
+	for _, f := range files {
+		if strings.HasSuffix(f, "_test.go") {
+			continue
+		}
+		src, err := os.ReadFile(f)
+		require.NoError(t, err)
+		assert.NotContains(t, string(src), "PermanentDeleteBatchThreadMembershipsForRetentionPolicies", f)
+	}
+}
