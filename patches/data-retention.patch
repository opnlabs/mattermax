+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func TestDataRetentionJobRemovesAttachmentsWithTheirPosts(t *testing.T) {
+	mainHelper.Parallel(t)
+	e := setupRetention(t, func(s *model.DataRetentionSettings) { s.EnableFileDeletion = model.NewPointer(false) })
+	old := e.now - 3*24*retentionHour
+
+	deleted := e.post(e.th.BasicChannel.Id, old)
+	pdf := e.file(deleted.Id, e.now)
+	image := e.file(deleted.Id, e.now, withImagePaths)
+	shared := e.file(deleted.Id, e.now, withImagePaths)
+	copies, appErr := e.th.App.CopyFileInfos(e.th.Context, e.th.BasicUser.Id, []string{shared.info.Id})
+	require.Nil(t, appErr)
+	require.Len(t, copies, 1)
+	keptPost := e.post(e.th.BasicChannel.Id, e.now)
+	oldFileOnKeptPost := e.file(keptPost.Id, old)
+
+	type state struct {
+		row     bool
+		deleted bool
+		objects int
+	}
+	check := func(t *testing.T, name string, f *retentionFile, want state) {
+		t.Helper()
+		row, deleteAt, objects := e.fileState(f)
+		assert.Equal(t, want, state{row, deleteAt > 0, objects}, name)
+	}
+	assertEndState := func(t *testing.T) {
+		t.Helper()
+		assert.False(t, e.postExists(deleted.Id))
+		check(t, "pdf of a deleted post", pdf, state{false, false, 0})
+		check(t, "image, thumbnail and preview of a deleted post", image, state{false, false, 0})
+		check(t, "file whose paths a copy still references", shared, state{false, false, 3})
+		check(t, "old file on a kept post, with file retention off", oldFileOnKeptPost, state{true, false, 1})
+		var copyDeleteAt []int64
+		require.NoError(t, e.th.SQLStore.GetMaster().Select(&copyDeleteAt, "SELECT DeleteAt FROM FileInfo WHERE Id = ?", copies[0]))
+		assert.Equal(t, []int64{0}, copyDeleteAt, "the copy stays visible")
+		assert.Zero(t, e.outboxRows())
+	}
+
+	job := e.run(nil, nil)
+	require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+	requireCounters(t, job, map[string]int64{
+		"posts_deleted":            1,
+		"files_deleted_with_posts": 2,
+		"files_shared_kept":        1,
+		"file_objects_removed":     4,
+		"files_deleted":            0,
+		"files_failed":             0,
+	})
+	assertEndState(t)
+
+	rerun := e.run(nil, nil)
+	require.Equal(t, model.JobStatusSuccess, rerun.Status, rerun.Data["error"])
+	requireCounters(t, rerun, zeroRetentionCounters)
+	assertEndState(t)
+
+	t.Run("the bytes go once the last reference is deleted", func(t *testing.T) {
+		later := e.post(e.th.BasicChannel.Id, old)
+		e.exec("UPDATE FileInfo SET PostId = ? WHERE Id = ?", later.Id, copies[0])
+
+		job := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+		requireCounters(t, job, map[string]int64{"files_deleted_with_posts": 1, "file_objects_removed": 3, "files_shared_kept": 0})
+		assert.False(t, e.exists("FileInfo", "Id", copies[0]))
+		for _, p := range shared.paths {
+			assert.False(t, e.objectExists(p), p)
+		}
+	})
+}
