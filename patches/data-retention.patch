+}
+
+func (s *dataRetentionService) RemoveTeamsFromPolicy(policyID string, teamIDs []string) *model.AppError {
+	policy, appErr := s.existingPolicy("RemoveTeamsFromPolicy", policyID)
+	if appErr != nil {
+		return appErr
+	}
+	change := unchangedPeriod(policy)
+	change.RemovedTeams = len(teamIDs)
+	if appErr := s.pauseIfStricter("RemoveTeamsFromPolicy", change); appErr != nil {
+		return appErr
+	}
+	if err := s.store().RemoveTeams(policyID, teamIDs); err != nil {
+		return retentionInternal("RemoveTeamsFromPolicy", err)
+	}
+	return nil
+}
+
