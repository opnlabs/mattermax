@@ -0,0 +1,85 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+)
+
+// confirmation is what a completed manual run approved. It is stored as JSON under ArmedSystemKey,
+// and scheduled runs go ahead only while the current settings delete nothing sooner than it.
+type confirmation struct {
+	JobID          string `json:"job_id"`
+	MessagePeriod  Period `json:"message_period_hours"`
+	FilePeriod     Period `json:"file_period_hours"`
+	PreservePinned bool   `json:"preserve_pinned"`
+	PolicyEpoch    string `json:"policy_epoch"`
+}
+
+func currentConfirmation(systems store.SystemStore, s *model.DataRetentionSettings) (confirmation, error) {
+	c := confirmation{
+		MessagePeriod:  GlobalPeriod(*s.EnableMessageDeletion, s.MessageRetentionHours, s.MessageRetentionDays),
+		FilePeriod:     GlobalPeriod(*s.EnableFileDeletion, s.FileRetentionHours, s.FileRetentionDays),
+		PreservePinned: *s.PreservePinnedPosts,
+	}
+	epoch, err := systems.GetByName(PolicyEpochSystemKey)
+	if err != nil {
+		var nfErr *store.ErrNotFound
+		if !errors.As(err, &nfErr) {
+			return c, fmt.Errorf("failed to read the policy epoch: %w", err)
+		}
+		return c, nil
+	}
+	c.PolicyEpoch = epoch.Value
+	return c, nil
+}
+
+func (c confirmation) covers(current confirmation) bool {
+	return current.MessagePeriod >= c.MessagePeriod &&
+		current.FilePeriod >= c.FilePeriod &&
+		(current.PreservePinned || !c.PreservePinned) &&
+		current.PolicyEpoch == c.PolicyEpoch
+}
+
+// MarkPoliciesStricter pauses scheduled runs until the next completed manual run.
+func MarkPoliciesStricter(systems store.SystemStore) error {
+	return systems.SaveOrUpdate(&model.System{Name: PolicyEpochSystemKey, Value: model.NewId()})
+}
+
+// PolicyChange is one edit of a custom policy: its period before and after, and the teams and
+// channels it gains or loses. Each channel is given by its team ID, "" for direct and group messages.
+type PolicyChange struct {
+	OldPeriod, NewPeriod                   Period
+	AddedTeams, RemovedTeams               int
+	AddedChannelTeams, RemovedChannelTeams []string
+}
+
+// Stricter reports whether the change can delete a post sooner than before. Outside every policy a
+// team follows the global period; a channel follows its team's policy, else the global period.
+func (c PolicyChange) Stricter(global Period, teamPeriods map[string]Period) bool {
+	fallback := func(teamID string) Period {
+		if p, ok := teamPeriods[teamID]; ok {
+			return p
+		}
+		return global
+	}
+	if c.NewPeriod < c.OldPeriod || (c.AddedTeams > 0 && c.NewPeriod < global) || (c.RemovedTeams > 0 && global < c.OldPeriod) {
+		return true
+	}
+	for _, team := range c.AddedChannelTeams {
+		if c.NewPeriod < fallback(team) {
+			return true
+		}
+	}
+	for _, team := range c.RemovedChannelTeams {
+		if fallback(team) < c.OldPeriod {
+			return true
+		}
+	}
+	return false
+}
