+	require.NoError(t, err)
+	stale, active1, active2 := model.NewId(), model.NewId(), model.NewId()
+	members := map[string]int64{stale: now - 45*day, active1: now, active2: now}
+	for user, lastUpdated := range members {
+		_, err = s.GetMaster().Exec("INSERT INTO ThreadMemberships (PostId, UserId, Following, LastViewed, LastUpdated, UnreadMentions) VALUES (?, ?, true, ?, ?, 0)", root, user, lastUpdated, lastUpdated)
+		require.NoError(t, err)
