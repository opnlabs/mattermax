+func (e *retentionEnv) lockWaits(fragment string) int64 {
+	var n int64
+	require.NoError(e.t, e.th.SQLStore.GetMaster().Get(&n, "SELECT COUNT(*) FROM pg_stat_activity WHERE datname = current_database() AND pid <> pg_backend_pid() AND wait_event_type = 'Lock' AND query LIKE ?", "%"+fragment+"%"))
+	return n
+}
+
+func (e *retentionEnv) waitForLockWait(fragment string) {
+	require.Eventually(e.t, func() bool { return e.lockWaits(fragment) > 0 }, 20*time.Second, 10*time.Millisecond, "waiting for a statement blocked on a lock: %s", fragment)
+}
