+		{name: "policy period shortened", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			_, appErr := e.th.App.PatchRetentionPolicy(patchDuration(fx.channelPolicy, 15))
+			require.Nil(t, appErr)
+		}},
+		{name: "policy period lengthened", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			_, appErr := e.th.App.PatchRetentionPolicy(patchDuration(fx.channelPolicy, 40))
+			require.Nil(t, appErr)
+		}},
+		{name: "policy set to keep forever", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			_, appErr := e.th.App.PatchRetentionPolicy(patchDuration(fx.teamPolicy, -1))
+			require.Nil(t, appErr)
