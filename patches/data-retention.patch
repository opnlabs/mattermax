+++ b/server/config/client_data_retention_test.go
@@ -0,0 +1,41 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func TestGenerateClientConfigDataRetention(t *testing.T) {
+	for name, license := range map[string]*model.License{
+		"unlicensed": nil,
+		"enterprise": model.NewTestLicenseSKU(model.LicenseShortSkuEnterprise),
+	} {
+		t.Run(name, func(t *testing.T) {
+			config := &model.Config{}
+			config.SetDefaults()
+
+			clientConfig := GenerateClientConfig(config, "", license)
+			assert.Equal(t, "false", clientConfig["DataRetentionEnableMessageDeletion"])
+			assert.Equal(t, "false", clientConfig["DataRetentionEnableFileDeletion"])
+			assert.Equal(t, "8760", clientConfig["DataRetentionMessageRetentionHours"])
+
+			config.DataRetentionSettings.EnableMessageDeletion = model.NewPointer(true)
+			config.DataRetentionSettings.MessageRetentionHours = model.NewPointer(36)
+			config.DataRetentionSettings.EnableFileDeletion = model.NewPointer(true)
+			config.DataRetentionSettings.FileRetentionHours = model.NewPointer(0)
+			config.DataRetentionSettings.FileRetentionDays = model.NewPointer(10)
+
+			clientConfig = GenerateClientConfig(config, "", license)
+			assert.Equal(t, "true", clientConfig["DataRetentionEnableMessageDeletion"])
+			assert.Equal(t, "36", clientConfig["DataRetentionMessageRetentionHours"])
+			assert.Equal(t, "true", clientConfig["DataRetentionEnableFileDeletion"])
+			assert.Equal(t, "240", clientConfig["DataRetentionFileRetentionHours"])
+		})
+	}
+}
