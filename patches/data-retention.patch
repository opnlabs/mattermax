+func testDataRetentionPolicyResolution(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) {
+	now := model.GetMillis()
+	day := int64(model.DayInMilliseconds)
+
+	t.Run("channel policy wins over team policy, shorter or longer", func(t *testing.T) {
+		f := newRetentionFixture(t, rctx, ss, s)
+		team := f.team()
+		channel := f.channel(team)
+		post := f.post(channel, now-2*day)
+		channelPolicy := f.policy(30, nil, []string{channel})
+		teamPolicy := f.policy(1, []string{team}, nil)
+
+		f.runPosts(now, 0)
+		assert.True(t, f.exists("Posts", "Id", post), "30-day channel policy keeps a 2-day-old post despite the 1-day team policy")
+
+		_, err := ss.RetentionPolicy().Patch(&model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: channelPolicy, PostDurationDays: model.NewPointer[int64](1)}})
+		require.NoError(t, err)
+		_, err = ss.RetentionPolicy().Patch(&model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: teamPolicy, PostDurationDays: model.NewPointer[int64](30)}})
+		require.NoError(t, err)
+		f.runPosts(now, 0)
+		assert.False(t, f.exists("Posts", "Id", post), "1-day channel policy deletes it despite the 30-day team policy")
+	})
+
+	t.Run("keep-forever channel policy beats team policy and global rule", func(t *testing.T) {
+		f := newRetentionFixture(t, rctx, ss, s)
+		team := f.team()
+		channel := f.channel(team)
+		post := f.post(channel, 1000)
+		f.policy(-1, nil, []string{channel})
+		f.policy(1, []string{team}, nil)
+
+		f.runPosts(now, 5000)
+		assert.True(t, f.exists("Posts", "Id", post))
+	})
+
+	t.Run("direct messages follow the global rule, or a legacy channel policy row", func(t *testing.T) {
+		f := newRetentionFixture(t, rctx, ss, s)
+		dm := f.directChannel()
+		legacyDM := f.directChannel()
+		dmPost := f.post(dm, 1000)
+		legacyPost := f.post(legacyDM, 1000)
+		policy := f.policy(-1, nil, nil)
+		_, err := s.GetMaster().Exec("INSERT INTO RetentionPoliciesChannels (PolicyId, ChannelId) VALUES (?, ?)", policy, legacyDM)
+		require.NoError(t, err)
+
+		f.runPosts(now, 5000)
+		assert.False(t, f.exists("Posts", "Id", dmPost))
+		assert.True(t, f.exists("Posts", "Id", legacyPost))
+	})
+
+	t.Run("archived channels are included", func(t *testing.T) {
+		f := newRetentionFixture(t, rctx, ss, s)
+		channel := f.channel(f.team())
+		post := f.post(channel, 1000)
+		require.NoError(t, ss.Channel().Delete(channel, now))
+
+		f.runPosts(now, 5000)
+		assert.False(t, f.exists("Posts", "Id", post))
+	})
+
+	t.Run("posts exactly at the cutoff are kept", func(t *testing.T) {
+		f := newRetentionFixture(t, rctx, ss, s)
+		globalChannel := f.channel(f.team())
+		atGlobal := f.post(globalChannel, 5000)
+		beforeGlobal := f.post(globalChannel, 4999)
+		policyChannel := f.channel(f.team())
+		f.policy(1, nil, []string{policyChannel})
+		atPolicy := f.post(policyChannel, now-day)
+		beforePolicy := f.post(policyChannel, now-day-1)
+
+		f.runPosts(now, 5000)
+		assert.True(t, f.exists("Posts", "Id", atGlobal))
+		assert.False(t, f.exists("Posts", "Id", beforeGlobal))
+		assert.True(t, f.exists("Posts", "Id", atPolicy))
+		assert.False(t, f.exists("Posts", "Id", beforePolicy))
+	})
+}
