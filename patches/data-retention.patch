+func (e *retentionEnv) assertFixtureEndState(fx *retentionFixture) {
+	t := e.t
+	for _, id := range fx.kept {
+		assert.True(t, e.postExists(id), "post %s kept", id)
+	}
+	for _, id := range fx.deleted {
+		assert.False(t, e.postExists(id), "post %s deleted", id)
+	}
+	assert.Empty(t, e.dependentsLeft(fx.oldDependents.Id), "dependents of a deleted post are gone")
+	assert.Len(t, e.dependentsLeft(fx.newDependents.Id), len(retentionDependents), "dependents of a kept post stay")
+	assert.Zero(t, e.outboxRows())
+
+	for _, h := range fx.history {
+		var n int64
+		require.NoError(t, e.th.SQLStore.GetMaster().Get(&n, "SELECT COUNT(*) FROM ChannelMemberHistory WHERE ChannelId = ? AND UserId = ?", h.channelID, h.userID))
+		assert.Equal(t, h.kept, n == 1, "channel member history: %s", h.name)
+	}
+
+	assert.True(t, e.exists("Threads", "PostId", fx.activeRoot.Id), "live thread stays")
+	assert.Equal(t, int64(3), e.count("ThreadMemberships", "PostId", fx.activeRoot.Id), "every member of a live thread stays")
+	assert.False(t, e.exists("Threads", "PostId", fx.oldRoot.Id))
+	assert.Zero(t, e.count("ThreadMemberships", "PostId", fx.oldRoot.Id))
+
+	type state struct {
+		row     bool
+		deleted bool
+		objects int
+	}
+	check := func(name string, f *retentionFile, want state) {
+		row, deleteAt, objects := e.fileState(f)
+		assert.Equal(t, want, state{row, deleteAt > 0, objects}, name)
+	}
+	check("old pdf without thumbnail or preview", fx.pdf, state{false, false, 0})
+	check("old image", fx.image, state{false, false, 0})
+	check("new file on a deleted post goes with it", fx.newOnOldPost, state{false, false, 0})
+	check("bookmark file", fx.bookmark, state{true, false, 1})
+	check("draft attachment", fx.draft, state{true, false, 1})
+	check("scheduled post attachment", fx.scheduledFile, state{true, false, 1})
+	check("old file whose path a newer copy shares", fx.sharedOrig, state{false, false, 1})
+	check("old file on a preserved pinned post", fx.pinnedFile, state{false, false, 0})
+	check("burn-on-read attachment", fx.borFile, state{false, false, 0})
+	assert.True(t, e.exists("FileInfo", "Id", fx.sharedCopyID), "the copy keeps its row")
+	assert.False(t, e.exists("TemporaryPosts", "PostId", fx.borFile.info.PostId))
+
+	_, err := os.Stat(*e.th.App.Config().FileSettings.Directory)
+	assert.NoError(t, err, "storage root still exists")
+}
