+func (s *dataRetentionService) validate(where string, p *model.RetentionPolicyWithTeamAndChannelIDs, onCreate bool) ([]*model.Channel, *model.AppError) {
+	if onCreate || p.DisplayName != "" {
+		name := strings.TrimSpace(p.DisplayName)
+		if name == "" || utf8.RuneCountInString(p.DisplayName) > retentionPolicyNameMax {
+			return nil, retentionInvalid(where, fmt.Sprintf("display_name must be 1 to %d characters", retentionPolicyNameMax))
+		}
+	}
+	if !data_retention.ValidatePostDuration(p.PostDurationDays, onCreate) {
+		return nil, retentionInvalid(where, fmt.Sprintf("post_duration must be -1 or 1 to %d days", data_retention.MaxRetentionDays))
+	}
+	if appErr := s.validateTeams(where, p.TeamIDs); appErr != nil {
+		return nil, appErr
+	}
+	return s.validateChannels(where, p.ChannelIDs)
+}
+
+func uniqueIDs(ids []string) map[string]bool {
+	set := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		set[id] = true
+	}
+	return set
+}
+
+func (s *dataRetentionService) validateTeams(where string, teamIDs []string) *model.AppError {
+	if len(teamIDs) == 0 {
+		return nil
+	}
+	want := uniqueIDs(teamIDs)
+	teams, err := s.app.Srv().Store().Team().GetMany(teamIDs)
+	var nfErr *store.ErrNotFound
+	if err != nil && !errors.As(err, &nfErr) {
+		return retentionInternal(where, err)
+	}
+	if len(teams) != len(want) {
+		return retentionInvalid(where, "team_ids contains an unknown team")
+	}
+	return nil
+}
+
+func (s *dataRetentionService) validateChannels(where string, channelIDs []string) ([]*model.Channel, *model.AppError) {
+	if len(channelIDs) == 0 {
+		return nil, nil
+	}
+	want := uniqueIDs(channelIDs)
+	channels, err := s.app.Srv().Store().Channel().GetMany(channelIDs, false)
+	var nfErr *store.ErrNotFound
+	if err != nil && !errors.As(err, &nfErr) {
+		return nil, retentionInternal(where, err)
+	}
+	if len(channels) != len(want) {
+		return nil, retentionInvalid(where, "channel_ids contains an unknown channel")
+	}
+	for _, c := range channels {
+		if c.IsGroupOrDirect() {
+			return nil, retentionInvalid(where, "direct and group message channels cannot be added to a policy: "+c.Id)
+		}
+	}
+	return channels, nil
+}
+
+func mapRetentionAddError(where string, err error) *model.AppError {
+	if err == nil {
+		return nil
+	}
+	var nfErr *store.ErrNotFound
+	var cErr *store.ErrConflict
+	if errors.As(err, &nfErr) || errors.As(err, &cErr) {
+		return model.NewAppError(where, retentionPolicyInvalidID, nil, "", http.StatusBadRequest).Wrap(err)
+	}
+	return retentionInternal(where, err)
+}
+
+// pauseIfStricter pauses scheduled deletion before a policy change that can delete posts sooner, so
+// the change applies on a schedule only after an administrator's next manual run.
+func (s *dataRetentionService) pauseIfStricter(where string, change data_retention.PolicyChange) *model.AppError {
+	cfg := s.app.Config().DataRetentionSettings
+	global := data_retention.GlobalPeriod(*cfg.EnableMessageDeletion, cfg.MessageRetentionHours, cfg.MessageRetentionDays)
+	var teamPeriods map[string]data_retention.Period
+	if len(change.AddedChannelTeams) > 0 || len(change.RemovedChannelTeams) > 0 {
+		var err error
+		if teamPeriods, err = s.teamPeriods(); err != nil {
+			return retentionInternal(where, err)
+		}
+	}
+	if !change.Stricter(global, teamPeriods) {
+		return nil
+	}
+	if err := data_retention.MarkPoliciesStricter(s.app.Srv().Store().System()); err != nil {
+		return retentionInternal(where, err)
+	}
+	s.app.Log().Info("Data retention: policy change deletes posts sooner; scheduled deletion paused until the next manual run", mlog.String("operation", where))
+	return nil
+}
+
+func unchangedPeriod(policy *model.RetentionPolicyWithTeamAndChannelCounts) data_retention.PolicyChange {
+	period := data_retention.PolicyPeriod(policy.PostDurationDays)
+	return data_retention.PolicyChange{OldPeriod: period, NewPeriod: period}
+}
+
+func (s *dataRetentionService) patchChange(old *model.RetentionPolicyWithTeamAndChannelCounts, patch *model.RetentionPolicyWithTeamAndChannelIDs, channels []*model.Channel) (data_retention.PolicyChange, error) {
+	change := unchangedPeriod(old)
+	if patch.PostDurationDays != nil {
+		change.NewPeriod = data_retention.PolicyPeriod(patch.PostDurationDays)
+	}
+	if patch.TeamIDs != nil {
+		teams, err := s.policyTeams(old)
+		if err != nil {
+			return change, err
+		}
+		current, next := uniqueIDs(teams), uniqueIDs(patch.TeamIDs)
+		for id := range next {
+			if !current[id] {
+				change.AddedTeams++
+			}
+		}
+		for id := range current {
+			if !next[id] {
+				change.RemovedTeams++
+			}
+		}
+	}
+	if patch.ChannelIDs != nil {
+		current, err := s.policyChannels(old)
+		if err != nil {
+			return change, err
+		}
+		next := map[string]bool{}
+		for _, c := range channels {
+			next[c.Id] = true
+			if _, ok := current[c.Id]; !ok {
+				change.AddedChannelTeams = append(change.AddedChannelTeams, c.TeamId)
+			}
+		}
+		for id, team := range current {
+			if !next[id] {
+				change.RemovedChannelTeams = append(change.RemovedChannelTeams, team)
+			}
+		}
+	}
+	return change, nil
+}
+
+func channelTeams(channels []*model.Channel) []string {
+	teams := make([]string, 0, len(channels))
+	for _, c := range channels {
+		teams = append(teams, c.TeamId)
+	}
+	return teams
+}
+
+func (s *dataRetentionService) teamPeriods() (map[string]data_retention.Period, error) {
+	periods := map[string]data_retention.Period{}
+	for offset := 0; ; offset += retentionPage {
+		policies, err := s.store().GetAll(offset, retentionPage)
+		if err != nil {
+			return nil, err
+		}
+		for _, p := range policies {
+			teams, err := s.policyTeams(p)
+			if err != nil {
+				return nil, err
+			}
+			for _, id := range teams {
+				periods[id] = data_retention.PolicyPeriod(p.PostDurationDays)
+			}
+		}
+		if len(policies) < retentionPage {
+			return periods, nil
+		}
+	}
+}
+
+func (s *dataRetentionService) policyTeams(p *model.RetentionPolicyWithTeamAndChannelCounts) ([]string, error) {
+	var ids []string
+	for offset := 0; int64(offset) < p.TeamCount; offset += retentionPage {
+		teams, err := s.store().GetTeams(p.ID, offset, retentionPage)
+		if err != nil {
+			return nil, err
+		}
+		for _, t := range teams {
+			ids = append(ids, t.Id)
+		}
+		if len(teams) < retentionPage {
+			break
+		}
+	}
+	return ids, nil
+}
+
+// policyChannels maps each channel of the policy to its team.
+func (s *dataRetentionService) policyChannels(p *model.RetentionPolicyWithTeamAndChannelCounts) (map[string]string, error) {
+	channels := map[string]string{}
+	for offset := 0; int64(offset) < p.ChannelCount; offset += retentionPage {
+		page, err := s.store().GetChannels(p.ID, offset, retentionPage)
+		if err != nil {
+			return nil, err
+		}
+		for _, c := range page {
+			channels[c.Id] = c.TeamId
+		}
+		if len(page) < retentionPage {
+			break
+		}
+	}
+	if int64(len(channels)) < p.ChannelCount {
+		// GetChannels joins Teams, so it omits direct and group message rows; they follow the global period.
+		channels[""] = ""
+	}
+	return channels, nil
+}
