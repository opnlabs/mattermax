+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {renderWithContext, screen} from 'tests/react_testing_utils';
+
+import DataRetentionSettings from './data_retention_settings';
+
+describe('components/admin_console/data_retention_settings cancel button', () => {
+    const runningJob = {
+        id: 'job1',
+        type: 'data_retention',
+        status: 'in_progress',
+        create_at: 1,
+        start_at: 1,
+        last_activity_at: 1,
+        progress: 10,
+        data: {},
+        priority: 0,
+    };
+
+    const renderSettings = (customPoliciesCount: number) => renderWithContext(
+        <DataRetentionSettings
+            config={{
+                DataRetentionSettings: {
+                    EnableMessageDeletion: false,
+                    EnableFileDeletion: false,
+                    DeletionJobStartTime: '02:00',
+                },
+            }}
+            customPolicies={{}}
+            customPoliciesCount={customPoliciesCount}
+            globalMessageRetentionHours='0'
+            globalFileRetentionHours='0'
+            actions={{
+                getDataRetentionCustomPolicies: jest.fn().mockResolvedValue([]),
+                createJob: jest.fn(),
+                getJobsByType: jest.fn().mockResolvedValue([]),
+                deleteDataRetentionCustomPolicy: jest.fn(),
+                patchConfig: jest.fn(),
+            }}
+        />,
+        {entities: {jobs: {jobsByTypeList: {data_retention: [runningJob]}}}} as any,
+    );
+
+    test('a running job can be canceled when only custom policies exist', () => {
+        renderSettings(1);
+        expect(screen.getByTitle('Cancel')).toBeInTheDocument();
+    });
+
+    test('nothing to cancel when no policy of any kind is enabled', () => {
+        renderSettings(0);
+        expect(screen.queryByTitle('Cancel')).not.toBeInTheDocument();
+    });
+});
