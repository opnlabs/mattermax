@@ -0,0 +1,74 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/jobs"
+	"github.com/mattermost/mattermost/server/v8/channels/store/storetest"
+	"github.com/mattermost/mattermost/server/v8/channels/utils/testutils"
+)
+
+func TestSchedulerGate(t *testing.T) {
+	setup := func(t *testing.T, messageDeletion bool, policies int64) (*Scheduler, *storetest.Store, *model.Config) {
+		cfg := &model.Config{}
+		cfg.SetDefaults()
+		cfg.DataRetentionSettings.EnableMessageDeletion = model.NewPointer(messageDeletion)
+
+		mockStore := &storetest.Store{}
+		t.Cleanup(func() { mockStore.AssertExpectations(t) })
+		mockStore.RetentionPolicyStore.On("GetCount").Return(policies, nil).Maybe()
+
+		jobServer := jobs.NewJobServer(&testutils.StaticConfigService{Cfg: cfg}, mockStore, nil, mlog.CreateConsoleTestLogger(t), nil)
+		jobServer.RegisterJobType(model.JobTypeDataRetention, MakeWorker(jobServer, mockStore, nil), nil)
+		return MakeScheduler(jobServer, mockStore), mockStore, cfg
+	}
+	rctx := request.EmptyContext(mlog.CreateConsoleTestLogger(t))
+	scheduledJob := mock.MatchedBy(func(job *model.Job) bool {
+		return job.Type == model.JobTypeDataRetention && len(job.Data) == 1 && job.Data["trigger"] == "schedule"
+	})
+
+	t.Run("nothing enabled creates no job", func(t *testing.T) {
+		s, _, cfg := setup(t, false, 0)
+		job, appErr := s.ScheduleJob(rctx, cfg, false, nil)
+		require.Nil(t, appErr)
+		require.Nil(t, job)
+	})
+
+	t.Run("a custom policy alone creates a scheduled job", func(t *testing.T) {
+		s, mockStore, cfg := setup(t, false, 1)
+		mockStore.JobStore.On("Save", scheduledJob).Return(func(j *model.Job) *model.Job { return j }, nil).Once()
+		job, appErr := s.ScheduleJob(rctx, cfg, false, nil)
+		require.Nil(t, appErr)
+		require.NotNil(t, job)
+		require.Equal(t, "schedule", job.Data["trigger"])
+	})
+
+	t.Run("global deletion creates a scheduled job", func(t *testing.T) {
+		s, mockStore, cfg := setup(t, true, 0)
+		mockStore.JobStore.On("Save", scheduledJob).Return(func(j *model.Job) *model.Job { return j }, nil).Once()
+		job, appErr := s.ScheduleJob(rctx, cfg, false, nil)
+		require.Nil(t, appErr)
+		require.NotNil(t, job)
+	})
+
+	t.Run("a pending job blocks a new one", func(t *testing.T) {
+		s, _, cfg := setup(t, true, 1)
+		job, appErr := s.ScheduleJob(rctx, cfg, true, nil)
+		require.Nil(t, appErr)
+		require.Nil(t, job)
+	})
+
+	t.Run("enabled does not depend on config or policies", func(t *testing.T) {
+		s, _, cfg := setup(t, false, 0)
+		require.True(t, s.Enabled(cfg))
+	})
+}
diff --git a/server/channels/jobs/data_retention/worker.go b/server/channels/jobs/data_retention/worker.go
new file mode 100644
index 000000000000..711ed45c5393
--- /dev/null
+++ b/server/channels/jobs/data_retention/worker.go
@@ -0,0 +1,843 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/mlog"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/jobs"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+	"github.com/mattermost/mattermost/server/v8/platform/shared/filestore"
+)
+
+const (
+	pausedWarning    = "Scheduled deletion is paused until an administrator selects Run Deletion Job Now. Nothing was deleted."
+	stricterWarning  = "Retention became stricter after the last manual run. " + pausedWarning
+	stoppedWarning   = "Retention became stricter during this run, so it stopped. Scheduled deletion is paused until an administrator selects Run Deletion Job Now."
+	notArmedWarning  = "Deletion ran, but the nightly schedule could not be enabled; run again."
+	filesFailedFmt   = "%d files could not be removed from storage and will be retried on the next run."
+	outboxFailedFmt  = "%d batches of deleted posts kept their attachments because storage removal failed; they will be retried on the next run."
+	runFailedErrorID = "ent.data_retention.run_failed.error"
+)
+
+var (
+	errStopped  = errors.New("worker stopped")
+	errYielded  = errors.New("yielded to an older run")
+	errCanceled = errors.New("canceled")
+	errLost     = errors.New("job is no longer in progress")
+	errStricter = errors.New("retention became stricter")
+)
+
+type Worker struct {
+	jobServer   *jobs.JobServer
+	store       store.Store
+	fileBackend func() filestore.FileBackend
+	logger      mlog.LoggerIFace
+
+	stateMut  sync.Mutex
+	stopCh    chan struct{}
+	stoppedCh chan bool
+	stopped   bool
+	jobs      chan model.Job
+}
+
+var _ model.Worker = (*Worker)(nil)
+
+func MakeWorker(jobServer *jobs.JobServer, s store.Store, fileBackend func() filestore.FileBackend) *Worker {
+	return &Worker{
+		jobServer:   jobServer,
+		store:       s,
+		fileBackend: fileBackend,
+		logger:      jobServer.Logger().With(mlog.String("worker", model.JobTypeDataRetention)),
+		stoppedCh:   make(chan bool, 1),
+		jobs:        make(chan model.Job),
+		stopped:     true,
+	}
+}
+
+func (w *Worker) Run() {
+	w.stateMut.Lock()
+	if !w.stopped {
+		w.stateMut.Unlock()
+		return
+	}
+	w.stopped = false
+	w.stopCh = make(chan struct{})
+	stopCh := w.stopCh
+	w.stateMut.Unlock()
+
+	defer func() { w.stoppedCh <- true }()
+
+	for {
+		select {
+		case <-stopCh:
+			return
+		case job := <-w.jobs:
+			w.doJob(&job, stopCh)
+		}
+	}
+}
+
+func (w *Worker) Stop() {
+	w.stateMut.Lock()
+	defer w.stateMut.Unlock()
+	if w.stopped {
+		return
+	}
+	w.stopped = true
+	close(w.stopCh)
+	<-w.stoppedCh
+}
+
+func (w *Worker) JobChannel() chan<- model.Job {
+	return w.jobs
+}
+
+func (w *Worker) IsEnabled(_ *model.Config) bool {
+	return true
+}
+
+func (w *Worker) DoJob(job *model.Job) {
+	w.doJob(job, make(chan struct{}))
+}
+
+func (w *Worker) doJob(job *model.Job, stopCh <-chan struct{}) {
+	logger := w.logger.With(mlog.String("job_id", job.Id))
+	rctx := request.EmptyContext(logger)
+
+	others, err := w.liveOthers(rctx, job.Id)
+	if err != nil {
+		logger.Warn("Data retention: failed to check for running jobs", mlog.Err(err))
+		return
+	}
+	if len(others) > 0 {
+		logger.Info("Data retention: another run is in progress; leaving this job pending", mlog.String("running_job_id", others[0].Id))
+		return
+	}
+
+	claimed, appErr := w.jobServer.ClaimJob(job)
+	if appErr != nil {
+		logger.Warn("Data retention: failed to claim job", mlog.Err(appErr))
+		return
+	}
+	if claimed == nil {
+		return
+	}
+	job = claimed
+	if job.Data == nil {
+		job.Data = model.StringMap{}
+	}
+	defer w.jobServer.HandleJobPanic(logger, job)
+
+	r := &run{w: w, rctx: rctx, logger: logger, job: job, stopCh: stopCh, backend: w.fileBackend(), outboxSkipped: map[string]bool{}}
+	warning, err := r.execute()
+	w.finish(r, warning, err)
+}
+
+func (w *Worker) liveOthers(rctx request.CTX, selfID string) ([]*model.Job, error) {
+	running, err := w.store.Job().GetByTypeAndData(rctx, model.JobTypeDataRetention, nil, true, model.JobStatusInProgress, model.JobStatusCancelRequested)
+	if err != nil {
+		return nil, err
+	}
+	now := model.GetMillis()
+	var live []*model.Job
+	for _, o := range running {
+		if o.Id == selfID {
+			continue
+		}
+		if !isAbandoned(o, now) {
+			live = append(live, o)
+			continue
+		}
+		reaped, err := w.reap(rctx, o, selfID, now)
+		if err != nil {
+			return nil, err
+		}
+		if reaped {
+			continue
+		}
+		fresh, err := w.store.Job().Get(rctx, o.Id)
+		if err != nil {
+			return nil, err
+		}
+		if fresh.Status == model.JobStatusInProgress || fresh.Status == model.JobStatusCancelRequested {
+			live = append(live, fresh)
+		}
+	}
+	return live, nil
+}
+
+func (w *Worker) reap(rctx request.CTX, o *model.Job, selfID string, now int64) (bool, error) {
+	detail := fmt.Sprintf("no activity since %s; superseded by %s", time.UnixMilli(o.LastActivityAt).UTC().Format(time.RFC3339), selfID)
+	failed := *o
+	failed.Status = model.JobStatusError
+	failed.Progress = -1
+	failed.Data = model.StringMap{}
+	for k, v := range o.Data {
+		failed.Data[k] = v
+	}
+	failed.Data["error"] = detail
+	reaped, err := w.store.Job().UpdateOptimisticallyIfInactive(&failed, o.Status, now-abandonAfter.Milliseconds())
+	if err != nil {
+		return false, fmt.Errorf("failed to mark abandoned job %s as failed: %w", o.Id, err)
+	}
+	if reaped == nil {
+		rctx.Logger().Info("Data retention: abandoned job became active or changed before it could be marked as failed; deferring", mlog.String("abandoned_job_id", o.Id))
+		return false, nil
+	}
+	rctx.Logger().Warn("Data retention: marked abandoned job as failed", mlog.String("abandoned_job_id", o.Id), mlog.String("detail", detail))
+	return true, nil
+}
+
+func (w *Worker) finish(r *run, warning string, runErr error) {
+	job := r.job
+	logger := r.logger
+	r.counters.write(job.Data)
+
+	switch {
+	case errors.Is(runErr, errLost):
+		logger.Warn("Data retention: job left in_progress while running; stopping without writing its status")
+	case errors.Is(runErr, errCanceled):
+		logger.Info("Data retention: job canceled", r.counters.fields()...)
+		if appErr := w.jobServer.SetJobCanceled(job); appErr != nil {
+			logger.Warn("Data retention: failed to publish canceled status", mlog.Err(appErr))
+		}
+	case errors.Is(runErr, errStricter):
+		w.complete(job, stoppedWarning, true, logger, r.counters.fields())
+	case errors.Is(runErr, errStopped), errors.Is(runErr, errYielded):
+		logger.Info("Data retention: setting job back to pending", mlog.String("reason", runErr.Error()))
+		w.requeue(job, logger)
+	case runErr != nil:
+		logger.Error("Data retention: job failed", append(r.counters.fields(), mlog.Err(runErr))...)
+		appErr := model.NewAppError("DataRetention", runFailedErrorID, nil, runErr.Error(), http.StatusInternalServerError)
+		if setErr := w.jobServer.SetJobError(job, appErr); setErr != nil {
+			logger.Warn("Data retention: failed to write error status", mlog.Err(setErr))
+		}
+	default:
+		w.complete(job, warning, r.paused != "", logger, r.counters.fields())
+	}
+}
+
+func (w *Worker) complete(job *model.Job, warning string, paused bool, logger mlog.LoggerIFace, fields []mlog.Field) {
+	job.Status = model.JobStatusSuccess
+	if warning != "" {
+		job.Status = model.JobStatusWarning
+		job.Data["error"] = warning
+	}
+	if !paused {
+		job.Progress = 100
+	}
+
+	updated, err := w.store.Job().UpdateOptimistically(job, model.JobStatusInProgress)
+	if err == nil && updated == nil {
+		updated, err = w.store.Job().UpdateOptimistically(job, model.JobStatusCancelRequested)
+	}
+	if err != nil {
+		logger.Error("Data retention: failed to write final status", mlog.Err(err))
+		return
+	}
+	if updated == nil {
+		logger.Warn("Data retention: job changed by someone else before completion; not writing its status")
+		return
+	}
+
+	logger.Info("Data retention: job finished", append(fields, mlog.String("status", job.Status), mlog.String("warning", warning))...)
+	var appErr *model.AppError
+	if job.Status == model.JobStatusWarning {
+		appErr = w.jobServer.SetJobWarning(job)
+	} else {
+		appErr = w.jobServer.SetJobSuccess(job)
+	}
+	if appErr != nil {
+		logger.Warn("Data retention: failed to publish final status", mlog.Err(appErr))
+	}
+}
+
+func (w *Worker) requeue(job *model.Job, logger mlog.LoggerIFace) {
+	job.Status = model.JobStatusPending
+	updated, err := w.store.Job().UpdateOptimistically(job, model.JobStatusInProgress)
+	if err != nil {
+		logger.Error("Data retention: failed to set job back to pending", mlog.Err(err))
+		return
+	}
+	if updated != nil {
+		return
+	}
+	job.Status = model.JobStatusCanceled
+	updated, err = w.store.Job().UpdateOptimistically(job, model.JobStatusCancelRequested)
+	if err != nil {
+		logger.Error("Data retention: failed to cancel job", mlog.Err(err))
+		return
+	}
+	if updated != nil {
+		if appErr := w.jobServer.SetJobCanceled(job); appErr != nil {
+			logger.Warn("Data retention: failed to publish canceled status", mlog.Err(appErr))
+		}
+	}
+}
+
+type counters struct {
+	postsDeleted                int64
+	postsDependentsCleaned      int64
+	threadsDeleted              int64
+	threadMembershipsDeleted    int64
+	channelMemberHistoryDeleted int64
+	flaggedPostsDeleted         int64
+	filesDeleted                int64
+	fileObjectsRemoved          int64
+	filesFailed                 int64
+	filesSharedKept             int64
+	filesDeletedWithPosts       int64
+}
+
+func (c *counters) named() []struct {
+	name  string
+	value int64
+} {
+	return []struct {
+		name  string
+		value int64
+	}{
+		{"posts_deleted", c.postsDeleted},
+		{"posts_dependents_cleaned", c.postsDependentsCleaned},
+		{"threads_deleted", c.threadsDeleted},
+		{"thread_memberships_deleted", c.threadMembershipsDeleted},
+		{"channel_member_history_deleted", c.channelMemberHistoryDeleted},
+		{"flagged_posts_deleted", c.flaggedPostsDeleted},
+		{"files_deleted", c.filesDeleted},
+		{"file_objects_removed", c.fileObjectsRemoved},
+		{"files_failed", c.filesFailed},
+		{"files_shared_kept", c.filesSharedKept},
+		{"files_deleted_with_posts", c.filesDeletedWithPosts},
+	}
+}
+
+func (c *counters) write(data model.StringMap) {
+	for _, n := range c.named() {
+		data[n.name] = strconv.FormatInt(n.value, 10)
+	}
+}
+
+func (c *counters) fields() []mlog.Field {
+	var fields []mlog.Field
+	for _, n := range c.named() {
+		fields = append(fields, mlog.Int(n.name, n.value))
+	}
+	return fields
+}
+
+type run struct {
+	w       *Worker
+	rctx    request.CTX
+	logger  mlog.LoggerIFace
+	job     *model.Job
+	stopCh  <-chan struct{}
+	backend filestore.FileBackend
+
+	plan          runPlan
+	settings      confirmation
+	phase         string
+	counters      counters
+	changed       bool
+	paused        string
+	outboxSkipped map[string]bool
+
+	removedSinceStep int
+}
+
+func (r *run) execute() (string, error) {
+	if err := r.preflight(); err != nil {
+		return "", err
+	}
+	if r.paused != "" {
+		return r.paused, nil
+	}
+
+	phases := []struct {
+		name     string
+		progress int64
+		fn       func() error
+	}{
+		{"outbox", 0, r.drainOutbox},
+		{"posts", 5, r.posts},
+		{"threads", 50, r.threads},
+		{"channel_member_history", 60, r.channelMemberHistory},
+		{"flagged_posts", 65, r.flaggedPosts},
+		{"policy_orphans", 68, r.policyOrphans},
+		{"files", 70, r.files},
+	}
+	for _, p := range phases {
+		r.phase = p.name
+		r.job.Progress = p.progress
+		if err := p.fn(); err != nil {
+			r.clearCaches()
+			return "", err
+		}
+		r.logger.Info("Data retention: phase done", append(r.counters.fields(), mlog.String("phase", p.name))...)
+		if p.name == "posts" {
+			r.clearCaches()
+		}
+	}
+	r.phase = "done"
+	r.clearCaches()
+
+	var warning string
+	switch {
+	case r.counters.filesFailed > 0:
+		warning = fmt.Sprintf(filesFailedFmt, r.counters.filesFailed)
+	case len(r.outboxSkipped) > 0:
+		warning = fmt.Sprintf(outboxFailedFmt, len(r.outboxSkipped))
+	}
+
+	if r.manual() {
+		if err := r.arm(); err != nil {
+			r.logger.Error("Data retention: failed to enable the nightly schedule", mlog.Err(err))
+			warning = notArmedWarning
+		}
+	}
+	return warning, nil
+}
+
+func (r *run) arm() error {
+	confirmed := r.settings
+	confirmed.JobID = r.job.Id
+	value, err := json.Marshal(confirmed)
+	if err != nil {
+		return err
+	}
+	return r.w.store.System().SaveOrUpdate(&model.System{Name: ArmedSystemKey, Value: string(value)})
+}
+
+func (r *run) preflight() error {
+	r.phase = "preflight"
+	var policies []*model.RetentionPolicyWithTeamAndChannelCounts
+	const page = 100
+	for {
+		batch, err := r.w.store.RetentionPolicy().GetAll(len(policies), page)
+		if err != nil {
+			return fmt.Errorf("failed to read retention policies: %w", err)
+		}
+		policies = append(policies, batch...)
+		if len(batch) < page {
+			break
+		}
+	}
+	if unsafe := unsafePolicies(policies); len(unsafe) > 0 {
+		p := unsafe[0]
+		d := "unset"
+		if p.PostDurationDays != nil {
+			d = strconv.FormatInt(*p.PostDurationDays, 10)
+		}
+		return fmt.Errorf("policy %q has duration %s; allowed: -1 or 1..%d days. Nothing was deleted", p.DisplayName, d, MaxRetentionDays)
+	}
+
+	settings := &r.w.jobServer.Config().DataRetentionSettings
+	r.plan = planFor(settings, model.GetMillis())
+	r.job.Data["now"] = strconv.FormatInt(r.plan.Now, 10)
+	r.job.Data["message_cutoff"] = strconv.FormatInt(r.plan.MessageCutoff, 10)
+	r.job.Data["file_cutoff"] = strconv.FormatInt(r.plan.FileCutoff, 10)
+	var err error
+	if r.settings, err = currentConfirmation(r.w.store.System(), settings); err != nil {
+		return err
+	}
+	if !r.manual() {
+		if r.paused, err = r.schedulePause(r.settings); err != nil {
+			return err
+		}
+		if r.paused != "" {
+			return nil
+		}
+	}
+	return r.step()
+}
+
+func (r *run) manual() bool {
+	return r.job.Data[TriggerKey] == TriggerManual
+}
+
+// schedulePause returns why a scheduled run must not delete, or "" when it may.
+func (r *run) schedulePause(current confirmation) (string, error) {
+	sys, err := r.w.store.System().GetByName(ArmedSystemKey)
+	if err != nil {
+		var nfErr *store.ErrNotFound
+		if !errors.As(err, &nfErr) {
+			return "", fmt.Errorf("failed to read the schedule flag: %w", err)
+		}
+		return pausedWarning, nil
+	}
+	var confirmed confirmation
+	if err := json.Unmarshal([]byte(sys.Value), &confirmed); err != nil {
+		r.logger.Warn("Data retention: unreadable schedule flag; pausing until the next manual run", mlog.Err(err))
+		return pausedWarning, nil
+	}
+	if !confirmed.covers(current) {
+		return stricterWarning, nil
+	}
+	return "", nil
+}
+
+func (r *run) step() error {
+	select {
+	case <-r.stopCh:
+		return errStopped
+	default:
+	}
+	r.removedSinceStep = 0
+
+	r.counters.write(r.job.Data)
+	r.job.Data["phase"] = r.phase
+	r.job.Status = model.JobStatusInProgress
+	updated, err := r.w.store.Job().UpdateOptimistically(r.job, model.JobStatusInProgress)
+	if err != nil {
+		return fmt.Errorf("failed to update job progress: %w", err)
+	}
+	if updated == nil {
+		r.job.Status = model.JobStatusCanceled
+		canceled, err := r.w.store.Job().UpdateOptimistically(r.job, model.JobStatusCancelRequested)
+		if err != nil {
+			return fmt.Errorf("failed to cancel job: %w", err)
+		}
+		if canceled != nil {
+			return errCanceled
+		}
+		return errLost
+	}
+
+	others, err := r.w.liveOthers(r.rctx, r.job.Id)
+	if err != nil {
+		return fmt.Errorf("failed to check for running jobs: %w", err)
+	}
+	if shouldYield(r.job, others, model.GetMillis()) {
+		return errYielded
+	}
+
+	if r.manual() {
+		return nil
+	}
+	current, err := currentConfirmation(r.w.store.System(), &r.w.jobServer.Config().DataRetentionSettings)
+	if err != nil {
+		return err
+	}
+	pause, err := r.schedulePause(current)
+	if err != nil {
+		return err
+	}
+	if pause != "" {
+		return errStricter
+	}
+	return nil
+}
+
+func (r *run) pause() error {
+	if r.plan.Pause <= 0 {
+		select {
+		case <-r.stopCh:
+			return errStopped
+		default:
+			return nil
+		}
+	}
+	select {
+	case <-r.stopCh:
+		return errStopped
+	case <-time.After(r.plan.Pause):
+		return nil
+	}
+}
+
+func (r *run) batchConfig() model.RetentionPolicyBatchConfigs {
+	return model.RetentionPolicyBatchConfigs{
+		Now:                 r.plan.Now,
+		GlobalPolicyEndTime: r.plan.MessageCutoff,
+		Limit:               int64(r.plan.BatchSize),
+		PreservePinnedPosts: r.plan.PreservePinned,
+	}
+}
+
+func cursorDone(c model.RetentionPolicyCursor) bool {
+	return c.ChannelPoliciesDone && c.TeamPoliciesDone && c.GlobalPoliciesDone
+}
+
+func (r *run) drainOutbox() error {
+	for {
+		if err := r.step(); err != nil {
+			return err
+		}
+		rows, err := r.w.store.RetentionPolicy().GetIdsForDeletionByTableName("Posts", r.plan.IdsBatchSize+len(r.outboxSkipped))
+		if err != nil {
+			return fmt.Errorf("failed to read deleted post ids: %w", err)
+		}
+		var pending []*model.RetentionIdsForDeletion
+		for _, row := range rows {
+			if !r.outboxSkipped[row.Id] {
+				pending = append(pending, row)
+			}
+		}
+		if len(pending) == 0 {
+			return nil
+		}
+		for i, row := range pending {
+			if i > 0 {
+				if err := r.step(); err != nil {
+					return err
+				}
+			}
+			ok, err := r.removeAttachments(row)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				r.outboxSkipped[row.Id] = true
+				r.logger.Warn("Data retention: attachments of deleted posts could not be removed; keeping the batch for the next run", mlog.String("outbox_id", row.Id))
+				continue
+			}
+			if err := r.w.store.RetentionPolicy().DeleteDependentsForOutboxRow(row, r.plan.Now); err != nil {
+				return fmt.Errorf("failed to delete rows that depend on deleted posts: %w", err)
+			}
+			r.counters.postsDependentsCleaned += int64(len(row.Ids))
+			r.changed = true
+		}
+	}
+}
+
+func (r *run) removeAttachments(row *model.RetentionIdsForDeletion) (bool, error) {
+	files, err := r.w.store.FileInfo().GetForRetentionByPostIds(row.Ids)
+	if err != nil {
+		return false, fmt.Errorf("failed to read attachments of deleted posts: %w", err)
+	}
+	if err := r.w.store.FileInfo().SoftDeleteByIds(fileIDs(files), r.plan.Now); err != nil {
+		return false, fmt.Errorf("failed to hide attachments of deleted posts: %w", err)
+	}
+	ok, err := r.removeFiles(files, &r.counters.filesDeletedWithPosts)
+	if err != nil {
+		return false, err
+	}
+	burnOnRead, err := r.w.store.RetentionPolicy().GetBurnOnReadIds(row.Ids)
+	if err != nil {
+		return false, fmt.Errorf("failed to find burn-on-read posts: %w", err)
+	}
+	for _, postID := range burnOnRead {
+		r.w.store.TemporaryPost().InvalidateTemporaryPost(postID)
+	}
+	return ok, nil
+}
+
+func (r *run) posts() error {
+	cursor := model.RetentionPolicyCursor{}
+	for {
+		if err := r.step(); err != nil {
+			return err
+		}
+		var n int64
+		var err error
+		n, cursor, err = r.w.store.Post().PermanentDeleteBatchForRetentionPolicies(r.batchConfig(), cursor)
+		if err != nil {
+			return fmt.Errorf("failed to delete posts: %w", err)
+		}
+		r.counters.postsDeleted += n
+		if n > 0 {
+			r.changed = true
+		}
+		if err := r.drainOutbox(); err != nil {
+			return err
+		}
+		if cursorDone(cursor) {
+			return nil
+		}
+		if err := r.pause(); err != nil {
+			return err
+		}
+	}
+}
+
+func (r *run) threads() error {
+	if err := r.retentionLoop(r.w.store.Thread().PermanentDeleteBatchForRetentionPolicies, &r.counters.threadsDeleted, "threads"); err != nil {
+		return err
+	}
+	return r.orphanLoop(r.w.store.Thread().DeleteOrphanedRows, &r.counters.threadMembershipsDeleted, "thread memberships")
+}
+
+func (r *run) channelMemberHistory() error {
+	return r.retentionLoop(r.w.store.ChannelMemberHistory().PermanentDeleteBatchForRetentionPolicies, &r.counters.channelMemberHistoryDeleted, "channel member history")
+}
+
+func (r *run) flaggedPosts() error {
+	return r.orphanLoop(r.w.store.Preference().DeleteOrphanedRows, &r.counters.flaggedPostsDeleted, "flagged posts")
+}
+
+func (r *run) policyOrphans() error {
+	var deleted int64
+	return r.orphanLoop(r.w.store.RetentionPolicy().DeleteOrphanedRows, &deleted, "retention policy rows")
+}
+
+func (r *run) retentionLoop(deleteBatch func(model.RetentionPolicyBatchConfigs, model.RetentionPolicyCursor) (int64, model.RetentionPolicyCursor, error), counter *int64, what string) error {
+	cursor := model.RetentionPolicyCursor{}
+	for {
+		if err := r.step(); err != nil {
+			return err
+		}
+		var n int64
+		var err error
+		n, cursor, err = deleteBatch(r.batchConfig(), cursor)
+		if err != nil {
+			return fmt.Errorf("failed to delete %s: %w", what, err)
+		}
+		*counter += n
+		if cursorDone(cursor) {
+			return nil
+		}
+		if err := r.pause(); err != nil {
+			return err
+		}
+	}
+}
+
+func (r *run) orphanLoop(deleteBatch func(int) (int64, error), counter *int64, what string) error {
+	for {
+		if err := r.step(); err != nil {
+			return err
+		}
+		n, err := deleteBatch(r.plan.BatchSize)
+		if err != nil {
+			return fmt.Errorf("failed to delete orphaned %s: %w", what, err)
+		}
+		*counter += n
+		if n < int64(r.plan.BatchSize) {
+			return nil
+		}
+		if err := r.pause(); err != nil {
+			return err
+		}
+	}
+}
+
+func (r *run) files() error {
+	if r.plan.FileCutoff == 0 {
+		return nil
+	}
+	var afterCreateAt int64
+	afterID := ""
+	for {
+		if err := r.step(); err != nil {
+			return err
+		}
+		candidates, err := r.w.store.FileInfo().GetForRetention(r.plan.FileCutoff, afterCreateAt, afterID, r.plan.BatchSize)
+		if err != nil {
+			return fmt.Errorf("failed to find expired files: %w", err)
+		}
+		if len(candidates) == 0 {
+			return nil
+		}
+		last := candidates[len(candidates)-1]
+		afterCreateAt, afterID = last.CreateAt, last.Id
+
+		if err := r.w.store.FileInfo().SoftDeleteByIds(fileIDs(candidates), r.plan.Now); err != nil {
+			return fmt.Errorf("failed to hide expired files: %w", err)
+		}
+		r.changed = true
+		if _, err := r.removeFiles(candidates, &r.counters.filesDeleted); err != nil {
+			return err
+		}
+		postIDs := map[string]bool{}
+		for _, f := range candidates {
+			if !postIDs[f.PostId] {
+				postIDs[f.PostId] = true
+				r.w.store.FileInfo().InvalidateFileInfosForPostCache(f.PostId, false)
+				r.w.store.FileInfo().InvalidateFileInfosForPostCache(f.PostId, true)
+			}
+		}
+		if err := r.pause(); err != nil {
+			return err
+		}
+	}
+}
+
+func fileIDs(files []*model.FileInfo) []string {
+	ids := make([]string, 0, len(files))
+	for _, f := range files {
+		ids = append(ids, f.Id)
+	}
+	return ids
+}
+
+func (r *run) removeFiles(files []*model.FileInfo, deletedCounter *int64) (bool, error) {
+	if len(files) == 0 {
+		return true, nil
+	}
+	var paths []string
+	for _, f := range files {
+		if f.Path != "" {
+			paths = append(paths, f.Path)
+		}
+	}
+	sharedList, err := r.w.store.FileInfo().GetPathsReferencedOutside(paths, fileIDs(files))
+	if err != nil {
+		return false, fmt.Errorf("failed to check shared file paths: %w", err)
+	}
+	shared := map[string]bool{}
+	for _, p := range sharedList {
+		shared[p] = true
+	}
+
+	removed := map[string]bool{}
+	for _, p := range removalPlan(files, shared) {
+		if !safeRelative(p) {
+			r.logger.Warn("Data retention: refusing to remove unsafe file path", mlog.String("path", p))
+			continue
+		}
+		if r.removedSinceStep >= r.plan.BatchSize {
+			if err := r.step(); err != nil {
+				return false, err
+			}
+		}
+		r.removedSinceStep++
+		if err := r.backend.RemoveFile(p); err != nil && !errors.Is(err, os.ErrNotExist) {
+			r.logger.Warn("Data retention: failed to remove file from storage", mlog.String("path", p), mlog.Err(err))
+			continue
+		}
+		removed[p] = true
+		r.counters.fileObjectsRemoved++
+	}
+
+	var deleteIDs []string
+	var deleted, sharedKept, failed int64
+	for _, f := range files {
+		switch decideFile(f, shared, removed) {
+		case fileKeep:
+			failed++
+			r.logger.Warn("Data retention: keeping file row until its stored objects are removed", mlog.String("file_id", f.Id), mlog.String("path", f.Path))
+			continue
+		case fileDeleteSharedKept:
+			sharedKept++
+		default:
+			deleted++
+		}
+		deleteIDs = append(deleteIDs, f.Id)
+	}
+	if err := r.w.store.FileInfo().PermanentDeleteByIds(deleteIDs); err != nil {
+		return false, fmt.Errorf("failed to delete file rows: %w", err)
+	}
+	*deletedCounter += deleted
+	r.counters.filesSharedKept += sharedKept
+	r.counters.filesFailed += failed
+	return failed == 0, nil
+}
+
+func (r *run) clearCaches() {
+	if !r.changed {
+		return
+	}
+	r.w.store.Post().ClearCaches()
+	r.w.store.FileInfo().ClearCaches()
+}
