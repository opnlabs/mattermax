+type hookRemoveBackend struct {
+	filestore.FileBackend
+	mut     *sync.Mutex
+	removed *[]string
+	before  func(p string)
+}
+
+func newHookRemoveBackend(inner filestore.FileBackend, before func(p string)) hookRemoveBackend {
+	return hookRemoveBackend{FileBackend: inner, mut: &sync.Mutex{}, removed: &[]string{}, before: before}
+}
+
+func (b hookRemoveBackend) RemoveFile(p string) error {
+	b.mut.Lock()
+	*b.removed = append(*b.removed, p)
+	b.mut.Unlock()
+	if b.before != nil {
+		b.before(p)
+	}
+	return b.FileBackend.RemoveFile(p)
+}
+
+func (b hookRemoveBackend) calls() []string {
+	b.mut.Lock()
+	defer b.mut.Unlock()
+	return slices.Clone(*b.removed)
+}
+
+func (e *retentionEnv) burnOnReadPost(createAt int64) (*model.Post, *retentionFile) {
+	p := e.post(e.th.BasicChannel.Id, createAt)
+	_, err := e.th.Server.Store().TemporaryPost().Save(e.th.Context, &model.TemporaryPost{ID: p.Id, Type: model.PostTypeBurnOnRead, ExpireAt: e.now + retentionHour, Message: "secret"})
+	require.NoError(e.t, err)
+	e.addDependents(p.Id)
+	return p, e.file(p.Id, e.now)
+}
+
+func (e *retentionEnv) queueDeletedPosts(perRow, rows int) {
+	cursor := model.RetentionPolicyCursor{}
+	for range rows {
+		var err error
+		_, cursor, err = e.th.Server.Store().Post().PermanentDeleteBatchForRetentionPolicies(model.RetentionPolicyBatchConfigs{Now: e.now, GlobalPolicyEndTime: e.now - 24*retentionHour, Limit: int64(perRow)}, cursor)
+		require.NoError(e.t, err)
+	}
+	require.Equal(e.t, int64(rows), e.outboxRows())
+}
+
+func (e *retentionEnv) cancelOnFirstRemove(jobID string) func() filestore.FileBackend {
+	var once sync.Once
+	b := newHookRemoveBackend(e.th.Server.FileBackend(), func(string) {
+		once.Do(func() { require.Nil(e.t, e.th.Server.Jobs.RequestCancellation(e.th.Context, jobID)) })
+	})
+	return func() filestore.FileBackend { return b }
+}
