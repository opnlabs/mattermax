+package app
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+const (
+	pausedText   = "Scheduled deletion is paused until an administrator selects Run Deletion Job Now. Nothing was deleted."
+	stricterText = "Retention became stricter after the last manual run. Scheduled deletion is paused until an administrator selects Run Deletion Job Now. Nothing was deleted."
+	stoppedText  = "Retention became stricter during this run, so it stopped. Scheduled deletion is paused until an administrator selects Run Deletion Job Now."
+)
+
+type confirmFixture struct {
+	team2, team3                   *model.Team
+	c1, plainChannel, team2Channel *model.Channel
+	channelPolicy, teamPolicy      string
+}
+
+func confirmSettings(base func(s *model.DataRetentionSettings)) func(s *model.DataRetentionSettings) {
+	return func(s *model.DataRetentionSettings) {
+		s.EnableMessageDeletion = model.NewPointer(true)
+		s.MessageRetentionHours = model.NewPointer(240)
+		s.MessageRetentionDays = model.NewPointer(0)
+		s.EnableFileDeletion = model.NewPointer(true)
+		s.FileRetentionHours = model.NewPointer(480)
+		s.FileRetentionDays = model.NewPointer(0)
+		s.PreservePinnedPosts = model.NewPointer(true)
+		s.BatchSize = model.NewPointer(1000)
+		if base != nil {
+			base(s)
+		}
+	}
+}
+
+// armConfirm builds fresh teams and channels: global messages 10 days, c1 in a 20-day channel policy,
+// team2 in a 5-day team policy, plainChannel (c1's team) and team3 in no policy. Then a manual run arms.
+func (e *retentionEnv) armConfirm(base func(s *model.DataRetentionSettings)) *confirmFixture {
+	e.settings(confirmSettings(base))
+	team1 := e.th.CreateTeam(e.t)
+	fx := &confirmFixture{team2: e.th.CreateTeam(e.t), team3: e.th.CreateTeam(e.t), c1: e.channel(team1), plainChannel: e.channel(team1)}
+	fx.team2Channel = e.channel(fx.team2)
+	fx.channelPolicy = e.policy("Channel twenty days", 20, nil, []string{fx.c1.Id})
+	fx.teamPolicy = e.policy("Team two five days", 5, []string{fx.team2.Id}, nil)
+
+	manual := e.run(nil, nil)
+	require.Equal(e.t, model.JobStatusSuccess, manual.Status, manual.Data["error"])
+	require.True(e.t, e.scheduledRuns(), "a manual run arms the schedule")
+	return fx
+}
+
+func (e *retentionEnv) scheduledRuns() bool {
+	job := e.scheduled()
+	switch job.Status {
+	case model.JobStatusSuccess:
+		return true
+	case model.JobStatusWarning:
+		assert.Contains(e.t, []string{pausedText, stricterText}, job.Data["error"])
+		return false
+	}
+	require.Failf(e.t, "unexpected scheduled job status", "%s: %s", job.Status, job.Data["error"])
+	return false
+}
+
+func (e *retentionEnv) settings(update func(s *model.DataRetentionSettings)) {
+	e.th.App.UpdateConfig(func(cfg *model.Config) { update(&cfg.DataRetentionSettings) })
+}
+
+func patchDuration(id string, days int64) *model.RetentionPolicyWithTeamAndChannelIDs {
+	return &model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: id, PostDurationDays: model.NewPointer(days)}}
+}
+
+func TestDataRetentionStricterChangesPauseTheSchedule(t *testing.T) {
+	mainHelper.Parallel(t)
+	off := func(s *model.DataRetentionSettings) {
