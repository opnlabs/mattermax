@@ -0,0 +1,52 @@
+// Copyright (c) 2026-present the Mattermax authors.
+// See LICENSE.txt for license information.
+
+package data_retention
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/jobs"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+)
+
+type Scheduler struct {
+	*jobs.DailyScheduler
+	jobServer *jobs.JobServer
+	store     store.Store
+}
+
+func MakeScheduler(jobServer *jobs.JobServer, s store.Store) *Scheduler {
+	startTime := func(cfg *model.Config) *time.Time {
+		parsed, err := time.Parse("15:04", *cfg.DataRetentionSettings.DeletionJobStartTime)
+		if err != nil {
+			return nil
+		}
+		return &parsed
+	}
+	enabled := func(_ *model.Config) bool { return true }
+	return &Scheduler{
+		DailyScheduler: jobs.NewDailyScheduler(jobServer, model.JobTypeDataRetention, startTime, enabled),
+		jobServer:      jobServer,
+		store:          s,
+	}
+}
+
+func (s *Scheduler) ScheduleJob(rctx request.CTX, cfg *model.Config, pendingJobs bool, _ *model.Job) (*model.Job, *model.AppError) {
+	if pendingJobs {
+		return nil, nil
+	}
+	if !*cfg.DataRetentionSettings.EnableMessageDeletion && !*cfg.DataRetentionSettings.EnableFileDeletion {
+		count, err := s.store.RetentionPolicy().GetCount()
+		if err != nil {
+			return nil, model.NewAppError("DataRetentionScheduler", "ent.data_retention.policies.internal_error", nil, "", http.StatusInternalServerError).Wrap(err)
+		}
+		if count == 0 {
+			return nil, nil
+		}
+	}
+	return s.jobServer.CreateJob(rctx, model.JobTypeDataRetention, map[string]string{TriggerKey: triggerSchedule})
+}
