+			e.settings(func(s *model.DataRetentionSettings) { s.MessageRetentionHours = model.NewPointer(120) })
+		}},
+		{name: "file period shortened", paused: true, change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) { s.FileRetentionHours = model.NewPointer(240) })
+		}},
+		{name: "Preserve Pinned Posts turned off", paused: true, change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) { s.PreservePinnedPosts = model.NewPointer(false) })
+		}},
+		{name: "message deletion turned off", change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) { s.EnableMessageDeletion = model.NewPointer(false) })
+		}},
+		{name: "file deletion turned off", change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) { s.EnableFileDeletion = model.NewPointer(false) })
+		}},
+		{name: "message and file periods lengthened", change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) {
+				s.MessageRetentionHours = model.NewPointer(480)
+				s.FileRetentionHours = model.NewPointer(960)
+			})
+		}},
+		{name: "the same message period in days", change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) {
+				s.MessageRetentionHours = model.NewPointer(0)
+				s.MessageRetentionDays = model.NewPointer(10)
+			})
+		}},
+		{name: "Preserve Pinned Posts turned on", base: off, change: func(t *testing.T, e *retentionEnv, _ *confirmFixture) {
+			e.settings(func(s *model.DataRetentionSettings) { s.PreservePinnedPosts = model.NewPointer(true) })
+		}},
+
+		{name: "new channel policy shorter than the global period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Three days", 3, nil, []string{fx.plainChannel.Id})
+		}},
+		{name: "new channel policy shorter than its team policy", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Three days", 3, nil, []string{fx.team2Channel.Id})
+		}},
+		{name: "new team policy shorter than the global period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Three days", 3, []string{fx.team3.Id}, nil)
+		}},
+		{name: "new channel policy longer than the global period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Thirty days", 30, nil, []string{fx.plainChannel.Id})
+		}},
+		{name: "new channel policy longer than its team policy", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Seven days", 7, nil, []string{fx.team2Channel.Id})
+		}},
+		{name: "new team policy longer than the global period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Thirty days", 30, []string{fx.team3.Id}, nil)
+		}},
+		{name: "new keep-forever policy", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			e.policy("Forever", -1, []string{fx.team3.Id}, []string{fx.plainChannel.Id})
