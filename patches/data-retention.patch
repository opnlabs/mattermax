+			_, appErr := e.th.App.PatchRetentionPolicy(&model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: fx.channelPolicy, DisplayName: "Renamed"}})
+			require.Nil(t, appErr)
+		}},
+		{name: "patch keeps its channel and adds one that had a shorter period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			_, appErr := e.th.App.PatchRetentionPolicy(&model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: fx.channelPolicy}, ChannelIDs: []string{fx.c1.Id, fx.plainChannel.Id}})
+			require.Nil(t, appErr)
+		}},
+		{name: "patch drops a channel that falls back to a shorter period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			_, appErr := e.th.App.PatchRetentionPolicy(&model.RetentionPolicyWithTeamAndChannelIDs{RetentionPolicy: model.RetentionPolicy{ID: fx.channelPolicy}, ChannelIDs: []string{}})
+			require.Nil(t, appErr)
+		}},
+
+		{name: "channel added to a policy shorter than its period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.AddChannelsToRetentionPolicy(fx.teamPolicy, []string{fx.plainChannel.Id}))
+		}},
+		{name: "team added to a policy shorter than the global period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.AddTeamsToRetentionPolicy(fx.teamPolicy, []string{fx.team3.Id}))
+		}},
+		{name: "channel added to a policy longer than its period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.AddChannelsToRetentionPolicy(fx.channelPolicy, []string{fx.team2Channel.Id}))
+		}},
+		{name: "team added to a policy longer than the global period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.AddTeamsToRetentionPolicy(fx.channelPolicy, []string{fx.team3.Id}))
+		}},
+
+		{name: "channel removed falls back to a shorter period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.RemoveChannelsFromRetentionPolicy(fx.channelPolicy, []string{fx.c1.Id}))
+		}},
+		{name: "policy deleted whose channel falls back to a shorter period", paused: true, change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.DeleteRetentionPolicy(fx.channelPolicy))
+		}},
+		{name: "team removed falls back to a longer period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.RemoveTeamsFromRetentionPolicy(fx.teamPolicy, []string{fx.team2.Id}))
+		}},
+		{name: "policy deleted whose team falls back to a longer period", change: func(t *testing.T, e *retentionEnv, fx *confirmFixture) {
+			require.Nil(t, e.th.App.DeleteRetentionPolicy(fx.teamPolicy))
+		}},
+	}
+	shared := setupRetention(t, confirmSettings(nil))
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := &retentionEnv{t: t, th: shared.th, now: shared.now}
+			fx := e.armConfirm(tc.base)
+			tc.change(t, e, fx)
+			assert.Equal(t, !tc.paused, e.scheduledRuns(), "scheduled run after the change")
+			if tc.paused {
+				assert.Equal(t, stricterText, e.scheduled().Data["error"])
+				manual := e.run(nil, nil)
+				require.Equal(t, model.JobStatusSuccess, manual.Status, manual.Data["error"])
+				assert.True(t, e.scheduledRuns(), "another manual run confirms the change")
+			}
+		})
+	}
+}
+
+func TestDataRetentionStricterChangeDuringRuns(t *testing.T) {
+	mainHelper.Parallel(t)
+
+	t.Run("a policy shortened during a manual run leaves the schedule paused", func(t *testing.T) {
+		e := setupRetention(t, slowSettings)
+		policy := e.policy("Twenty days", 20, nil, []string{e.th.BasicChannel.Id})
+		e.slowRetention(10)
+		job := e.createJob(nil)
+		done := make(chan struct{})
+		go func() { defer close(done); e.worker(nil).DoJob(job) }()
+		e.waitFor("posts phase", func(j *model.Job) bool { return j.Data["phase"] == "posts" }, job.Id)
+		_, appErr := e.th.App.PatchRetentionPolicy(patchDuration(policy, 10))
+		require.Nil(t, appErr)
+		<-done
+
+		require.Equal(t, model.JobStatusSuccess, e.job(job.Id).Status)
+		assert.False(t, e.scheduledRuns())
+	})
+
+	t.Run("a scheduled run stops when a policy gets stricter", func(t *testing.T) {
+		e := setupRetention(t, slowSettings)
+		policy := e.policy("Twenty days", 20, nil, []string{e.th.BasicChannel.Id})
+		manual := e.run(nil, nil)
+		require.Equal(t, model.JobStatusSuccess, manual.Status, manual.Data["error"])
+		ids := e.slowRetention(10)
+
+		job := e.createJob(map[string]string{"trigger": "schedule"})
+		done := make(chan struct{})
+		go func() { defer close(done); e.worker(nil).DoJob(job) }()
+		require.Eventually(t, func() bool { return e.remaining(ids) < len(ids) }, 20*time.Second, 5*time.Millisecond, "some posts deleted")
+		_, appErr := e.th.App.PatchRetentionPolicy(patchDuration(policy, 10))
+		require.Nil(t, appErr)
+		<-done
+
+		stopped := e.job(job.Id)
+		assert.Equal(t, model.JobStatusWarning, stopped.Status)
+		assert.Equal(t, stoppedText, stopped.Data["error"])
+		assert.NotZero(t, e.remaining(ids), "the run stopped before finishing")
+	})
+}
