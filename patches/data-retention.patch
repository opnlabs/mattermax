+func (e *retentionEnv) saveRunningJob(createAt, lastActivityAt int64) *model.Job {
+	job, err := e.th.Server.Store().Job().Save(&model.Job{
+		Id: model.NewId(), Type: model.JobTypeDataRetention, Status: model.JobStatusInProgress,
+		CreateAt: createAt, StartAt: createAt, LastActivityAt: lastActivityAt, Data: model.StringMap{},
+	})
+	require.NoError(e.t, err)
+	return job
+}
+
+func (e *retentionEnv) slowRetention(threads int) []string {
+	channel := e.channel(e.th.BasicTeam)
+	old := e.now - 3*24*retentionHour
+	var ids []string
+	for range threads {
+		root := e.post(channel.Id, old)
+		reply := e.post(channel.Id, old+1, func(p *model.Post) { p.RootId = root.Id })
+		ids = append(ids, root.Id, reply.Id)
+	}
+	return ids
+}
+
+func (e *retentionEnv) remaining(ids []string) int {
+	n := 0
+	for _, id := range ids {
+		if e.postExists(id) {
+			n++
+		}
+	}
+	return n
+}
+
+func (e *retentionEnv) waitFor(desc string, cond func(job *model.Job) bool, jobID string) {
+	require.Eventually(e.t, func() bool { return cond(e.job(jobID)) }, 20*time.Second, 5*time.Millisecond, desc)
+}
+
+func slowSettings(s *model.DataRetentionSettings) {
+	s.BatchSize = model.NewPointer(1)
+	s.TimeBetweenBatchesMilliseconds = model.NewPointer(40)
+	s.EnableFileDeletion = model.NewPointer(false)
+}
