+func TestDataRetentionJobCopyRace(t *testing.T) {
+	t.Run("a copy that has read its source before retention hides it keeps the bytes", func(t *testing.T) {
+		e := setupRetention(t, nil)
+		src := e.file(e.post(e.th.BasicChannel.Id, e.now).Id, e.now-3*24*retentionHour)
+
+		require.Regexp(t, `^[0-9a-z/]+\.pdf$`, src.info.Path)
+		e.exec(`CREATE OR REPLACE FUNCTION mmx_retention_hold_copy() RETURNS trigger AS $$ BEGIN PERFORM pg_advisory_xact_lock(731400); RETURN NEW; END $$ LANGUAGE plpgsql`)
+		e.exec(`CREATE TRIGGER mmx_retention_hold_copy BEFORE INSERT ON FileInfo FOR EACH ROW WHEN (NEW.Path = '` + src.info.Path + `') EXECUTE FUNCTION mmx_retention_hold_copy()`)
+		t.Cleanup(func() {
+			e.exec("DROP TRIGGER IF EXISTS mmx_retention_hold_copy ON FileInfo")
+			e.exec("DROP FUNCTION IF EXISTS mmx_retention_hold_copy()")
+		})
+		tx, err := e.th.SQLStore.GetMaster().Begin()
+		require.NoError(t, err)
+		_, err = tx.Exec("SELECT pg_advisory_xact_lock(731400)")
+		require.NoError(t, err)
+
+		var copies []string
+		var copyErr *model.AppError
+		copyDone := make(chan struct{})
+		go func() {
+			defer close(copyDone)
+			copies, copyErr = e.th.App.CopyFileInfos(e.th.Context, e.th.BasicUser.Id, []string{src.info.Id})
+		}()
+		e.waitForLockWait("INSERT INTO FileInfo")
+
+		var job *model.Job
+		jobDone := make(chan struct{})
+		go func() {
+			defer close(jobDone)
+			j := e.createJob(nil)
+			e.worker(nil).DoJob(j)
+			job = j
+		}()
+		require.Eventually(t, func() bool {
+			select {
+			case <-jobDone:
+				return true
+			default:
+				return e.lockWaits("UPDATE FileInfo SET DeleteAt") > 0
+			}
+		}, 20*time.Second, 10*time.Millisecond, "retention reached the soft-delete")
+		require.NoError(t, tx.Commit())
+		<-copyDone
+		<-jobDone
+
+		require.Nil(t, copyErr)
+		require.Len(t, copies, 1)
+		got := e.job(job.Id)
+		require.Equal(t, model.JobStatusSuccess, got.Status, got.Data["error"])
+		requireCounters(t, got, map[string]int64{"files_shared_kept": 1, "files_deleted": 0, "file_objects_removed": 0})
+		assert.False(t, e.exists("FileInfo", "Id", src.info.Id), "the expired source row is gone")
+		assert.True(t, e.exists("FileInfo", "Id", copies[0]), "the copy keeps its row")
+		assert.True(t, e.objectExists(src.info.Path), "the copy keeps its bytes")
+	})
+
+	t.Run("a copy that reaches its source after retention hides it fails and saves nothing", func(t *testing.T) {
+		e := setupRetention(t, nil)
+		src := e.file(e.post(e.th.BasicChannel.Id, e.now).Id, e.now-3*24*retentionHour)
+
+		tx, err := e.th.SQLStore.GetMaster().Begin()
+		require.NoError(t, err)
+		_, err = tx.Exec("UPDATE FileInfo SET DeleteAt = ? WHERE Id = ?", model.GetMillis(), src.info.Id)
+		require.NoError(t, err)
+
+		var copyErr *model.AppError
+		copyDone := make(chan struct{})
+		go func() {
+			defer close(copyDone)
+			_, copyErr = e.th.App.CopyFileInfos(e.th.Context, e.th.BasicUser.Id, []string{src.info.Id})
+		}()
+		e.waitForLockWait("FOR SHARE")
+		require.NoError(t, tx.Commit())
+		<-copyDone
+
+		require.NotNil(t, copyErr)
+		assert.Equal(t, http.StatusNotFound, copyErr.StatusCode)
+		assert.Equal(t, int64(1), e.count("FileInfo", "Path", src.info.Path), "no copy row was saved")
+	})
+}
