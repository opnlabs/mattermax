+
+func (s *dataRetentionService) GetPolicy(policyID string) (*model.RetentionPolicyWithTeamAndChannelCounts, *model.AppError) {
+	return s.existingPolicy("GetPolicy", policyID)
+}
+
+func (s *dataRetentionService) existingPolicy(where, policyID string) (*model.RetentionPolicyWithTeamAndChannelCounts, *model.AppError) {
+	policy, err := s.store().Get(policyID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, model.NewAppError(where, retentionPolicyInvalidID, nil, "policy_id="+policyID, http.StatusNotFound).Wrap(err)
+	}
+	if err != nil {
+		return nil, retentionInternal(where, err)
+	}
+	return policy, nil
+}
+
+func (s *dataRetentionService) CreatePolicy(policy *model.RetentionPolicyWithTeamAndChannelIDs) (*model.RetentionPolicyWithTeamAndChannelCounts, *model.AppError) {
+	channels, appErr := s.validate("CreatePolicy", policy, true)
+	if appErr != nil {
+		return nil, appErr
+	}
+	period := data_retention.PolicyPeriod(policy.PostDurationDays)
+	change := data_retention.PolicyChange{OldPeriod: period, NewPeriod: period, AddedTeams: len(policy.TeamIDs), AddedChannelTeams: channelTeams(channels)}
+	if appErr := s.pauseIfStricter("CreatePolicy", change); appErr != nil {
+		return nil, appErr
+	}
+	created, err := s.store().Save(policy)
+	if err != nil {
+		return nil, retentionInternal("CreatePolicy", err)
+	}
+	return created, nil
+}
+
+func (s *dataRetentionService) PatchPolicy(patch *model.RetentionPolicyWithTeamAndChannelIDs) (*model.RetentionPolicyWithTeamAndChannelCounts, *model.AppError) {
+	old, appErr := s.existingPolicy("PatchPolicy", patch.ID)
+	if appErr != nil {
+		return nil, appErr
+	}
+	channels, appErr := s.validate("PatchPolicy", patch, false)
+	if appErr != nil {
+		return nil, appErr
+	}
+	change, err := s.patchChange(old, patch, channels)
+	if err != nil {
+		return nil, retentionInternal("PatchPolicy", err)
+	}
+	if appErr := s.pauseIfStricter("PatchPolicy", change); appErr != nil {
+		return nil, appErr
+	}
+	patched, err := s.store().Patch(patch)
+	if err != nil {
+		return nil, retentionInternal("PatchPolicy", err)
+	}
+	return patched, nil
+}
+
+func (s *dataRetentionService) DeletePolicy(policyID string) *model.AppError {
+	policy, appErr := s.existingPolicy("DeletePolicy", policyID)
+	if appErr != nil {
+		return appErr
+	}
+	teams, err := s.policyTeams(policy)
+	if err != nil {
+		return retentionInternal("DeletePolicy", err)
+	}
+	channels, err := s.policyChannels(policy)
+	if err != nil {
+		return retentionInternal("DeletePolicy", err)
+	}
+	change := unchangedPeriod(policy)
+	change.RemovedTeams = len(teams)
+	change.RemovedChannelTeams = slices.Collect(maps.Values(channels))
+	if appErr := s.pauseIfStricter("DeletePolicy", change); appErr != nil {
+		return appErr
+	}
+	if err := s.store().Delete(policyID); err != nil {
+		if _, appErr := s.existingPolicy("DeletePolicy", policyID); appErr != nil {
+			return appErr
+		}
+		return retentionInternal("DeletePolicy", err)
+	}
+	return nil
+}
+
+func (s *dataRetentionService) GetTeamsForPolicy(policyID string, offset, limit int) (*model.TeamsWithCount, *model.AppError) {
+	if _, appErr := s.existingPolicy("GetTeamsForPolicy", policyID); appErr != nil {
