+func (e *retentionEnv) buildRetentionFixture() *retentionFixture {
+	th := e.th
+	old := e.now - 3*24*retentionHour
+	recent := e.now - retentionHour
+	fx := &retentionFixture{}
+
+	t1 := th.BasicTeam
+	c1 := e.channel(t1)
+	t1Other := th.BasicChannel
+	t2 := th.CreateTeam(e.t)
+	c2 := e.channel(t2)
+	archived := e.channel(t2)
+	dm := th.CreateDmChannel(e.t, th.BasicUser2)
+	e.policy("Team one forever", -1, []string{t1.Id}, nil)
+	e.policy("Channel one day", 1, nil, []string{c1.Id})
+
+	messageCutoff := e.now - 24*retentionHour
+	fx.history = []retentionHistory{
+		e.history("left before the cutoff", c2.Id, old-retentionHour, model.NewPointer(old), false),
+		e.history("left just before the cutoff", c2.Id, old, model.NewPointer(messageCutoff-time.Minute.Milliseconds()), false),
+		e.history("left after the cutoff", c2.Id, old, model.NewPointer(recent), true),
+		e.history("joined long ago and still a member", c2.Id, old-retentionHour, nil, true),
+		e.history("left long ago a channel kept forever", t1Other.Id, old-retentionHour, model.NewPointer(old), true),
+	}
+
+	keep := func(p *model.Post) *model.Post { fx.kept = append(fx.kept, p.Id); return p }
+	drop := func(p *model.Post) *model.Post { fx.deleted = append(fx.deleted, p.Id); return p }
+
+	drop(e.post(c1.Id, old))
+	keep(e.post(c1.Id, recent))
+	keep(e.post(t1Other.Id, old))
+	fx.oldDependents = drop(e.post(c2.Id, old))
+	fx.newDependents = keep(e.post(c2.Id, recent))
+	drop(e.post(dm.Id, old))
+	keep(e.post(dm.Id, recent))
+	drop(e.post(archived.Id, old))
+	pinned := keep(e.post(c2.Id, old, func(p *model.Post) { p.IsPinned = true }))
+	drop(e.post(c2.Id, old, func(p *model.Post) { p.OriginalId = fx.oldDependents.Id; p.DeleteAt = old + 1 }))
+	appErr := th.App.DeleteChannel(th.Context, archived, th.SystemAdminUser.Id)
+	require.Nil(e.t, appErr)
+
+	fx.activeRoot = drop(e.post(c2.Id, old))
+	keep(e.post(c2.Id, recent, func(p *model.Post) { p.RootId = fx.activeRoot.Id }))
+	fx.activeMembers = []string{model.NewId(), model.NewId(), model.NewId()}
+	e.addMember(fx.activeRoot.Id, fx.activeMembers[0], e.now-45*24*retentionHour)
+	e.addMember(fx.activeRoot.Id, fx.activeMembers[1], e.now)
+	e.addMember(fx.activeRoot.Id, fx.activeMembers[2], e.now)
+
+	fx.oldRoot = drop(e.post(c2.Id, old))
+	drop(e.post(c2.Id, old+retentionHour, func(p *model.Post) { p.RootId = fx.oldRoot.Id }))
+	e.addMember(fx.oldRoot.Id, model.NewId(), old)
+	e.addMember(fx.oldRoot.Id, model.NewId(), old)
+
+	e.addDependents(fx.oldDependents.Id)
+	e.addDependents(fx.newDependents.Id)
+
+	bor := drop(e.post(c2.Id, old))
+	_, err := th.Server.Store().TemporaryPost().Save(th.Context, &model.TemporaryPost{ID: bor.Id, Type: model.PostTypeBurnOnRead, ExpireAt: e.now + 24*retentionHour, Message: "secret"})
+	require.NoError(e.t, err)
+	fx.borFile = e.file(bor.Id, recent)
+
+	fx.pdf = e.file(fx.newDependents.Id, old)
+	fx.image = e.file(fx.oldDependents.Id, old, withImagePaths)
+	fx.newOnOldPost = e.file(fx.oldDependents.Id, recent)
+	fx.bookmark = e.file("", old, func(f *model.FileInfo) { f.CreatorId = model.BookmarkFileOwner; f.ChannelId = c2.Id })
+	fx.pinnedFile = e.file(pinned.Id, old)
+	fx.sharedOrig = e.file(fx.newDependents.Id, old)
+	copies, appErr := th.App.CopyFileInfos(th.Context, th.BasicUser.Id, []string{fx.sharedOrig.info.Id})
+	require.Nil(e.t, appErr)
+	require.Len(e.t, copies, 1)
+	fx.sharedCopyID = copies[0]
+
+	fx.draft = e.file("", old)
+	_, err = th.Server.Store().Draft().Upsert(&model.Draft{UserId: th.BasicUser.Id, ChannelId: c2.Id, Message: "draft", FileIds: []string{fx.draft.info.Id}})
+	require.NoError(e.t, err)
+
+	fx.scheduledFile = e.file("", old)
+	fx.scheduledPost, err = th.Server.Store().ScheduledPost().CreateScheduledPost(th.Context, &model.ScheduledPost{
+		Draft:       model.Draft{CreateAt: e.now, UserId: th.BasicUser.Id, ChannelId: c2.Id, Message: "scheduled with attachment", FileIds: []string{fx.scheduledFile.info.Id}},
+		ScheduledAt: model.GetMillis() + 1000,
+	})
+	require.NoError(e.t, err)
+	return fx
+}
