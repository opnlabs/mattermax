+func (s *SqlRetentionPolicyStore) GetBurnOnReadIds(postIDs []string) ([]string, error) {
+	if len(postIDs) == 0 {
+		return nil, nil
+	}
+
+	ids := []string{}
+	if err := s.GetMaster().Select(&ids, `SELECT PostId FROM TemporaryPosts WHERE PostId = ANY(?)`, pq.Array(postIDs)); err != nil {
+		return nil, errors.Wrap(err, "failed to find burn-on-read posts")
+	}
+
+	return ids, nil
+}
+
+func (s *SqlRetentionPolicyStore) DeleteDependentsForOutboxRow(row *model.RetentionIdsForDeletion, now int64) (err error) {
+	txn, err := s.GetMaster().Begin()
+	if err != nil {
+		return errors.Wrap(err, "begin_transaction")
+	}
+	defer finalizeTransactionX(txn, &err)
+
+	ids := pq.Array(row.Ids)
+	statements := []struct {
+		query string
+		args  []any
+	}{
+		{`UPDATE FileInfo SET DeleteAt = ?, UpdateAt = ? WHERE PostId = ANY(?) AND DeleteAt = 0`, []any{now, now, ids}},
+		{`DELETE FROM PostsPriority WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM PersistentNotifications WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM PostAcknowledgements WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM PostReminders WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM ReadReceipts WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM TemporaryPosts WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM Reactions WHERE PostId = ANY(?)`, []any{ids}},
+		{`DELETE FROM PropertyValues WHERE TargetType = ? AND TargetID = ANY(?)`, []any{model.PropertyValueTargetTypePost, ids}},
+		{`DELETE FROM RetentionIdsForDeletion WHERE Id = ?`, []any{row.Id}},
+	}
+	for _, st := range statements {
+		if _, err = txn.Exec(st.query, st.args...); err != nil {
+			return errors.Wrapf(err, "failed to delete dependents of RetentionIdsForDeletion Id=%s", row.Id)
+		}
+	}
+
+	if err = txn.Commit(); err != nil {
+		return errors.Wrap(err, "commit_transaction")
+	}
+
+	return nil
+}
+
+func mapRetentionPolicyInsertError(err error, entity, policyID string) error {
+	var pqErr *pq.Error
+	if errors.As(err, &pqErr) {
+		switch pqErr.Code {
+		case PGForeignKeyViolationErrorCode:
+			return store.NewErrNotFound("RetentionPolicy", policyID)
+		case "23505":
+			return store.NewErrConflict(entity, err, "")
+		}
+	}
+	return errors.Wrapf(err, "failed to insert %s rows", entity)
+}
