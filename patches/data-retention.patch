+func (e *retentionEnv) addDependents(postID string) {
+	now := model.GetMillis()
+	e.exec("INSERT INTO Reactions (UserId, PostId, EmojiName, CreateAt, UpdateAt, DeleteAt) VALUES (?, ?, 'smile', ?, ?, 0)", e.th.BasicUser.Id, postID, now, now)
+	e.exec("INSERT INTO PostAcknowledgements (PostId, UserId, AcknowledgedAt) VALUES (?, ?, ?)", postID, e.th.BasicUser.Id, now)
+	e.exec("INSERT INTO PostReminders (PostId, UserId, TargetTime) VALUES (?, ?, ?)", postID, e.th.BasicUser.Id, now+retentionHour)
+	e.exec("INSERT INTO PostsPriority (PostId, ChannelId, Priority) VALUES (?, ?, 'urgent')", postID, e.th.BasicChannel.Id)
+	e.exec("INSERT INTO PersistentNotifications (PostId, CreateAt, LastSentAt, DeleteAt, SentCount) VALUES (?, ?, 0, 0, 0)", postID, now)
+	e.exec("INSERT INTO ReadReceipts (PostId, UserId, ExpireAt) VALUES (?, ?, ?)", postID, e.th.BasicUser.Id, now+retentionHour)
+	e.exec("INSERT INTO Preferences (UserId, Category, Name, Value) VALUES (?, ?, ?, 'true')", e.th.BasicUser.Id, model.PreferenceCategoryFlaggedPost, postID)
+	e.exec("INSERT INTO PropertyValues (ID, TargetID, TargetType, GroupID, FieldID, Value, CreateAt, UpdateAt, DeleteAt) VALUES (?, ?, 'post', ?, ?, '\"pending\"', ?, ?, 0)", model.NewId(), postID, model.NewId(), model.NewId(), now, now)
+}
+
+var retentionDependents = []struct{ table, column string }{
