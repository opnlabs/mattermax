+func TestDataRetentionJobArming(t *testing.T) {
+	mainHelper.Parallel(t)
+	e := setupRetention(t, nil)
+	p := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+	armed := func() bool { return e.exists("Systems", "Name", data_retention.ArmedSystemKey) }
+
+	job := e.scheduled()
+	require.Equal(t, model.JobStatusWarning, job.Status)
+	assert.Equal(t, "Scheduled deletion is paused until an administrator selects Run Deletion Job Now. Nothing was deleted.", job.Data["error"])
+	assert.Equal(t, "schedule", job.Data["trigger"])
+	assert.True(t, e.postExists(p.Id))
+	assert.False(t, armed())
+
+	t.Run("an old pending job with no provenance, delivered by the watcher, deletes nothing and does not arm", func(t *testing.T) {
+		old := e.file(e.post(e.th.BasicChannel.Id, e.now).Id, e.now-3*24*retentionHour)
+		legacy, err := e.th.Server.Store().Job().Save(&model.Job{
+			Id: model.NewId(), Type: model.JobTypeDataRetention, Status: model.JobStatusPending,
+			CreateAt: e.now - 400*24*retentionHour, Data: model.StringMap{},
+		})
+		require.NoError(t, err)
+
+		w := e.worker(nil)
+		go w.Run()
+		defer w.Stop()
+		workers := jobs.NewWorkers(e.th.Server.Jobs.ConfigService)
+		workers.AddWorker(model.JobTypeDataRetention, w)
+		watcher := e.th.Server.Jobs.MakeWatcher(workers, jobs.DefaultWatcherPollingInterval)
+		require.Eventually(t, func() bool {
+			watcher.PollAndNotify()
+			s := e.job(legacy.Id).Status
+			return s != model.JobStatusPending && s != model.JobStatusInProgress
+		}, 20*time.Second, 20*time.Millisecond)
+
+		got := e.job(legacy.Id)
+		assert.Equal(t, model.JobStatusWarning, got.Status)
+		assert.Equal(t, "Scheduled deletion is paused until an administrator selects Run Deletion Job Now. Nothing was deleted.", got.Data["error"])
+		assert.Empty(t, got.Data["trigger"], "the worker does not infer a manual run")
+		assert.True(t, e.postExists(p.Id))
+		row, deleteAt, objects := e.fileState(old)
+		assert.True(t, row)
+		assert.Zero(t, deleteAt)
+		assert.Equal(t, 1, objects)
+		assert.False(t, armed())
+	})
+
+	_, err := e.th.Server.Store().Job().Save(&model.Job{
+		Id: model.NewId(), Type: model.JobTypeDataRetention, Status: model.JobStatusSuccess,
+		CreateAt: e.now - 2*365*24*retentionHour, LastActivityAt: e.now - 2*365*24*retentionHour, Progress: 100,
+	})
+	require.NoError(t, err)
+	job = e.scheduled()
+	require.Equal(t, model.JobStatusWarning, job.Status, "an Enterprise-era success row does not arm the schedule")
+	assert.True(t, e.postExists(p.Id))
+
+	f := e.file(e.post(e.th.BasicChannel.Id, e.now).Id, e.now-3*24*retentionHour)
+	failing := func() filestore.FileBackend {
+		return failingRemoveBackend{FileBackend: e.th.Server.FileBackend(), fail: f.info.Path}
+	}
+	manual := e.run(nil, failing)
+	require.Equal(t, model.JobStatusWarning, manual.Status)
+	assert.Equal(t, "manual", manual.Data["trigger"])
+	assert.False(t, e.postExists(p.Id))
+	sys, err := e.th.Server.Store().System().GetByName(data_retention.ArmedSystemKey)
+	require.NoError(t, err)
+	var confirmed struct {
+		JobID string `json:"job_id"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(sys.Value), &confirmed))
+	assert.Equal(t, manual.Id, confirmed.JobID)
+
+	p2 := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+	job = e.scheduled()
+	require.Equal(t, model.JobStatusSuccess, job.Status, job.Data["error"])
+	assert.False(t, e.postExists(p2.Id))
+
+	e.exec("DELETE FROM Jobs")
+	p3 := e.post(e.th.BasicChannel.Id, e.now-3*24*retentionHour)
+	job = e.scheduled()
+	require.Equal(t, model.JobStatusSuccess, job.Status, "job cleanup does not disarm")
+	assert.False(t, e.postExists(p3.Id))
+}
