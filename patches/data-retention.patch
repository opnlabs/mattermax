+	t.Run("ThreadMembershipsSurviveLiveThreads", func(t *testing.T) { testDataRetentionThreadMemberships(t, rctx, ss, s) })
+	t.Run("OrphanedThreadMembershipsRespectTheBatchSize", func(t *testing.T) { testDataRetentionOrphanedMembershipBatch(t, rctx, ss, s) })
+	t.Run("SaveCopy", func(t *testing.T) { testDataRetentionSaveCopy(t, rctx, ss, s) })
+	t.Run("UpdateOptimisticallyIfInactive", func(t *testing.T) { testDataRetentionReapInactiveJob(t, rctx, ss, s) })
+}
+
+type retentionFixture struct {
+	t        *testing.T
+	rctx     request.CTX
+	ss       store.Store
+	s        SqlStore
+	channels []string
+}
+
+func newRetentionFixture(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) *retentionFixture {
+	f := &retentionFixture{t: t, rctx: rctx, ss: ss, s: s}
+	t.Cleanup(func() {
+		for _, q := range []string{"DELETE FROM RetentionIdsForDeletion", "DELETE FROM RetentionPolicies", "DELETE FROM RetentionPoliciesChannels", "DELETE FROM RetentionPoliciesTeams"} {
+			_, err := s.GetMaster().Exec(q)
+			require.NoError(t, err)
+		}
+		for _, c := range f.channels {
+			_, err := s.GetMaster().Exec("DELETE FROM Posts WHERE ChannelId = ?", c)
+			require.NoError(t, err)
+			_, err = s.GetMaster().Exec("DELETE FROM Threads WHERE ChannelId = ?", c)
+			require.NoError(t, err)
+		}
+	})
+	return f
+}
