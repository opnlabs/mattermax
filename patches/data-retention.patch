+func testDataRetentionReapInactiveJob(t *testing.T, rctx request.CTX, ss store.Store, s SqlStore) {
+	now := model.GetMillis()
+	save := func(lastActivityAt int64) *model.Job {
+		job, err := ss.Job().Save(&model.Job{Id: model.NewId(), Type: model.JobTypeDataRetention, Status: model.JobStatusInProgress, CreateAt: lastActivityAt, LastActivityAt: lastActivityAt, Data: model.StringMap{}})
+		require.NoError(t, err)
+		t.Cleanup(func() { _, err := ss.Job().Delete(job.Id); require.NoError(t, err) })
+		return job
+	}
+	failed := func(job *model.Job) *model.Job {
+		c := *job
+		c.Status = model.JobStatusError
+		c.Data = model.StringMap{"error": "abandoned"}
+		return &c
+	}
+	cutoff := now - 15*60*1000
+
+	t.Run("an inactive job is reaped", func(t *testing.T) {
+		job := save(now - 60*60*1000)
+		reaped, err := ss.Job().UpdateOptimisticallyIfInactive(failed(job), model.JobStatusInProgress, cutoff)
+		require.NoError(t, err)
+		require.NotNil(t, reaped)
+		got, err := ss.Job().Get(rctx, job.Id)
+		require.NoError(t, err)
+		assert.Equal(t, model.JobStatusError, got.Status)
+		assert.Equal(t, "abandoned", got.Data["error"])
+	})
+
+	t.Run("a heartbeat after the read wins over the reap", func(t *testing.T) {
+		stale := save(now - 60*60*1000)
+		heartbeat := *stale
+		heartbeat.Data = model.StringMap{"phase": "posts"}
+		beat, err := ss.Job().UpdateOptimistically(&heartbeat, model.JobStatusInProgress)
+		require.NoError(t, err)
+		require.NotNil(t, beat)
+
+		reaped, err := ss.Job().UpdateOptimisticallyIfInactive(failed(stale), model.JobStatusInProgress, cutoff)
+		require.NoError(t, err)
+		assert.Nil(t, reaped)
+		got, err := ss.Job().Get(rctx, stale.Id)
+		require.NoError(t, err)
+		assert.Equal(t, model.JobStatusInProgress, got.Status)
+		assert.Equal(t, "posts", got.Data["phase"])
+	})
+
+	t.Run("a status change after the read wins over the reap", func(t *testing.T) {
+		stale := save(now - 60*60*1000)
+		_, err := s.GetMaster().Exec("UPDATE Jobs SET Status = ? WHERE Id = ?", model.JobStatusCancelRequested, stale.Id)
+		require.NoError(t, err)
+		reaped, err := ss.Job().UpdateOptimisticallyIfInactive(failed(stale), model.JobStatusInProgress, cutoff)
+		require.NoError(t, err)
+		assert.Nil(t, reaped)
+	})
+}
