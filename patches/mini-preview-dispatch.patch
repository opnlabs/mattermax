From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rhnvrm <hello@rohanverma.net>
Date: Sat, 14 Nov 2026 12:50:42 +0530
Subject: [PATCH] perf: skip preview dispatch for completed attachments

Use the existing preview eligibility predicate before starting workers and allocate the wait group only when work is needed. Keep pending raster previews concurrent and wait for persistence before returning. Retain SVG, existing-preview and failed-read behavior.

Add a real-image batch/retry regression and real app preparation benchmarks. Existing Mattermax patches and original contributor attribution remain unchanged.

Mattermax-Patch: mini-preview-dispatch.patch
---
 server/channels/app/file.go                   |  28 +++-
 server/channels/app/file_mini_preview_test.go | 149 ++++++++++++++++++
 2 files changed, 169 insertions(+), 8 deletions(-)
 create mode 100644 server/channels/app/file_mini_preview_test.go

diff --git a/server/channels/app/file.go b/server/channels/app/file.go
index 0c72bb5d6eb8..a8c8128ac45b 100644
--- a/server/channels/app/file.go
+++ b/server/channels/app/file.go
@@ -1250,10 +1250,15 @@ func (a *App) generatePreviewImage(rctx request.CTX, img image.Image, imgType, p
 	}
 }
 
+// needsMiniPreview is shared by single-file generation and batch dispatch.
+func needsMiniPreview(fi *model.FileInfo) bool {
+	return fi.IsImage() && !fi.IsSvg() && fi.MiniPreview == nil
+}
+
 // generateMiniPreview updates mini preview if needed
 // will save fileinfo with the preview added
 func (a *App) generateMiniPreview(rctx request.CTX, fi *model.FileInfo) {
-	if fi.IsImage() && !fi.IsSvg() && fi.MiniPreview == nil {
+	if needsMiniPreview(fi) {
 		file, appErr := a.FileReader(fi.Path)
 		if appErr != nil {
 			rctx.Logger().Debug("Error reading image file", mlog.Err(appErr))
@@ -1284,16 +1289,23 @@ func (a *App) generateMiniPreview(rctx request.CTX, fi *model.FileInfo) {
 }
 
 func (a *App) generateMiniPreviewForInfos(rctx request.CTX, fileInfos []*model.FileInfo) {
-	wg := new(sync.WaitGroup)
-
-	wg.Add(len(fileInfos))
+	var wg *sync.WaitGroup
 	for _, fileInfo := range fileInfos {
-		go func(fi *model.FileInfo) {
-			defer wg.Done()
+		if !needsMiniPreview(fileInfo) {
+			continue
+		}
+		if wg == nil {
+			wg = new(sync.WaitGroup)
+		}
+		wg.Add(1)
+		go func(fi *model.FileInfo, group *sync.WaitGroup) {
+			defer group.Done()
 			a.generateMiniPreview(rctx, fi)
-		}(fileInfo)
+		}(fileInfo, wg)
+	}
+	if wg != nil {
+		wg.Wait()
 	}
-	wg.Wait()
 }
 
 func (s *Server) getFileInfo(fileID string) (*model.FileInfo, *model.AppError) {
diff --git a/server/channels/app/file_mini_preview_test.go b/server/channels/app/file_mini_preview_test.go
new file mode 100644
