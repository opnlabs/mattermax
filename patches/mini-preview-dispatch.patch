+func TestMiniPreviewDispatch(t *testing.T) {
+	th := Setup(t)
+	var encoded bytes.Buffer
+	require.NoError(t, png.Encode(&encoded, image.NewRGBA(image.Rect(0, 0, 8, 8))))
+	prefix := "mini-preview/" + model.NewId() + "/"
+	// A second pending image is made readable only after the first call, proving
+	// failed preview attempts remain eligible on a later request.
+	makePending := func(name string, write bool) *model.FileInfo {
+		t.Helper()
+		path := prefix + name
+		if write {
+			_, err := th.App.WriteFile(bytes.NewReader(encoded.Bytes()), path)
+			require.Nil(t, err)
+		}
+		info, err := th.App.Srv().Store().FileInfo().Save(th.Context, &model.FileInfo{CreatorId: model.NewId(), PostId: model.NewId(), Name: name, Path: path, MimeType: "image/png", Width: 8, Height: 8})
+		require.NoError(t, err)
+		return info
+	}
+	first := makePending("first.png", true)
+	second := makePending("second.png", true)
+	retry := makePending("retry.png", false)
+	preview := []byte("existing preview")
+	text := &model.FileInfo{Id: model.NewId(), Name: "note.txt", MimeType: "text/plain"}
+	svg := &model.FileInfo{Id: model.NewId(), Name: "drawing.svg", MimeType: "image/svg+xml"}
+	ready := &model.FileInfo{Id: model.NewId(), Name: "ready.png", MimeType: "image/png", MiniPreview: &preview}
+	originalText, originalSVG, originalReady := *text, *svg, *ready
+	infos := []*model.FileInfo{text, first, svg, ready, second, retry}
+	originalOrder := append([]*model.FileInfo(nil), infos...)
+	th.App.generateMiniPreviewForInfos(th.Context, infos)
+	require.Equal(t, originalOrder, infos, "dispatch must not reorder or replace caller entries")
+	require.Equal(t, originalText, *text)
+	require.Equal(t, originalSVG, *svg)
+	require.Equal(t, originalReady, *ready)
+	for _, info := range []*model.FileInfo{first, second} {
+		require.NotNil(t, info.MiniPreview, "pending images must finish before dispatch returns")
+		require.NotEmpty(t, *info.MiniPreview)
+		persisted, err := th.SQLStore.FileInfo().Get(info.Id)
+		require.NoError(t, err)
+		require.Equal(t, info.MiniPreview, persisted.MiniPreview, "preview writes must be complete before return")
+	}
+	require.Nil(t, retry.MiniPreview)
+	_, appErr := th.App.WriteFile(bytes.NewReader(encoded.Bytes()), retry.Path)
+	require.Nil(t, appErr)
+	th.App.generateMiniPreviewForInfos(th.Context, infos)
+	require.NotNil(t, retry.MiniPreview)
+	persisted, err := th.SQLStore.FileInfo().Get(retry.Id)
+	require.NoError(t, err)
+	require.Equal(t, retry.MiniPreview, persisted.MiniPreview)
+	// A completed batch and an empty batch preserve the input and do no extra work.
+	completed := append([]byte(nil), (*first.MiniPreview)...)
+	th.App.generateMiniPreviewForInfos(th.Context, infos)
+	require.Equal(t, completed, *first.MiniPreview)
+	th.App.generateMiniPreviewForInfos(th.Context, nil)
+}
+
+// BenchmarkMiniPreviewPostPreparation exercises real app preparation with text
+// files and image metadata whose mini-preview is already present. It excludes
+// image decoding, uploads, HTTP and remote links. Both existing metadata passes
+// stay enabled so this benchmark is independent of the metadata-reuse patch.
+func BenchmarkMiniPreviewPostPreparation(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableLinkPreviews = false })
+	var jpegBytes bytes.Buffer
+	if err := jpeg.Encode(&jpegBytes, image.NewRGBA(image.Rect(0, 0, 8, 8)), nil); err != nil {
+		b.Fatal(err)
+	}
+	preview := jpegBytes.Bytes()
+	for _, kind := range []string{"text", "ready_image"} {
+		b.Run(kind, func(b *testing.B) {
+			for _, files := range []int{0, 1, 10} {
+				b.Run(fmt.Sprintf("files=%d", files), func(b *testing.B) {
+					post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "attachment benchmark"})
+					if err != nil {
+						b.Fatal(err)
+					}
+					ids := make([]string, files)
+					for i := range ids {
+						fi := &model.FileInfo{CreatorId: th.BasicUser.Id, PostId: post.Id, Name: fmt.Sprintf("attachment-%d.txt", i), Path: fmt.Sprintf("benchmark/%s/%d", post.Id, i), MimeType: "text/plain"}
+						if kind == "ready_image" {
+							fi.Name = fmt.Sprintf("attachment-%d.png", i)
+							fi.MimeType = "image/png"
+							fi.MiniPreview = &preview
+							fi.Width = 8
+							fi.Height = 8
+						}
+						info, err := th.App.Srv().Store().FileInfo().Save(th.Context, fi)
+						if err != nil {
+							b.Fatal(err)
+						}
+						ids[i] = info.Id
+					}
+					updated := post.Clone()
+					updated.FileIds = ids
+					post, err = th.App.Srv().Store().Post().Update(th.Context, updated, post)
+					if err != nil {
+						b.Fatal(err)
+					}
+					for _, mode := range []string{"warm", "master"} {
+						b.Run(mode, func(b *testing.B) {
+							opts := &model.PreparePostForClientOpts{IsNewPost: mode == "master"}
+							check := func(p *model.Post) bool {
+								if p.Metadata == nil || len(p.Metadata.Files) != files {
+									return false
+								}
+								for i, info := range p.Metadata.Files {
+									if info.Id != ids[i] {
+										return false
+									}
+									if kind == "ready_image" && (info.MiniPreview == nil || !bytes.Equal(*info.MiniPreview, preview)) {
+										return false
+									}
+								}
+								return true
+							}
+							if !check(th.App.PreparePostForClientWithEmbedsAndImages(th.Context, post, opts)) {
+								b.Fatal("incorrect attachment preflight")
+							}
+							b.ReportAllocs()
+							b.ResetTimer()
+							for i := 0; i < b.N; i++ {
+								if !check(th.App.PreparePostForClientWithEmbedsAndImages(th.Context, post, opts)) {
+									b.Fatal("incorrect attachment metadata")
+								}
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
