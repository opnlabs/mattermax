@@ -0,0 +1,293 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package api4
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func storeChannelPostingRules(t *testing.T, client *model.Client4, channelID string, rules model.ChannelPostingRules) (*http.Response, error) {
+	t.Helper()
+	resp, err := client.DoAPIPutJSON(context.Background(), "/channels/"+channelID+"/posting_rules", rules)
+	if resp != nil {
+		resp.Body.Close()
+	}
+	return resp, err
+}
+
+func fetchChannelPostingRules(t *testing.T, client *model.Client4, channelID string) model.ChannelPostingRules {
+	t.Helper()
+	resp, err := client.DoAPIGet(context.Background(), "/channels/"+channelID+"/posting_rules", "")
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	var rules model.ChannelPostingRules
+	require.NoError(t, json.NewDecoder(resp.Body).Decode(&rules))
+	return rules
+}
+
+func newChannelMemberClient(t *testing.T, th *TestHelper, channel *model.Channel) (*model.User, *model.Client4) {
+	t.Helper()
+	user := th.CreateUser(t)
+	th.LinkUserToTeam(t, user, th.BasicTeam)
+	th.AddUserToChannel(t, user, channel)
+	client := th.CreateClient()
+	_, _, err := client.Login(context.Background(), user.Username, user.Password)
+	require.NoError(t, err)
+	return user, client
+}
+
+func postMessage(client *model.Client4, channelID, rootID string) error {
+	_, _, err := client.CreatePost(context.Background(), &model.Post{ChannelId: channelID, RootId: rootID, Message: "message_" + model.NewId()})
+	return err
+}
+
+func TestChannelPostingRulesAPI(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	channel := th.CreatePublicChannel(t)
+	_, memberClient := newChannelMemberClient(t, th, channel)
+
+	t.Run("rules are off by default", func(t *testing.T) {
+		require.Equal(t, model.ChannelPostingRules{}, fetchChannelPostingRules(t, memberClient, channel.Id))
+	})
+
+	t.Run("a member cannot change the rules", func(t *testing.T) {
+		resp, err := storeChannelPostingRules(t, memberClient, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 30})
+		require.Error(t, err)
+		require.Equal(t, http.StatusForbidden, resp.StatusCode)
+	})
+
+	t.Run("a channel admin sets slowmode and members can read it", func(t *testing.T) {
+		_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 30})
+		require.NoError(t, err)
+		require.Equal(t, 30, fetchChannelPostingRules(t, memberClient, channel.Id).SlowmodeSeconds)
+	})
+
+	t.Run("an interval outside the allowed options is rejected", func(t *testing.T) {
+		resp, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 42})
+		CheckErrorID(t, err, "model.channel_posting_rules.slowmode_seconds.app_error")
+		require.Equal(t, http.StatusBadRequest, resp.StatusCode)
+	})
+
+	t.Run("rules are cached and a save takes effect on the next post", func(t *testing.T) {
+		channel := th.CreatePublicChannel(t)
+		_, client := newChannelMemberClient(t, th, channel)
+		require.Equal(t, model.ChannelPostingRules{}, fetchChannelPostingRules(t, client, channel.Id))
+
+		_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 60})
+		require.NoError(t, err)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		CheckErrorID(t, postMessage(client, channel.Id, ""), "api.post.create_post.slowmode.app_error")
+
+		_, err = storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{})
+		require.NoError(t, err)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+
+		require.NoError(t, th.App.Srv().Store().System().SaveOrUpdate(&model.System{Name: "channel_posting_rules_" + channel.Id, Value: `{"slowmode_seconds":60}`}))
+		require.NoError(t, postMessage(client, channel.Id, ""))
+	})
+
+	t.Run("rules cannot be set on a direct message", func(t *testing.T) {
+		dm := th.CreateDmChannel(t, th.BasicUser2)
+		_, err := storeChannelPostingRules(t, th.SystemAdminClient, dm.Id, model.ChannelPostingRules{SlowmodeSeconds: 30})
+		CheckErrorID(t, err, "app.channel_posting_rules.dm_gm.app_error")
+	})
+}
+
+func TestSlowmodeConcurrentPosts(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	channel := th.CreatePublicChannel(t)
+	_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 60})
+	require.NoError(t, err)
+	_, client := newChannelMemberClient(t, th, channel)
+
+	errs := make([]error, 10)
+	var wg sync.WaitGroup
+	for i := range errs {
+		wg.Go(func() { errs[i] = postMessage(client, channel.Id, "") })
+	}
+	wg.Wait()
+
+	succeeded := 0
+	for _, err := range errs {
+		if err == nil {
+			succeeded++
+			continue
+		}
+		CheckErrorID(t, err, "api.post.create_post.slowmode.app_error")
+	}
+	require.Equal(t, 1, succeeded)
+}
+
+func TestSlowmode(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+
+	channel := th.CreatePublicChannel(t)
+	_, err := storeChannelPostingRules(t, th.Client, channel.Id, model.ChannelPostingRules{SlowmodeSeconds: 60})
+	require.NoError(t, err)
+
+	t.Run("a second root post or reply inside the interval is rejected with the seconds left", func(t *testing.T) {
+		_, client := newChannelMemberClient(t, th, channel)
+		root, _, err := client.CreatePost(context.Background(), &model.Post{ChannelId: channel.Id, Message: "first"})
+		require.NoError(t, err)
+
+		for _, rootID := range []string{"", root.Id} {
+			err = postMessage(client, channel.Id, rootID)
+			CheckErrorID(t, err, "api.post.create_post.slowmode.app_error")
+			var appErr *model.AppError
+			require.ErrorAs(t, err, &appErr)
+			require.Equal(t, http.StatusTooManyRequests, appErr.StatusCode)
+			require.Regexp(t, `You can post again in (59|60) seconds\.`, appErr.Message)
+		}
+	})
+
+	t.Run("the interval is per user", func(t *testing.T) {
+		_, first := newChannelMemberClient(t, th, channel)
+		_, second := newChannelMemberClient(t, th, channel)
+		require.NoError(t, postMessage(first, channel.Id, ""))
+		require.NoError(t, postMessage(second, channel.Id, ""))
+	})
+
+	t.Run("deleting the last post does not reset the interval", func(t *testing.T) {
+		_, client := newChannelMemberClient(t, th, channel)
+		post, _, err := client.CreatePost(context.Background(), &model.Post{ChannelId: channel.Id, Message: "first"})
+		require.NoError(t, err)
+		_, err = client.DeletePost(context.Background(), post.Id)
+		require.NoError(t, err)
+		CheckErrorID(t, postMessage(client, channel.Id, ""), "api.post.create_post.slowmode.app_error")
+	})
+
+	t.Run("posting is allowed again once the interval has passed", func(t *testing.T) {
+		user, client := newChannelMemberClient(t, th, channel)
+		_, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{
+			ChannelId: channel.Id,
+			UserId:    user.Id,
+			Message:   "an hour ago",
+			CreateAt:  model.GetMillis() - 61*1000,
+		})
+		require.NoError(t, err)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		CheckErrorID(t, postMessage(client, channel.Id, ""), "api.post.create_post.slowmode.app_error")
+	})
+
+	t.Run("the join message does not start the interval", func(t *testing.T) {
+		user := th.CreateUser(t)
+		th.LinkUserToTeam(t, user, th.BasicTeam)
+		client := th.CreateClient()
+		_, _, err := client.Login(context.Background(), user.Username, user.Password)
+		require.NoError(t, err)
+		_, _, err = client.AddChannelMember(context.Background(), channel.Id, user.Id)
+		require.NoError(t, err)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+	})
+
+	t.Run("channel admins are exempt", func(t *testing.T) {
+		user, client := newChannelMemberClient(t, th, channel)
+		th.MakeUserChannelAdmin(t, user, channel)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		require.NoError(t, postMessage(client, channel.Id, ""))
+	})
+
+	t.Run("team admins are exempt", func(t *testing.T) {
+		user, client := newChannelMemberClient(t, th, channel)
+		th.UpdateUserToTeamAdmin(t, user, th.BasicTeam)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		require.NoError(t, postMessage(client, channel.Id, ""))
+	})
+
+	t.Run("system admins are exempt", func(t *testing.T) {
+		th.LinkUserToTeam(t, th.SystemAdminUser, th.BasicTeam)
+		th.AddUserToChannel(t, th.SystemAdminUser, channel)
+		require.NoError(t, postMessage(th.SystemAdminClient, channel.Id, ""))
+		require.NoError(t, postMessage(th.SystemAdminClient, channel.Id, ""))
+	})
+
+	t.Run("bots are exempt", func(t *testing.T) {
+		th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableBotAccountCreation = true })
+		bot := th.CreateBotWithSystemAdminClient(t)
+		botUser, appErr := th.App.GetUser(th.Context, bot.UserId)
+		require.Nil(t, appErr)
+		th.LinkUserToTeam(t, botUser, th.BasicTeam)
+		th.AddUserToChannel(t, botUser, channel)
+		for range 2 {
+			_, _, appErr = th.App.CreatePostAsUser(th.Context, &model.Post{ChannelId: channel.Id, UserId: bot.UserId, Message: "beep"}, "", false)
+			require.Nil(t, appErr)
+		}
+	})
+
+	t.Run("incoming webhook posts are exempt", func(t *testing.T) {
+		th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableIncomingWebhooks = true })
+		user, _ := newChannelMemberClient(t, th, channel)
+		hook, appErr := th.App.CreateIncomingWebhookForChannel(user.Id, channel, &model.IncomingWebhook{ChannelId: channel.Id})
+		require.Nil(t, appErr)
+		for range 2 {
+			resp, err := http.Post(th.Client.URL+"/hooks/"+hook.Id, "application/json", strings.NewReader(`{"text": "hook"}`))
+			require.NoError(t, err)
+			resp.Body.Close()
+			require.Equal(t, http.StatusOK, resp.StatusCode)
+		}
+	})
+
+	t.Run("built-in slash commands such as /me are slowed down", func(t *testing.T) {
+		_, client := newChannelMemberClient(t, th, channel)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		_, _, err := client.ExecuteCommand(context.Background(), channel.Id, "/me waves")
+		CheckErrorID(t, err, "api.post.create_post.slowmode.app_error")
+	})
+
+	t.Run("CreatePostMissingChannel, which /echo posts through, is slowed down", func(t *testing.T) {
+		user, client := newChannelMemberClient(t, th, channel)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		_, _, appErr := th.App.CreatePostMissingChannel(th.Context, &model.Post{ChannelId: channel.Id, UserId: user.Id, Message: "echo"}, true, true)
+		require.NotNil(t, appErr)
+		require.Equal(t, "api.post.create_post.slowmode.app_error", appErr.Id)
+	})
+
+	t.Run("a scheduled post that would break slowmode fails as unable to send", func(t *testing.T) {
+		user, _ := newChannelMemberClient(t, th, channel)
+		for range 2 {
+			_, err := th.App.Srv().Store().ScheduledPost().CreateScheduledPost(th.Context, &model.ScheduledPost{
+				Draft:       model.Draft{CreateAt: model.GetMillis(), UserId: user.Id, ChannelId: channel.Id, Message: "scheduled"},
+				ScheduledAt: model.GetMillis() - 1000,
+			})
+			require.NoError(t, err)
+		}
+
+		th.App.ProcessScheduledPosts(th.Context)
+
+		remaining, err := th.App.Srv().Store().ScheduledPost().GetScheduledPostsForUser(th.Context, user.Id, th.BasicTeam.Id)
+		require.NoError(t, err)
+		require.Len(t, remaining, 1)
+		require.Equal(t, model.ScheduledPostErrorUnableToSend, remaining[0].ErrorCode)
+	})
+
+	t.Run("system messages and plugin posts are exempt", func(t *testing.T) {
+		user, client := newChannelMemberClient(t, th, channel)
+		require.NoError(t, postMessage(client, channel.Id, ""))
+		_, _, appErr := th.App.CreatePost(th.Context, &model.Post{ChannelId: channel.Id, UserId: user.Id, Type: model.PostTypeHeaderChange, Message: "header"}, channel, model.CreatePostFlags{})
+		require.Nil(t, appErr)
+		_, _, appErr = th.App.CreatePost(th.Context, &model.Post{ChannelId: channel.Id, UserId: user.Id, Message: "plugin"}, channel, model.CreatePostFlags{FromPlugin: true})
+		require.Nil(t, appErr)
+	})
+
+	t.Run("direct messages are never slowed down", func(t *testing.T) {
+		dm := th.CreateDmChannel(t, th.BasicUser2)
+		require.NoError(t, th.App.Srv().Store().System().SaveOrUpdate(&model.System{Name: "channel_posting_rules_" + dm.Id, Value: `{"slowmode_seconds":60}`}))
+		require.NoError(t, postMessage(th.Client, dm.Id, ""))
+		require.NoError(t, postMessage(th.Client, dm.Id, ""))
+	})
+}
diff --git a/server/channels/app/channel_posting_rules.go b/server/channels/app/channel_posting_rules.go
new file mode 100644
index 000000000000..621c35763c11
--- /dev/null
+++ b/server/channels/app/channel_posting_rules.go
@@ -0,0 +1,125 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/mattermost/mattermost/server/public/model"
+	"github.com/mattermost/mattermost/server/public/shared/request"
+	"github.com/mattermost/mattermost/server/v8/channels/store"
+)
+
+const channelPostingRulesKeyPrefix = "channel_posting_rules_"
+
+func (a *App) GetChannelPostingRules(channelID string) (*model.ChannelPostingRules, *model.AppError) {
+	var cached model.ChannelPostingRules
+	if err := a.Srv().channelPostingRulesCache.Get(channelID, &cached); err == nil {
+		return &cached, nil
+	}
+
+	rules := &model.ChannelPostingRules{}
+	system, err := a.Srv().Store().System().GetByName(channelPostingRulesKeyPrefix + channelID)
+	var nfErr *store.ErrNotFound
+	switch {
+	case errors.As(err, &nfErr):
+	case err != nil:
+		return nil, model.NewAppError("GetChannelPostingRules", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	default:
+		if err := json.Unmarshal([]byte(system.Value), rules); err != nil {
+			return nil, model.NewAppError("GetChannelPostingRules", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+		}
+	}
+
+	if err := a.Srv().channelPostingRulesCache.SetWithDefaultExpiry(channelID, rules); err != nil {
+		return nil, model.NewAppError("GetChannelPostingRules", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+	return rules, nil
+}
+
+func (a *App) SaveChannelPostingRules(channel *model.Channel, rules *model.ChannelPostingRules) *model.AppError {
+	if channel.IsGroupOrDirect() {
+		return model.NewAppError("SaveChannelPostingRules", "app.channel_posting_rules.dm_gm.app_error", nil, "", http.StatusBadRequest)
+	}
+
+	if appErr := rules.IsValid(); appErr != nil {
+		return appErr
+	}
+
+	value, err := json.Marshal(rules)
+	if err != nil {
+		return model.NewAppError("SaveChannelPostingRules", "app.channel_posting_rules.save.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	if err := a.Srv().Store().System().SaveOrUpdate(&model.System{Name: channelPostingRulesKeyPrefix + channel.Id, Value: string(value)}); err != nil {
+		return model.NewAppError("SaveChannelPostingRules", "app.channel_posting_rules.save.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	if err := a.Srv().channelPostingRulesCache.Remove(channel.Id); err != nil {
+		return model.NewAppError("SaveChannelPostingRules", "app.channel_posting_rules.save.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+	return nil
+}
+
+func isChannelPostingRulesError(appErr *model.AppError) bool {
+	return appErr.Id == "api.post.create_post.slowmode.app_error"
+}
+
+func (a *App) enforceChannelPostingRules(rctx request.CTX, post *model.Post, channel *model.Channel, user *model.User, flags model.CreatePostFlags) (func(), *model.AppError) {
+	noop := func() {}
+	if channel.IsGroupOrDirect() || post.IsSystemMessage() || user.IsBot || flags.FromIncomingWebhook || flags.FromPlugin {
+		return noop, nil
+	}
+
+	rules, appErr := a.GetChannelPostingRules(channel.Id)
+	if appErr != nil {
+		return nil, appErr
+	}
+	if rules.SlowmodeSeconds == 0 {
+		return noop, a.checkChannelPostingRules(rctx, post, channel)
+	}
+
+	// Held until the post is saved. An in-process lock suffices because Mattermax runs single-node.
+	unlock := a.Srv().channelPostingRulesLocks.lock(channel.Id + user.Id)
+	if appErr := a.checkChannelPostingRules(rctx, post, channel); appErr != nil {
+		unlock()
+		return nil, appErr
+	}
+	return unlock, nil
+}
+
+func (a *App) checkChannelPostingRules(rctx request.CTX, post *model.Post, channel *model.Channel) *model.AppError {
+	rules, appErr := a.GetChannelPostingRules(channel.Id)
+	if appErr != nil {
+		return appErr
+	}
+
+	if rules.SlowmodeSeconds == 0 {
+		return nil
+	}
+
+	if ok, _ := a.HasPermissionToChannel(rctx, post.UserId, channel.Id, model.PermissionManageChannelRoles); ok {
+		return nil
+	}
+
+	return a.checkSlowmode(post, channel, rules.SlowmodeSeconds)
+}
+
+func (a *App) checkSlowmode(post *model.Post, channel *model.Channel, slowmodeSeconds int) *model.AppError {
+	interval := int64(slowmodeSeconds) * 1000
+	now := model.GetMillis()
+	lastCreateAt, err := a.Srv().Store().Post().GetLastCreateAtForUserInChannel(channel.Id, post.UserId, now-interval)
+	if err != nil {
+		return model.NewAppError("checkSlowmode", "app.channel_posting_rules.get.app_error", nil, "", http.StatusInternalServerError).Wrap(err)
+	}
+
+	if lastCreateAt == 0 {
+		return nil
+	}
+
+	secondsLeft := (lastCreateAt + interval - now + 999) / 1000
+	return model.NewAppError("createPost", "api.post.create_post.slowmode.app_error", map[string]any{"Seconds": secondsLeft}, "", http.StatusTooManyRequests)
+}
