+
+import {Permissions} from 'mattermost-redux/constants';
+import {createSelector} from 'mattermost-redux/selectors/create_selector';
+import {getChannel} from 'mattermost-redux/selectors/entities/channels';
+import {haveIChannelPermission} from 'mattermost-redux/selectors/entities/roles';
+import {getCurrentUserId} from 'mattermost-redux/selectors/entities/users';
+import {isSystemMessage} from 'mattermost-redux/utils/post_utils';
+
+import Constants from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+import {useChannelPostingRules} from './use_channel_posting_rules';
+
+export function isPostingRulesChannel(channel?: Channel): channel is Channel {
+    return channel?.type === Constants.OPEN_CHANNEL || channel?.type === Constants.PRIVATE_CHANNEL;
+}
+
+function makeGetLastOwnPostAt() {
+    return createSelector(
+        'makeGetLastOwnPostAt',
+        (state: GlobalState) => state.entities.posts.posts as IDMappedObjects<Post>,
+        getCurrentUserId,
+        (_state: GlobalState, channelId: string) => channelId,
+        (posts, userId, channelId) => {
+            let lastPostAt = 0;
+            for (const post of Object.values(posts)) {
+                if (post.channel_id === channelId && post.user_id === userId && !post.failed && !isSystemMessage(post) && post.create_at > lastPostAt) {
+                    lastPostAt = post.create_at;
+                }
+            }
+            return lastPostAt;
+        },
+    );
+}
+
+function useSecondsUntil(timestamp: number) {
+    const [now, setNow] = useState(Date.now);
+
+    useEffect(() => {
+        setNow(Date.now());
+        if (timestamp <= Date.now()) {
+            return undefined;
+        }
+        const interval = setInterval(() => {
+            setNow(Date.now());
+            if (Date.now() >= timestamp) {
+                clearInterval(interval);
+            }
+        }, 1000);
+        return () => clearInterval(interval);
+    }, [timestamp]);
+
+    return Math.max(0, Math.ceil((timestamp - now) / 1000));
+}
+
+export function useSlowmode(channelId: string) {
+    const channel = useSelector((state: GlobalState) => getChannel(state, channelId));
+    const rules = useChannelPostingRules(isPostingRulesChannel(channel) ? channelId : undefined);
+    const slowmodeSeconds = isPostingRulesChannel(channel) ? rules?.slowmode_seconds ?? 0 : 0;
+    const exempt = useSelector((state: GlobalState) => !channel || haveIChannelPermission(state, channel.team_id, channelId, Permissions.MANAGE_CHANNEL_ROLES));
+    const getLastOwnPostAt = useMemo(() => makeGetLastOwnPostAt(), []);
+    const lastOwnPostAt = useSelector((state: GlobalState) => (slowmodeSeconds && !exempt ? getLastOwnPostAt(state, channelId) : 0));
+    const secondsLeft = useSecondsUntil(lastOwnPostAt ? lastOwnPostAt + (slowmodeSeconds * 1000) : 0);
+
+    return {slowmodeSeconds, secondsLeft: Math.min(secondsLeft, slowmodeSeconds)};
+}
+
+export function useSlowmodeNotice(channelId: string, isInEditMode: boolean) {
+    const {secondsLeft} = useSlowmode(channelId);
+    if (isInEditMode || !secondsLeft) {
+        return null;
+    }
+
+    return (
+        <FormattedMessage
+            id='channel_posting_rules.slowmode.blocked'
+            defaultMessage='Slowmode is on: you can post again in {seconds}s'
+            values={{seconds: secondsLeft}}
+        />
+    );
+}
