+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+import {FormattedMessage, useIntl} from 'react-intl';
+
+import {slowmodeOptions} from './posting_rules_options';
+import {useSlowmode} from './use_slowmode';
+
+import './slowmode_indicator.scss';
+
+type Props = {
+    channelId: string;
+};
+
+export default function SlowmodeIndicator({channelId}: Props) {
+    const {formatMessage} = useIntl();
+    const {slowmodeSeconds} = useSlowmode(channelId);
+    const option = slowmodeOptions.find(({value}) => value === slowmodeSeconds);
+
+    if (!slowmodeSeconds || !option) {
+        return null;
+    }
+
+    return (
+        <div
+            className='SlowmodeIndicator'
+            data-testid='slowmode-indicator'
+        >
+            <i className='icon icon-clock-outline'/>
+            <FormattedMessage
+                id='channel_posting_rules.slowmode.indicator'
+                defaultMessage='Slowmode is on: one message every {interval}'
+                values={{interval: formatMessage(option.label, {count: option.count})}}
+            />
+        </div>
+    );
+}
