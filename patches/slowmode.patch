+import {TestHelper} from 'utils/test_helper';
+
+jest.mock('actions/views/create_comment', () => ({
+    ...jest.requireActual('actions/views/create_comment'),
+    onSubmit: jest.fn(() => () => Promise.resolve({data: true})),
+}));
+
+const mockedOnSubmit = jest.mocked(onSubmit);
+
+const currentUserId = 'current_user_id';
+const now = new Date('2026-11-12T12:00:00Z').getTime();
+
+function makeState(channelId: string, channelType: ChannelType, channelPermissions: string[], lastOwnPostAt?: number) {
+    return {
+        entities: {
+            general: {
+                config: {PostPriority: 'false', ExperimentalTimezone: 'false', EnableCustomEmoji: 'false', AllowSyncedDrafts: 'false'},
+                license: {IsLicensed: 'false'},
+            },
+            channels: {
+                currentChannelId: channelId,
+                channels: {
+                    [channelId]: TestHelper.getChannelMock({id: channelId, team_id: 'team_id', type: channelType, display_name: 'Town'}),
+                },
+                stats: {[channelId]: {member_count: 2}},
+                roles: {[channelId]: new Set(['channel_user'])},
+            },
+            posts: {
+                posts: lastOwnPostAt ? {
+                    own_post: TestHelper.getPostMock({id: 'own_post', channel_id: channelId, user_id: currentUserId, create_at: lastOwnPostAt, type: ''}),
+                    other_post: TestHelper.getPostMock({id: 'other_post', channel_id: channelId, user_id: 'other_user', create_at: now - 1000, type: ''}),
+                } : {},
+            },
+            roles: {
+                roles: {
+                    system_user: {permissions: [Permissions.CREATE_POST]},
+                    channel_user: {permissions: channelPermissions},
+                },
+            },
+            teams: {
+                currentTeamId: 'team_id',
+                teams: {team_id: TestHelper.getTeamMock({id: 'team_id'})},
+                myMembers: {team_id: TestHelper.getTeamMembershipMock({team_id: 'team_id', roles: ''})},
+            },
+            users: {
+                currentUserId,
+                profiles: {[currentUserId]: TestHelper.getUserMock({id: currentUserId, roles: 'system_user'})},
+                statuses: {[currentUserId]: 'online'},
+            },
+        },
+        websocket: {connectionId: 'connection_id'},
+    };
+}
+
+function renderComposer(channelId: string, state: ReturnType<typeof makeState>) {
+    return renderWithContext(
+        <AdvancedTextEditor
+            location={Locations.CENTER}
+            channelId={channelId}
+            rootId=''
+            isThreadView={false}
+        />,
+        state,
+    );
+}
+
+async function flushRulesRequest() {
+    await act(async () => {
+        await Promise.resolve();
+    });
+}
+
+async function typeAndSend(message: string) {
+    fireEvent.input(screen.getByTestId('post_textbox'), {target: {value: message}});
+    await act(async () => {
+        fireEvent.click(screen.getByTestId('SendMessageButton'));
+    });
+}
+
+describe('slowmode in the composer', () => {
+    let getRules: jest.SpyInstance;
+
+    beforeEach(() => {
+        jest.useFakeTimers({now, doNotFake: ['queueMicrotask', 'nextTick']});
+        mockedOnSubmit.mockClear();
+        getRules = jest.spyOn(Client4, 'getChannelPostingRules').mockResolvedValue({slowmode_seconds: 30});
+    });
+
+    afterEach(() => {
+        getRules.mockRestore();
+        jest.useRealTimers();
+    });
+
+    it('shows that slowmode is on and blocks sending until the interval since the last own post has passed', async () => {
+        renderComposer('slow_channel', makeState('slow_channel', 'O', [Permissions.CREATE_POST], now - 10000));
+        await flushRulesRequest();
+
+        expect(screen.getByText('Slowmode is on: one message every 30 seconds')).toBeInTheDocument();
+        expect(screen.getByText('Slowmode is on: you can post again in 20s')).toBeInTheDocument();
+
+        await typeAndSend('too soon');
+        expect(mockedOnSubmit).not.toHaveBeenCalled();
+
+        act(() => {
+            jest.advanceTimersByTime(5000);
+        });
+        expect(screen.getByText('Slowmode is on: you can post again in 15s')).toBeInTheDocument();
+
+        act(() => {
+            jest.advanceTimersByTime(15000);
+        });
+        expect(screen.queryByText(/you can post again/)).not.toBeInTheDocument();
+
+        await typeAndSend('on time');
+        expect(mockedOnSubmit).toHaveBeenCalledWith('slow_channel', '', expect.objectContaining({message: 'on time'}), expect.anything(), undefined);
+    });
+
+    it('does not block a user whose last post is older than the interval', async () => {
+        renderComposer('quiet_channel', makeState('quiet_channel', 'O', [Permissions.CREATE_POST], now - 31000));
+        await flushRulesRequest();
+
+        expect(screen.getByText('Slowmode is on: one message every 30 seconds')).toBeInTheDocument();
+        expect(screen.queryByText(/you can post again/)).not.toBeInTheDocument();
+    });
+
+    it('does not block channel admins', async () => {
+        renderComposer('admin_channel', makeState('admin_channel', 'O', [Permissions.CREATE_POST, Permissions.MANAGE_CHANNEL_ROLES], now - 1000));
+        await flushRulesRequest();
+
+        expect(screen.getByText('Slowmode is on: one message every 30 seconds')).toBeInTheDocument();
+        expect(screen.queryByText(/you can post again/)).not.toBeInTheDocument();
+
+        await typeAndSend('admin message');
+        expect(mockedOnSubmit).toHaveBeenCalled();
+    });
+
+    it('does not apply to direct messages', async () => {
+        renderComposer('dm_channel', makeState('dm_channel', 'D', [Permissions.CREATE_POST], now - 1000));
+        await flushRulesRequest();
+
+        expect(getRules).not.toHaveBeenCalled();
+        expect(screen.queryByTestId('slowmode-indicator')).not.toBeInTheDocument();
+        expect(screen.queryByText(/you can post again/)).not.toBeInTheDocument();
+    });
+});
