+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {useEffect, useSyncExternalStore} from 'react';
+
+import type {ChannelPostingRules} from '@mattermost/types/channel_posting_rules';
+
+import {Client4} from 'mattermost-redux/client';
+
+const rulesByChannel = new Map<string, ChannelPostingRules>();
+const requestsByChannel = new Map<string, Promise<void>>();
+const listeners = new Set<() => void>();
+
+function subscribe(listener: () => void) {
+    listeners.add(listener);
+    return () => {
+        listeners.delete(listener);
+    };
+}
+
+export function setChannelPostingRules(channelId: string, rules: ChannelPostingRules) {
+    rulesByChannel.set(channelId, rules);
+    listeners.forEach((listener) => listener());
+}
+
+function fetchChannelPostingRules(channelId: string) {
+    if (!requestsByChannel.has(channelId)) {
+        const request = Client4.getChannelPostingRules(channelId).
+            then((rules) => setChannelPostingRules(channelId, rules), () => undefined).
+            finally(() => requestsByChannel.delete(channelId));
+        requestsByChannel.set(channelId, request);
+    }
+}
+
+export function useChannelPostingRules(channelId?: string): ChannelPostingRules | undefined {
+    const rules = useSyncExternalStore(subscribe, () => (channelId ? rulesByChannel.get(channelId) : undefined));
+
+    useEffect(() => {
+        if (channelId) {
+            fetchChannelPostingRules(channelId);
+        }
+    }, [channelId]);
+
+    return rules;
+}
