+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import isEqual from 'lodash/isEqual';
+import React, {useCallback, useEffect, useState} from 'react';
+import {useIntl} from 'react-intl';
+
+import type {ChannelPostingRules} from '@mattermost/types/channel_posting_rules';
+import type {Channel} from '@mattermost/types/channels';
+import type {ServerError} from '@mattermost/types/errors';
+
+import {Client4} from 'mattermost-redux/client';
+
+import DropdownInput from 'components/dropdown_input';
+import type {SaveChangesPanelState} from 'components/widgets/modals/components/save_changes_panel';
+import SaveChangesPanel from 'components/widgets/modals/components/save_changes_panel';
+
+import {slowmodeOptions} from './posting_rules_options';
+import type {PostingRuleOption} from './posting_rules_options';
+import {setChannelPostingRules, useChannelPostingRules} from './use_channel_posting_rules';
+
+import './channel_settings_moderation_tab.scss';
+
+const DEFAULT_RULES: ChannelPostingRules = {slowmode_seconds: 0};
+
+type Props = {
+    channel: Channel;
+    setAreThereUnsavedChanges?: (unsaved: boolean) => void;
+    showTabSwitchError?: boolean;
+};
+
+type SectionProps = {
+    name: string;
+    heading: string;
+    subheading: string;
+    options: PostingRuleOption[];
+    value: number;
+    onChange: (value: number) => void;
+};
+
+function PostingRuleSection({name, heading, subheading, options, value, onChange}: SectionProps) {
+    const {formatMessage} = useIntl();
+    const toSelectOption = (option: PostingRuleOption) => ({value: String(option.value), label: formatMessage(option.label, {count: option.count})});
+    const selected = options.find((option) => option.value === value) ?? options[0];
+
+    return (
+        <div className='ChannelSettingsModal__moderationTab__section'>
+            <div className='ChannelSettingsModal__moderationTab__text'>
+                <label
+                    className='Input_legend'
+                    htmlFor={name}
+                >
+                    {heading}
+                </label>
+                <span className='Input_subheading'>{subheading}</span>
+            </div>
+            <div className='ChannelSettingsModal__moderationTab__select'>
+                <DropdownInput
+                    name={name}
+                    testId={name}
+                    inputId={name}
+                    options={options.map(toSelectOption)}
+                    value={toSelectOption(selected)}
+                    onChange={(option) => onChange(Number(option.value))}
+                    isClearable={false}
+                    isSearchable={false}
+                />
+            </div>
+        </div>
+    );
+}
+
+export default function ChannelSettingsModerationTab({channel, setAreThereUnsavedChanges, showTabSwitchError}: Props) {
+    const {formatMessage} = useIntl();
+    const savedRules = useChannelPostingRules(channel.id) ?? DEFAULT_RULES;
+    const [editedRules, setEditedRules] = useState<ChannelPostingRules>();
+    const [panelState, setPanelState] = useState<SaveChangesPanelState>();
+    const [saving, setSaving] = useState(false);
+    const [saveError, setSaveError] = useState('');
+
+    const rules = editedRules ?? savedRules;
+    const hasChanges = !isEqual(rules, savedRules);
+    const showPanel = hasChanges || panelState === 'saved';
+
+    useEffect(() => {
+        setAreThereUnsavedChanges?.(hasChanges);
+    }, [hasChanges, setAreThereUnsavedChanges]);
+
+    const updateRules = useCallback((patch: Partial<ChannelPostingRules>) => {
+        setEditedRules({...rules, ...patch});
+        setPanelState('editing');
+        setSaveError('');
+    }, [rules]);
+
+    const handleSave = useCallback(async () => {
+        setSaving(true);
+        try {
+            const saved = await Client4.updateChannelPostingRules(channel.id, rules);
+            setChannelPostingRules(channel.id, saved);
+            setEditedRules(undefined);
+            setPanelState('saved');
+        } catch (error) {
+            setSaveError((error as ServerError).message);
+            setPanelState('error');
+        } finally {
+            setSaving(false);
+        }
+    }, [channel.id, rules]);
+
+    const handleCancel = useCallback(() => {
+        setEditedRules(undefined);
+        setPanelState(undefined);
+        setSaveError('');
+    }, []);
+
+    const handleClose = useCallback(() => setPanelState(undefined), []);
+
+    return (
+        <div
+            className={`ChannelSettingsModal__moderationTab${showPanel ? ' ChannelSettingsModal__moderationTab--with-save-panel' : ''}`}
+            data-testid='channel-settings-moderation-tab'
+        >
+            <PostingRuleSection
+                name='channelSlowmode'
+                heading={formatMessage({id: 'channel_settings.moderation.slowmode.heading', defaultMessage: 'Slowmode'})}
+                subheading={formatMessage({id: 'channel_settings.moderation.slowmode.subheading', defaultMessage: 'Members must wait this long between messages, including replies. Channel admins, team admins and system admins are exempt.'})}
+                options={slowmodeOptions}
+                value={rules.slowmode_seconds}
+                onChange={(value) => updateRules({slowmode_seconds: value})}
+            />
+            {showPanel && (
+                <SaveChangesPanel
+                    handleSubmit={handleSave}
+                    handleCancel={handleCancel}
+                    handleClose={handleClose}
+                    tabChangeError={showTabSwitchError}
+                    state={showTabSwitchError ? 'error' : panelState}
+                    saving={saving}
+                    customErrorMessage={saveError}
+                    cancelButtonText={formatMessage({id: 'channel_settings.save_changes_panel.reset', defaultMessage: 'Reset'})}
+                />
+            )}
+        </div>
+    );
+}
