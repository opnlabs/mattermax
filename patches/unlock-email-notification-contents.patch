+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import AdminDefinition from './admin_definition';
+import type {AdminDefinitionSubSectionSchema} from './types';
+
+describe('AdminDefinition - Email Notification Contents', () => {
+    test('is shown without a license', () => {
+        const schema = AdminDefinition.site.subsections.notifications.schema as AdminDefinitionSubSectionSchema;
+        const settings = 'settings' in schema && schema.settings ? schema.settings : [];
+        const setting = settings.find((s) => s.key === 'EmailSettings.EmailNotificationContentsType');
+        const isHidden = setting?.isHidden;
+        const hidden = typeof isHidden === 'function' ? isHidden({}, {}, {IsLicensed: 'false'}) : Boolean(isHidden);
+
+        expect(setting).toBeDefined();
+        expect(hidden).toBe(false);
+    });
+});
