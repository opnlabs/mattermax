+func TestSendNotificationEmailContentsTypeWithoutLicense(t *testing.T) {
+	th := Setup(t).InitBasic(t)
+	th.App.Srv().SetLicense(nil)
+	require.Nil(t, th.App.Srv().License())
+	th.ConfigureInbucketMail()
+
+	recipient, appErr := th.App.CreateUser(th.Context, &model.User{
+		Email:    strings.ToLower(model.NewId()) + "@localhost",
+		Username: "un_" + model.NewId(),
+		Password: "Password1!",
+	})
+	require.Nil(t, appErr)
+
+	sendAndReceive := func(t *testing.T, contentsType string) (*model.Post, mail.JSONMessageInbucket) {
+		t.Helper()
+
+		require.NoError(t, mail.DeleteMailBox(recipient.Email))
+		th.App.UpdateConfig(func(cfg *model.Config) {
+			*cfg.EmailSettings.EmailNotificationContentsType = contentsType
+		})
+
+		post := th.CreatePost(t, th.BasicChannel)
+		notification := buildTestPostNotification(post, th.BasicChannel, th.BasicUser)
+		_, err := th.App.sendNotificationEmail(th.Context, notification, recipient, th.BasicTeam, nil)
+		require.NoError(t, err)
+
+		var mailbox mail.JSONMessageHeaderInbucket
+		require.NoError(t, mail.RetryInbucket(5, func() error {
+			var innerErr error
+			mailbox, innerErr = mail.GetMailBox(recipient.Email)
+			return innerErr
+		}))
+		require.Len(t, mailbox, 1)
+
+		message, err := mail.GetMessageFromMailbox(recipient.Email, mailbox[0].ID)
+		require.NoError(t, err)
+		return post, message
+	}
+
+	t.Run("full contents include the message", func(t *testing.T) {
+		post, message := sendAndReceive(t, model.EmailNotificationContentsFull)
+		require.Contains(t, message.Body.HTML, post.Message)
+	})
+
+	t.Run("generic contents omit the message", func(t *testing.T) {
+		post, message := sendAndReceive(t, model.EmailNotificationContentsGeneric)
+		require.Contains(t, message.Body.HTML, th.BasicUser.Username)
+		require.NotContains(t, message.Body.HTML, post.Message)
+		require.NotContains(t, message.Body.Text, post.Message)
+	})
+}
