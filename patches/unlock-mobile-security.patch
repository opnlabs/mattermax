@@ -0,0 +1,51 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {ClientLicense} from '@mattermost/types/config';
+
+import {RESOURCE_KEYS} from 'mattermost-redux/constants/permissions_sysconsole';
+
+import AdminDefinition from './admin_definition';
+import type {AdminDefinitionConfigSchemaSection, AdminDefinitionSetting, Check} from './types';
+
+describe('AdminDefinition - Mobile Security without a license', () => {
+    const unlicensed = {IsLicensed: 'false'} as ClientLicense;
+    const consoleAccess = {read: {[RESOURCE_KEYS.ENVIRONMENT.MOBILE_SECURITY]: true}, write: {}};
+    const mobileSecurity = AdminDefinition.environment.subsections.mobile_security;
+
+    const isHidden = (check?: Check) => (typeof check === 'function' ? check({}, {}, unlicensed, false, consoleAccess) : Boolean(check));
+
+    const generalSettings = () => {
+        const sections = 'sections' in mobileSecurity.schema! ? mobileSecurity.schema.sections : [];
+        const general = sections!.find((section: AdminDefinitionConfigSchemaSection) => section.key === 'MobileSecuritySettings.General');
+        return general?.settings || [];
+    };
+
+    const findSetting = (key: string) => generalSettings().find((setting: AdminDefinitionSetting) => setting.key === key);
+
+    test('shows the Mobile Security page', () => {
+        expect(isHidden(mobileSecurity.isHidden)).toBe(false);
+    });
+
+    test('has no separate feature discovery page', () => {
+        expect(AdminDefinition.environment.subsections).not.toHaveProperty('mobile_security_feature_discovery');
+    });
+
+    test.each([
+        'NativeAppSettings.MobileEnableBiometrics',
+        'NativeAppSettings.MobilePreventScreenCapture',
+        'NativeAppSettings.MobileJailbreakProtection',
+    ])('shows %s', (key) => {
+        const setting = findSetting(key);
+
+        expect(setting).toBeDefined();
+        expect(isHidden(setting?.isHidden)).toBe(false);
+    });
+
+    test.each([
+        'NativeAppSettings.MobileEnableSecureFilePreview',
+        'NativeAppSettings.MobileAllowPdfLinkNavigation',
+    ])('keeps %s hidden because the mobile app checks the license itself', (key) => {
+        expect(isHidden(findSetting(key)?.isHidden)).toBe(true);
+    });
+});
