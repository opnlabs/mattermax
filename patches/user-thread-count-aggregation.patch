+// BenchmarkUserThreadCountsHistory checks real stored roots/replies and the
+// returned totals/page. Parallel results are amortized time/op, not latency.
+func BenchmarkUserThreadCountsHistory(b *testing.B) {
+	for _, priority := range []bool{false, true} {
+		b.Run(fmt.Sprintf("priority=%t", priority), func(b *testing.B) {
+			th := SetupConfig(b, func(cfg *model.Config) {
+				*cfg.ServiceSettings.PostPriority = priority
+				*cfg.ServiceSettings.SiteURL = "http://localhost:8065"
+			}).InitBasic(b)
+			pool := th.SQLStore.GetReplica().DB()
+			if pool != th.SQLStore.GetMaster().DB() {
+				b.Fatal("benchmark requires one pool")
+			}
+			oldOpen, oldIdle := pool.Stats().MaxOpenConnections, *th.App.Config().SqlSettings.MaxIdleConns
+			pool.SetMaxOpenConns(8)
+			pool.SetMaxIdleConns(8)
+			b.Cleanup(func() { pool.SetMaxOpenConns(oldOpen); pool.SetMaxIdleConns(oldIdle) })
+			for _, size := range []int{0, 10, 1000} {
+				b.Run(fmt.Sprintf("threads=%d", size), func(b *testing.B) {
+					user := th.CreateUser(b)
+					if _, err := th.App.Srv().Store().Team().SaveMember(th.Context, &model.TeamMember{TeamId: th.BasicTeam.Id, UserId: user.Id, SchemeUser: true}, -1); err != nil {
+						b.Fatal(err)
+					}
+					if _, err := th.App.Srv().Store().Channel().SaveMember(th.Context, &model.ChannelMember{ChannelId: th.BasicChannel.Id, UserId: user.Id, SchemeUser: true, NotifyProps: model.GetDefaultChannelNotifyProps()}); err != nil {
+						b.Fatal(err)
+					}
+					roots, replies := make([]*model.Post, size), make([]*model.Post, size)
+					members := make([]*model.ThreadMembership, size)
+					indices := make(map[string]int, size)
+					var unread, mentions, urgentMentions int64
+					for i := range roots {
+
+						stamp := int64(1000000 + i*2)
+						roots[i] = &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "count benchmark", CreateAt: stamp}
+						replies[i] = &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "reply", CreateAt: stamp + 1}
+						viewed := int64(0)
+						if i%2 == 0 {
+							viewed = stamp + 2
+						} else {
+							unread++
+						}
+						members[i] = &model.ThreadMembership{UserId: user.Id, Following: true, LastViewed: viewed, UnreadMentions: int64(i % 3)}
+
+						mentions += int64(i % 3)
+						if i%4 == 0 && priority {
+							urgentMentions += int64(i % 3)
+						}
+					}
+					if size > 0 {
+						if _, _, err := th.App.Srv().Store().Post().SaveMultiple(th.Context, roots); err != nil {
+							b.Fatal(err)
+						}
+						for i, root := range roots {
+							replies[i].RootId = root.Id
+							members[i].PostId = root.Id
+							indices[root.Id] = i
+						}
+						if _, _, err := th.App.Srv().Store().Post().SaveMultiple(th.Context, replies); err != nil {
+							b.Fatal(err)
+						}
+						if _, err := th.App.Srv().Store().Thread().SaveMultipleMemberships(members); err != nil {
+							b.Fatal(err)
+						}
+						if priority {
+							for i, root := range roots {
+								if i%4 != 0 {
+									continue
+								}
+								if _, err := th.App.Srv().Store().PostPriority().Save(&model.PostPriority{PostId: root.Id, ChannelId: root.ChannelId, Priority: model.NewPointer(model.PostPriorityUrgent)}); err != nil {
+									b.Fatal(err)
+								}
+							}
+						}
+					}
+					for _, responseMode := range []string{"page", "totals", "threads_only"} {
+						totalsOnly, threadsOnly := responseMode == "totals", responseMode == "threads_only"
+						name := responseMode
+						b.Run(name, func(b *testing.B) {
+							modes := []string{"serial"}
+							if size == 1000 {
+								modes = append(modes, "parallel")
+							}
+							for _, mode := range modes {
+								b.Run(mode, func(b *testing.B) {
+									options := model.GetUserThreadsOpts{PageSize: 30, TotalsOnly: totalsOnly, ThreadsOnly: threadsOnly}
+									check := func(result *model.Threads, err *model.AppError) {
+										if err != nil {
+											b.Fatal(err)
+										}
+										expectedTotal, expectedUnread, expectedMentions, expectedUrgent := int64(size), unread, mentions, urgentMentions
+										if threadsOnly {
+											expectedTotal, expectedUnread, expectedMentions, expectedUrgent = 0, 0, 0, 0
+										}
+										if result == nil || result.Total != expectedTotal || result.TotalUnreadThreads != expectedUnread || result.TotalUnreadMentions != expectedMentions || result.TotalUnreadUrgentMentions != expectedUrgent {
+											b.Fatalf("incorrect totals: %#v", result)
+										}
+										if totalsOnly {
+											if result.Threads != nil {
+												b.Fatal("totals-only fetched page")
+											}
+											return
+										}
+										if len(result.Threads) != min(size, 30) {
+											b.Fatal("incorrect page size")
+										}
+										for _, thread := range result.Threads {
+											i, ok := indices[thread.PostId]
+											if !ok || thread.Post == nil || thread.Post.Id != thread.PostId || thread.Post.Message != "count benchmark" || thread.ReplyCount != 1 || thread.LastViewedAt != members[i].LastViewed || thread.UnreadMentions != members[i].UnreadMentions || thread.IsUrgent != (priority && i%4 == 0) {
+												b.Fatalf("incorrect page: %#v", thread)
+											}
+										}
+									}
+									rctx := th.Context.WithSession(&model.Session{UserId: user.Id})
+									call := func(ctx request.CTX) { check(th.App.GetThreadsForUser(ctx, user.Id, th.BasicTeam.Id, options)) }
+									call(rctx)
+									b.ReportAllocs()
+									b.ResetTimer()
+									if mode == "serial" {
+										for range b.N {
+											call(rctx)
+										}
+									} else {
+										b.RunParallel(func(pb *testing.PB) {
+											ctx := th.Context.WithSession(&model.Session{UserId: user.Id})
+											for pb.Next() {
+												call(ctx)
+											}
+										})
+									}
+								})
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
