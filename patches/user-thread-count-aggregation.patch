+func TestUserThreadCountFlags(t *testing.T) {
+	for _, threadsOnly := range []bool{false, true} {
+		for _, totalsOnly := range []bool{false, true} {
+			for _, unread := range []bool{false, true} {
+				t.Run(fmt.Sprintf("threadsOnly=%t/totalsOnly=%t/unread=%t", threadsOnly, totalsOnly, unread), func(t *testing.T) {
+					th := SetupConfigWithStoreMock(t, func(cfg *model.Config) { *cfg.ServiceSettings.PostPriority = false })
+					user, team, root := model.NewId(), model.NewId(), model.NewId()
+					options := model.GetUserThreadsOpts{ThreadsOnly: threadsOnly, TotalsOnly: totalsOnly, Unread: unread}
+					threadStore := &mocks.ThreadStore{}
+					th.App.Srv().Store().(*mocks.Store).On("Thread").Return(threadStore)
+					if !threadsOnly {
+						// Page data from the count DTO must never replace the separate page result.
+						countDTO := &model.Threads{Total: 42, TotalUnreadThreads: 5, TotalUnreadMentions: 7, Threads: []*model.ThreadResponse{{PostId: "counts-are-not-page-data"}}}
+						threadStore.On("GetThreadCountsForUser", user, team, options, false).Return(countDTO, nil).Once()
+					}
+					if !totalsOnly {
+						page := []*model.ThreadResponse{{PostId: root, Post: &model.Post{Id: root, ChannelId: model.NewId(), UserId: user, Message: "thread page"}}}
+						threadStore.On("GetThreadsForUser", mock.Anything, user, team, options).Return(page, nil).Once()
+					}
+					got, err := th.App.GetThreadsForUser(th.Context, user, team, options)
+					require.Nil(t, err)
+					require.NotNil(t, got)
+					if threadsOnly {
+						require.Zero(t, got.Total)
+						require.Zero(t, got.TotalUnreadThreads)
+						require.Zero(t, got.TotalUnreadMentions)
+					} else {
+						wantTotal := int64(42)
+						if unread {
+							wantTotal = 5
+						}
+						require.Equal(t, wantTotal, got.Total)
+						require.Equal(t, int64(5), got.TotalUnreadThreads)
+						require.Equal(t, int64(7), got.TotalUnreadMentions)
+					}
+					require.Zero(t, got.TotalUnreadUrgentMentions)
+					if totalsOnly {
+						require.Nil(t, got.Threads)
+					} else {
+						require.Len(t, got.Threads, 1)
+						require.Equal(t, root, got.Threads[0].PostId)
+						require.Equal(t, "thread page", got.Threads[0].Post.Message)
+					}
+					threadStore.AssertExpectations(t)
+				})
+			}
+		}
+	}
+}
