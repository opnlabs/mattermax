+func legacyUserThreadCounts(st store.ThreadStore, user, team string, opts model.GetUserThreadsOpts, urgent bool) (*model.Threads, error) {
+	var result model.Threads
+	var group errgroup.Group
+	group.Go(func() error {
+		value, err := st.GetTotalUnreadThreads(user, team, opts)
+		result.TotalUnreadThreads = value
+		return err
+	})
+	if !opts.Unread {
+		group.Go(func() error { value, err := st.GetTotalThreads(user, team, opts); result.Total = value; return err })
+	}
+	group.Go(func() error {
+		value, err := st.GetTotalUnreadMentions(user, team, opts)
+		result.TotalUnreadMentions = value
+		return err
+	})
+	if urgent {
+		group.Go(func() error {
+			value, err := st.GetTotalUnreadUrgentMentions(user, team, opts)
+			result.TotalUnreadUrgentMentions = value
+			return err
+		})
+	}
+	if err := group.Wait(); err != nil {
+		return nil, err
+	}
+	if opts.Unread {
+		result.Total = result.TotalUnreadThreads
+	}
+	return &result, nil
+}
