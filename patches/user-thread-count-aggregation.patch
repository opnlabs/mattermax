+func (s *RetryLayerThreadStore) GetThreadCountsForUser(userID string, teamID string, opts model.GetUserThreadsOpts, includeUrgentMentionCount bool) (*model.Threads, error) {
+
+	tries := 0
+	for {
+		result, err := s.ThreadStore.GetThreadCountsForUser(userID, teamID, opts, includeUrgentMentionCount)
+		if err == nil {
+			return result, nil
+		}
+		if !isRepeatableError(err) {
+			return result, err
+		}
+		tries++
+		if tries >= 3 {
+			err = errors.Wrap(err, "giving up after 3 consecutive repeatable transaction failures")
+			return result, err
+		}
+		timepkg.Sleep(100 * timepkg.Millisecond)
+	}
+
+}
