+// GetThreadCountsForUser computes the counts used by the user-thread response.
+// The existing count methods remain available to callers that need one value.
+func (s *SqlThreadStore) GetThreadCountsForUser(userID, teamID string, opts model.GetUserThreadsOpts, includeUrgentMentionCount bool) (*model.Threads, error) {
+	query := s.getTotalThreadsQuery(userID, teamID, opts).
+		Column("COUNT(ThreadMemberships.PostId) FILTER (WHERE ThreadMemberships.LastViewed < Threads.LastReplyAt) AS UnreadCount").
+		Column("COALESCE(SUM(ThreadMemberships.UnreadMentions), 0) AS Mentions")
+	if includeUrgentMentionCount {
+		query = query.LeftJoin("PostsPriority ON PostsPriority.PostId = ThreadMemberships.PostId").
+			Column("COALESCE(SUM(CASE WHEN PostsPriority.Priority = ? THEN ThreadMemberships.UnreadMentions ELSE 0 END), 0) AS UrgentMentions", model.PostPriorityUrgent)
+	} else {
+		query = query.Column("0 AS UrgentMentions")
+	}
+	var row struct{ Count, UnreadCount, Mentions, UrgentMentions int64 }
+	if err := s.GetReplica().GetBuilder(&row, query); err != nil {
+		return nil, errors.Wrapf(err, "failed to get thread counts for user id=%s", userID)
+	}
+	result := &model.Threads{
+		Total:                     row.Count,
+		TotalUnreadThreads:        row.UnreadCount,
+		TotalUnreadMentions:       row.Mentions,
+		TotalUnreadUrgentMentions: row.UrgentMentions,
+	}
+	if opts.Unread {
+		result.Total = result.TotalUnreadThreads
+	}
+	return result, nil
+}
