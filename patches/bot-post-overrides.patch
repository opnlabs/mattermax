@@ -242,6 +242,10 @@ func (a *App) CreatePost(rctx request.CTX, post *model.Post, channel *model.Chan
 
 	silentRequested := flags.SilentNotification
 
+	// Mattermax: bot accounts keep per-post name and icon overrides; restored
+	// below once the author is known to be a bot.
+	botDisplayOverrides := captureBotDisplayOverrides(post)
+
 	post.SanitizeProps()
 
 	var pchan chan store.StoreResult[*model.PostList]
@@ -339,6 +343,11 @@ func (a *App) CreatePost(rctx request.CTX, post *model.Post, channel *model.Chan
 		if flags.WebhookDisplayName != "" {
 			post.AddProp(model.PostPropsWebhookDisplayName, flags.WebhookDisplayName)
 		}
+	} else if user.IsBot {
+		// Mattermax: unlike upstream, a bot account may set from_webhook and
+		// the override props on its own posts, as it could before v12. Only
+		// real bot accounts qualify; a user's personal access token does not.
+		restoreBotDisplayOverrides(post, botDisplayOverrides)
 	}
 
 	// Strip mm_blocks_actions from posts that are neither bot-authored nor
