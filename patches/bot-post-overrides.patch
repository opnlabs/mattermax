@@ -0,0 +1,47 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+// botDisplayOverrideProps are the post props a bot account may set to change
+// how a single post is displayed. from_webhook is included because every
+// render path only honours the overrides on posts that carry it.
+var botDisplayOverrideProps = []string{
+	model.PostPropsFromWebhook,
+	model.PostPropsOverrideUsername,
+	model.PostPropsOverrideIconURL,
+	model.PostPropsOverrideIconEmoji,
+	model.PostPropsWebhookDisplayName,
+}
+
+// captureBotDisplayOverrides returns the display-override props on post
+// before SanitizeProps strips them. Only non-empty strings are kept, and
+// from_webhook only when it is "true".
+func captureBotDisplayOverrides(post *model.Post) map[string]string {
+	overrides := map[string]string{}
+	for _, key := range botDisplayOverrideProps {
+		value, ok := post.GetProp(key).(string)
+		if !ok || value == "" {
+			continue
+		}
+		if key == model.PostPropsFromWebhook && value != "true" {
+			continue
+		}
+		overrides[key] = value
+	}
+	return overrides
+}
+
+// restoreBotDisplayOverrides puts back the props captured by
+// captureBotDisplayOverrides. CreatePost calls it only for bot accounts, so
+// regular users, including those posting with a personal access token, still
+// cannot override their name or icon.
+func restoreBotDisplayOverrides(post *model.Post, overrides map[string]string) {
+	for key, value := range overrides {
+		post.AddProp(key, value)
+	}
+}
diff --git a/server/channels/app/post.go b/server/channels/app/post.go
index becdef96d86b..c22d037e46a6 100644
--- a/server/channels/app/post.go
