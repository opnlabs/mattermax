+func TestUsersBatchExportWithoutLicense(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t).InitBasic(t)
+	require.Nil(t, th.App.Srv().RemoveLicense())
+	require.Nil(t, th.App.Srv().License())
+	rctx := th.Context.WithSession(&model.Session{UserId: th.BasicUser.Id})
+	require.Nil(t, th.App.StartUsersBatchExport(rctx, &model.UserReportOptions{
+		ReportingBaseOptions: model.ReportingBaseOptions{DateRange: model.ReportDurationAllTime},
+		SearchTerm:           th.BasicUser.Username,
+	}, 0, model.GetMillis()))
+	pending, appErr := th.App.Srv().Jobs.GetJobsByTypeAndStatus(rctx, model.JobTypeExportUsersToCSV, model.JobStatusPending)
+	require.Nil(t, appErr)
+	var exportJob *model.Job
+	for _, job := range pending {
+		if job.Data["requesting_user_id"] == th.BasicUser.Id {
+			exportJob = job
+		}
+	}
+	require.NotNil(t, exportJob)
+	worker := export_users_to_csv.MakeWorker(th.App.Srv().Jobs, th.App.Srv().Store(), th.App)
+	worker.(interface{ DoJob(*model.Job) }).DoJob(exportJob)
+	completed, appErr := th.App.Srv().Jobs.GetJob(rctx, exportJob.Id)
+	require.Nil(t, appErr)
+	require.Equal(t, model.JobStatusSuccess, completed.Status, completed.Data)
+	data, appErr := th.App.ReadFile(makeCompiledFilePath(exportJob.Id, "csv"))
+	require.Nil(t, appErr)
+	rows, err := csv.NewReader(bytes.NewReader(data)).ReadAll()
+	require.NoError(t, err)
+	require.Len(t, rows, 2)
+	require.Equal(t, []string{"Id", "Username", "Email", "CreateAt", "Name", "Roles", "LastLogin", "LastStatusAt", "LastPostDate", "DaysActive", "TotalPosts", "ChannelCount", "Teams", "DeletedAt"}, rows[0])
+	require.Equal(t, th.BasicUser.Id, rows[1][0])
+	require.Equal(t, th.BasicUser.Username, rows[1][1])
+	require.Equal(t, th.BasicUser.Email, rows[1][2])
+}
+
+func TestSaveCSVChunkEscapesFormulas(t *testing.T) {
+	mainHelper.Parallel(t)
+	th := Setup(t)
+	prefix := model.NewId()
+	var reports []model.ReportableObject
+	for _, trigger := range []string{"=", "+", "-", "@", "\t", "\r"} {
+		reports = append(reports, &model.UserReport{
+			User: model.User{
+				Id:        trigger + "id",
+				Username:  trigger + "username",
+				Email:     trigger + "user@example.com",
+				FirstName: trigger + "first",
+				LastName:  "last",
+			},
+			Teams: trigger + "team",
+		})
+	}
+	reports = append(reports, &model.UserReport{User: model.User{Id: "plain", Username: "user-name", Email: "a=b@example.com"}})
+	require.Nil(t, th.App.SaveReportChunk("csv", prefix, 0, reports))
+	data, appErr := th.App.ReadFile(makeFilePath(prefix, 0, "csv"))
+	require.Nil(t, appErr)
+	rows, err := csv.NewReader(bytes.NewReader(data)).ReadAll()
+	require.NoError(t, err)
+	require.Len(t, rows, 7)
+	for i, trigger := range []string{"=", "+", "-", "@", "\t", "\r"} {
+		require.Equal(t, "'"+trigger+"id", rows[i][0])
+		require.Equal(t, "'"+trigger+"username", rows[i][1])
+		require.Equal(t, "'"+trigger+"user@example.com", rows[i][2])
+		require.Equal(t, "'"+trigger+"first last", rows[i][4])
+		require.Equal(t, "'"+trigger+"team", rows[i][12])
+	}
+	require.Equal(t, []string{"plain", "user-name", "a=b@example.com"}, rows[6][:3])
+}
