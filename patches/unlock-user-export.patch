+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {openModal} from 'actions/views/modals';
+
+import {renderWithContext, screen, userEvent} from 'tests/react_testing_utils';
+import {ModalIdentifiers} from 'utils/constants';
+
+import {ExportUserDataModal} from './export_user_data_modal';
+
+import {SystemUsersExport} from './index';
+
+jest.mock('actions/views/modals', () => ({
+    openModal: jest.fn(() => ({type: 'OPEN_MODAL'})),
+}));
+
+describe('SystemUsersExport without a license', () => {
+    test('opens the export confirmation instead of an upgrade dialog', async () => {
+        renderWithContext(
+            <SystemUsersExport
+                currentUserId='admin'
+                usersLenght={1}
+            />,
+            {entities: {general: {license: {IsLicensed: 'false'}}}},
+        );
+
+        await userEvent.click(screen.getByRole('button', {name: 'Export'}));
+
+        expect(openModal).toHaveBeenCalledWith({
+            modalId: ModalIdentifiers.EXPORT_USER_DATA_MODAL,
+            dialogType: ExportUserDataModal,
+            dialogProps: {onConfirm: expect.any(Function)},
+        });
+        expect(screen.queryByText('Professional feature')).not.toBeInTheDocument();
+    });
+
+    test('disables export when the user list is empty', () => {
+        renderWithContext(
+            <SystemUsersExport
+                currentUserId='admin'
+                usersLenght={0}
+            />,
+        );
+        expect(screen.getByRole('button', {name: 'Export'})).toBeDisabled();
+    });
+});
