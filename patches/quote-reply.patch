@@ -0,0 +1,66 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {IntlShape} from 'react-intl';
+
+import type {Post} from '@mattermost/types/posts';
+
+import {getTeammateNameDisplaySetting} from 'mattermost-redux/selectors/entities/preferences';
+import {getUser} from 'mattermost-redux/selectors/entities/users';
+import {displayUsername} from 'mattermost-redux/utils/user_utils';
+
+import {getIntl} from 'utils/i18n';
+
+import type {ActionFunc} from 'types/store';
+
+const MAX_QUOTED_LINES = 5;
+
+type QuoteTarget = {
+    channelId: string;
+    rootId: string;
+    insert: (text: string) => void;
+};
+
+const targets: QuoteTarget[] = [];
+
+export function registerQuoteTarget(target: QuoteTarget) {
+    targets.push(target);
+    return () => {
+        targets.splice(targets.indexOf(target), 1);
+    };
+}
+
+function insertIntoComposer(channelId: string, rootId: string, text: string) {
+    const target = [...targets].reverse().find((t) => t.channelId === channelId && t.rootId === rootId);
+    target?.insert(text);
+    return Boolean(target);
+}
+
+function escapeMarkdown(text: string) {
+    return text.replace(/\s*[\r\n]+\s*/g, ' ').replace(/[\\`*_[\]~>]/g, '\\$&').replace(/</g, '&lt;');
+}
+
+function buildQuote(intl: IntlShape, post: Post, authorName: string, permalink: string) {
+    const message = (post.message_source || post.message).trim();
+    const lines = message ? message.split('\n') : [];
+    const quoted = lines.slice(0, MAX_QUOTED_LINES);
+    if (lines.length > MAX_QUOTED_LINES) {
+        quoted[MAX_QUOTED_LINES - 1] += '…';
+    }
+    if (post.file_ids?.length || post.metadata?.files?.length) {
+        quoted.push(intl.formatMessage({id: 'quote_reply.attachment', defaultMessage: '[attachment]'}));
+    }
+
+    const attribution = intl.formatMessage({id: 'quote_reply.attribution', defaultMessage: '**{name}** [wrote]({permalink}):'}, {name: escapeMarkdown(authorName), permalink});
+
+    return [attribution, ...quoted].map((line) => (line ? `> ${line}` : '>')).join('\n') + '\n\n';
+}
+
+export function quoteReply(post: Post, rootId: string, permalink: string): ActionFunc<boolean> {
+    return (dispatch, getState) => {
+        const state = getState();
+        const authorName = displayUsername(getUser(state, post.user_id), getTeammateNameDisplaySetting(state));
+        const text = buildQuote(getIntl(), post, authorName, permalink);
+        return {data: insertIntoComposer(post.channel_id, rootId, text)};
+    };
+}
