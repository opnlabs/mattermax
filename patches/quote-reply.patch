+import {useEffect} from 'react';
+
+import type {WysiwygEditorHandle} from 'components/advanced_text_editor/wysiwyg_editor/wysiwyg_editor';
+import type TextboxClass from 'components/textbox/textbox';
+
+import {useLatest} from 'hooks/useLatest';
+import {placeCaretAtEnd} from 'utils/utils';
+
+import type {PostDraft} from 'types/store/draft';
+
+import {registerQuoteTarget} from './quote_reply';
+
+type Options = {
+    channelId: string;
+    rootId: string;
+    enabled: boolean;
+    draft: PostDraft;
+    handleDraftChange: (draft: PostDraft) => void;
+    focusTextbox: (keepFocus?: boolean) => void;
+    textboxRef: React.RefObject<TextboxClass | null>;
+    wysiwygRef: React.RefObject<WysiwygEditorHandle | null>;
+};
+
+export default function useQuoteReplyTarget(options: Options) {
+    const latest = useLatest(options);
+    const {channelId, rootId, enabled} = options;
+
+    useEffect(() => {
+        if (!enabled) {
+            return undefined;
+        }
+
+        return registerQuoteTarget({
+            channelId,
+            rootId,
+            insert: (text) => {
+                const {draft, handleDraftChange, focusTextbox, textboxRef, wysiwygRef} = latest.current;
+
+                const editor = wysiwygRef.current?.getEditor();
+                if (editor) {
+                    editor.chain().focus('end').insertContent(text, {contentType: 'markdown'}).run();
+                    return;
+                }
+
+                const existing = draft.message.trimEnd();
+                handleDraftChange({...draft, message: existing ? `${existing}\n\n${text}` : text});
+                focusTextbox(true);
+                requestAnimationFrame(() => {
+                    const input = textboxRef.current?.getInputBox();
+                    if (input) {
+                        placeCaretAtEnd(input);
+                    }
+                });
+            },
+        });
+    }, [channelId, rootId, enabled, latest]);
+}
