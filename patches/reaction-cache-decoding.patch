+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package localcachelayer
+
+import (
+	"fmt"
+
+	"github.com/tinylib/msgp/msgp"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+// cachedReactions decodes the existing msgpack slice-of-maps representation
+// without reflection. Writes retain the ordinary []*model.Reaction encoding.
+// Unrecognized fields cause a cache miss rather than silently losing metadata.
+type cachedReactions []*model.Reaction
+
+func (r *cachedReactions) UnmarshalMsg(data []byte) ([]byte, error) {
+	if msgp.IsNil(data) {
+		rest, err := msgp.ReadNilBytes(data)
+		*r = nil
+		return rest, err
+	}
+
+	count, data, err := msgp.ReadArrayHeaderBytes(data)
+	if err != nil {
+		return nil, err
+	}
+	// Even a nil element needs one byte. Bound allocations for corrupt entries.
+	if uint64(count) > uint64(len(data)) {
+		return nil, msgp.ErrShortBytes
+	}
+	result := make(cachedReactions, count)
+	for i := range result {
+		if msgp.IsNil(data) {
+			data, err = msgp.ReadNilBytes(data)
+			if err != nil {
+				return nil, err
+			}
+			continue
+		}
+		var fields uint32
+		fields, data, err = msgp.ReadMapHeaderBytes(data)
+		if err != nil {
+			return nil, err
+		}
+		postReaction := &model.Reaction{}
+		for range fields {
+			var key []byte
+			key, data, err = msgp.ReadMapKeyZC(data)
+			if err != nil {
+				return nil, err
+			}
+			switch string(key) {
+			case "UserId":
+				postReaction.UserId, data, err = msgp.ReadStringBytes(data)
+			case "PostId":
+				postReaction.PostId, data, err = msgp.ReadStringBytes(data)
+			case "EmojiName":
+				postReaction.EmojiName, data, err = msgp.ReadStringBytes(data)
+			case "CreateAt":
+				postReaction.CreateAt, data, err = msgp.ReadInt64Bytes(data)
+			case "UpdateAt":
+				postReaction.UpdateAt, data, err = msgp.ReadInt64Bytes(data)
+			case "DeleteAt":
+				postReaction.DeleteAt, data, err = msgp.ReadInt64Bytes(data)
+			case "ChannelId":
+				postReaction.ChannelId, data, err = msgp.ReadStringBytes(data)
+			case "RemoteId":
+				if msgp.IsNil(data) {
+					data, err = msgp.ReadNilBytes(data)
+					postReaction.RemoteId = nil
+				} else {
+					var remoteID string
+					remoteID, data, err = msgp.ReadStringBytes(data)
+					postReaction.RemoteId = &remoteID
+				}
+			default:
+				return nil, fmt.Errorf("unrecognized reaction cache field %q", key)
+			}
+			if err != nil {
+				return nil, err
+			}
+		}
+		result[i] = postReaction
+	}
+	*r = result
+	return data, nil
+}
